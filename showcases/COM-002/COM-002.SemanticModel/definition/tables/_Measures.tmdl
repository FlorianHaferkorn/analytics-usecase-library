/// COM-002 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table[Column1 = text], {})
				in
				    Source

	column Column1
		isHidden
		summarizeBy: none

    /// margin.gm.pct - Gross Margin %
    /// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
    measure 'Gross Margin %' =
            BLANK()
        formatString: "0.0%"
        displayFolder: "COM-002"

    /// margin.gm.amount - Gross Margin Amount
    /// Absolute gross margin in currency.
    measure 'Gross Margin Amount' =
            BLANK()
        formatString: "#,0.00"
        displayFolder: "COM-002"

    /// sales.price.realization_pct - Price Realization %
    /// Shows how much of list price is realized after discounts.
    measure 'Price Realization %' =
            BLANK()
        formatString: "0.0%"
        displayFolder: "COM-002"

    /// sales.pvm.mix_effect.amount - Mix Effect Amount
    /// Captures the residual effect from changes in product, channel, or region mix.
    measure 'Mix Effect Amount' =
            BLANK()
        formatString: "#,0.00"
        displayFolder: "COM-002"

    /// cost.cogs_per_unit.amount - COGS per Unit
    /// Shows unit cost level relative to sold volume.
    measure 'COGS per Unit' =
            BLANK()
        formatString: "#,0"
        displayFolder: "COM-002"

    /// margin.gm.vs_plan.pct - Gross Margin % vs Plan
    /// Measures gross margin rate variance versus plan.
    measure 'Gross Margin % vs Plan' =
            BLANK()
        formatString: "0.0%"
        displayFolder: "COM-002"
