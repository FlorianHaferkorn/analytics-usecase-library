/// Measures (Use Cases: COM-001–COM-004, XD-001, XD-002, XD-003).
/// KPI-backed and supporting measures; single source in this table.
table _Measures
	lineageTag: bd8e5291-a2e8-45c1-9782-db4ae255f7e3

	/// KPI: sales.net_sales.amount — Net Sales Amount
	/// Description: Total invoiced revenue net of discounts and returns.
	/// Purpose: Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: f53c3077-ea80-47eb-a284-9a7b2716a488

	/// KPI: sales.net_sales.delta_pct.plan — Net Sales % vs Plan
	/// Description: Relative variance of Net Sales vs Plan.
	/// Purpose: Relative variance of Net Sales vs Plan.
	measure 'Net Sales % vs Plan' =
			VAR Actual = [Net Sales Amount]
			VAR Plan   = SUM ( fact_sales[Plan Sales Amount] )
			RETURN DIVIDE ( Actual - Plan, Plan )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: 4cfc9765-f233-4b2c-8bd0-ed79f6ba2ec9

	/// KPI: sales.net_sales.delta_pct.ly — Delta% Net Sales
	/// Description: Relative variance of Net Sales vs Last Year.
	/// Purpose: Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' =
			VAR Actual = [Net Sales Amount]
			VAR LY     = SUM ( fact_sales[Last Year Sales Amount] )
			RETURN DIVIDE ( Actual - LY, LY )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: d6e30ce5-3089-444d-bf11-24f2b06da0f2

	/// KPI: margin.gm.pct — Gross Margin %
	/// Description: Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	/// Purpose: Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' = DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: 228c5c1a-26d8-4143-93f4-3f77bcde15dc

	/// KPI: sales.pvm.price_effect.amount — Price Effect Amount
	/// Description: Quantifies the pure price impact in the PVM bridge.
	/// Purpose: Quantifies the pure price impact in the PVM bridge.
	measure 'Price Effect Amount' =
			SUMX (
			fact_sales,
			VAR ActualPrice = DIVIDE ( fact_sales[Net Sales Amount], fact_sales[Quantity] )
			VAR PlanPrice   = DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] )
			RETURN ( ActualPrice - PlanPrice ) * fact_sales[Quantity]
			)
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 3d95c393-e033-4659-b027-482ab2fef628

	/// KPI: sales.pvm.volume_effect.amount — Volume Effect Amount
	/// Description: Measures the variance caused purely by quantity changes at plan price.
	/// Purpose: Measures the variance caused purely by quantity changes at plan price.
	measure 'Volume Effect Amount' =
			SUMX (
			fact_sales,
			VAR ActualQty = fact_sales[Quantity]
			VAR PlanQty   = fact_sales[Plan Quantity]
			VAR PlanPrice = DIVIDE ( fact_sales[Plan Sales Amount], PlanQty )
			RETURN ( ActualQty - PlanQty ) * PlanPrice
			)
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 957de74b-0394-49e7-8d0c-420dc881d466

	/// KPI: sales.pvm.mix_effect.amount — Mix Effect Amount
	/// Description: Captures the residual effect from changes in product, channel, or region mix.
	/// Purpose: Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' =
			[Net Sales Amount]
			- SUM ( fact_sales[Plan Sales Amount] )
			- [Price Effect Amount]
			- [Volume Effect Amount]
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: be1a726d-2dd2-427b-a89b-1117ea849dcd

	/// KPI: margin.gm.amount — Gross Margin Amount
	/// Description: Absolute gross margin in currency.
	/// Purpose: Absolute gross margin in currency.
	measure 'Gross Margin Amount' = [Net Sales Amount] - [Cost of Goods Sold Amount]
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 49105aa8-80b6-4ccc-a0e5-ab3ca290218f

	/// KPI: cost.cogs.amount — Cost of Goods Sold Amount
	/// Description: Total cost of goods sold (supporting measure for margin calculations).
	/// Purpose: Total cost of goods sold (supporting measure for margin calculations).
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 8bfac931-4d8c-42e0-bc28-e5260a562236

	/// Supporting: sales.price.net.amount — Net Price Amount
	/// Description: Net price after discounts (supporting measure for price realization).
	/// Purpose: Support price realization and discount analysis.
	measure 'Net Price Amount' = SUM ( fact_sales[Net Price Amount] )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: b1abc6da-176b-4121-8d2f-07d17dab53ca

	/// Supporting: sales.price.list.amount — List Price Amount
	/// Description: List price before discounts (supporting measure for price realization).
	/// Purpose: Support price realization and discount analysis.
	measure 'List Price Amount' = SUM ( fact_sales[List Price Amount] )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 6a54b175-20e8-477a-ad5e-a44d470758e8

	/// KPI: sales.price.realization_pct — Price Realization %
	/// Description: Shows how much of list price is realized after discounts.
	/// Purpose: Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: e3abde22-ca5c-4123-9853-d551c6a77a68

	/// KPI: cost.cogs_per_unit.amount — COGS per Unit
	/// Description: Shows unit cost level relative to sold volume.
	/// Purpose: Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' = DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		formatString: #,0
		displayFolder: COM-002
		lineageTag: 73697d29-fe38-4531-afda-a5ce2b29043c

	/// KPI: margin.gm.vs_plan.pct — Gross Margin % vs Plan
	/// Description: Measures gross margin rate variance versus plan.
	/// Purpose: Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' =
			VAR GMAct =
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
			VAR GMPlan =
			DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] ),
			SUM ( fact_sales[Plan Sales Amount] ) )
			RETURN
			DIVIDE ( GMAct - GMPlan, GMPlan )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: 5f41fbca-a98d-4244-ac1d-4043c2285700

	/// KPI: crm.clv.amount — CLV
	/// Description: Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	/// Purpose: Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure CLV =
			AVERAGEX (
			VALUES ( fact_sales[CustomerKey] ),
			CALCULATE (
			SUM ( fact_sales[Net Sales Amount] ) - SUM ( fact_sales[Cost of Goods Sold Amount] )
			) * 3
			)
		formatString: #,0.00
		displayFolder: COM-003
		lineageTag: 40a9be3a-f2fc-4a0d-9df0-e68deb5ac155

	/// KPI: crm.lifetime_revenue.amount — Customer Lifetime Revenue Amount
	/// Description: Sum of realized revenue across the customer lifecycle.
	/// Purpose: Sum of realized revenue across the customer lifecycle.
	measure 'Customer Lifetime Revenue Amount' =
			CALCULATE (
			SUM ( fact_sales[Net Sales Amount] ),
			ALLSELECTED ( dim_date )
			)
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 4be3ac4f-ff2b-4573-97d0-3cf2fcb62cdf

	/// KPI: crm.retention.pct — Customer Retention %
	/// Description: Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	/// Purpose: Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'Customer Retention %' =
			VAR CurrentPeriodCustomers =
			CALCULATE (
			DISTINCTCOUNT ( fact_sales[CustomerKey] ),
			FILTER ( ALLSELECTED ( dim_date ), dim_date[Date] = MAX ( dim_date[Date] ) )
			)
			VAR PreviousPeriodCustomers =
			CALCULATE (
			DISTINCTCOUNT ( fact_sales[CustomerKey] ),
			DATEADD ( dim_date[Date], -1, MONTH )
			)
			RETURN DIVIDE ( CurrentPeriodCustomers, PreviousPeriodCustomers )
		formatString: 0.0%
		displayFolder: COM-003
		lineageTag: f39d68b7-9382-4ad4-a107-e2941b01672a

	/// KPI: crm.churned_customers.count — Churned Customers
	/// Description: Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	/// Purpose: Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'Churned Customers' =
			VAR PreviousMonthCustomers =
			CALCULATETABLE (
			VALUES ( fact_sales[CustomerKey] ),
			DATEADD ( dim_date[Date], -1, MONTH )
			)
			VAR CurrentMonthCustomers =
			VALUES ( fact_sales[CustomerKey] )
			RETURN
			COUNTROWS ( EXCEPT ( PreviousMonthCustomers, CurrentMonthCustomers ) )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 88a7be8d-3890-4004-86fb-d0343c78732e

	/// KPI: crm.revenue_at_risk.amount — Revenue at Risk Amount
	/// Description: Quantify revenue exposure from customers flagged as churn-risk.
	/// Purpose: Quantify revenue exposure from customers flagged as churn-risk.
	measure 'Revenue at Risk Amount' =
			VAR ChurnRiskPct = 0.15
			RETURN [CLV] * ChurnRiskPct
		formatString: #,0
		displayFolder: COM-003
		lineageTag: f0a75dbc-d719-46e1-a485-d17cbbf1ae18

	/// KPI: crm.active_customers.count — Active Customers
	/// Description: Number of unique active customers in the reporting period.
	/// Purpose: Number of unique active customers in the reporting period.
	measure 'Active Customers' = DISTINCTCOUNT ( fact_sales[CustomerKey] )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 6a63a5f1-1ba1-4493-b2aa-389d3bb94733

	/// KPI: crm.nps.index — NPS Score
	/// Description: Measures customer advocacy and likelihood to recommend.
	/// Purpose: Measures customer advocacy and likelihood to recommend.
	measure 'NPS Score' = BLANK()
		formatString: #,0
		displayFolder: COM-003
		lineageTag: b84c65b1-fbe2-487e-af69-448134acf23f

	/// KPI: crm.complaint.count — Complaint Count
	/// Description: Provide the absolute number of logged complaints.
	/// Purpose: Provide the absolute number of logged complaints.
	measure 'Complaint Count' = COUNTROWS ( fact_experience )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 23a8b996-f1d8-48f2-bddb-e9845d8d31da

	/// Supporting: Promo Cost (from fact_promo)
	/// Description: Sum of promo cost from fact_promo.
	/// Purpose: COM-004 promo ROI and incremental analysis.
	measure 'Promo Cost' = SUM ( fact_promo[Promo Cost] )
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 53a3d21f-befa-479d-a6b9-85e21053987c

	/// Supporting: Baseline Sales Amount (from fact_promo)
	/// Description: Baseline sales amount from fact_promo.
	/// Purpose: COM-004 promo ROI and cannibalization.
	measure 'Baseline Sales Amount' = SUM ( fact_promo[Baseline Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 34721733-39de-4f40-8f8a-38e2a0497670

	/// Supporting: Cannibalized Sales Amount (baseline minus non-promo baseline)
	/// Description: Sales cannibalized by promotion.
	/// Purpose: COM-004 cannibalization analysis.
	measure 'Cannibalized Sales Amount' = SUM ( fact_promo[Baseline Sales Amount] ) - SUM ( fact_promo[Baseline Non-Promo Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 82389636-7b17-4f96-99a9-f235bf7a2096

	/// Supporting: Incremental Gross Margin Amount (GM on incremental sales)
	/// Description: Gross margin on incremental sales from promo.
	/// Purpose: COM-004 promo ROI.
	measure 'Incremental Gross Margin Amount' = [Incremental Sales Amount] * 0.35
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: c5f1fe2d-163b-4842-9b3d-b00bcebe5b30

	/// KPI: sales.promo.roi.pct — Promo ROI %
	/// Description: Measures profitability of promotions relative to spend.
	/// Purpose: Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' = DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 1360afa2-df22-499b-8c4f-4cf3ba19a7a5

	/// KPI: sales.promo.incremental.amount — Incremental Sales Amount
	/// Description: Additional sales due to promotion.
	/// Purpose: Additional sales due to promotion.
	measure 'Incremental Sales Amount' = [Net Sales Amount] - [Baseline Sales Amount]
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 77c87164-f561-4935-b38e-ef924d0127ee

	/// margin.promo.gm.pct - GM % During Promo
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' =
			CALCULATE (
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ),
			fact_sales[Promo Flag] = "Yes"
			)
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 0ba2128c-44a9-47a3-838e-c5ec56be6165

	/// sales.promo.cannibalization.pct - Cannibalization %
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' = DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 3f1b957a-8684-47a1-a8c9-0326cba7b471

