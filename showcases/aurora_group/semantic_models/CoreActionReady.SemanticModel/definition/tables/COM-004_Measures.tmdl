/// COM-004 Measures
table COM-004_Measures

	partition COM-004_Measures = m
		mode: import
		source =
				let
				    Source = #table(type table[Column1 = text], {})
				in
				    Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

    /// sales.promo.roi.pct - Promo ROI %
    /// Measures profitability of promotions relative to spend.
    measure 'Promo ROI %' =
            DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
        formatString: "0.0%"
        displayFolder: "04_Promotion Effectiveness"

    /// sales.promo.incremental.amount - Incremental Sales Amount
    /// Additional sales due to promotion.
    measure 'Incremental Sales Amount' =
            [Net Sales Amount] - [Baseline Sales Amount]
        formatString: "#,0.00"
        displayFolder: "04_Promotion Effectiveness"

    /// margin.promo.gm.pct - GM % During Promo
    /// Gross margin rate during promo periods.
    measure 'GM % During Promo' =
            CALCULATE (
                DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ),
                fact_sales[Promo Flag] = "Yes"
            )
        formatString: "0.0%"
        displayFolder: "04_Promotion Effectiveness"

    /// sales.price.realization_pct - Price Realization %
    /// Shows how much of list price is realized after discounts.
    measure 'Price Realization %' =
            DIVIDE ( [Net Price Amount], [List Price Amount] )
        formatString: "0.0%"
        displayFolder: "04_Promotion Effectiveness"

    /// sales.promo.cannibalization.pct - Cannibalization %
    /// Measures share of promo uplift offset by decline in non-promoted sales.
    measure 'Cannibalization %' =
            DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
        formatString: "0.0%"
        displayFolder: "04_Promotion Effectiveness"
