/// COM-002 Measures
table COM-002_Measures

	partition COM-002_Measures = m
		mode: import
		source =
				let
				    Source = #table(type table[Column1 = text], {})
				in
				    Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

    /// margin.gm.pct - Gross Margin %
    /// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
    measure 'Gross Margin %' =
            DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
        formatString: "0.0%"
        displayFolder: "02_Margin Analysis"

    /// margin.gm.amount - Gross Margin Amount
    /// Absolute gross margin in currency.
    measure 'Gross Margin Amount' =
            [Net Sales Amount] - [Cost of Goods Sold Amount]
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"

    /// sales.price.realization_pct - Price Realization %
    /// Shows how much of list price is realized after discounts.
    measure 'Price Realization %' =
            DIVIDE ( [Net Price Amount], [List Price Amount] )
        formatString: "0.0%"
        displayFolder: "02_Margin Analysis"

    /// sales.pvm.mix_effect.amount - Mix Effect Amount
    /// Captures the residual effect from changes in product, channel, or region mix.
    measure 'Mix Effect Amount' =
            [Net Sales Amount]
                - SUM ( fact_sales[Plan Sales Amount] )
                - [Price Effect Amount]
                - [Volume Effect Amount]
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"

    /// cost.cogs_per_unit.amount - COGS per Unit
    /// Shows unit cost level relative to sold volume.
    measure 'COGS per Unit' =
            DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
        formatString: "#,0"
        displayFolder: "02_Margin Analysis"

    /// margin.gm.vs_plan.pct - Gross Margin % vs Plan
    /// Measures gross margin rate variance versus plan.
    measure 'Gross Margin % vs Plan' =
            VAR GMAct =
                DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
            VAR GMPlan =
                DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] ),
                         SUM ( fact_sales[Plan Sales Amount] ) )
            RETURN
                DIVIDE ( GMAct - GMPlan, GMPlan )
        formatString: "0.0%"
        displayFolder: "02_Margin Analysis"

    /// Supporting - Net Sales Amount
    measure 'Net Sales Amount' =
            SUM ( fact_sales[Net Sales Amount] )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden

    /// Supporting - Cost of Goods Sold Amount
    measure 'Cost of Goods Sold Amount' =
            SUM ( fact_sales[Cost of Goods Sold Amount] )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden

    /// Supporting - Net Price Amount
    measure 'Net Price Amount' =
            SUM ( fact_sales[Net Price Amount] )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden

    /// Supporting - List Price Amount
    measure 'List Price Amount' =
            SUM ( fact_sales[List Price Amount] )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden

    /// Supporting - Price Effect Amount
    measure 'Price Effect Amount' =
            SUMX (
                fact_sales,
                VAR ActualPrice = DIVIDE ( fact_sales[Net Sales Amount], fact_sales[Quantity] )
                VAR PlanPrice   = DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] )
                RETURN ( ActualPrice - PlanPrice ) * fact_sales[Quantity]
            )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden

    /// Supporting - Volume Effect Amount
    measure 'Volume Effect Amount' =
            SUMX (
                fact_sales,
                VAR ActualQty = fact_sales[Quantity]
                VAR PlanQty   = fact_sales[Plan Quantity]
                VAR PlanPrice = DIVIDE ( fact_sales[Plan Sales Amount], PlanQty )
                RETURN ( ActualQty - PlanQty ) * PlanPrice
            )
        formatString: "#,0.00"
        displayFolder: "02_Margin Analysis"
        isHidden
