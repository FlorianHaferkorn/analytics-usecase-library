	measure 'Symbol Δ% Ø Price Deviation %' =
			
			VAR _meas = [Δ% Ø Price Deviation %]
			VAR _Threshold = 0.02
			RETURN
			    SWITCH (
			        TRUE (),
			        _meas = BLANK (), BLANK (),
			        _meas < 0, BLANK (),
			        _meas <= _Threshold, "SymbolMedium",
			        _meas > _Threshold, "SymbolLow"
			    )
		lineageTag: 7a072166-91c9-4871-8044-97801d817680

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure X_AXIS_Suppliers = ```
			
			VAR _ScaleFactor = 1.5
			VAR _Table =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            dim_suppliers,
			            dim_suppliers[supplier_id]
			        ),
			        "Total_Spend", [Total Spend] 
			    )
			VAR _MAX =
			    MAXX(
			        _Table ,
			        [Total_Spend]
			    )
			RETURN
			_MAX * _ScaleFactor
			```
		lineageTag: 2930142c-4296-4840-b369-674fb5eab207

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Card_Contracts_expiring_soon =
			
			SWITCH(
			    TRUE(),
			    [# Contracts expiring soon] > 1 , "❗ " & [# Contracts expiring soon] & " contract expiring in the next 60 days" ,
			    [# Contracts expiring soon] = 1 , "❗ " & [# Contracts expiring soon] & " contracts expiring in the next 60 days" ,
			    "✅ None in next 60 days")
		lineageTag: 338d2063-c1df-45ff-bad5-893d6fcf2c63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

