/// All baseline metrics for procurement reporting
table _All_Measures
	lineageTag: 73dac9c9-af1e-4890-8acb-09858fd7d3df

	/// Total spend based on unit price and quantity
	measure 'Total Spend' = ```
			
			-- Sum of unit price times quantity over all transactions
			SUMX(
			    fact_transactions, 
			    fact_transactions[unit_price] * fact_transactions[quantity]
			)
			```
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000001

	/// Spend covered by valid contracts
	measure 'Contract Spend' =
			
			-- Only transactions that are linked to a contract
			CALCULATE([Total Spend], NOT(ISBLANK(fact_transactions[contract_id])))
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000002

	/// Share of spend under contract
	measure 'Spend under Contract %' =
			-- Ratio of contract spend to total spend
			DIVIDE([Contract Spend], [Total Spend])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000003

	/// Average actual price from transactions
	measure 'Average Actual Price' =
			-- Average price over all transactions
			AVERAGEX(fact_transactions, fact_transactions[unit_price])
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000004

	/// Average contract price from contract details
	measure 'Average Contract Price' =
			-- Average agreed price per part
			AVERAGEX(fact_contractdetails, fact_contractdetails[agreed_price])
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000005

	/// Average deviation of actual vs contract price in %
	measure 'Ø Price Deviation %' =
			-- (Actual - Contract) / Contract
			VAR _actual = [Average Actual Price]
			VAR _contract = [Average Contract Price]
			VAR _result = DIVIDE( _actual - _contract, _contract)
			RETURN
			_result
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000006

	/// Number of index-linked contracts
	measure '# Index Linked Contracts' =
			-- Count of contracts where index_linked is TRUE
			CALCULATE(DISTINCTCOUNT(dim_contracts[contract_id]), dim_contracts[index_linked] = TRUE())
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000007

	/// Share of index-linked contracts
	measure 'Index Linked Share %' =
			-- Percentage of contracts that are index-linked
			DIVIDE([# Index Linked Contracts], DISTINCTCOUNT(dim_contracts[contract_id]))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000008

	/// Contracts expiring within 60 days
	measure '# Contracts expiring soon' = ```
			-- Contracts with end date within the next 60 days
			VAR _selDate = MAX(dim_date[Date])
			VAR _Threshold = 60
			VAR _result = 
			    CALCULATE(
			        COUNTROWS(dim_contracts), 
			        dim_contracts[end_date] <= _selDate + _Threshold, 
			        dim_contracts[end_date] >= _selDate
			    )
			RETURN
			_result
			```
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 00000000-0000-0000-0000-000000000009

	/// Number of unique parts
	measure '# Parts' =
			-- Count of distinct part IDs
			DISTINCTCOUNT(dim_parts[part_id])
		formatString: #,0
		displayFolder: Metadata
		lineageTag: 00000000-0000-0000-0000-000000000010

	/// Number of unique suppliers
	measure '# Suppliers' =
			-- Count of distinct suppliers
			DISTINCTCOUNT(dim_suppliers[supplier_id])
		formatString: #,0
		displayFolder: Metadata
		lineageTag: 00000000-0000-0000-0000-000000000011

	/// Number of valid contracts
	measure '# Contracts' =
			-- Count of distinct contract IDs
			DISTINCTCOUNT(dim_contracts[contract_id])
		formatString: #,0
		displayFolder: Metadata
		lineageTag: 00000000-0000-0000-0000-000000000012

	/// Number of recorded transactions
	measure '# Transactions' =
			-- Row count in fact_transactions
			COUNTROWS(fact_transactions)
		formatString: #,0
		displayFolder: Metadata
		lineageTag: 00000000-0000-0000-0000-000000000013

