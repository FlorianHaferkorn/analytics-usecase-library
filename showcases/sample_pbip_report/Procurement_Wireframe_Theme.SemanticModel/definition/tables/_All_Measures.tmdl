	/// Upward Triangle (iOS style)
	measure 'Arrow Up (iOS)' =
			-- Modern iOS-style up indicator
			"▲"
		formatString: Text
		displayFolder: Symbols
		lineageTag: 00000000-0000-0000-0000-000000003101

	/// Downward Triangle (iOS style)
	measure 'Arrow Down (iOS)' =
			-- Modern iOS-style down indicator
			"▼"
		formatString: Text
		displayFolder: Symbols
		lineageTag: 00000000-0000-0000-0000-000000003102

	/// Rightward Triangle (iOS style - neutral)
	measure 'Arrow Flat (iOS)' =
			-- Modern iOS-style neutral indicator
			"►"
		formatString: Text
		displayFolder: Symbols
		lineageTag: 00000000-0000-0000-0000-000000003103

	/// Dynamic iOS-style arrow based on Ø Price Deviation %
	measure 'Price Deviation Arrow (iOS)' =
			-- Returns ▲, ▼ or ► based on value of Ø Price Deviation %
			SWITCH(
				TRUE(),
				[Ø Price Deviation %] > 0.01, "▲",
				[Ø Price Deviation %] < -0.01, "▼",
				"►"
			)
		formatString: Text
		displayFolder: Symbols
		lineageTag: 00000000-0000-0000-0000-000000003110

	measure 'Total Spend PY' = CALCULATE ( [Total Spend], SAMEPERIODLASTYEAR ( dim_date[DATE] ) )
		formatString: #,0.0
		lineageTag: 5906b119-9b31-4418-8db6-2a261fe1e604

	measure 'Δ Total Spend' =
			
			VAR _AY = [Total Spend]
			VAR _LY = [Total Spend PY]
			VAR _Result = _AY - _LY
			RETURN
			_Result
		formatString: #,0.0
		lineageTag: 9030b6b4-b8f5-4102-8883-b31d18c6ff6f

	measure 'Δ% Total Spend' =
			
			VAR _Deviance = [Δ Total Spend]
			VAR _LY = [Total Spend PY]
			VAR _Result = DIVIDE( _Deviance , _LY , 0 )
			RETURN
			_Result
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1a8e885b-f18a-4051-bd99-79925b9aab4f

	measure 'Color Δ Total Spend' =
			
			VAR _UsedMeasure = [Δ Total Spend]
			VAR _Meas = [Total Spend]
			RETURN
			    SWITCH (
			        TRUE (),
			        _Meas = BLANK (), [Black],
			        _UsedMeasure > 0, [Green],
			        _UsedMeasure < 0, [Red],
			        [Black]
			    )
		lineageTag: 498c926c-a913-47a1-b169-92b564322b33

		annotation PBI_FormatHint = {"isText":true}

	measure Card_Detail_Text = "compared to PY"
