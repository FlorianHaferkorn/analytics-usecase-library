	measure 'Symbol Purchase Price Ratio' =
			
			VAR UsedMeasure = [∆ PP Ratio to Target in %]
			VAR Target = 0
			VAR MinGreen = 0.0
			VAR MinYellow = 0.05
			VAR MinRed = 0.1
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure <= MinGreen, "CircleHigh",
			        UsedMeasure <= MinYellow, "CircleMedium",
			        UsedMeasure <= MinRed, "CircleLow",
			        ISBLANK ( UsedMeasure ), BLANK (),
			        "4CircleLow"
			    )
		displayFolder: _Symbols
		lineageTag: 97e592b3-311b-4e08-9641-8e2196b1417d

		changedProperty = IsHidden

	measure 'Symbol COS_pre_calc' =
			
