	/// Chemical Inventory Compliance against ZDHC MRSL and ZDHC Wastewater Testing​:
	/// 
	/// A) Chemical Inventory:  the chemical inventory is verified against ZDHC MRSL standard based on third party screening tool and test report​
	/// 
	/// ​​B) ZDHC Wastewater Testing: perform wastewater testing per ZDHC wastewater guideline (a more stringent industrial standard)​
	/// ​
	/// 100% - Demonstrate both A and B (passed)​
	/// 50% - Demonstrate A and B (failed)​
	/// 50% - Cannot demonstrate A , only B (passed)​
	/// 0% - Demonstrate only B (failed)​
	/// 0% - Demonstrate neither A nor B​
	measure 'Chemical Compliance' =
			
			CALCULATE (
			    AVERAGE ( Sustainability[KPI 4] ),
			    FILTER ( Sustainability, Sustainability[Wet processing] = "Yes" ),
			    FILTER ( dimManufacturer, dimManufacturer[Manufacturer ID] <> BLANK () )
			)
		formatString: 0.00
		displayFolder: Sustainability
		lineageTag: aa96b0c3-c16f-436f-a0d4-ef3e6fe4d789

		changedProperty = FormatString

		changedProperty = IsHidden

