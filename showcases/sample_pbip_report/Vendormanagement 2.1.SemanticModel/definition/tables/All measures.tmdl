		changedProperty = IsHidden

	measure 'Color Inspection Rate' =
			
			VAR UsedMeasure = [Inspection Rate]
			VAR Target = [Target Inspection Rate]
			VAR MinGreen = Target
			VAR MinYellow = Target * 0.67
			VAR MinRed = Target * 0.33
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure >= MinGreen, [Green],
			        UsedMeasure >= MinYellow, [Yellow],
			        UsedMeasure < MinYellow, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: f38447f7-e8a1-4a52-95e6-793eece938d1

		changedProperty = IsHidden

	measure 'Color Complaint Rate' =
			
			VAR UsedMeasure = [Complaint Rate]
			VAR Target = [Target Complaint Rate]
			VAR MinGreen = Target
			VAR MinYellow = Target * 1.5
			VAR MinRed = Target * 2
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure <= MinGreen, [Green],
			        UsedMeasure <= MinYellow, [Yellow],
			        UsedMeasure > MinYellow, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: 0121b45b-b38d-4dfa-b8fb-dc1c26d276de

		changedProperty = IsHidden

	/// Percentage of styles overshipped compared to the total ordered styles.
	measure 'Overshipped in % (styles)' =
			
			DIVIDE (
			    CALCULATE (
			        [# of styles],
			        FILTER ( Details, Details[PO overshipped (pcs)] > 0 )
			    ),
			    [# of styles]
			)
