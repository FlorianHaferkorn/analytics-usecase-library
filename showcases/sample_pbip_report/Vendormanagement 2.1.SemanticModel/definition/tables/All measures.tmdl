	/// Shortshipped in % difference to Target.
	measure 'Shortshipped in % ∆ to Target' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [Shortshipped in %] - [Target Shortshipped]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Percent" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Percent" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Percent" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Quantity Variance
		lineageTag: 2ac3b6c0-317e-4ef0-a1cc-e6c71e681bbb

