	measure 'Description Total Score' =
			
			"The Total Score reflects the overall performance from 0 (worst) to 100 (best) points. It is calculated from the major fields Delivery (25% split into DDR 17,5% and Quantity Variance 7,5%), Quality (25%), Sustainability (25%) and Price Level (25%)."
		displayFolder: Description
		lineageTag: 711b9ad0-70de-4815-92b3-05122fd1cb99

		changedProperty = IsHidden

	/// The Delivery KPI reflects the delivery performance from 0 (worst) to 100 (best) points.
	/// It is calculated from the major fields Delivery Date Reliability (55 %), Shortshipments (35 %) and Overshipments (10 %).
	measure 'Description Delivery' =
			
			"The Delivery KPI reflects the delivery performance from 0 (worst) to 100 (best) points.
			It is calculated by Delivery Date Reliability (70 %), Shortshipments (20 %) and Overshipments (10 %).
			Until 2022 the weightages were Delivery Date Reliability (55 %), Shortshipments (35 %) and Overshipments (10 %)."
		displayFolder: Description
		lineageTag: 92812369-57ce-402c-98df-64ac3041716d

		changedProperty = IsHidden

	measure 'Description Quality' =
			
			"The Quality KPI reflects the quality performance from 0 (worst) to 100 (best) points.
			It is calculated by Cancellation Rate (30 %), Right first time (40 %) and Complaint Rate (30 %)."
		displayFolder: Description
		lineageTag: 1292210f-a4fe-4062-9e03-599acd794bfb

		changedProperty = IsHidden

	measure 'Description Sustainability' =
			
			"The Sustainability KPI reflects the Sustainability performance from 0 (worst) to 100 (best) points. It is calculated by the KPIs Transparency (15%), Social Audit (55%), Environmental Audit (15%) and Chemical Compliance (15%). Whenever a Chemical Compliance Rate can not be evaluated because of no wet processing needs (Blank), the weights are changed to Transparency (17,65%), Social Audit (64,71%) and Environmental (17,65%)."
		displayFolder: Description
		lineageTag: 93c76a76-f77b-4ecd-8829-5c18a688439a

		changedProperty = IsHidden

	/// The Price Level reflects the price level from 0 (worst) to 100 (best) points.
	/// It compares the purchase price on Brand, Gender, Line, Main Class and UVP to the corresponding country average (50%) and to the global average (50%).
	measure 'Description Price Level' =
			
			"The Price Level reflects the price level from 0 (worst) to 100 (best) points.
			It scores the difference of the actual purchase price ratio (PPR) and the cost of sales ratio (COS) to their respective target. A difference of 0 or below is 100 points and an actual PPR/COS higher than 10 percent points compared to the target is 0 points. PPR and COS are both weighted in with 50% each."
		displayFolder: Description
		lineageTag: 98b1562c-fec9-4f1a-85eb-15c824115253

		changedProperty = IsHidden

	measure 'Description DDR' =
			
			"Percentage of ordered value handed over within the tolerance of 5 days after confirmed handover date."
		displayFolder: Description
		lineageTag: 302c1a2f-e1da-4835-afab-80338f537b0d

		changedProperty = IsHidden

	measure 'Description Shortshipments' =
			
			"Measures the quote of the shortshipped value to the total order value on style variant level."
		displayFolder: Description
		lineageTag: 214ece00-9512-4d2c-8d04-0268799b9d9a

		changedProperty = IsHidden

	measure 'Description Overshipments' =
			
			"Measures the quote of the overshipped value to the total order value on style variant level."
		displayFolder: Description
		lineageTag: 41f1db3a-6451-460f-b61a-260a6b28119f

		changedProperty = IsHidden

	measure 'Description Audit Rating' =
			
			"Numerical value based on average audit result of all active Manufacturers (Tier 1). Audit scores vary from A (best) to E (Zero Tolerance) with the following translations: A = 100 %, B = 80 %, C = 60 %, D = 40 %, E = 0 %"
		displayFolder: Description
		lineageTag: 260487d0-f81e-42ed-bc3e-be8322009cc8

		changedProperty = IsHidden

	measure 'Description Right first time' =
			
			"Percentage of points achieved within the inspection types optical test result (45 %), measurement (MSMT) test result (45 %) and random check result (10 %) to the number of styles. The number of ordered styles reflect the maximum points which can be achieved. For each issue within optical, MSMT or random check the possible points will be reduced by 0.5 points for minor issues above the defined tolerances and 1 point for major issues above the defined tolerances. After the reductions the lowest overall score is 0 points."
		displayFolder: Description
		lineageTag: 5df3d60e-200c-4c66-8483-42fd18c1111a

		changedProperty = IsHidden

	measure 'Description Inspection styles' =
			
			"Percentage of styles inspected within the final goods inspection, incoming goods inspection or random checks in comparison to all ordered styles."
		displayFolder: Description
		lineageTag: de9b0038-6034-47dc-9f06-cdb59c924bd4

		changedProperty = IsHidden

	measure 'Description Complaint Rate' =
			
			"Only reflecting the customer claim rate. Percentage of claimed and invoiced valued in comparison to the total delivered value to our customers."
		displayFolder: Description
		lineageTag: c9cb9977-0596-49bd-80d5-681890a36cd3

		changedProperty = IsHidden

	measure 'Description Cancellation Rate' =
			
			"Percentage of the cancelled value to the total order value. Cancellations because of PA = Production downtime, LT = Delay of Delivery, QM = Quality Issues. Cancellations before handover (purchase order) and after receipt of goods (by QA Department) are combined."
		displayFolder: Description
		lineageTag: 2e9bd45b-7e5e-450d-b8e8-38ae82ad65bc

		changedProperty = IsHidden

	measure 'Description FGI' =
			
			"Percentage of styles with final FGI result marginal or failed in comparison to all ordered styles."
		displayFolder: Description
		lineageTag: dabdac6b-d602-439f-9b53-fca65c6e4d50

		changedProperty = IsHidden

	measure 'Description IGI' =
			
			"Percentage of styles with final IGI result marginal or failed in comparison to all ordered styles."
