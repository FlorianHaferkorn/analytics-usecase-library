		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Bulk purchase order value in $ (cumulative).
	measure 'PO_conf_val $ (cumulative)' =
			
			VAR LastOrderDate =
			    CALCULATE (
			        LASTDATE ( Details[Season_Calendar] ),
			        FILTER ( Details, Details[sample_bulk] = "bulk" )
			    )
			RETURN
			    IF (
			        ISBLANK ( [PO_conf_pcs] ),
			        BLANK (),
			        IF (
			            SELECTEDVALUE ( dimTimetable_Season[Date] ) > LastOrderDate,
			            BLANK (),
			            CALCULATE (
			                [PO_conf_val $],
			                FILTER (
			                    ALLSELECTED ( dimTimetable_Season ),
			                    dimTimetable_Season[Date] <= MAX ( dimTimetable_Season[Date] )
			                )
			            )
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Planning
		lineageTag: 46fff288-d07e-490e-a15f-f541018d8a82

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Planned purchase order value in $ (cumulative).
	measure 'PO_plan_val $ (cumulative)' =
			
			CALCULATE (
			    [PO_plan_val $],
			    FILTER (
			        ALLSELECTED ( dimTimetable_Season ),
			        dimTimetable_Season[Date] <= MAX ( dimTimetable_Season[Date] )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Planning
		lineageTag: 84e9be21-a354-44eb-ba60-5525d4b3d71f

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Purchase order value in $ cancelled. 
	/// The following cancellation reasons for cancellations before handover are relevant: 
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	/// 
	/// Cancellations after receipt of goods are defined by the Quality Department and are included as well.
	measure 'PO cancelled (value) $' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    [PO_cancelled (value) $ (pre delivery)] + [PO_cancelled (value) $ (WEK)] + 0,
			    BLANK ()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Cancellations
		lineageTag: 68e35bb1-6d9f-4673-8af0-40356bb221c5

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Shortshipped value in $ compared to the purchase order on style variant level.
	measure 'PO_shortship_val $' =
			
			[PO_shortship_pcs] * [Purchase Price $]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Quantity Variance
