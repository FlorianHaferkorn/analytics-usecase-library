	/// Wholesale Price value € calculated by PO_conf_pcs and Wholesale Price €.
	measure 'WHSSP_val €' =
			
			CALCULATE ( SUM ( Details[WHSSP val €] ), Details[KSCHL] <> "ZFMS" )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
