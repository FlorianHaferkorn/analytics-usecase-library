table 'All measures'
	lineageTag: 02b2fae7-af11-4631-8280-81cd54bb93c2

	/// The Total Score reflects the overall performance from 0 (worst) to 100 (best) points. It is calculated from the major fields Delivery (25%), Quality (25%), Sustainability (25%) and Price level (25%).
	measure 'Total Score' =
			
			VAR weight_delivery =
			    DIVIDE ( 1, 3 )
			VAR weight_quality =
			    DIVIDE ( 1, 3 )
			VAR weight_sustainability =
			    DIVIDE ( 1, 3 )
			RETURN
			    IF (
			        ISBLANK ( [PO_conf_pcs] ),
			        BLANK (),
			        IF (
			            ISBLANK ( [Sustainability] ),
			            [Delivery] * DIVIDE ( 1, 2 )
			                + [Quality] * DIVIDE ( 1, 2 ),
			            [Delivery] * weight_delivery + [Quality] * weight_quality + [Sustainability] * weight_sustainability
			        )
			    )
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: 9dcdd7e8-ae66-4176-bf8a-135b95fcd6cd

		changedProperty = IsHidden

	/// Distinct number of purchase orders.
	measure '# of orders' =
			
			--DISTINCTCOUNTNOBLANK ( Details[Purchase Order] )
			COUNTROWS (
			    SUMMARIZE ( Details, Details[Purchase Order] )
			)
		formatString: #,0
		displayFolder: Purchase Order
		lineageTag: 884fce2f-71af-42d7-92ab-d14e11a8420b

		changedProperty = IsHidden

	/// Distinct number of styles.
	measure '# of styles' =
			
			--CALCULATE (
			--    DISTINCTCOUNTNOBLANK ( Details[RT_CONFMAT] ),
			--    Details[KSCHL] <> "ZFMS"
			--)
			CALCULATE (
			    SUMX ( VALUES ( Details[RT_CONFMAT] ), 1 ),
			    NOT ( Details[KSCHL] = "ZFMS" )
			)
		formatString: #,0
		displayFolder: Purchase Order
		lineageTag: 6981d904-ec3d-4acf-ae7f-12ae52a0fdc4

		changedProperty = IsHidden

	measure 'Target Social Audit Rating' =
			
			SWITCH ( TRUE (), SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 80, 85 )
