	/// Forecast purchase order quantity, which indicates "what can happen". If the season is released, then the actual data is used else the plan.
	/// A season is released, when the corresponding sales period is due more than 14 days.
	measure PO_forecast_pcs =
			
			VAR Forecast2 =
			    CALCULATE (
			        [PO_conf_pcs],
			        FILTER ( dimTimetable_Season, dimTimetable_Season[Released] = "Yes" )
			    )
			        + CALCULATE (
			            [PO_plan_pcs],
			            FILTER ( dimTimetable_Season, dimTimetable_Season[Released] = "No" )
			        )
			RETURN
			    Forecast2
		formatString: #,0
		displayFolder: Planning
		lineageTag: 34d5630f-7eba-4e89-b235-cd5750f85f78

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Forecast purchase order value €, which indicates "what can happen". If the season is released, then the actual data is used else the plan.
