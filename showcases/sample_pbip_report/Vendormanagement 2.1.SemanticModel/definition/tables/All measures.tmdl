	/// Forecast purchase order quantity, which indicates "what can happen" and considering the current trend based on all released seasons of selected year. If the season is released, then the actual data is used else the plan.
	/// A season is released, when the corresponding sales period is due more than 14 days.
	measure 'PO_forecast_pcs (Trend)' =
			
			VAR _Act =
			    CALCULATE (
			        [PO_conf_pcs],
			        FILTER ( dimTimetable_Season, dimTimetable_Season[Released] = "Yes" )
			    )
			VAR _Plan =
			    CALCULATE (
			        [PO_plan_pcs],
			        FILTER ( dimTimetable_Season, dimTimetable_Season[Released] = "No" )
			    )
			RETURN
			    _Act + _Plan * [Trend]
		formatString: #,0
		displayFolder: Planning
		lineageTag: 4bea259c-cabd-42aa-9bfc-a2ab0c1a299b

	/// Represents the trend based on the comparison of the actual quantity and the planned quantity for all released seasons of a year.
	measure Trend =
			
			VAR _Actual =
			    CALCULATE (
			        [PO_conf_pcs],
			        REMOVEFILTERS ( dimTimetable_Season[Season] ),
			        dimTimetable_Season[Released] = "Yes"
			    )
			VAR _Plan =
			    CALCULATE (
			        [PO_plan_pcs],
			        REMOVEFILTERS ( dimTimetable_Season[Season] ),
			        dimTimetable_Season[Released] = "Yes"
			    )
			VAR _Trend =
			    DIVIDE ( _Actual, _Plan, 0 )
			RETURN
			    _Trend
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Planning
		lineageTag: a5cb42f2-511f-4105-ae7c-3729636f7865

	measure 'Sell Through Target' =
			
			0.44
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _Targets
		lineageTag: d9baf665-0949-4e9e-8dee-8b96e17d61ac

