	measure 'Target Inspection Rate' =
			
			SWITCH (
			    TRUE (),
			    SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 0.6,
			    0.75
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _Targets
		lineageTag: 84d49ef3-26c1-47ab-8181-80372b817b9f

