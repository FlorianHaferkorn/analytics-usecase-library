	/// Deviation of the Total Leadtime to the Leadtime Target of 140 in weeks. This measure is used to calculate the potential risk of markdowns.
	measure 'Δ Total Leadtime to Target' =
			
			VAR Target = 140
			RETURN
			    IF (
			        [PO_conf_pcs] <> BLANK (),
			        ROUNDUP ( DIVIDE ( [Total Leadtime] - Target, 7, 0 ), 0 ),
			        BLANK ()
			    )
		formatString: 0
		displayFolder: Delivery
		lineageTag: 5fd15c5f-6eb4-463d-94f4-882631edba2a

		changedProperty = IsHidden

