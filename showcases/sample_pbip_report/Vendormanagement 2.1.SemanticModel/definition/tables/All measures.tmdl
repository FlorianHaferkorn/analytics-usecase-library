	/// Calculated malus cost surcharge value € added to the purchase price.
	measure 'Malus_pre_calc_val €' =
			
			CALCULATE (
			    SUMX ( Details, Details[PO_conf_pcs] * Details[Malus_pre_calc] ),
			    Details[KSCHL] <> "ZFMS"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
