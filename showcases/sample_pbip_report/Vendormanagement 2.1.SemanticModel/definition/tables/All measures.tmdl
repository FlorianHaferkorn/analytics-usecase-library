	/// Difference to the purchase price of previous year.
	measure 'Δ Purchase Price to PY' =
			
			[Purchase Price] - [Purchase Price PY]
		formatString: #,0.00
		displayFolder: Price
		lineageTag: 8919c78e-e4dc-4e5c-be04-52b005e1358e

	/// Difference to the purchase price ratio calculation of previous year.
	measure '∆ PP Ratio to PY' =
			
			[PP Ratio] - [PP Ratio PY]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: e0f15017-da1e-4697-b024-0304ea61a01a

	/// Difference in % to the cost of sales pre calculation of previous year.
	measure '∆ COS_pre_calc % to PY' =
			
			[COS_pre_calc %] - [COS_pre_calc % PY]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 99275d83-1fe2-4afc-8c83-ed4d4ebedcd3

	/// Difference in % to the purchase price of previous year.
	measure 'Δ Purchase Price to PY %' =
			
			IF (
			    [Purchase Price] > 0,
			    DIVIDE ( [Purchase Price], [Purchase Price PY], 0 ) - 1,
			    BLANK ()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 233874e1-3e0f-42b0-ac91-fabe598aa5f4

	/// Wholesale Price € per pcs of previous year.
	measure 'WHSSP € PY' =
			
			CALCULATE ( [WHSSP €], DATEADD ( dimTimetable_Season[Date], -1, YEAR ) )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: 3e623ab4-76bb-456b-be43-f274fb53daa6

	/// Difference to the wholesale price of previous year.
	measure 'Δ WHSSP € to PY' =
			
			[WHSSP €] - [WHSSP € PY]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: 4737690d-81b9-4076-9b2b-5228d10340ce

	/// Difference in % to the wholesale price of previous year.
	measure 'Δ WHSSP € to PY %' =
			
			IF ( [WHSSP €] > 0, DIVIDE ( [WHSSP €], [WHSSP € PY], 0 ) - 1, BLANK () )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 35e09d11-e6a8-4ad5-9f58-3fc8d60435b5

	/// Distinct number of styles compared to the total number of styles in %.
	measure '# of styles %' =
			
			DIVIDE ( [# of styles], CALCULATE ( [# of styles], ALLSELECTED ( Details ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Purchase Order
		lineageTag: 881faebf-7124-4735-8387-54ad03f41fa6

	/// Claimed value € by the QA department. Only the claim types Cancellation, CN, CRN, Refinishing, Discount are included. Any issues related to wet cartons are excluded.
	measure 'Claimed_val € (QA Claims)' =
			
			[Claimed_pcs (QA Claims)] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Quality Inspections
		lineageTag: 6da45693-00a3-4ad5-ba74-e66505a37fa5

	/// Percentage of distinct styles inspected within the IGI compared to all ordered styles.
	measure 'Inspected styles in % (IGI)' =
			
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( 'Inspections (Centric)'[Style] ),
			        'Inspections (Centric)'[Template] = "Incoming Goods Inspection"
			    ),
			    [# of styles],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: 1271ee2d-9387-4dc1-9be3-57da93b6cbca

	/// Percentage of distinct styles inspected within the FGI compared to all ordered styles.
	measure 'Inspected styles in % (FGI)' =
			
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( 'Inspections (Centric)'[Style] ),
			        'Inspections (Centric)'[Template] = "Final Goods Inspection"
			    ),
			    [# of styles],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: be80bbe7-fc5e-4620-b726-486dd772877f

	/// Target Cost of Sales in € calculated by the WHSSP in € and the Cost of Sales Target.
	measure 'COS Target €' =
			
			DIVIDE (
			    CALCULATE ( [COS_pre_calc_val (COS_pre_calc Target)], Details[KSCHL] <> "ZFMS" ),
			    [PO_conf_pcs],
			    0
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: Price
		lineageTag: 38b0280a-4b31-45a0-9600-95436eeb694f

	/// Target Purchase Price in € calculated by the WHSSP in € and the Purchase Price Ratio Target.
	measure 'PP Target €' =
			
			DIVIDE ( [PO_conf_val (PP Ratio Target)], [PO_conf_pcs], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: d412ff43-0022-4bee-82e8-897c1bf3c638

	/// Target Purchase Price in $ calculated by the WHSSP in $, the Purchase Price Ratio Target and the respective exchange rate plan.
	measure 'PP Target $' =
			
			DIVIDE (
			    SUMX ( Details, [PO_conf_val (PP Ratio Target)] * Details[PP_CALC_FW] ),
			    [PO_conf_pcs],
			    0
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Price
		lineageTag: 7c81f4dd-6cae-4617-9fdd-63c65de41bcc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Number of distinct styles inspected either in FGI, IGI or tested on restricted substances.
	measure '# of styles inspected' =
			
			VAR Inspected =
			    COUNTROWS (
			        FILTER (
			            DISTINCT (
			                UNION (
			                    CALCULATETABLE (
			                        DISTINCT (
			                            SELECTCOLUMNS (
			                                'CTDB_data (LINK)',
			                                "Style", VALUE ( 'CTDB_data (LINK)'[RT_CONFMAT] )
			                            )
			                        )
			                    ),
			                    CALCULATETABLE (
			                        DISTINCT (
			                            SELECTCOLUMNS (
			                                'Inspections (Centric)',
			                                "Style", 'Inspections (Centric)'[Style]
			                            )
			                        )
			                    )
			                )
			            ),
			            NOT ( ISBLANK ( [Style] ) )
			        )
			    )
			RETURN
			    Inspected
		formatString: #,0
		displayFolder: Quality Inspections
		lineageTag: ef70829d-8ef5-432a-a43c-aa744cc566bc

	/// Quantity delivered to eCommerce customers.
	measure 'delivered to eCom customer_pcs' =
			
			SUM ( CPBI_OMS_ARTICLEPERF[LIEF_UMS_stk] )
		formatString: #,0
		displayFolder: Complaints
		lineageTag: eeaadd12-c54e-4be5-bedb-85ae6f7309d9

	/// Quantity claimed by eCom customers. Only measurement deviations (too big, too small), quality doesn't meet the expectations and article defect are considered.
	measure 'claimed eCom_pcs' =
			
			CALCULATE (
			    SUM ( CPBI_OMS_ARTICLEPERF[UMTAUSCH_stk] ),
			    FILTER (
			        CPBI_OMS_ARTICLEPERF,
			        CPBI_OMS_ARTICLEPERF[Return Reason (Cluster)] = "Artikel zu groß (weit / lang)"
			            || CPBI_OMS_ARTICLEPERF[Return Reason (Cluster)] = "Artikel zu klein (eng / kurz)"
			            || CPBI_OMS_ARTICLEPERF[Return Reason (Cluster)] = "Qualität spricht nicht der Erwartung"
			            || CPBI_OMS_ARTICLEPERF[Return Reason (Cluster)] = "Artikel defekt"
			    )
			)
		formatString: #,0
		displayFolder: Complaints
		lineageTag: 8f094c87-ed42-4d47-a70e-66dda6802c2b

	/// Quantity used as total for the DDR calculation. If a purchase order wasn't handed over yet, the order quantity (PO_conf_pcs) is used. Else the quantity already handed over (PO_ship_initial_pcs).
	measure 'DDR Calculation Quantity' =
			
			CALCULATE (
			    SUMX (
			        Details,
			        IF ( Details[KPI2137] = 0, Details[POconf_after_cxl_pcs], Details[KPI2137] )
			    ),
			    NOT ( Details[KSCHL] = "ZFMS" )
			)
		formatString: #,0
		isHidden
		displayFolder: Delivery
		lineageTag: 17866f68-7ab7-496b-b699-0d68a00a5e35

		changedProperty = IsHidden

	/// Quantity used as total for the DDR calculation. If a purchase order wasn't handed over yet, the order value (PO_conf_val) is used. Else the value already handed over (PO_ship_initial_val).
	measure 'DDR Calculation Value' =
			
			[DDR Calculation Quantity] * [Purchase Price €]
		formatString: #,0.00
		isHidden
		displayFolder: Delivery
		lineageTag: 67384ca6-bfc7-48d9-bed0-00df8163c5be

		changedProperty = IsHidden

	/// The Quantity Variance KPI reflects the order accuracy from 0 (worst) to 100 (best) points. It is calculated by Shortshipped Score (66 %) and Overshipped Score (33 %).
	measure 'Quantity Variance Score' =
			
			VAR _ShortWeight = 2 / 3
			VAR _OverWeight = 1 / 3
			RETURN
			    [Shortshipped Score] * _ShortWeight + [Overshipped Score] * _OverWeight
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: c02776c6-3fbf-42da-9111-f5ef24129d5c

	measure 'Target Quantity Variance' =
			
			80
		formatString: #,0.00
		displayFolder: _Targets
		lineageTag: ba8085ff-75dc-4745-a7d9-0fc7dc3c2e4a

	measure 'Color Quantity Variance' =
			
			VAR UsedMeasure = [Quantity Variance Score]
			VAR Target = [Target Quantity Variance]
			VAR MinGreen = Target
			VAR MinYellow = Target * 0.67
			VAR MinRed = Target * 0.33
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure >= MinGreen, [Green],
			        UsedMeasure >= MinYellow, [Yellow],
			        UsedMeasure < MinYellow, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: f663c019-139f-4c77-8e07-cde5089f7cf4

		changedProperty = IsHidden

	measure 'Symbol Quantity Variance' =
			
			VAR UsedMeasure = [Quantity Variance Score]
			VAR Target = [Target Quantity Variance]
			VAR MinGreen = Target
			VAR MinYellow = Target * 0.67
			VAR MinRed = Target * 0.33
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure >= MinGreen, "CircleHigh",
			        UsedMeasure >= MinYellow, "CircleMedium",
			        UsedMeasure >= MinRed, "CircleLow",
			        ISBLANK ( UsedMeasure ), BLANK (),
			        "4CircleLow"
			    )
		displayFolder: _Symbols
		lineageTag: 3cee1e6f-efcd-4a7f-9ded-8583d6586023

		changedProperty = IsHidden

	/// Quantity Variance score difference to previous year.
	measure 'Quantity Variance Score ∆ to PY' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [Quantity Variance Score] - [Quantity Variance Score PY]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Standard" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Standard" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Standard" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Scoring
		lineageTag: f743f160-0b34-4c90-a12d-7b5418c49724

	/// Quantity Variance score of previous year.
	measure 'Quantity Variance Score PY' =
			
			CALCULATE (
			    [Quantity Variance Score],
			    DATEADD ( dimTimetable_Season[Date], -1, YEAR )
			)
		displayFolder: Scoring
		lineageTag: c6039d40-8ab3-448a-8d8f-cb8b5fd0ed25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Quantity Variance score difference to the target.
	measure 'Quantity Variance Score ∆ to Target' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [Quantity Variance Score] - [Target Quantity Variance]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Standard" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Standard" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Standard" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Scoring
		lineageTag: 8e748fef-674b-49af-a823-e3d682daee24

