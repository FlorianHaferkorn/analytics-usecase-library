	/// Cost of Sales value € calculated by PO_conf_pcs and the Cost of Sales € per pcs.
	measure 'COS_pre_calc_val €' =
			
			[PO_conf_val €] + [samplecost_pre_calc_val €] + [customscost_pre_calc_val €] + [freightcost_pre_calc_val €] + [AGY_Comm_pre_calc_val €] + [Malus_pre_calc_val €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: 656ce927-df63-4f81-8f8b-03827a39f67f

		changedProperty = IsHidden

	/// Cost of Sales € per pcs. The Cost of Sales consist of the Purchase Price, Freight Costs, Custom Clearance Costs, Sample Costs, Agency Comission Costs and Malus Costs.
	measure 'COS_pre_calc €' =
			
			DIVIDE ( [COS_pre_calc_val €], [PO_conf_pcs], 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: 208599da-27dc-4f36-9834-6faeb84bd103

		changedProperty = IsHidden

	/// Percentage of the Cost of Sales value € to the Wholesale Price value €.
	measure 'COS_pre_calc %' =
			
			DIVIDE ( [COS_pre_calc_val €], [WHSSP_val €], 0 )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 38c387a4-0f66-4108-9274-0fd8fb8f992f

		changedProperty = IsHidden

	/// Calculated agency commission surcharge value € added to the purchase price.
	measure 'AGY_Comm_pre_calc_val €' =
			
			CALCULATE (
			    SUMX ( Details, Details[PO_conf_pcs] * Details[AGY_Comm_pre_calc] ),
			    Details[KSCHL] <> "ZFMS"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
