		lineageTag: fe2f6b20-ad2a-435b-98c4-e8ab0ef0983f

		changedProperty = IsHidden

	measure 'Description Stop Claim' =
			
			"Percentage of all styles claimed bei the QA department in comparison to all ordered styles."
		displayFolder: Description
		lineageTag: 4a7cece0-1851-411c-9fa4-d3e0ec224ef9

		changedProperty = IsHidden

	measure 'Description Random Checks' =
			
			"Number of styles with failed random check"
		displayFolder: Description
		lineageTag: 8c5ed879-d185-443c-87c5-ba43352e1ce1

		changedProperty = IsHidden

	measure 'Description CCR' =
			
