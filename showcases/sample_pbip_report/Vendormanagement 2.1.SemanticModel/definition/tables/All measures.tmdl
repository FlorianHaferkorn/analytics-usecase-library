	/// Value delivered to eCom customers in EURO.
	measure 'delivered to eCom customer_val €' =
			
			SUM ( CPBI_OMS_ARTICLEPERF[LIEF_UMS] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
