	/// Points after optical inspection of a style where 0 is the minimum and 1 point the maximum. Each style variant will be calculated separatly and aggregated as average on style level for Final Goods Inspection. Incoming Goods Inspection is done only on style level.
	measure 'Optical Test Points' =
			
			VAR Points =
			    ADDCOLUMNS (
			        FILTER (
			            DISTINCT (
			                SELECTCOLUMNS (
			                    'Inspections (Centric)',
			                    "Style", 'Inspections (Centric)'[Style]
			                )
			            ),
			            NOT ISBLANK ( [Style] )
			        ),
			        "Points",
			            CALCULATE (
			                AVERAGE ( 'Inspections (Centric)'[Points (Optical)] ),
			                ALLEXCEPT ( 'Inspections (Centric)', 'Inspections (Centric)'[Style] )
			            )
			    )
			VAR Result =
			    SUMX ( Points, [Points] )
			RETURN
			    IF ( [# of styles] > 0, [# of styles] - Result, BLANK () )
		formatString: #,0.00
		displayFolder: Quality Inspections
		lineageTag: 338bc9fe-7633-43aa-acc0-11d612ed2b5b

		changedProperty = FormatString

		changedProperty = IsHidden

