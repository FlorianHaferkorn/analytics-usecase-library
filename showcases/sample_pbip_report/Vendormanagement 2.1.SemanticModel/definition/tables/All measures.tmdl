		displayFolder: Price
		lineageTag: ab46e11e-c8ff-4a6e-8df0-0e750c2ae023

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Clustering of the total score performance into the categories Platinum, Gold, Silver, Bronze, Wood where Platinum is the best and Wood the worst.
	measure Cluster =
			
			VAR Meas = [Total Score]
			VAR Target = [Target Total Score]
			VAR AA = Target + 10
			VAR A = Target
			VAR B = Target - 10
			VAR C = Target - 20
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Meas >= AA, "Platinum",
			            Meas >= A, "Gold",
			            Meas >= B, "Silver",
			            Meas >= C, "Bronze",
			            "Wood"
			        ),
			        BLANK ()
			    )
		displayFolder: Clustering
		lineageTag: a077aed2-2d92-48a4-8645-2d72d31afa0d

		changedProperty = IsHidden

	/// Purchase order value in % compared to the total ordered value
	measure 'PO_conf_val %' =
			
			DIVIDE ( [PO_conf_val], CALCULATE ( [PO_conf_val], ALLSELECTED ( Details ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _Slicer Measures
		lineageTag: fc013812-bc02-4847-bbc4-14013ae8b777

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Purchase order pieces in % compared to the total ordered pcs
	measure 'PO_conf_pcs %' =
			
			DIVIDE ( [PO_conf_pcs], CALCULATE ( [PO_conf_pcs], ALLSELECTED ( Details ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Purchase Order
		lineageTag: bab0fa85-58ac-4c3c-8cef-fae7bc1daa00

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Clustering of the purchase order volume in EURO by the total score performance into the categories Platinum, Gold, Silver, Bronze, Wood where Platinum is the best and Wood the worst.
	measure 'Cluster PO_conf_val €' =
			
			CALCULATE (
			    [PO_conf_val €],
			    FILTER (
			        VALUES ( dimVendor[Vendor] ),
			        COUNTROWS (
			            FILTER (
			                dimCluster,
			                [Total Score] >= dimCluster[MIN]
			                    && [Total Score] <= dimCluster[MAX]
			            )
			        ) > 0
			    )
			)
		displayFolder: Clustering
		lineageTag: df72bb93-2ed0-48d7-8cfc-3e32a181e068

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Clustering of the number of vendors by the total score performance into the categories Platinum, Gold, Silver, Bronze, Wood where Platinum is the best and Wood the worst.
	measure 'Cluster # of Vendors' =
			
			CALCULATE (
			    [# of Vendors],
			    FILTER (
			        VALUES ( dimVendor[Vendor] ),
			        COUNTROWS (
			            FILTER (
			                dimCluster,
			                [Total Score] >= dimCluster[MIN]
			                    && [Total Score] <= dimCluster[MAX]
			            )
			        ) > 0
			    )
			)
		formatString: 0
		displayFolder: Clustering
		lineageTag: 01c4071e-551c-43c1-a725-54a1cae513fd

		changedProperty = IsHidden

	/// Percentage of distinct number of manufacturers with a valid audit
	measure 'Audit Coverage %' =
			
			IF (
			    [PO_conf_pcs] <> BLANK (),
			    DIVIDE ( [# MFR with Audit], [# of MFR], 0 ),
			    BLANK ()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
