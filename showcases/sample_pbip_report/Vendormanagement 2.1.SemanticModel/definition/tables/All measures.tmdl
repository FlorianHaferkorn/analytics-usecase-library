	/// Target Purchase Order value € calculated by PO_conf_pcs and the target PP Ratio Price € per pcs.
	measure 'PO_conf_val (PP Ratio Target)' =
			
			CALCULATE (
			    SUMX ( Details, Details[WHSSP val €] * Details[PP Ratio Target] ),
			    NOT ( Details[KSCHL] = "ZFMS" )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
