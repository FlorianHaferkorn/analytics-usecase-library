		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Target Cost of Sales value € calculated by PO_conf_pcs and the target Cost of Sales € per pcs.
	measure 'COS_pre_calc_val (COS_pre_calc Target)' =
			
			SUM ( Details[COS_pre_calc_val (COS Target)] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Price
		lineageTag: 430c0849-63b6-43bc-8c8c-50a0d36981ad

