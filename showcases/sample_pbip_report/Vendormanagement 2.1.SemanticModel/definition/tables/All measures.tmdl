	/// Percentage of all purchase order value within the shortshipment and overshipment targets.
	measure 'Order Accuracy' =
			
			// Calculates the number of orders within all delivery tolerances
			VAR OTIForders =
			    CALCULATE (
			        [PO_conf_val €],
			        FILTER (
			            Details,
			            [Shortshipped in %] <= [Target Shortshipped]
			                && [Overshipped in %] <= [Target Overshipped]
			        )
			    ) // Calculates the percentage of orders in all tolerances to all orders
			VAR OTIF =
			    CALCULATE (
			        DIVIDE ( OTIForders, [PO_conf_val €], 0 ),
			        FILTER ( Details, NOT ISBLANK ( Details[PO_conf_pcs] ) )
			    )
			RETURN
			    OTIF
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quantity Variance
		lineageTag: 6b4523d8-4167-4788-bb9e-70b9372188ce

		changedProperty = IsHidden

