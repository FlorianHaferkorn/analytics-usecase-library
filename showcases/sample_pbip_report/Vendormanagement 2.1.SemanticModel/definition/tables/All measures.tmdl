	/// Percentage of points achieved within the inspection type optical test to the number of styles. The number of ordered styles reflect the maximum points which can be achieved. For each issue the possible points will be reduced by 0.5 points for minor issues above the defined tolerances and 1 point for major issues above the defined tolerances. After the reductions the lowest overall score is 0 points.
	measure 'Optical Test Result' =
			
			DIVIDE ( [Optical Test Points], [# of styles] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: e13b6f0e-b989-43c5-ab01-7108a2837cbb

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Points after measurement inspection of a style where 0 is the minimum and 1 point the maximum. Each style variant will be calculated separatly and aggregated as average on style level for Final Goods Inspection. Incoming Goods Inspection is done only on style level.
	measure 'MSMT Test Points' =
			
			VAR Points =
			    ADDCOLUMNS (
			        FILTER (
			            DISTINCT (
			                SELECTCOLUMNS (
			                    'Inspections (Centric)',
			                    "Style", 'Inspections (Centric)'[Style]
			                )
			            ),
			            NOT ISBLANK ( [Style] )
			        ),
			        "Points",
			            //CALCULATE(MAX(Inspection_Files[Points (MSMT)]), ALLEXCEPT(Inspection_Files,Inspection_Files[Style]))
			            CALCULATE (
			                AVERAGE ( 'Inspections (Centric)'[Points (MSMT)] ),
			                ALLEXCEPT ( 'Inspections (Centric)', 'Inspections (Centric)'[Style] )
			            )
			    )
			VAR Result =
			    SUMX ( Points, [Points] )
			RETURN
			    IF ( [# of styles] > 0, [# of styles] - Result, BLANK () )
		formatString: #,0.00
		displayFolder: Quality Inspections
		lineageTag: 566a8ada-9562-4596-8d2f-a0e2310397c6

		changedProperty = FormatString

		changedProperty = IsHidden

