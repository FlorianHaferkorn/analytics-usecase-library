	measure 'OTIF Rate' = ```
			
			// Calculates the number of orders within all delivery tolerances
			VAR OTIForders =
			    CALCULATE (
			        [PO_conf_val €],
			        FILTER (
			            Details,
			            NOT [DDR] < [Target DDR]
			            && NOT [Shortshipped in %] > [Target Shortshipped] 
			            && NOT [Overshipped in %] > [Target Overshipped]
			        )
			    ) 
			    
			// Calculates the percentage of orders in all tolerances to all orders
			VAR OTIF =
			    CALCULATE (
			        DIVIDE ( OTIForders, [PO_conf_val €], 0 ),
			        FILTER ( Details, NOT ISBLANK ( Details[PO_conf_pcs] ) )
			    )
			
			RETURN
			    OTIF
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery
		lineageTag: fc7152d5-ba8f-40fb-9b1b-eb0b417e3ca8

