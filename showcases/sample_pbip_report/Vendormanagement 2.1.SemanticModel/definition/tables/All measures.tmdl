	measure 'Description PP Ratio post calc' =
			
			"The Purchase Price Ratio reflects the percentage of the purchase price post calculation of a product to the wholesale selling price (WHSSP). The wholesale selling price is calculated dividing the retail price by the retail margin."
		displayFolder: Description
		lineageTag: a866d3c4-fae5-4748-8ca6-410ecbe65394

	measure 'Description COS_post_calc' =
			
			"The COS (Cost of Sales) Ratio reflects the percentage of the cost of sales of a product to the wholesale selling price (WHSSP). In the cost of sale  costs for sample cost, custom clearance, transport cost, agency commission and malus are added to the purchase price. All figures are prost calculation. The wholesale selling price is calculated dividing the retail price by the retail margin."
		displayFolder: Description
		lineageTag: da073e85-961b-4651-9df7-5b564dc9fd84

	/// Percentage of value with handover compared to the purchase order value.
	measure 'PO_ship_initial_val in %' =
			
			DIVIDE ( [PO_ship_initial_val €], [POconf_after_cxl_val €] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery
