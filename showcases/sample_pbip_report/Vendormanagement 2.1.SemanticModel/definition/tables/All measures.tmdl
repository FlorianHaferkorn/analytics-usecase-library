	/// Cost of Sales in % of previous year.
	measure 'COS_pre_calc % PY' =
			
			CALCULATE ( [COS_pre_calc %], DATEADD ( dimTimetable_Season[Date], -1, YEAR ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 7dcab31b-f57f-4eb0-8a6c-555d9db18e62

		changedProperty = IsHidden

	/// Difference in % of the Cost of Sales to previous year.
	measure 'COS_pre_calc % ∆ to PY' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [COS_pre_calc %] - [COS_pre_calc % PY]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Percent" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Percent" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Percent" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Price
		lineageTag: 27eb304c-bdb4-42c0-bfae-c474000bc2b9

		changedProperty = IsHidden

	/// Difference in % of the Cost of Sales to the target.
	measure 'COS_pre_calc % ∆ to Target' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [COS_pre_calc %] - [COS Target]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Percent" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Percent" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Percent" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Price
		lineageTag: b60774b0-8b96-4615-bf2f-de364f5399a7

		changedProperty = IsHidden

