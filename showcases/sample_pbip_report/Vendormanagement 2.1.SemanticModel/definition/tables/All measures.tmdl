	measure 'Target Total Score' =
			
			VAR _2023 = 78 //Target with Price Level is 84
			VAR _2024 = 85 //Target with Price Level is 89
			RETURN
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, _2023,
			        _2024
			    )
		formatString: #,0.00
		displayFolder: _Targets
		lineageTag: 91e7f79a-a7ed-4637-8ea5-5bf532a492a6

