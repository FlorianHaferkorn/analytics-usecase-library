	/// The Delivery KPI reflects the delivery performance from 0 (worst) to 100 (best) points. It is calculated by Delivery Date Reliability (55 %), Shortshipments (35 %) and Overshipments (10 %).
	measure Delivery =
			
			VAR DDRweight =
			    IF ( SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 0.55, 0.7 )
			VAR SSweight =
			    IF ( SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 0.35, 0.2 )
			VAR OSWeight =
			    IF ( SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 0.1, 0.1 )
			RETURN
			    IF (
			        OR ( [PO_conf_pcs] = 0, ISBLANK ( [PO_conf_pcs] ) ),
			        BLANK (),
			        [DDR Score] * DDRweight + [Shortshipped Score] * SSweight + [Overshipped Score] * OSWeight
			    )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: a7ee7605-6e3d-46ca-a861-694b5155ec16

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Color Delivery' =
			
			VAR UsedMeasure = [Delivery]
			VAR Target = [Target Delivery]
			VAR MinGreen = Target
			VAR MinYellow = Target * 0.67
			VAR MinRed = Target * 0.33
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure >= MinGreen, [Green],
			        UsedMeasure >= MinYellow, [Yellow],
			        UsedMeasure < MinYellow, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: 962e3d88-9ebf-439e-87e3-e3a071cf4f25

