	/// Number of distinct style-color combinations.
	measure '# of style-colors' =
			
			IF (
			    SELECTEDVALUE ( dimBrand[Brand] ) = "75",
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE ( CPBI_MATERIAL, CPBI_MATERIAL[Sammelartikel], CPBI_MATERIAL[Color] )
			        ),
			        FILTER ( Details, Details[PO_conf_pcs] > 2 )
			    ),
			    IF (
			        SELECTEDVALUE ( dimBrand[Brand] ) = "30",
			        CALCULATE (
			            COUNTROWS (
			                SUMMARIZE ( CPBI_MATERIAL, CPBI_MATERIAL[Sammelartikel], CPBI_MATERIAL[Color] )
			            ),
			            FILTER ( Details, Details[PO_conf_pcs] > 1 )
			        ),
			        CALCULATE (
			            COUNTROWS (
			                SUMMARIZE ( CPBI_MATERIAL, CPBI_MATERIAL[Sammelartikel], CPBI_MATERIAL[Color] )
			            )
			        )
			    )
			)
		formatString: #,0
		displayFolder: Color Duplication
