	/// Points after random check of a style where 0 is the minimum and 1 point the maximum. Each style will be calculated separatly.
	measure 'Random Check Points' =
			
			VAR Points =
			    ADDCOLUMNS (
			        FILTER (
			            DISTINCT ( SELECTCOLUMNS ( Details, "Style", Details[RT_CONFMAT] ) ),
			            NOT ISBLANK ( [Style] )
			        ),
			        "Points",
			            IF (
			                CALCULATE (
			                    [# of failed styles (RS)],
			                    ALLEXCEPT ( Details, Details[RT_CONFMAT] )
			                ) > 1,
			                1,
			                CALCULATE (
			                    [# of failed styles (RS)],
			                    ALLEXCEPT ( Details, Details[RT_CONFMAT] )
			                )
			            )
			    )
			VAR Result =
			    SUMX ( Points, [Points] )
			RETURN
			    IF ( [# of styles] > 0, [# of styles] - Result, BLANK () )
		formatString: #,0.00
		displayFolder: Chemical
		lineageTag: c8404a2c-ddfc-4f5c-8a5f-9637db01aa9c

		changedProperty = FormatString

