	/// The Sustainability KPI (net) reflects the Sustainability performance excluding inactive manufacturer from 0 (worst) to 100 (best) points. It is calculated by the KPIs Transparency (15%), Social Audit (55%), Environmental Audit (15%) and Chemical Compliance (15%). Whenever a Chemical Compliance Rate can not be evaluated because of no wet processing needs (Blank), the weights are changed to Transparency (17,65%), Social Audit (64,71%) and Environmental (17,65%).
	measure 'Sustainability (net)' =
			
			VAR weight_Transparency = 0.15
			VAR weight_Social = 0.55
			VAR weight_Environmental = 0.15
			VAR weight_Chemical = 0.15 // weights if no wet processing
			VAR weight_Trans2 = 1 / ( 1 - weight_Chemical ) * weight_Transparency
			VAR weight_Social2 = 1 / ( 1 - weight_Chemical ) * weight_Social
			VAR weight_Env2 = 1 / ( 1 - weight_Chemical ) * weight_Environmental
			RETURN
			    IF (
			        NOT ISBLANK ( [PO_conf_pcs] ),
			        IF (
			            NOT ISBLANK ( [Chemical Compliance] ),
			            CALCULATE ( [Transparency], dimManufacturer[Manufacturer Status] = "Active" ) * weight_Transparency
			                + CALCULATE (
			                    [Social audit rating],
			                    dimManufacturer[Manufacturer Status] = "Active"
			                ) * weight_Social
			                + CALCULATE (
			                    [Environmental impact],
			                    dimManufacturer[Manufacturer Status] = "Active"
			                ) * weight_Environmental
			                + CALCULATE (
			                    [Chemical Compliance],
			                    dimManufacturer[Manufacturer Status] = "Active"
			                ) * weight_Chemical,
			            CALCULATE ( [Transparency], dimManufacturer[Manufacturer Status] = "Active" ) * weight_Trans2
			                + CALCULATE (
			                    [Social audit rating],
			                    dimManufacturer[Manufacturer Status] = "Active"
			                ) * weight_Social2
			                + CALCULATE (
			                    [Environmental impact],
			                    dimManufacturer[Manufacturer Status] = "Active"
			                ) * weight_Env2
			        ),
			        BLANK ()
			    )
		formatString: #,0.00
		displayFolder: Sustainability
		lineageTag: 0a4f7bd8-afcf-4ad3-9b22-5f1ee8f387a8

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Purchase order value € cancelled.
	/// Cancellations after receipt of goods are defined by the Quality Department and are included as well.
	measure 'PO_cancelled (value) € (WEK)' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    CALCULATE (
			        SUMX (
			            'QA Stop Claim (Centric)',
			            'QA Stop Claim (Centric)'[Stop/Claim Qty] * [Purchase Price €]
			        ),
			        FILTER (
			            'QA Stop Claim (Centric)',
			            'QA Stop Claim (Centric)'[Claim Type] = "Cancellation"
			                && 'QA Stop Claim (Centric)'[Valid Claim Type] = "Valid"
			        )
			    ) + 0,
			    BLANK ()
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Cancellations
		lineageTag: 78e6b976-4fe7-432d-b81f-ec3facb49c80

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Purchase order val € cancelled. 
	/// The following cancellation reasons for cancellations before handover are relevant: 
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	measure 'PO_cancelled (value) € (pre delivery)' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    CALCULATE (
			        [PO_cancelled (pcs) (pre delivery)] * [Purchase Price €],
			        FILTER (
			            Details,
			            Details[KSCHL] <> "ZFMS"
			                && Details[Cancellation Reason] = "LT"
			                || Details[Cancellation Reason] = "PA"
			                || Details[Cancellation Reason] = "QM"
			        )
			    ) + 0,
			    BLANK ()
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Cancellations
		lineageTag: adc22791-cdf8-4000-a532-ed6d51d34b2b

		changedProperty = FormatString

		changedProperty = IsHidden

