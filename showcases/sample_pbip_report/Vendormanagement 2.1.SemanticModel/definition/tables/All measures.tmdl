	measure '∆ Plan to Forecast (Trend) in %' =
			
			IF (
			    [PO_forecast_pcs/val (Trend)] > 0,
			    DIVIDE ( [PO_forecast_pcs/val (Trend)], [PO_plan_pcs/val], 0 ) - 1,
