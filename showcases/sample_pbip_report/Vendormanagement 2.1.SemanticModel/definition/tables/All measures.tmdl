	/// Percentage of cancelled value in comparison to the total order value. Only cancellations before receipt of goods are considered.
	measure 'Cancellation Rate (pre delivery)' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    DIVIDE ( [PO_cancelled (value) € (pre delivery)], [PO_conf_val €], 0 ) + 0,
			    BLANK ()
