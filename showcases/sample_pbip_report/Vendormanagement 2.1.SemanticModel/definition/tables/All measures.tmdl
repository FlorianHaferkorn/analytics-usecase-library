		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: c25f1a33-dcc7-4eaf-8a89-22612ad02ce6

	/// Purchase order value $ in transit (handed over but not yet received in RoDo).
