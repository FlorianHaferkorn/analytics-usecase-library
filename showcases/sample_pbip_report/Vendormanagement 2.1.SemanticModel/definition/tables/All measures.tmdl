	/// Percentage of claimed styles by QA department compared to the ordered styles.
	measure 'Claim Rate (QA Claims)' =
			
			VAR IssuedStyles =
			    DIVIDE (
			        CALCULATE (
			            [# of claimed styles (QA Claims)],
			            FILTER (
			                'QA Stop Claim (Centric)',
			                'QA Stop Claim (Centric)'[Valid Claim Type] = "valid" = "valid"
			                    && 'QA Stop Claim (Centric)'[Claim Status] = "settled"
			            )
			        ),
			        [# of styles]
			    )
			RETURN
			    IF (
			        ISBLANK ( [PO_conf_pcs] ),
			        BLANK (),
			        IF ( ISBLANK ( IssuedStyles ), 0, IssuedStyles )
			    )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: 3ffd9ec7-5b89-426b-9eec-bc52e3df8d4f

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Percentage of cancelled styles in comparison to the total ordered styles.
	measure 'Cancellation Rate (styles)' =
			
