	/// Percentage of claimed value by wholesale customers compared to the delivered value to our whole sale customers.
	measure CCR =
			
			IF (
			    ISBLANK ( [PO_conf_pcs] ),
			    BLANK (),
			    DIVIDE ( [claimed WHSSP], [delivered to customer WHSSP], 0 )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Complaints
		lineageTag: 4b8faada-acb0-475d-b985-3d50825fb2e8

		changedProperty = IsHidden

	/// Scored percentage of claimed value by wholesale customers compared to the delivered value to our whole sale customers.
	measure 'CCR Score' =
			
			VAR Faktor = 100 // with Factor 375 a CCR in % of 0,133333 % = 50 Points (Performance in 2021) and Target of 0,05 % = 81,25 Points
			// with Factor 200 a CCR in % of 0,25 % = 50 Points and Target of 0,05 % = 90 Points
			VAR _Meas = ( 1 - ( [CCR] * Faktor ) ) * 100
			RETURN
			    IF ( ISBLANK ( [PO_conf_pcs] ), BLANK (), IF ( _Meas < 0, 0, _Meas ) )
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: a5be6446-21ee-472b-954c-be434b9bf58a

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Percentage of cancelled value in comparison to the total order value.
	measure 'Cancellation Rate' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    DIVIDE ( [PO cancelled (value) €], [PO_conf_val €], 0 ) + 0,
			    BLANK ()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Cancellations
		lineageTag: d3450097-01bc-4c68-a4f2-6dd7506f4efb

		changedProperty = IsHidden

	/// Scored percentage of cancelled value in comparison to the total order value. The following cancellation reasons are relevant:
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	measure 'CR Score' =
			
			IF (
			    ISBLANK ( [PO_conf_pcs] ),
			    BLANK (),
			    IF (
			        100 - ( [Cancellation Rate] * 10000 ) < 0,
			        0,
			        100 - ( [Cancellation Rate] * 10000 )
			    )
			)
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: abdba3e0-3e1a-45bb-bbd6-f12231048b00

		changedProperty = IsHidden

	/// Percentage of the value shipped in tolerance compared to the total value shipped (Handover). If an order wasn't shipped yet, the order value is used as calculation base (Calculation Value).
	///  
	/// The calculation value uses the handover value for all handed over orders and the purchase order value for all orders not handed over yet.
	///  
	/// The following tolerances are valid:
	/// <= 5 days after confirmed handover (= 100,00% DDR)
	/// > 5 days after confirmed handover (= 0,00% DDR)
	measure DDR =
			
			DIVIDE ( [PO_ship_intol_val €], [DDR Calculation Value], 0 )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery
		lineageTag: 82831ede-36ef-45e1-8f8a-c0683fd596e7

		changedProperty = IsHidden

	/// Scored percentage of the value shipped in tolerance compared to the total value shipped (Handover). If an order wasn't shipped yet, the order value is used as calculation base (Calculation Value).
	///  
	/// The calculation value uses the handover value for all handed over orders and the purchase order value for all orders not handed over yet.
	///  
	/// The following tolerances are valid:
	/// <= 5 days after confirmed handover (= 100,00% DDR)
	/// > 5 days after confirmed handover (= 0,00% DDR)
	measure 'DDR Score' =
			
			IF ( ISBLANK ( [PO_conf_pcs] ), BLANK (), 100 - ( 100 - [DDR] * 100 ) )
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: 2a34cad1-205d-4915-8ada-6c555f7e8b7c

		changedProperty = IsHidden

	/// Percentage of value overshipped compared to the total ordered value.
	measure 'Overshipped in %' =
			
			DIVIDE ( [PO_overship_val €], [POconf_after_cxl_val €], 0 )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quantity Variance
		lineageTag: 5d0fe21a-9dec-4465-8fad-48d108abd643

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Scored percentage of value overshipped compared to the total ordered value.
	measure 'Overshipped Score' =
			
			IF (
			    ISBLANK ( [PO_conf_pcs] ),
			    BLANK (),
			    IF (
			        100 - ( [Overshipped in %] * 1000 ) < 0,
			        0,
			        100 - ( [Overshipped in %] * 1000 )
			    )
			)
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: 7ffec9fe-4ee1-4f1f-948d-ca29636b00e6

		changedProperty = IsHidden

	/// Percentage of value shortshipped compared to the total ordered value.
	measure 'Shortshipped in %' =
			
			DIVIDE ( [PO_shortship_val €], [POconf_after_cxl_val €], 0 )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quantity Variance
		lineageTag: 849d8912-9d99-4abe-b0fc-4cc1760b9e0a

		changedProperty = IsHidden

	/// Scored percentage of value shortshipped compared to the total ordered value.
	measure 'Shortshipped Score' =
			
			IF (
			    ISBLANK ( [PO_conf_pcs] ),
			    BLANK (),
			    IF (
			        100 - ( [Shortshipped in %] * 2353 ) < 0,
			        0,
			        100 - ( [Shortshipped in %] * 2353 )
			    )
			)
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: 666aed79-917c-4aa0-af94-3958212bff12

		changedProperty = IsHidden

	/// Quantity claimed by wholesale customers.
	measure 'claimed pcs' =
			
			SUM ( CCR[claimed quantity pcs] )
		formatString: #,0
		displayFolder: Complaints
		lineageTag: 0a843014-aad1-477d-b782-1c59dfe2ba0b

		changedProperty = IsHidden

	/// Value claimed by wholesale customers in EURO based on the wholesale price.
	measure 'claimed WHSSP' =
			
			SUM ( CCR[claimed_ghvk] )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Complaints
		lineageTag: a4ad9948-acc5-4221-b894-9f5eb47bef71

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Quantity delivered to wholesale customers.
	measure 'delivered to customer pcs' =
			
			CALCULATE (
			    SUM ( CCR[delivered to customer pcs] ),
			    FILTER ( CCR, CCR[_SOL_RETURNRS] = BLANK () )
			)
		formatString: #,0
		displayFolder: Complaints
		lineageTag: e61f3045-7a67-4f06-a681-60346b42f775

		changedProperty = IsHidden

	/// Value delivered to wholesale customers in EURO based on the wholesale price
	measure 'delivered to customer WHSSP' =
			
			CALCULATE ( SUM ( CCR[delivered_ghvk] ), CCR[_SOL_RETURNRS] = BLANK () )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Complaints
		lineageTag: aa0b3d58-c3f7-4f0f-a724-8d010773cf26

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Overshipped pieces compared to the purchase order on style variant level.
	measure PO_overship_pcs =
			
			CALCULATE ( SUM ( Details[PO overshipped (pcs)] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Quantity Variance
		lineageTag: b20b9dbd-97da-4906-98d4-0d5dd83c0f8c

		changedProperty = IsHidden

	/// Shortshipped pieces compared to the purchase order on style variant level.
	measure PO_shortship_pcs =
			
			CALCULATE ( SUM ( Details[PO shortshipped (pcs)] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Quantity Variance
		lineageTag: 445d7b2c-71c9-4d0d-8e72-6f8b2aed5cb1

		changedProperty = IsHidden

	/// Overshipped value in € compared to the purchase order on style variant level.
	measure 'PO_overship_val €' =
			
			[PO_overship_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Quantity Variance
		lineageTag: adf43337-1c06-4cec-965d-955562e0396c

		changedProperty = IsHidden

	/// Shortshipped value in € compared to the purchase order on style variant level.
	measure 'PO_shortship_val €' =
			
			[PO_shortship_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Quantity Variance
		lineageTag: 13ba751f-bfd6-4bd2-a1e2-7e739ec238e0

		changedProperty = IsHidden

	/// Purchase order pieces.
	measure PO_conf_pcs =
			
			CALCULATE ( SUM ( Details[PO_conf_pcs] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Purchase Order
		lineageTag: cddeac4a-490a-4e77-a60f-f78653bb59e7

		changedProperty = IsHidden

	/// Purchase order value in €.
	measure 'PO_conf_val €' =
			
			CALCULATE (
			    SUM ( Details[PO_conf_val € (pre_calc)] ),
			    Details[KSCHL] <> "ZFMS"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Purchase Order
		lineageTag: 3976a849-24d1-4630-94c4-ca437dbc91a3

		changedProperty = IsHidden

	/// Purchase order pieces without cancellations.
	measure POconf_after_cxl_pcs =
			
			CALCULATE ( SUM ( Details[POconf_after_cxl_pcs] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Purchase Order
		lineageTag: 258ddce5-eaf0-4903-884b-80e55115c248

		changedProperty = IsHidden

	/// Purchase order value in € without cancellations.
	measure 'POconf_after_cxl_val €' =
			
			[POconf_after_cxl_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Purchase Order
		lineageTag: 97a3037a-b03a-44c9-9a67-c74e486f5433

		changedProperty = IsHidden

	/// Purchase order pieces cancelled. 
	/// The following cancellation reasons for cancellations before handover are relevant: 
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	/// 
	/// Cancellations after receipt of goods are defined by the Quality Department and are included as well.
	measure 'PO cancelled (pcs)' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    [PO_cancelled (pcs) (pre delivery)] + [PO_cancelled (pcs) (WEK)] + 0,
			    BLANK ()
			)
		formatString: #,0
		displayFolder: Cancellations
		lineageTag: bcb09dfb-f6fb-4a70-960b-86230379a64b

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Purchase order value in € cancelled. 
	/// The following cancellation reasons for cancellations before handover are relevant: 
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	/// 
	/// Cancellations after receipt of goods are defined by the Quality Department and are included as well.
	measure 'PO cancelled (value) €' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    [PO_cancelled (value) € (pre delivery)] + [PO_cancelled (value) € (WEK)] + 0,
			    BLANK ()
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Cancellations
		lineageTag: 1f7193b9-a3b5-4968-a9d1-2111e2dea606

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Purchase order quantity with handover.
	measure PO_ship_initial_pcs =
			
			CALCULATE ( SUM ( Details[KPI2137] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 32456cdf-ddca-4fea-924b-23b044c9d09a

		changedProperty = IsHidden

	/// Purchase order value in € with handover.
	measure 'PO_ship_initial_val €' =
			
			[PO_ship_initial_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: 60e34b39-1202-4164-875f-ef13583c4732

		changedProperty = IsHidden

	/// Purchase order quantity with handover in tolerance (delay in days below or equal 5 days. For Fast Track 2 days).
	measure PO_ship_intol_pcs =
			
			VAR Bulk = 5
			VAR Sample = 0
			RETURN
			    IF (
			        SELECTEDVALUE ( dimOrderType[Purchase Order Type] ) = "BULK",
			        CALCULATE (
			            [DDR Calculation Quantity],
			            Details[Delay in days excl. buffer] <= Bulk
			        ),
			        CALCULATE (
			            [DDR Calculation Quantity],
			            Details[Delay in days excl. buffer] <= Sample
			        )
			    )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: d4b22b32-ef48-4908-9841-79961a548926

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Purchase order value in € with handover in tolerance (delay in days below or equal 5 days. For Fast Track 2 days).
	measure 'PO_ship_intol_val €' =
			
			[PO_ship_intol_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: 553dd747-2734-452e-a8d5-5772aea2ee51

		changedProperty = IsHidden

	/// Average delay in days at handover (HO_act - HO_conf).
	/// For Bangladesh any buffer used in the initial date calculation in SAP is excluded.
	measure 'Delay in days excl. buffer' =
			
			VAR AvgDelay =
			    AVERAGE ( Details[Delay in days excl. buffer] )
			RETURN
			    SWITCH (
			        TRUE (),
			        AvgDelay > 300, BLANK (),
			        AvgDelay < -300, BLANK (),
			        AvgDelay
			    )
		formatString: #,0.00
		displayFolder: Delivery
		lineageTag: fca3e682-898f-4d35-958c-906a229c1846

		changedProperty = IsHidden

	/// Purchase order quantity with handover on the date of confirmed handover.
	measure PO_ship_ontime_pcs =
			
			CALCULATE ( [PO_ship_initial_pcs], Details[Delay in days excl. buffer] = 0 )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 859f56bf-ebc1-4e5d-8a19-334cfe699239

		changedProperty = IsHidden

	/// Purchase order value in € with handover on the date of confirmed handover.
	measure 'PO_ship_ontime_val €' =
			
			[PO_ship_ontime_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: ed588629-5b74-4eff-9b5f-24155e1a1f9a

		changedProperty = IsHidden

	/// Purchase order pieces with handover earlier than the confirmed handover.
	measure PO_ship_early_pcs =
			
			CALCULATE (
			    [PO_ship_initial_pcs],
			    FILTER ( Details, Details[Delay in days excl. buffer] < 0 )
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: af82402f-5e25-4129-8a63-83f82ba389cd

		changedProperty = IsHidden

	/// Purchase order value in € with handover earlier than the confirmed handover.
	measure 'PO_ship_early_val €' =
			
			[PO_ship_early_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: 89c60727-6e47-4f9e-952c-058ae9f79549

		changedProperty = IsHidden

	/// Purchase order quantity with handover not in tolerance (delay in days higher than 5 days. For Fast Track higher than 2 days).
	measure PO_ship_late_pcs =
			
			VAR Bulk = 5
			VAR Sample = 0
			RETURN
			    IF (
			        SELECTEDVALUE ( dimOrderType[Purchase Order Type] ) = "BULK",
			        CALCULATE ( [PO_ship_initial_pcs], Details[Delay in days excl. buffer] > Bulk ),
			        CALCULATE (
			            [PO_ship_initial_pcs],
			            Details[Delay in days excl. buffer] > Sample
			        )
			    )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: b180da41-3bfe-4570-8611-e5e2c0f24095

		changedProperty = IsHidden

	/// Purchase order value in € with handover not in tolerance (delay in days higher than 5 days. For Fast Track higher than 2 days).
	measure 'PO_ship_late_val €' =
			
			[PO_ship_late_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: 1515730c-21b0-4a3c-9fba-13a8184bb73b

		changedProperty = IsHidden

	/// Purchase order quantity with handover in tolerance (delay in days higher 0 days and below or equal 5 days. For Fast Track below or equal 2 days).
	measure 'PO_ship_late but intol_pcs' =
			
			VAR Bulk = 5
			VAR Sample = 0
			RETURN
			    IF (
			        MIN ( dimOrderType[Purchase Order Type] ) = "BULK",
			        CALCULATE (
			            [PO_ship_initial_pcs],
			            Details[Delay in days excl. buffer] > 0
			                && Details[Delay in days excl. buffer] <= Bulk
			        ),
			        0
			    )
		displayFolder: Delivery
		lineageTag: 7d3a6f28-52ad-4c8a-86c8-3706cf590cac

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Purchase order value in € with handover in tolerance (delay in days higher 0 days and below or equal 5 days. For Fast Track below or equal 2 days).
	measure 'PO_ship_late but intol_val €' =
			
			[PO_ship_late but intol_pcs] * [Purchase Price €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Delivery
		lineageTag: 5917a642-ffdc-4b5c-bc3d-5a2ac0649f78

		changedProperty = IsHidden

	/// Quantity received in Rottendorf (RoDo).
	measure 'Receipt of Goods direct_pcs' =
			
			CALCULATE ( SUM ( Details[WE_DIR_Stk] ), Details[KSCHL] <> "ZFMS" )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 0bbe9f1e-c0c8-49ea-af4e-07c5648c579d

		changedProperty = IsHidden

	/// Percentage of received quantity in Rottendorf (Rodo) compared to the purchase order quantity.
	measure 'Receipt of Goods direct %' =
			
			DIVIDE ( [Receipt of Goods direct_pcs], [POconf_after_cxl_pcs] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery
		lineageTag: fdb1f5ac-6a54-4053-affd-5f436df809b3

		changedProperty = IsHidden

	/// Percentage of quantity with handover compared to the purchase order quantity.
	measure 'PO_ship_initial_pcs in %' =
			
			DIVIDE ( [PO_ship_initial_pcs], [POconf_after_cxl_pcs] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Delivery
		lineageTag: b7727989-adc0-43e7-8d3b-9aa2650fa630

		changedProperty = IsHidden

	/// Distinct number of styles claimed by B2C customers (Customer Sales Service).
	measure '# of claimed styles (CSS)' =
			
			COUNTROWS ( SUMMARIZE ( CSS_Tickets, CSS_Tickets[Style (gen. Article)] ) )
