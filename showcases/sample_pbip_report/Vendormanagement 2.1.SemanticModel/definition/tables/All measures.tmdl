	/// Difference in % to the cost of sales target.
	measure '∆ COS_pre_calc to Target in %' =
			
			[COS_pre_calc %] - [COS Target]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Price
		lineageTag: 18ed714c-051e-4d33-ad22-a3ea2787a53a

		changedProperty = IsHidden

	/// Scored difference in % to the purchase price ratio target based on pre calculation.
	measure 'PP Ratio Score' =
			
			// Scoring factor
			VAR Faktor = 10
			VAR Meas = [∆ PP Ratio to Target in %]
			RETURN
			    //Scores the difference to target by the scoring factor
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH ( TRUE (), Meas < 0, 100, Meas > 0.1, 0, ( 1 - Meas * Faktor ) * 100 ),
			        BLANK ()
			    )
		displayFolder: Scoring
		lineageTag: e83a03c5-a430-4de7-a047-172b73eceddd

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Scored difference in % to the cost of sales target.
	measure 'COS_pre_calc Score' =
			
			// Scoring factor
			VAR Faktor = 10
			VAR Meas = [∆ COS_pre_calc to Target in %]
			RETURN
			    //Scores the difference to target by the scoring factor
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH ( TRUE (), Meas < 0, 100, Meas > 0.1, 0, ( 1 - Meas * Faktor ) * 100 ),
			        BLANK ()
			    )
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: 8addca51-5da1-4cc3-a859-40b0d6aa46d1

		changedProperty = IsHidden

	measure 'Description COS_pre_calc' =
			
			"The COS (Cost of Sales) Ratio reflects the percentage of the cost of sales of a product to the wholesale selling price (WHSSP). In the cost of sale  costs for sample cost, custom clearance, transport cost, agency commission and malus are added to the purchase price. All figures are pre calculation. The wholesale selling price is calculated dividing the retail price by the retail margin."
		displayFolder: Description
		lineageTag: 4f08148e-ada7-4566-b15f-3330f31cd731

		changedProperty = IsHidden

