	measure 'Color Δ to PY_Delivery' =
			
			VAR UsedMeasure = [Delivery]
			VAR PY = [Delivery PY]
			
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure > PY, [Green],
			        UsedMeasure < PY, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: e7594690-6b9a-4d76-b735-b182d4bf280e

