	measure 'Symbol Fail Rate (RS)' =
			
			VAR UsedMeasure = [Fail Rate (RS)]
			VAR Target = [Target Fail Rate (RS)]
			VAR MinGreen = Target
			VAR MinYellow = Target * 2
			VAR MinRed = Target * 4
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( UsedMeasure ), BLANK (),
			        UsedMeasure <= MinGreen, "CircleHigh",
			        UsedMeasure <= MinYellow, "CircleMedium",
