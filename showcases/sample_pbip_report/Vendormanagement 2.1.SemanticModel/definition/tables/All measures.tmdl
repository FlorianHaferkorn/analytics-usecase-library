	/// Calculated sample cost surcharge value € added to the purchase price.
	measure 'samplecost_pre_calc_val €' =
			
			CALCULATE (
			    SUMX ( Details, Details[PO_conf_pcs] * Details[samplecost_pre_calc] ),
			    Details[KSCHL] <> "ZFMS"
			)
		displayFolder: Price
