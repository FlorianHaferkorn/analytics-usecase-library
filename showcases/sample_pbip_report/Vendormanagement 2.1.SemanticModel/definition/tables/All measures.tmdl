	/// Wholesale Price € reduced by the cost of sales €.
	measure 'Gross Profit_val €' =
			
			[WHSSP_val €] - [COS_pre_calc_val €]
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
