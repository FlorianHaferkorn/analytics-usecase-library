	measure 'Symbol eCom Returns' =
			
			VAR UsedMeasure = [eCom Return Rate]
			VAR MinGreen = [Target eCom Returns]
			VAR MinYellow = [Target eCom Returns] + 0.10
			VAR MinRed = [Target eCom Returns] + 0.20
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure <= MinGreen, "CircleHigh",
			        UsedMeasure <= MinYellow, "CircleMedium",
			        UsedMeasure <= MinRed, "CircleLow",
			        ISBLANK ( UsedMeasure ), BLANK (),
			        "4CircleLow"
			    )
		displayFolder: _Symbols
		lineageTag: 86172711-20f3-48fd-8816-ed176def4188

		changedProperty = IsHidden

	measure 'Color eCom Returns' =
			
			VAR UsedMeasure = [eCom Return Rate]
			VAR MinGreen = [Target eCom Returns]
			VAR MinYellow = [Target eCom Returns] + 0.10
			VAR MinRed = [Target eCom Returns] + 0.20
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure <= MinGreen, [Green],
			        UsedMeasure <= MinYellow, [Yellow],
			        UsedMeasure > MinYellow, [Red],
			        [Black]
			    )
		displayFolder: _Colors
		lineageTag: 00b3ab54-b3d7-4f94-ab9e-6517c062fabd

