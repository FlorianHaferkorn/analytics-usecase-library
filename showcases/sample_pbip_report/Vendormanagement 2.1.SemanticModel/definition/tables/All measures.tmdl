	measure 'Description eCom Returns' =
			
			"Percentage of claimed and invoiced value in comparison to the total delivered value of our eCom customers. Reasons 1 - Article too big (wide/long) , 2 - Article too small (tight/short) , 6 - Quality doesn't meet expectations and 7 - Article defect are taken into account in the measure claimed value."
		displayFolder: Description
