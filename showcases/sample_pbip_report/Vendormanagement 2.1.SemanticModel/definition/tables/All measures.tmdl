	/// Inspection Rate difference to previous year.
	measure 'Inspection Rate ∆ to PY' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [Inspection Rate] - [Inspection Rate PY]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Percent" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Percent" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Percent" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Quality Inspections
		lineageTag: 2c534ea7-8e67-4a0b-9666-37a9a8f460b1

