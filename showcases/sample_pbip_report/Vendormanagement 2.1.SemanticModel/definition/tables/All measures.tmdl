	/// Bulk purchase order quantity (cumulative).
	measure 'PO_conf_pcs (cumulative)' =
			
			VAR LastOrderDate =
			    CALCULATE (
			        LASTDATE ( Details[Season_Calendar] ),
			        FILTER ( Details, Details[sample_bulk] = "bulk" )
			    )
			RETURN
			    IF (
			        ISBLANK ( [PO_conf_pcs] ),
			        BLANK (),
			        IF (
			            SELECTEDVALUE ( dimTimetable_Season[Date] ) > LastOrderDate,
			            BLANK (),
			            CALCULATE (
			                [PO_conf_pcs],
			                FILTER (
			                    ALLSELECTED ( dimTimetable_Season ),
			                    dimTimetable_Season[Date] <= MAX ( dimTimetable_Season[Date] )
			                )
			            )
			        )
			    )
		formatString: #,0
		displayFolder: Planning
		lineageTag: bc440086-931b-4d61-a4cf-3b7e1142e912

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

