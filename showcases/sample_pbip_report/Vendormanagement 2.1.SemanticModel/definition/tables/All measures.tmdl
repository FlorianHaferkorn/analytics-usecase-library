	/// The Quality KPI reflects the quality performance from 0 (worst) to 100 (best) points. It is calculated by Cancellation Rate (30 %), Right first time (40 %) and Complaint Rate (30 %).
	measure Quality =
			
			VAR RFTScore = [Inspection Score]
			VAR ComplaintScore = [CCR Score]
			VAR Cancellations = [CR Score]
			VAR WeightRFTScore = 0.4
			VAR WeightComplaintScore = 0.3
			VAR WeightCancellationScore = 0.3
			RETURN
			    IF (
			        ISBLANK ( [# of styles] ),
			        BLANK (),
			        Cancellations * WeightCancellationScore + RFTScore * WeightRFTScore + ComplaintScore * WeightComplaintScore
			    )
		formatString: #,0.00
		displayFolder: Scoring
		lineageTag: e27c7e0b-f42d-4295-b104-d73e40835238

		changedProperty = FormatString

		changedProperty = IsHidden

	/// The Sustainability KPI reflects the Sustainability performance from 0 (worst) to 100 (best) points. It is calculated by the KPIs Transparency (15%), Social Audit (55%), Environmental Audit (15%) and Chemical Compliance (15%). Whenever a Chemical Compliance Rate can not be evaluated because of no wet processing needs (Blank), the weights are changed to Transparency (17,65%), Social Audit (64,71%) and Environmental (17,65%).
	measure Sustainability =
			
			VAR weight_Transparency = 0.15
			VAR weight_Social = 0.55
			VAR weight_Environmental = 0.15
			VAR weight_Chemical = 0.15 // weights if no wet processing
			VAR weight_Trans2 =
			    DIVIDE ( 1, ( 1 - weight_Chemical ) ) * weight_Transparency
			VAR weight_Social2 =
			    DIVIDE ( 1, ( 1 - weight_Chemical ) ) * weight_Social
			VAR weight_Env2 =
			    DIVIDE ( 1, ( 1 - weight_Chemical ) ) * weight_Environmental
			RETURN
			    IF (
			        ISBLANK ( [PO_conf_pcs] ),
			        BLANK (),
			        IF (
			            NOT ISBLANK ( [Chemical Compliance] ),
			            [Transparency] * weight_Transparency + [Social audit rating] * weight_Social + [Environmental impact] * weight_Environmental + [Chemical Compliance] * weight_Chemical,
			            [Transparency] * weight_Trans2 + [Social audit rating] * weight_Social2 + [Environmental impact] * weight_Env2
			        )
			    )
		formatString: 0.00
		displayFolder: Scoring
		lineageTag: 03422ff2-eede-4c1b-871a-79e95eb908ab

		changedProperty = IsHidden

	measure 'Target Quality' =
			
			SWITCH ( TRUE (), SELECTEDVALUE ( dimTimetable_Season[Year] ) < 2023, 77, 83 )
