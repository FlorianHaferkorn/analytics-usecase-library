	/// Distinct number of manufacturers.
	measure '# of MFR' =
			
			--DISTINCTCOUNTNOBLANK ( dimManufacturer[Manufacturer] )
			COUNTROWS (
			    SUMMARIZE ( dimManufacturer, dimManufacturer[Manufacturer] )
			)
		formatString: #,0
		displayFolder: Purchase Order
		lineageTag: 4006cc72-1a8d-4f27-b8f3-ee3bf00f3246

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Number of distinct styles cancelled.
	/// The following cancellation reasons for cancellations before handover are relevant: 
	/// PA: Production downtime
	/// LT: Delay of Delivery
	/// QM: Quality Issues
	/// RN: Return & subsequent delivery
	/// 
	/// Cancellations after receipt of goods are defined by the Quality Department and are included as well.
	measure '# of styles cancelled' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    CALCULATE (
			        [# of styles],
			        FILTER ( Details, [PO_cancelled (pcs) (pre delivery)] > 0 )
			    )
			        + CALCULATE (
			            [# of styles],
			            FILTER (
			                'QA Stop Claim (Centric)',
			                'QA Stop Claim (Centric)'[Claim Type] = "Cancellation"
			                    && 'QA Stop Claim (Centric)'[Valid Claim Type] = "Valid"
			            )
			        ) + 0,
			    BLANK ()
			)
		formatString: 0
		displayFolder: Cancellations
