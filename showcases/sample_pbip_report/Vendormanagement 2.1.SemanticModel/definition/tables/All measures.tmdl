	measure 'Fail Rate (RS) Score' =
			
			VAR _var = [Fail Rate (RS)]
			RETURN
			    IF (
			        ISBLANK ( _var ),
			        BLANK (),
			        IF ( 100 - ( _var * 1000 ) < 0, 0, 100 - ( _var * 1000 ) )
			    )
		displayFolder: Chemical
		lineageTag: fdef49e8-850d-49f8-9347-fa3dc5375571

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Digital Tool Score' =
			
			CALCULATE (
			    AVERAGE ( Sustainability[KPI 4a Digital Tool] ),
			    FILTER ( Sustainability, Sustainability[Wet processing] = "Yes" ),
			    FILTER ( dimManufacturer, dimManufacturer[Manufacturer ID] <> BLANK () )
			)
		displayFolder: Chemical
		lineageTag: aef88de4-4cf0-4ae5-a30c-f66fa1fd9877

		annotation PBI_FormatHint = {"isGeneralNumber":true}

