	/// Inspection Rate difference to the target
	measure 'Inspection Rate ∆ to Target' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9206 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9207 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9205 ), " " )
			VAR Diff = [Inspection Rate] - [Target Inspection Rate]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Percent" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Percent" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Percent" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Quality Inspections
		lineageTag: f110a453-c163-4ea6-92b4-b18469bf20f3

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Percentage of styles without any issues during all inspection steps compared to all ordered styles previous year.
	measure 'Inspection Rate PY' =
			
			CALCULATE ( [Inspection Rate], DATEADD ( dimTimetable_Season[Date], -1, YEAR ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: 936d0529-1ee6-4574-81a7-e160c2f59392

		changedProperty = FormatString

