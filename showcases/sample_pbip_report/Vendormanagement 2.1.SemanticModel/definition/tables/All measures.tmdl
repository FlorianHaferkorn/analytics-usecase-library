	/// Distinct number of ordered SMS styles without any bulk order.
	measure '# of dropped SMS styles' =
			
			VAR SampleTable =
			    FILTER (
			        Details,
			        Details[sample_bulk] = "sample"
			            && Details[PO_conf_pcs] > 5
			            && Details[KSCHL] <> "ZFMS"
			            && NOT ISBLANK ( RELATED ( CPBI_MATERIAL[Style] ) )
			    )
			VAR BulkTable =
			    SELECTCOLUMNS (
			        FILTER (
			            Details,
			            Details[sample_bulk] = "Bulk"
			                && Details[KSCHL] <> "ZFMS"
			                && NOT ISBLANK ( RELATED ( CPBI_MATERIAL[Style] ) && Details[PO_conf_pcs] )
			        ),
			        "Bulk Styles", RELATED ( CPBI_MATERIAL[Style] )
			    )
			VAR DroppedStyles =
			    FILTER (
			        ADDCOLUMNS (
			            DISTINCT (
			                SELECTCOLUMNS ( SampleTable, "Sample Styles", RELATED ( CPBI_MATERIAL[Style] ) )
			            ),
			            "Dropped", IF ( [Sample Styles] IN DISTINCT ( BulkTable ), 0, 1 )
			        ),
			        [Dropped] > 0
			    )
			RETURN
			    COUNTROWS ( DroppedStyles )
		formatString: #,0
		displayFolder: Drop Rate
		lineageTag: c77c1454-2379-46d1-b6cf-6e036ec51c41

		changedProperty = FormatString

		changedProperty = IsHidden

