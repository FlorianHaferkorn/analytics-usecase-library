	/// Planned purchase order value $, which indicates "what should happen".
	measure 'PO_plan_val $' =
			
			CALCULATE (
			    SUM ( 'Capacity Planning'[Planned_val $] ),
			    FILTER ( 'Capacity Planning', 'Capacity Planning'[sample_bulk] = "Bulk" )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Planning
		lineageTag: d253de93-43b8-41cb-890a-9ddec2e1c7e3

