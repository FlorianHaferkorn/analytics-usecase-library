	/// Value € needed to be refinished calculated by the pcs needed to be refinished and the refinishing price per unit
	measure 'Refinishing_val €' =
			
			CALCULATE (
			    SUM ( 'QA Stop Claim (Centric)'[Refinishing_val] ),
			    'QA Stop Claim (Centric)'[Claim Type] = "Refinishing"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Quality Inspections
