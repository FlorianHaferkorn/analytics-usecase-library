	/// Total score difference to previous year.
	measure 'Total Score ∆ to PY' =
			
			VAR Up =
			    CONCATENATE ( UNICHAR ( 9650 ), " " )
			VAR Down =
			    CONCATENATE ( UNICHAR ( 9660 ), " " )
			VAR Stable =
			    CONCATENATE ( UNICHAR ( 9654 ), " " )
			VAR Diff = [Total Score] - [Total Score PY]
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        SWITCH (
			            TRUE (),
			            Diff > 0, CONCATENATE ( UP, FORMAT ( Diff, "Standard" ) ),
			            Diff < 0, CONCATENATE ( Down, FORMAT ( Diff, "Standard" ) ),
			            CONCATENATE ( Stable, FORMAT ( Diff, "Standard" ) )
			        ),
			        BLANK ()
			    )
		displayFolder: Scoring
