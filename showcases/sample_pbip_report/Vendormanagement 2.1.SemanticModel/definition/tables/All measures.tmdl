	measure '∆ PO_conf_val to PY' =
			
			VAR _Act = [PO_conf_val]
			VAR _PY = [PO_conf_val PY]
			RETURN
			    IF ( _Act = 0, BLANK (), DIVIDE ( DIVIDE ( _Act, _PY ), _PY ) )
		formatString: #,0.00\ %;-#,0.00\ %;#,0.00\ %
		displayFolder: _Slicer Measures
		lineageTag: a8aaaf9d-bed0-43a4-b445-6129fba4b081

