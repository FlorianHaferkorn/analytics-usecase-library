	/// Percentage of cancelled styles in comparison to the total ordered styles. Only cancellations before receipt of goods are considered.
	measure 'Cancellation Rate (pre delivery styles)' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    DIVIDE (
			        CALCULATE (
			            [# of styles],
			            FILTER ( Details, [PO_cancelled (pcs) (pre delivery)] > 0 )
			        ),
			        [# of styles]
			    ) + 0,
			    BLANK ()
