	/// Number of pcs needed to be refinished
	measure Refinishing_pcs =
			
			CALCULATE (
			    SUM ( 'QA Stop Claim (Centric)'[Stop/Claim Qty] ),
			    'QA Stop Claim (Centric)'[Claim Type] = "Refinishing"
			        && 'QA Stop Claim (Centric)'[Refinishing Price per Unit] > 0
			)
		formatString: #,0
		displayFolder: Quality Inspections
