	/// Percentage of claimed value by eCom customers compared to the delivered value to eCom customers.
	measure 'eCom Return Rate' =
			
			IF (
			    [PO_conf_pcs] > 0,
			    DIVIDE ( [claimed eCom_val €], [delivered to eCom customer_val €], 0 ) + 0,
			    BLANK ()
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Complaints
		lineageTag: afa59cfc-3f65-458c-9df8-7fd43b63aac9

