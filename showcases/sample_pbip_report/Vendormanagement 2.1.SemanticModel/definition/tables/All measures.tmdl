	/// Distinct number of styles with a failed random check.
	measure '# of failed styles (RS)' =
			
			VAR failedRC =
			    CALCULATE (
			        DISTINCTCOUNTNOBLANK ( 'CTDB_data (LINK)'[RT_CONFMAT] ),
			        FILTER (
			            'CTDB_data (LINK)',
			            'CTDB_data (LINK)'[Conclusion] = "Fail"
			                && NOT ( 'CTDB_data (LINK)'[Status] = "Cancelled" )
			        )
			    )
			RETURN
			    failedRC
		formatString: #,0
		displayFolder: Chemical
		lineageTag: 80bd1cc5-82e8-40a6-a9f1-9a82fbc96183

		changedProperty = FormatString

		changedProperty = IsHidden

