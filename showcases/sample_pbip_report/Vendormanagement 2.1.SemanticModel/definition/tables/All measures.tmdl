			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _Slicer Measures
		lineageTag: 989dd151-9e99-4f8b-9d49-027306902a25

		changedProperty = IsHidden

	measure 'Symbol Sustainability (net)' =
			
			VAR UsedMeasure = [Sustainability (net)]
			VAR Target = [Target Sustainability]
			VAR MinGreen = Target
			VAR MinYellow = Target - 20
			VAR MinRed = Target - 40
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure >= MinGreen, "CircleHigh",
			        UsedMeasure >= MinYellow, "CircleMedium",
			        UsedMeasure >= MinRed, "CircleLow",
			        ISBLANK ( UsedMeasure ), BLANK (),
			        "4CircleLow"
			    )
		displayFolder: _Symbols
		lineageTag: d202bc1c-37de-45e8-97fe-456835f84d78

		changedProperty = IsHidden

	/// Counts the number of distinct Manufacturer with any type of audit (= entry in the Sustainability database).
	measure '# MFR with Audit' =
			
			CALCULATE (
			    [# of MFR],
			    FILTER ( Sustainability, NOT ( ISBLANK ( Sustainability[External ID] ) ) )
			)
		formatString: #,0
		displayFolder: Sustainability
		lineageTag: 92b3ea88-887e-4cee-bf5f-2eceda3371bc

