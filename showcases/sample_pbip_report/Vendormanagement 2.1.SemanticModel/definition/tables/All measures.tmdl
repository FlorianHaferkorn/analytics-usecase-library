	/// Handover status clustered in in time (<= 0 days delay), nearly overdue (0-5 days delay) and overdue (> 5 days delay).
	measure 'Handover Status' =
			
			VAR OnTime = 0
			VAR inTolerance = 5
			RETURN
			    IF (
			        [PO_conf_pcs] > 0,
			        IF (
			            MIN ( dimOrderType[Purchase Order Type] ) = "BULK",
			            SWITCH (
			                TRUE (),
			                [Delay in days excl. buffer] <= OnTime, "in time",
			                [Delay in days excl. buffer] > OnTime
			                    && [Delay in days excl. buffer] <= inTolerance, "close to overdue",
			                "overdue"
			            ),
			            SWITCH ( TRUE (), [Delay in days excl. buffer] <= OnTime, "in time", "overdue" )
			        ),
			        BLANK ()
			    )
		displayFolder: Delivery
		lineageTag: 84ec1e96-3b7f-421c-8e50-4e1ca6400977

		changedProperty = IsHidden

