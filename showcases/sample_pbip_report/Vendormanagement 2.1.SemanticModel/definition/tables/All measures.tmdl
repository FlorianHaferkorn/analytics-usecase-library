	measure 'Symbol color duplication' =
			
			VAR UsedMeasure = [color duplication]
			VAR Target = [Target color duplication]
			VAR MinGreen = Target
			VAR MinYellow = 1.7
			VAR MinRed = 2.0
			RETURN
			    SWITCH (
			        TRUE (),
			        UsedMeasure <= MinGreen, "CircleHigh",
			        UsedMeasure <= MinYellow, "CircleMedium",
			        UsedMeasure <= MinRed, "CircleLow",
			        ISBLANK ( UsedMeasure ), BLANK (),
			        "4CircleLow"
			    )
		displayFolder: _Symbols
		lineageTag: 2ea72fbb-3862-4416-ad85-b3f19466fcf9

		changedProperty = IsHidden

