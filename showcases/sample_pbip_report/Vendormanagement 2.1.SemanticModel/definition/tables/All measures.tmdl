	measure 'Target Complaint Rate' =
			
			0.001
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: _Targets
		lineageTag: 5f696e31-d55d-4ee2-843c-5b2c0e2f929d

