	/// Color logic used in the portfolio matrix for the quadrants
	measure 'CF Quadrants for Matrix' =
			
			VAR TargetScore = [Total Score] >= [Portfolio_Total Score x-axis] //Measure: [Min Performance Score] -> Tabelle mit Dax: TotalScoreRange = GENERATESERIES(0, 100, 1)
			VAR TargetRelevance = [PO_conf_val %] >= [Portfolio_Growth y-axis] //Measure: [Min Order Relevance] -> Tabelle mit Dax: OrderPcs%Range = GENERATESERIES(0, 1, 0.01)
			VAR Result =
			    SWITCH (
			        TRUE (),
			        TargetScore && TargetRelevance, 1,
			        TargetScore
			            && TargetRelevance = FALSE (), 2,
			        TargetScore = FALSE ()
			            && TargetRelevance = FALSE (), 4,
			        TargetScore = FALSE ()
			            && TargetRelevance, 3
			    )
			RETURN
			    IF ( [PO_conf_pcs] > 0, Result, BLANK () )
		formatString: 0
		displayFolder: _Colors
		lineageTag: f9c1cad6-b827-42a7-80a7-20d136624e39

