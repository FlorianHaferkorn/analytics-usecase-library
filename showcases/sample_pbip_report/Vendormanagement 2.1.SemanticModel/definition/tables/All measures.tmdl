	/// Distinct number of claimed styles by the QA department. Only the claim types Cancellation, CN, CRN, Refinishing, Discount are included. Any issues related to wet cartons are excluded.
	measure '# of claimed styles (QA Claims)' =
			
			CALCULATE (
			    [# of styles],
			    FILTER (
			        'QA Stop Claim (Centric)',
			        'QA Stop Claim (Centric)'[Valid Claim Type] = "valid"
			            && 'QA Stop Claim (Centric)'[Claim Status] = "settled"
			    )
			)
		formatString: #,0
		displayFolder: Quality Inspections
		lineageTag: 1f813b60-9689-4649-8e03-0cab2c5cd89f

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Percentage of weighted points of all inspection steps compared to the maximum number of points = number of styles.
	measure 'Inspection Rate' =
			
			VAR OpticalWeight = 0.45
			VAR MSMTWeight = 0.45
			VAR RCsWeight = 0.1
			VAR _Calculation =
			    IF (
			        [PO_conf_pcs] > 0,
			        [Optical Test Result] * OpticalWeight + [MSMT Test Result] * MSMTWeight + [Random Check Result] * RCsWeight,
			        BLANK ()
			    )
			RETURN
			    _Calculation
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Quality Inspections
		lineageTag: 06a1301e-411a-4aa7-bd7d-10d3c65fcdf2

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Distinct number of styles claimed by wholesale customers.
	measure '# of claimed styles (CCR)' =
			
			CALCULATE (
			    [# of styles delivered to cust.],
			    FILTER ( CCR, CCR[claimed quantity pcs] > 0 )
			)
		formatString: #,0
		displayFolder: Complaints
		lineageTag: 9d4fab31-ee9f-4929-b222-56ac46e7b950

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Distinct number of styles claimed either by wholesale or B2C customers.
	measure '# of claimed styles' =
			
			VAR complainedStyles =
			    COUNTROWS (
			        DISTINCT (
			            UNION (
			                CALCULATETABLE (
			                    DISTINCT ( Details[RT_CONFMAT] ),
			                    CCR[claimed quantity pcs] > 0,
			                    Details[RT_CONFMAT] <> BLANK ()
			                ),
			                CALCULATETABLE (
			                    DISTINCT ( CSS_Tickets[Artikelnummer] ),
			                    CSS_Tickets[Status] = "closed",
			                    Details[RT_CONFMAT] <> BLANK ()
			                )
			            )
			        )
			    )
			RETURN
			    IF (
			        SUMX ( CCR, CCR[delivered to customer pcs] ) > 0,
			        complainedStyles,
			        BLANK ()
			    )
		formatString: #,0
		displayFolder: Complaints
		lineageTag: 4a96e47f-4c59-46f0-8e96-0bd7e75f1479

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Percentage of claimed value by wholesale customers compared to the delivered value to our whole sale customers.
	measure 'Complaint Rate' =
			
			VAR ComplaintRate = [CCR] RETURN IF ( ComplaintRate > 1, 1, ComplaintRate )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
