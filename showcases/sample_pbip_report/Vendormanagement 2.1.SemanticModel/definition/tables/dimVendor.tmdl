	column 'Default Transport Chain' = ```
			
			IF(
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
			        CC_LFM1_S4[TRANSPORT_CHAIN]
			    ) = BLANK() ,
			    FIRSTNONBLANK(
			        TOPN( 1 , 
			            VALUES( Details[Initial Transport Chain] ) , 
			            Calculate( [PO_conf_val €] , 
			                ALLEXCEPT( 
			                    dimVendor , 
			                    dimVendor[Vendor] 
			                ) 
			            ) 
			        ) , 1 
			    ) ,
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
			        CC_LFM1_S4[TRANSPORT_CHAIN]
			    )
			)
			```
		lineageTag: 9aa86de5-2c7c-466e-a2e5-e5bdef9c21f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Default Port of Dispatch' = RIGHT( dimVendor[Default Transport Chain] , 3 )
		lineageTag: 9c45e3fa-0757-4257-98eb-833123dda3b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Default Transport Mode' = MID( dimVendor[Default Transport Chain] , 3 , 2 )
		lineageTag: 043a58ea-e670-42d9-a61d-8cbd0ecdd8e5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Pending = ```
			
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
			        CC_LFM1_S4[Allg. EK Sperre]
			    )
			```
		lineageTag: 76a181d8-a8b8-4fac-a9a4-20a5fdd6fdc9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Pending Date' = ```
			
			var _Date =
			    MAXX (
			        FILTER ( 
			            CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] && 
			            CC_LFM1_S4[EK Sperre Datum] <> "00000000" ),
			        CC_LFM1_S4[EK Sperre Datum]
			    )
			
			RETURN
			DATE( LEFT( _Date , 4 ) , MID( _Date , 5 , 2 ) , RIGHT( _Date , 2 ) )
			```
		dataType: string
		lineageTag: 417efef0-12b1-46f0-92a4-64c1fc95386f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Delisting = ```
			
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
