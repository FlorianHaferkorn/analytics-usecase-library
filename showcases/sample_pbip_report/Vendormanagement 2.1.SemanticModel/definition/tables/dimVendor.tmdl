	column 'Sourcing Market' =
			SWITCH(
				TRUE,
				ISBLANK('dimVendor'[Sourcing Country]),
				"(Leer)",
				'dimVendor'[Sourcing Country] IN {"BD"},
				"Bangladesh",
				'dimVendor'[Sourcing Country] IN {"CN",
					"HK",
					"KH",
					"MM"},
				"China",
				'dimVendor'[Sourcing Country] IN {"IN",
					"LK"},
				"India",
				'dimVendor'[Sourcing Country] IN {"ID",
					"VN"},
				"Indonesia",
				'dimVendor'[Sourcing Country] IN {"PK"},
				"Pakistan",
				'dimVendor'[Sourcing Country] IN {"TR"},
				"Turkey",
				"Other Nearshore"
			)
