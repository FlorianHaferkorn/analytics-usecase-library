	column 'Delisting Date' = ```
			
			var _Date =
			    MAXX (
			        FILTER ( 
			            CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] && 
			            CC_LFM1_S4[Bch Sperre Datum] <> "00000000" ),
			        CC_LFM1_S4[Bch Sperre Datum]
			    )
			
			RETURN
			DATE( LEFT( _Date , 4 ) , MID( _Date , 5 , 2 ) , RIGHT( _Date , 2 ) )
			```
		dataType: string
		lineageTag: 8ce13f58-c412-4763-bd2d-b1844a1ac479
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Vendor Status' = ```
			
			    SWITCH(
			        TRUE() ,
			            dimVendor[Delisting] <> BLANK() , "Delisted" ,
			            dimVendor[Pending] <> BLANK() , "Pending" ,
			            LEFT( dimVendor[Vendor], 1 ) = "*" , "Delisted" ,
			            "Active"
			    )
			```
		lineageTag: 733466f1-8143-49be-a6a2-134df10ac7d8
