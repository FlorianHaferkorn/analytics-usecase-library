	partition dimVendor-f97c3d90-9635-40dc-b10e-89ca69757b17 = calculated
		mode: import
		source = ```
				
				FILTER(
				    DISTINCT(
				        SELECTCOLUMNS(
				                Details,
				                "Key", FORMAT( Details[Vendor] , "0000000000" ) ,
				                "Vendor ID", VALUE( Details[Vendor] ) ,
				                "Country ID", Details[COUNTRY_VENDOR] ,
				                "City", Details[CITY_VENDOR] ,
				                "Street", Details[STREET_VENDOR] ,
				                "Activation Date", 
				                    IF(
				                        VALUE( Details[Date of Activation Vendor] ) > 0 , 
				                        Details[Date of activation Vendor] , 
				                        BLANK()
				                    )
				        )
				    ), NOT ISBLANK( [Vendor ID] )
				)
				```

	annotation PBI_Id = dfd1b9a275b348c28f4a24431cb69da7

