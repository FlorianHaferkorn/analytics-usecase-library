	column 'Sourcing Country' = ```
			//FIRSTNONBLANK(TOPN(1,VALUES(Details[Country of dispatch (PO)]),Calculate([PO_conf_val €], ALLEXCEPT(dimVendor,dimVendor[Vendor]))),1)
			IF(
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
			        CC_LFM1_S4[TRANSPORT_CHAIN]
			    ) = BLANK() ,
			    FIRSTNONBLANK(
			        TOPN( 1 , 
			            VALUES( Details[Country of dispatch (PO)] ) , 
			            Calculate( [PO_conf_val €] , 
			                ALLEXCEPT( 
			                    dimVendor , 
			                    dimVendor[Vendor] 
			                ) 
			            ) 
			        ) , 1 
			    ) ,
			    LEFT(
			        MAXX (
			            FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimVendor[Key] ),
			            CC_LFM1_S4[TRANSPORT_CHAIN]
			        ), 2
			    )
			)
			```
		lineageTag: 83fc5deb-2754-44c9-9952-9ca023c6fd96
		dataCategory: Country
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"dimVendor","TableItemName":"Sourcing Market","ObjectType":4},"LinkType":"UsedInGroup"},{"LinkTarget":{"TableName":"dimVendor","TableItemName":"Continent","ObjectType":4},"LinkType":"UsedInGroup"}]

