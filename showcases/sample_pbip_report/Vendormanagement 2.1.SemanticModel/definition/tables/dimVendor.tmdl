		dataCategory: PostalCode
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Partnership in years' =
			
			IF(
			    IF(
			        dimVendor[Delisting Date] <> BLANK() ,
			        DIVIDE( dimVendor[Delisting Date] - dimVendor[Activation Date] , 365.25 , 0 ) ,
			        DIVIDE( TODAY() - dimVendor[Activation Date] , 365.25 , 0 )
			    ) < 0 ,
			    BLANK() ,
			    IF(
			        dimVendor[Delisting Date] <> BLANK() ,
			        DIVIDE( dimVendor[Delisting Date] - dimVendor[Activation Date] , 365.25 , 0 ) ,
			        DIVIDE( TODAY() - dimVendor[Activation Date] , 365.25 , 0 )
			    )
			)
		formatString: 0.0
		lineageTag: 46c7d436-b291-4ebb-b552-92ddc28abb7a
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

