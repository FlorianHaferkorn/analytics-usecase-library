table dimClaimReason
	lineageTag: 97ef82e9-583e-49bd-a11b-2539e8471c3d

	column 'Claim Reason ID'
		lineageTag: f1c6ea62-19f2-4437-a7a7-cf0298e99df1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Claim Reason ID]

		annotation SummarizationSetBy = Automatic

	column 'Claim Reason Name'
		lineageTag: 4d3fccf0-8357-4371-8909-a1184e0c32a7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Claim Reason Name]

		annotation SummarizationSetBy = Automatic

	column 'Claim Reason Cluster' = LEFT( dimClaimReason[Claim Reason ID] )
		lineageTag: a816cedc-5322-4ced-984f-9c657b0c5fbf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dimClaimReason-df24c04e-8665-4617-ba1b-e6814aeb30db = calculated
		mode: import
		source = ```
				
				FILTER(
				    ADDCOLUMNS(
				        DISTINCT(
				            SELECTCOLUMNS(
				                CCR ,
				                    "Claim Reason ID" , CCR[_SOL_RETURNRS]
				            )
				        ),
				        "Claim Reason Name" , 
				        IF(
				            [Claim Reason ID] = "S3" , "Qualität allgemein" ,
				                MAXX (
				                    FILTER ( 'Claim reason', 'Claim reason'[Claim reason] = [Claim Reason ID] ),
				                    MID( 'Claim reason'[Claim reason name] , 5 , 200 )
				                )
				        )
				    ), [Claim Reason Name] <> BLANK()
				)
				```

	annotation PBI_Id = a2255c1d3bc34b07a269a8b27db01f61

