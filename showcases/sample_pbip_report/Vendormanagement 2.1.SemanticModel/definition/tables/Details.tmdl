	column 'Exchange Rate (Plan)' =
			
			
			VAR vPostingDate = Details[Season_Calendar]
			VAR vCurrency = "USD"
			Var iCurrency = "EUR"
			VAR vMaxValidFrom =
			    CALCULATE (
			        MAX ( CPBI_PLANKURS[Datum] ) ,
			        CPBI_PLANKURS[Nach-Waehrung] = vCurrency &&
			        CPBI_PLANKURS[Von-Waehrung] = iCurrency &&
			        CPBI_PLANKURS[Datum] <= vPostingDate
			    )
			VAR vRate =
			    CALCULATE (
			        MAX ( CPBI_PLANKURS[Kurs] ),
			        CPBI_PLANKURS[Nach-Waehrung] = vCurrency &&
			        CPBI_PLANKURS[Von-Waehrung] = iCurrency &&
			        CPBI_PLANKURS[Datum] = vMaxValidFrom
			    )
			
			RETURN
			    vRate
		dataType: double
		formatString: 0.000
		lineageTag: 627ee2aa-1068-42d3-afac-badd5952c81d
		summarizeBy: sum

		changedProperty = DataType

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Exchange Rate (Calc.)' =
			
			
			VAR vPostingDate = Details[Delivery Date DC]
			VAR vCurrency = "USD"
			Var iCurrency = "EUR"
			VAR vMaxValidFrom =
			    CALCULATE (
			        MAX ( CPBI_KALKKURS[Datum] ) ,
			        CPBI_KALKKURS[Nach-Waehrung] = vCurrency &&
			        CPBI_KALKKURS[Von-Waehrung] = iCurrency &&
			        CPBI_KALKKURS[Datum] <= vPostingDate
			    )
			VAR vRate =
			    CALCULATE (
			        MAX ( CPBI_KALKKURS[Kurs] ),
			        CPBI_KALKKURS[Nach-Waehrung] = vCurrency &&
			        CPBI_KALKKURS[Von-Waehrung] = iCurrency &&
			        CPBI_KALKKURS[Datum] = vMaxValidFrom
			    )
			
			RETURN
			    vRate
		formatString: 0.000
