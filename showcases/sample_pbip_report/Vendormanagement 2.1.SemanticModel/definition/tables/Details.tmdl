	column 'Order Cluster' =
			
			Var QtyperOrder = CALCULATE([PO_conf_pcs], ALLEXCEPT(Details, Details[Purchase Order]))
			Return
			    SWITCH(
			        TRUE(),
			        QtyperOrder <= 500, "A: <= 500",
			        QtyperOrder <= 1000, "B: <= 1.000",
			        QtyperOrder <= 3000, "C: <= 3.000",
			        QtyperOrder <= 5000, "D: <= 5.000",
			        QtyperOrder <= 10000, "E: <= 10.000",
			        "F: > 10.000"
			    )
		lineageTag: 95826445-1eab-4ae7-8b7b-3361839d8272
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Season_Calendar =
			
			IF(
			     VALUE( LEN( Details[Saison_ALKW] ) ) = 6 ,
			        Date( Details[Saison_ALKW_Year] , Details[Saison_ALKW_Month_] , 15 ) ,
			        Date( Details[Saison_ALKW_Year] , RIGHT( Details[Saison_ALKW_Month_] , 1 ) , 15 )
			)
