	column 'Cluster Delay in Days' = ```
			
			var Delay = Details[Delay in days excl. buffer] 
			
			Return
			SWITCH(
			    TRUE(),
			        Delay <= 0 , "A: <= 0" ,
			        Delay <= 5 , "B: <= 5" ,
			        Delay <= 10 , "C: <= 10" ,
			        Delay <= 30 , "D: <= 30" ,
			        "E: > 30" 
			)
			```
		lineageTag: 952e3b1c-d7d6-4436-b0e1-44c5bf5cdeb0
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'PO_conf_val $ (PP_Calc)' =
			
			IF(
			    Details[PP_FW_CURR] = "USD",
			    Details[PO_conf_pcs] * Details[PP_CALC_FW] ,
			    Details[PO_conf_pcs] * DIVIDE( Details[PP_CALC_FW] , Details[Exchange Rate (Plan)] , 0 )
			)
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
