		annotation SummarizationSetBy = Automatic

	column 'PP Ratio Target' = ```
			
			Var _ExceptionTarget = 0.45
			Var _KoopTarget =
			MAXX (
			    FILTER(
			        Targets_PPRatio_BGL ,
			        RELATED( dimBrand[Brand ID] ) = Targets_PPRatio_BGL[Brand] &&
			        RELATED( dimGender[Gender ID] ) = Targets_PPRatio_BGL[Gender] &&
			        RELATED( dimLine[Line ID] ) = Targets_PPRatio_BGL[Line] &&
			        RELATED( dimCollectionType[Collection Type ID] ) = Targets_PPRatio_BGL[Koll.art] &&
			        Details[Season_Calendar] >= Targets_PPRatio_BGL[Gültig ab] &&
			        Details[Season_Calendar] <= Targets_PPRatio_BGL[Gültig bis]
			    ),
			    Targets_PPRatio_BGL[Betrag]
			)
			Var _Lookup_Country =
			MAXX (
			    FILTER(
			        Targets_PPRatio ,
			        RELATED( dimBrand[Brand ID] ) = Targets_PPRatio[Brand] &&
			        RELATED( dimGender[Gender ID] ) = Targets_PPRatio[Gender] &&
			        RELATED( dimLine[Line ID] ) = Targets_PPRatio[Line] &&
			        RELATED( dimCollectionType[Collection Type ID] ) = Targets_PPRatio[Koll.art] &&
			        RELATED( dimMainclass[Main Class ID] ) = Targets_PPRatio[Hauptklass] &&
			        RELATED( dimVendor[Sourcing Country] ) = Targets_PPRatio[AL/R] &&
			        Details[Season_Calendar] >= Targets_PPRatio[Gültig ab] &&
			        Details[Season_Calendar] <= Targets_PPRatio[Gültig bis]
			    ),
			    Targets_PPRatio[Betrag]
			)
			
			Var _Lookup_MC =
			MAXX (
			    FILTER(
			        Targets_PPRatio_MC ,
			        RELATED( dimBrand[Brand ID] ) = Targets_PPRatio_MC[Brand] &&
			        RELATED( dimGender[Gender ID] ) = Targets_PPRatio_MC[Gender] &&
			        RELATED( dimLine[Line ID] ) = Targets_PPRatio_MC[Line] &&
			        RELATED( dimCollectionType[Collection Type ID] ) = Targets_PPRatio_MC[Koll.art] &&
			        RELATED( dimMainclass[Main Class ID] ) = Targets_PPRatio_MC[Hauptklass] &&
			        Details[Season_Calendar] >= Targets_PPRatio_MC[Gültig ab] &&
			        Details[Season_Calendar] <= Targets_PPRatio_MC[Gültig bis]
			    ),
			    Targets_PPRatio_MC[Betrag]
			)
			
			Return
			IF(
			    ISBLANK( _Lookup_Country ) ,
			        IF( 
			            ISBLANK( _Lookup_MC ) ,
			                IF(
			                    ISBLANK( _KoopTarget ) ,
			                    _ExceptionTarget ,
			                    _KoopTarget 
			                ) ,
			            _Lookup_MC
			        ) , 
			    _Lookup_Country
			)
			```
		isHidden
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 16a801a4-8842-40e6-a853-077b73ae1d5a
		summarizeBy: none

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Initial Transport Mode' =
			
			var ActTrans = MID( Details[Initial Transport Chain] , 3 , 2 )
			
			Return
			SWITCH(
			    TRUE(),
			        ActTrans = "AI" , "AIR" ,
			        ActTrans = "SA" , "SEA/AIR" ,
			        ActTrans = "SE" , "SEA" ,
			        ActTrans = "SH" , "SEA" ,
			        ActTrans = "TR" , "TRUCK" ,
