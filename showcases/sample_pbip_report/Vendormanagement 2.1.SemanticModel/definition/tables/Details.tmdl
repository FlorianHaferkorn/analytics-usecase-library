	column 'Handover Status' =
			
			Var OnTime = 0
			Var inTolerance = 5
			
			Return
			IF(
			    Details[sample_bulk] = "BULK" ,
			    Switch(
			        True(),
			            [Delay in days excl. buffer] <= OnTime, "in time",
			            [Delay in days excl. buffer] > OnTime && [Delay in days excl. buffer] <= inTolerance, "nearly overdue",
			            "overdue"
			    ) ,
			    Switch(
			        True(),
			            [Delay in days excl. buffer] <= OnTime, "in time",
			            "overdue"
			    )
			)
		lineageTag: 00474809-37ac-45d8-964a-9586179e0d6d
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

