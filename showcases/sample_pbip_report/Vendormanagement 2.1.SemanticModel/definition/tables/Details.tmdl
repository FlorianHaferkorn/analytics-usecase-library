	column 'COS Target' = ```
			
			
			Var ExceptionTarget = 
			    SWITCH(
			        TRUE() ,
			        MAX( Targets_COS[Year] ) <= 2021 , 0.49 ,
			        MAX( Targets_COS[Year] ) <= 2022 , 0.515 ,
			        0.535
			    )
			    
			Var Lookup =
			MAXX (
			    FILTER(
			        Targets_COS ,
			        RELATED( dimBrand[Brand ID] ) = Targets_COS[Brand] &&
			        RELATED( dimGender[Gender ID] ) = Targets_COS[Gender] &&
			        RELATED( dimLine[Line ID] ) = Targets_COS[Line] &&
			        RELATED( dimCollectionType[Collection Type ID] ) = Targets_COS[Koll.art] &&
			        Details[Season_Calendar] >= Targets_COS[Gültig ab] &&
			        Details[Season_Calendar] <= Targets_COS[Gültig bis]
			    ),
			    Targets_COS[Betrag]
			)
			
			Return
			IF(
			    ISBLANK( Lookup ),
			    ExceptionTarget ,
			    Lookup
			)
			```
