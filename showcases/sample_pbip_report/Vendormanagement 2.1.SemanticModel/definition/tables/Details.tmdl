		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'PO_conf_val € (pre_calc)' =
			
			IF(
			    Details[PP_FW_CURR] = "USD",
			    Details[PO_conf_pcs] * DIVIDE( Details[PP_CALC_FW] , Details[Exchange Rate (Plan)] , 0 ) ,
			    Details[PO_conf_pcs] * Details[PP_CALC_HW]
			)
		isHidden
