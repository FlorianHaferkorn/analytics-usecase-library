	column 'Points OrangePOMs' = ```
			
			    IF(
			        'Inspections (Centric)'[Number of Orange POMs] > 'Inspections (Centric)'[Maximum Orange POMs], 0.5,
			        0
			    )
			```
		isHidden
		formatString: 0.0
		lineageTag: a8c9b4e7-468e-47ac-a0ea-570c96c0c000
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation SummarizationSetBy = User

	column 'Points (MSMT)' = ```
			
			
			    SWITCH(
			        TRUE(),
			            'Inspections (Centric)'[Points RedPOMs] > 0, 1,
			            AND('Inspections (Centric)'[Points RedPOMs] < 1, 'Inspections (Centric)'[Points OrangePOMs] > 0), 0.5,
			            0
			    )
			```
		isHidden
		formatString: 0.00
		lineageTag: 18d4ca4c-43ad-4a28-ad90-7967faf4f009
		summarizeBy: none

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Points (Optical)' = ```
			
			    IF( 'Inspections (Centric)'[Optical Test Result] = "Failed" , 1 ,
			        IF( 'Inspections (Centric)'[Optical Test Result] = "Marginal" , 0.5 ,
			            0
			        )
			    )
			```
		isHidden
