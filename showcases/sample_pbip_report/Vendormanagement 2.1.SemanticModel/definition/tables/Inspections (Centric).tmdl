	column 'Maximum Red POMs' = ```
			
			
			// Select and return Sample Size Category
			Var _SampleSizeCategories =
			    CALCULATETABLE(
			        SELECTCOLUMNS( 
			            'Measurement_AQL_2.5', 
			            "Sample Size", 'Measurement_AQL_2.5'[Sample Size] ),
			        FILTER(
			            ALL( 'Measurement_AQL_2.5' ),
			            'Measurement_AQL_2.5'[Sample Size] <= 'Inspections (Centric)'[Measured Qty]
			        )
			    )
			
			// Return maximum Major Count for closest sample size
			VAR _treatas =
			    TREATAS ( _SampleSizeCategories, 'Measurement_AQL_2.5'[Sample Size] )
			
			RETURN
			    IF(
			        NOT ISBLANK(CALCULATE ( MAX ( 'Measurement_AQL_2.5'[Major - Rejected] ), _treatas )),
			            CALCULATE ( MAX ( 'Measurement_AQL_2.5'[Major - Rejected] ), _treatas ),
			        1
			    )
			```
		isHidden
		formatString: #,0
		lineageTag: 5ea59728-f003-473e-86b8-1519386105b6
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation SummarizationSetBy = User

	column 'Maximum Orange POMs' = ```
			
			
			// Select and return Sample Size Category
			Var _SampleSizeCategories =
			    CALCULATETABLE(
			        SELECTCOLUMNS( 
			            'Measurement_AQL_2.5', 
			            "Sample Size", 'Measurement_AQL_2.5'[Sample Size] ),
			        FILTER(
			            ALL( 'Measurement_AQL_2.5' ),
			            'Measurement_AQL_2.5'[Sample Size] <= 'Inspections (Centric)'[Measured Qty]
			        )
			    )
			
			// Return maximum Minor Count for closest sample size
			VAR _treatas =
			    TREATAS ( _SampleSizeCategories, 'Measurement_AQL_2.5'[Sample Size] )
			
			RETURN
			    IF(
			        NOT ISBLANK(CALCULATE ( MAX ( 'Measurement_AQL_2.5'[Major - Rejected] ), _treatas )),
			            CALCULATE ( MAX ( 'Measurement_AQL_2.5'[Minor - Rejected] ), _treatas ),
			        1
			    )
			```
		isHidden
		formatString: #,0
		lineageTag: 8200447e-aa1a-4cc6-9113-acb14b96e4b0
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation SummarizationSetBy = User

	column 'Points RedPOMs' = ```
			
			    IF(
			        'Inspections (Centric)'[Number of Red POMs] > 'Inspections (Centric)'[Maximum Red POMs], 1,
			        0
			    )
			```
		isHidden
		formatString: 0
		lineageTag: 9cbbb7ad-c17a-4ac9-a505-1ee5af898d5a
		summarizeBy: none

