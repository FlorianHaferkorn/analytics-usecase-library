	column 'FGI & IGI Check' =
			
			var _FGI = CALCULATE( DISTINCTCOUNT( 'Inspections (Centric)'[Inspection] ) , FILTER( ALLEXCEPT( 'Inspections (Centric)' , 'Inspections (Centric)'[Inspection] ) , 'Inspections (Centric)'[Inspection Type] = "FGI" ) )
			var _IGI = CALCULATE( DISTINCTCOUNT( 'Inspections (Centric)'[Inspection] ) , FILTER( ALLEXCEPT( 'Inspections (Centric)' , 'Inspections (Centric)'[Inspection] ) , 'Inspections (Centric)'[Inspection Type] = "IGI" ) )
			
			RETURN
			IF ( _FGI > 0 && _IGI > 0 , "YES", "NO" )
		lineageTag: 5ffce96d-2352-43bc-9a86-184ccef6d5e9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

