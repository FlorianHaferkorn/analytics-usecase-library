	column Pending = ```
			
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimManufacturer[Key] ),
			        CC_LFM1_S4[Allg. EK Sperre]
			    )
			```
		lineageTag: 30aa62cf-57e1-4308-b3ba-9c341d7cfa11
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Pending Date' = ```
			
			var _Date =
			    MAXX (
			        FILTER ( 
			            CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimManufacturer[Key] && 
			            CC_LFM1_S4[EK Sperre Datum] <> "00000000" ),
			        CC_LFM1_S4[EK Sperre Datum]
			    )
			
			RETURN
			DATE( LEFT( _Date , 4 ) , MID( _Date , 5 , 2 ) , RIGHT( _Date , 2 ) )
			```
		dataType: string
		lineageTag: 9c5579d1-bdbc-4d5e-98e0-4c1757a87c42
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Delisting = ```
			
			    MAXX (
			        FILTER ( CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimManufacturer[Key] ),
			        CC_LFM1_S4[Allg. Bch Sperre]
			    )
			```
		lineageTag: 6dd545f9-7b50-4817-91f6-cd69e9d1f153
		summarizeBy: none

