	column 'Delisting Date' = ```
			
			var _Date =
			    MAXX (
			        FILTER ( 
			            CC_LFM1_S4, CC_LFM1_S4[LIFNR] = dimManufacturer[Key] && 
			            CC_LFM1_S4[Bch Sperre Datum] <> "00000000" ),
			        CC_LFM1_S4[Bch Sperre Datum]
			    )
			
			RETURN
			DATE( LEFT( _Date , 4 ) , MID( _Date , 5 , 2 ) , RIGHT( _Date , 2 ) )
			```
		dataType: string
		lineageTag: 16ac041e-6380-4076-9946-5b2cfc495ea8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Manufacturer Status' = ```
			
			    SWITCH(
			        TRUE() ,
			            dimManufacturer[Delisting] <> BLANK() , "Delisted" ,
			            dimManufacturer[Pending] <> BLANK() , "Pending" ,
			            LEFT( dimManufacturer[Manufacturer] , 1 ) = "*" , "Delisted" ,
			            "Active"
			    )
			```
		lineageTag: af2dafe8-dd86-4d9b-8594-58e9c82c3e18
		summarizeBy: none

