		annotation SummarizationSetBy = Automatic

	column 'Partnership in years' =
			
			IF(
			    IF(
			        dimManufacturer[Delisting Date] <> BLANK() ,
			        DIVIDE( dimManufacturer[Delisting Date] - dimManufacturer[Activation Date] , 365.25 , 0 ) ,
			        DIVIDE( TODAY() - dimManufacturer[Activation Date] , 365.25 , 0 )
			    ) < 0 ,
			    BLANK() ,
			    IF(
			        dimManufacturer[Delisting Date] <> BLANK() ,
			        DIVIDE( dimManufacturer[Delisting Date] - dimManufacturer[Activation Date] , 365.25 , 0 ) ,
			        DIVIDE( TODAY() - dimManufacturer[Activation Date] , 365.25 , 0 )
			    )
			)
		formatString: 0.0
		lineageTag: 80ed075a-41b7-40c3-8915-644865107337
		summarizeBy: none

		changedProperty = FormatString

		annotation SummarizationSetBy = User

