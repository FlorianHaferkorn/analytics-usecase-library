	column 'Wet Processing' =
			
			CALCULATE(
			    MAX( Sustainability[Wet processing] ) ,
			    FILTER(
			        Sustainability,
			        VALUE( dimManufacturer[Manufacturer ID] ) = VALUE( Sustainability[External ID] )
			    )
			)
		lineageTag: c9987716-552a-4507-b206-bd564ce37468
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Manufacturer = ```
			
			CALCULATE( 
			    MAX( CC_VENDOR[Textspalte für Attribut 0VENDOR] ) ,
			    FILTER(
			        CC_VENDOR, 
			        dimManufacturer[Key] = CC_VENDOR[Lieferant]
			    )
			)
			```
		lineageTag: 7753ad31-b60e-48d0-82a2-6a167e1c8dec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dimManufacturer-ad4242b0-ff73-4f63-95ad-35cb42509d57 = calculated
		mode: import
		source = ```
				
				FILTER(
				    DISTINCT(
				        SELECTCOLUMNS(
				                Details,
				                "Key", Details[Hersteller ID] ,
				                "Manufacturer ID", 
				                    IF(
				                        Details[Hersteller] <> BLANK(), 
				                        VALUE( RIGHT( Details[Hersteller] , 7 ) ) ,
				                        BLANK()
				                    ),
				                --"Manufacturer" , Details[Manufacturer] ,
				                "Production Country ID" , Details[COUNTRY_MFR] ,
				                "City" , Details[CITY_MFR] ,
				                "Street" , Details[STREET_MFR] ,
				                "Activation Date" , 
				                    IF(
				                        VALUE( Details[Date of activation MFR] ) > 0, 
				                        Details[Date of Activation MFR] , 
				                        BLANK()
				                    )
				        )
				    ), NOT ISBLANK( [Manufacturer ID] )
				)
				```

	annotation PBI_Id = 70b3018cf22c40118f98dd8e0767bc19

