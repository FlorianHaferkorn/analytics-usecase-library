/// XD-002 Measures
table _Measures

    /// res.utilization.pct - Utilization %
    /// Measures productive time versus paid time for agents.
    measure 'Utilization %' =
            BLANK()
        formatString: "0.0%"

    /// res.occupancy.pct - Occupancy %
    /// Measures active vs idle share of time.
    measure 'Occupancy %' =
            BLANK()
        formatString: "0.0%"

    /// svc.sla.attainment.pct - SLA Attainment %
    /// Measures how many cases meet the committed SLA.
    measure 'SLA Attainment %' =
            BLANK()
        formatString: "0.0%"

    /// res.overtime.pct - Overtime %
    /// Shows overtime share of total hours.
    measure 'Overtime %' =
            BLANK()
        formatString: "0.0%"

    /// res.shrinkage.pct - Shrinkage %
    /// Measures non-productive share of paid time.
    measure 'Shrinkage %' =
            BLANK()
        formatString: "0.0%"

    /// svc.backlog.count - Backlog Count
    /// Quantifies unresolved work in queue.
    measure 'Backlog Count' =
            BLANK()
        formatString: "#,0"
