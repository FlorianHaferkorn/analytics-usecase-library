/// COM-011 Measures (Innovation Revenue Contribution)
table _Measures

    /// people.new_product_share - New Product Share %
    /// Show how much of revenue is generated by recently launched products.
    measure 'New Product Revenue Share %' =
            BLANK()
        formatString: "0.0 %"

    /// people.innovation_rate.pct - Innovation Rate %
    /// Share of revenue generated by products launched within the last 3 years.
    measure 'Innovation Rate %' =
            DIVIDE([Revenue from New Products],[Total Revenue])
        formatString: "0.0 %"

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// margin.gm.pct - Gross Margin % (Operational)
    /// Provide the Gross Margin % used in commercial and management reporting at the same granularity as Net Sales.
    measure 'Gross Margin %' =
            DIVIDE([Net Sales Amount]-[COGS Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"
