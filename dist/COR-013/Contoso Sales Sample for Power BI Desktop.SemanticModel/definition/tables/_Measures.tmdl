/// COR-013 Measures (Customer Profitability Across Lifecycle)
table _Measures

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// margin.customer.amount - Customer Margin Amount
    /// Measure gross margin generated by a specific customer or customer segment.
    measure 'Customer Margin Amount' =
            [Net Sales Amount] - [COGS Amount]
        formatString: "€ #,0.00"
        displayFolder: "02_Margin"

    /// margin.customer.pct - Customer Margin %
    /// Show gross margin rate for a customer or segment.
    measure 'Customer Margin %' =
            DIVIDE([Customer Margin Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// crm.clv.amount - CLV (Customer Lifetime Value)
    /// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
    measure 'Customer Lifetime Value (CLV) Amount' =
            BLANK()
        formatString: "EUR #,0.00"

    /// crm.acquisition.cac.amount - Customer Acquisition Cost (CAC) Amount
    /// Measure average marketing and sales cost per new acquired customer.
    measure 'Customer Acquisition Cost (CAC) Amount' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "07_Acquisition"

    /// crm.retention.pct - Customer Retention %
    /// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
    measure 'Customer Retention %' =
            DIVIDE([Active Customers End],[Active Customers Start])
        formatString: "0.0 %"

    /// crm.churn.pct - Customer Churn Rate %
    /// Measures proportion of customers lost during a period.
    measure 'Customer Churn Rate %' =
            DIVIDE([Churned Customers],[Active Customers Start])

    /// crm.complaint.rate.pct - Complaint Rate %
    /// Measure complaints relative to delivered orders or customers.
    measure 'Complaint Rate %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "05_Service_Quality"
