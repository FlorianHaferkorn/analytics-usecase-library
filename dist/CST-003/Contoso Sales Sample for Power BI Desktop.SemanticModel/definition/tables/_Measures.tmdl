/// CST-003 Measures (Customer Lifetime Value Analysis)
table _Measures

    /// crm.clv.amount - CLV (Customer Lifetime Value)
    /// Discounted gross margin per customer over the analysis horizon.
    measure 'CLV (Customer Lifetime Value)' =
            SUM(fact_customer_transactions[Margin Amount])
        formatString: "€ #,0"

    /// crm.active_customers_start.count - Active Customers Start
    /// Number of active customers at the beginning of the period.
    measure 'Active Customers Start' =
            CALCULATE(
                DISTINCTCOUNT(dim_customer[CustomerID]),
                dim_period[IsStartOfPeriod] = TRUE()
            )
        formatString: "0"

    /// crm.active_customers_end.count - Active Customers End
    /// Number of active customers at the end of the period.
    measure 'Active Customers End' =
            CALCULATE(
                DISTINCTCOUNT(dim_customer[CustomerID]),
                dim_period[IsEndOfPeriod] = TRUE()
            )
        formatString: "0"

    /// crm.churned_customers.count - Lost Customers Count
    /// Number of customers that became inactive in the current period.
    measure 'Lost Customers Count' =
            CALCULATE(
                DISTINCTCOUNT(dim_customer[CustomerID]),
                fact_customer_transactions[Status] = "Lost"
            )
        formatString: "0"

    /// crm.reactivated_customers.count - Reactivated Customers Count
    /// Number of previously lost customers that became active again.
    measure 'Reactivated Customers Count' =
            CALCULATE(
                DISTINCTCOUNT(dim_customer[CustomerID]),
                fact_customer_transactions[Reactivated Flag] = TRUE()
            )
        formatString: "0"

    /// crm.at_risk_customers.count - At-Risk Customers Count
    /// Number of customers flagged as at-risk by the churn scoring model.
    measure 'At-Risk Customers Count' =
            CALCULATE(
                DISTINCTCOUNT(dim_customer[CustomerID]),
                fact_customer_transactions[At-Risk Flag] = TRUE()
            )
        formatString: "0"

    /// crm.active_customers.count - Active Customers
    /// Number of active customers in the selected period.
    measure 'Active Customers' =
            DISTINCTCOUNT(dim_customer[CustomerID])
        formatString: "0"

    /// crm.retention.pct - Customer Retention %
    /// Share of customers that remain active from one period to the next.
    measure 'Retention %' =
            DIVIDE([Active Customers End],[Active Customers Start])
        formatString: "0.0 %"

    /// crm.churn.pct - Churn %
    /// Customer churn rate as complement of retention.
    measure 'Churn %' =
            1 - [Retention %]
        formatString: "0.0 %"

    /// crm.reactivation.pct - Reactivation Rate %
    /// Share of previously lost customers that became active again.
    measure 'Reactivation Rate %' =
            DIVIDE([Reactivated Customers Count],[Lost Customers Count])
        formatString: "0.0 %"

    /// crm.at_risk_share.pct - At-Risk Share %
    /// Share of active customers currently flagged as at risk.
    measure 'At-Risk Share %' =
            DIVIDE([At-Risk Customers Count],[Active Customers])
        formatString: "0.0 %"


