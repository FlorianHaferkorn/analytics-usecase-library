/// OPS-005 Measures (Capacity Utilization)
table _Measures

    /// Supporting: Planned Hours
    /// Total planned production hours.
    measure 'Planned Hours' =
            SUM(fact_production[PlannedHours])
        formatString: "#,0.0"
        displayFolder: "01_Capacity"

    /// Supporting: Downtime Hours
    /// Total downtime hours.
    measure 'Downtime Hours' =
            SUM(fact_production[DowntimeHours])
        formatString: "#,0.0"
        displayFolder: "01_Capacity"

    /// Supporting: Operating Hours
    /// Planned hours minus downtime.
    measure 'Operating Hours' =
            [Planned Hours] - [Downtime Hours]
        formatString: "#,0.0"
        displayFolder: "01_Capacity"

    /// Supporting: Produced Units
    /// Total produced units.
    measure 'Produced Units' =
            SUM(fact_production[OutputUnits])
        formatString: "#,0"
        displayFolder: "01_Capacity"

    /// Supporting: Good Units
    /// Good units without quality losses.
    measure 'Good Units' =
            SUM(fact_production[GoodUnits])
        formatString: "#,0"
        displayFolder: "01_Capacity"

    /// ops.availability.pct - Availability %
    /// Share of planned time where the line is running.
    measure 'Availability %' =
            DIVIDE([Operating Hours],[Planned Hours])
        formatString: "0.0 %"
        displayFolder: "01_Capacity"

    /// ops.performance.pct - Performance %
    /// Speed factor versus ideal cycle time.
    measure 'Performance %' =
            VAR _idealTime =
                SUMX(
                    fact_production,
                    fact_production[OutputUnits] * fact_production[IdealCycleTime]
                )
            RETURN DIVIDE(_idealTime,[Operating Hours])
        formatString: "0.0 %"
        displayFolder: "01_Capacity"

    /// ops.quality.pct - Quality %
    /// Share of good units in total units produced.
    measure 'Quality %' =
            DIVIDE([Good Units],[Produced Units])
        formatString: "0.0 %"
        displayFolder: "01_Capacity"

    /// ops.machine_downtime.pct - Downtime % of Planned
    /// Downtime as a share of planned hours.
    measure 'Downtime % of Planned' =
            DIVIDE([Downtime Hours],[Planned Hours])
        formatString: "0.0 %"
        displayFolder: "01_Capacity"

    /// ops.oee.pct - OEE %
    /// Overall Equipment Effectiveness (Availability x Performance x Quality).
    measure 'OEE %' =
            [Availability %] * [Performance %] * [Quality %]
        formatString: "0.0 %"
        displayFolder: "01_Capacity"

