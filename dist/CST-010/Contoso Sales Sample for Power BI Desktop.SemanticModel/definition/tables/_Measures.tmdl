/// CST-010 Measures (Acquisition Funnel Performance)
table _Measures

    /// crm.acquisition.leads.count - Leads Count
    /// Measure the number of new leads generated in the funnel.
    measure 'Leads Count' =
            BLANK()
        formatString: "#,0"
        displayFolder: "07_Acquisition"

    /// crm.acquisition.conversions.count - Acquisition Conversions Count
    /// Measure how many leads convert to new customers or deals.
    measure 'New Customers Acquired' =
            BLANK()
        formatString: "#,0"
        displayFolder: "07_Acquisition"

    /// crm.acquisition.conversion_rate.pct - Acquisition Conversion Rate %
    /// Measure how efficiently leads convert into new customers or opportunities.
    measure 'Conversion Rate %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "07_Acquisition"

    /// crm.acquisition.cac.amount - Customer Acquisition Cost (CAC) Amount
    /// Measure average marketing and sales cost per new acquired customer.
    measure 'Customer Acquisition Cost (CAC)' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "07_Acquisition"
