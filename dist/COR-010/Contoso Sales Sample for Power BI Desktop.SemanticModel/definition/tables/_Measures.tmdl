/// COR-010 Measures (Enterprise Performance Cockpit)
table _Measures

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// sales.revenue.growth_pct - Revenue Growth %
    /// Measures top-line expansion versus Plan and Last Year.
    measure 'Revenue Growth %' =
            DIVIDE([Δ Net Sales Amount],[Net Sales Amount LY])
        formatString: "0.0 %"

    /// margin.gm.pct - Gross Margin % (Operational)
    /// Provide the Gross Margin % used in commercial and management reporting at the same granularity as Net Sales.
    measure 'Gross Margin %' =
            DIVIDE([Net Sales Amount]-[COGS Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// profit.ebitda_margin - EBITDA Margin %
    /// Shows earnings before interest, taxes, depreciation, and amortization as a share of revenue.
    measure 'EBITDA Margin %' =
            DIVIDE([EBITDA Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// fin.liquidity.working_capital - Working Capital %
    /// Share of capital tied up in operations relative to sales.
    measure 'Working Capital %' =
            DIVIDE([Receivables Amount]+[Inventory Amount]-[Payables Amount],[Net Sales Amount])
        formatString: "0.0 %"

    /// ops.working_capital.ccc.days - Cash Conversion Cycle (Days)
    /// Combines receivables, inventory, and payables days to show cash efficiency.
    measure 'Cash Conversion Cycle (Days)' =
            [DSO (Days)] + [DIO (Days)] - [DPO (Days)]
        formatString: "0"
        displayFolder: "02_WorkingCapital"

    /// ops.inventory.turnover - Inventory Turnover
    /// Measures how often inventory is sold and replaced over a period to assess stock efficiency.
    measure 'Inventory Turnover' =
            BLANK()
        formatString: "0.00"

    /// ops.inventory.days - Inventory Days
    /// Average number of days current inventory covers sales (on-hand duration).
    measure 'Inventory Days on Hand (DIO)' =
            BLANK()
        formatString: "0"

    /// crm.retention.pct - Customer Retention %
    /// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
    measure 'Customer Retention %' =
            DIVIDE([Active Customers End],[Active Customers Start])
        formatString: "0.0 %"

    /// crm.clv.amount - CLV (Customer Lifetime Value)
    /// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
    measure 'Customer Lifetime Value (CLV) Amount' =
            BLANK()
        formatString: "EUR #,0.00"

    /// hr.revenue_per_fte.amount - Revenue per FTE
    /// Measure how much revenue is generated per full-time equivalent to assess workforce productivity.
    measure 'Revenue per FTE Amount' =
            DIVIDE([Revenue Amount],[Average FTE])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// hr.turnover.pct - Turnover Rate %
    /// Measure the share of employees leaving the organization over a period to assess retention risk.
    measure 'Employee Turnover %' =
            DIVIDE([Exits Count],[Average Headcount])
        formatString: "0.0 %"
        displayFolder: "COR Workforce"

    /// esg.aligned_revenue.pct - ESG-Aligned Revenue %
    /// Tracks portion of revenue classified as environmentally sustainable.
    measure 'ESG-Aligned Revenue %' =
            DIVIDE([ESG-Aligned Revenue Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "01_Strategy"

    /// esg.co2.total.tco2e - Total CO2 Emissions (tCO2e)
    /// Track total greenhouse gas emissions (CO2e) as core input for climate targets and disclosures.
    measure 'Total COâ‚‚ Emissions (tCO2e)' =
            BLANK()
        formatString: "#,0"
