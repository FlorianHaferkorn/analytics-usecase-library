/// ESG-002 Measures (Energy Efficiency Optimization)
table _Measures

    /// esg.energy.renewable_kwh - Renewable Energy (kWh)
    /// Renewable energy consumption in kWh.
    measure 'Renewable Energy (kWh)' =
            SUM(fact_energy[Renewable_kWh])
        formatString: "#,0"
        displayFolder: "01_Energy"

    /// esg.energy.total_kwh - Total Energy (kWh)
    /// Total energy consumption in kWh.
    measure 'Total Energy (kWh)' =
            SUM(fact_energy[Total_kWh])
        formatString: "#,0"
        displayFolder: "01_Energy"

    /// Supporting: Energy Cost Amount
    /// Total energy cost.
    measure 'Energy Cost Amount' =
            SUM(fact_energy[EnergyCostAmount])
        formatString: "€ #,0.00"
        displayFolder: "01_Energy"

    /// Renewable Energy Share %
    /// Share of renewable energy in total consumption.
    measure 'Renewable Energy Share %' =
            DIVIDE([Renewable Energy (kWh)],[Total Energy (kWh)])
        formatString: "0.0 %"
        displayFolder: "01_Energy"

