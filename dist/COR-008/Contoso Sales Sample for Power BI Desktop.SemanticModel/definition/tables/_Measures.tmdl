/// COR-008 Measures (Cybersecurity Incident Monitoring)
table _Measures

    /// sec.incident.count - Security Incidents Count
    /// Measure the number of detected cybersecurity or information security incidents.
    measure 'Cybersecurity Incident Count' =
            BLANK()
        formatString: "#,0"
        displayFolder: "01_Security"

    /// sec.incident.critical.count - Critical Security Incidents Count
    /// Highlight the number of high or critical severity security incidents.
    measure 'Critical Incidents Count' =
            BLANK()
        formatString: "#,0"
        displayFolder: "01_Security"

    /// sec.incident.mttr.hours - Security Incident MTTR (Hours)
    /// Measure average time to resolve security incidents.
    measure 'Mean Time to Resolve (MTTR) Hours' =
            BLANK()
        formatString: "0.0"
        displayFolder: "01_Security"
