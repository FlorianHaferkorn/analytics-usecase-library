/// CST-005 Measures (NPS Analysis)
table _Measures

    /// Supporting: Responses Count
    /// Total number of NPS survey responses.
    measure 'Responses Count' =
            COUNTROWS(fact_nps_survey)
        formatString: "#,0"
        displayFolder: "01_NPS"

    /// Supporting: Promoters Count
    /// Number of responses with score 9-10.
    measure 'Promoters Count' =
            COUNTROWS(FILTER(fact_nps_survey, fact_nps_survey[Score] >= 9))
        formatString: "#,0"
        displayFolder: "01_NPS"

    /// Supporting: Passives Count
    /// Number of responses with score 7-8.
    measure 'Passives Count' =
            COUNTROWS(FILTER(fact_nps_survey, fact_nps_survey[Score] >= 7 && fact_nps_survey[Score] <= 8))
        formatString: "#,0"
        displayFolder: "01_NPS"

    /// Supporting: Detractors Count
    /// Number of responses with score 0-6.
    measure 'Detractors Count' =
            COUNTROWS(FILTER(fact_nps_survey, fact_nps_survey[Score] <= 6))
        formatString: "#,0"
        displayFolder: "01_NPS"

    /// crm.nps.index - NPS Index
    /// Net Promoter Score based on promoter and detractor shares.
    measure 'NPS Index' =
            VAR _resp = [Responses Count]
            VAR _prom = [Promoters Count]
            VAR _det  = [Detractors Count]
            RETURN
                IF(_resp = 0, BLANK(), DIVIDE(_prom - _det, _resp) * 100)
        formatString: "0.0"
        displayFolder: "01_NPS"

