/// OPS-002 Measures (Inventory Health & Stock-Out Prevention)
table _Measures

    /// ops.inventory.days - Inventory Days
    /// Average number of days current inventory covers sales (on-hand duration).
    measure 'Inventory Days' =
            VAR _inventory =
                SUM(fact_inventory_snapshot[Inventory Value])
            VAR _cogs =
                SUM(fact_sales[COGS Amount])
            RETURN
                IF(
                    _cogs = 0,
                    BLANK(),
                    DIVIDE(_inventory,_cogs) * 365
                )
        formatString: "0"

    /// ops.stockout.pct - Stock-Out Rate %
    /// Share of demand not fulfilled due to stock unavailability.
    measure 'Stock-Out Rate %' =
            VAR _demand =
                SUM(fact_inventory_snapshot[Demand Qty])
            VAR _delivered =
                SUM(fact_inventory_snapshot[Delivered Qty])
            VAR _unfulfilled =
                MAX(_demand - _delivered, 0)
            RETURN
                IF(
                    _demand = 0,
                    BLANK(),
                    DIVIDE(_unfulfilled,_demand)
                )
        formatString: "0.0 %"

    /// ops.inventory.turnover - Inventory Turnover
    /// Measures how often inventory is sold and replaced over a period to assess stock efficiency.
    measure 'Inventory Turnover' =
            VAR _cogs =
                SUM(fact_sales[COGS Amount])
            VAR _avgInventory =
                AVERAGE(fact_inventory_snapshot[Inventory Value])
            RETURN
                IF(
                    _avgInventory = 0,
                    BLANK(),
                    DIVIDE(_cogs,_avgInventory)
                )
        formatString: "0.00"

    /// ops.inventory.obsolescence.pct - Obsolescence %
    /// Share of inventory considered obsolete or blocked.
    measure 'Obsolescence %' =
            VAR _obsolete =
                SUM(fact_inventory_snapshot[Obsolete Inventory Value])
            VAR _totalInventory =
                SUM(fact_inventory_snapshot[Inventory Value])
            RETURN
                IF(
                    _totalInventory = 0,
                    BLANK(),
                    DIVIDE(_obsolete,_totalInventory)
                )
        formatString: "0.0 %"

    /// ops.otif.pct - OTIF %
    /// Delivery reliability measured by orders delivered on-time and in-full.
    measure 'OTIF %' =
            VAR _demand =
                SUM(fact_inventory_snapshot[Demand Qty])
            VAR _delivered =
                SUM(fact_inventory_snapshot[Delivered Qty])
            RETURN
                IF(
                    _demand = 0,
                    BLANK(),
                    DIVIDE(_delivered,_demand)
                )
        formatString: "0.0 %"

