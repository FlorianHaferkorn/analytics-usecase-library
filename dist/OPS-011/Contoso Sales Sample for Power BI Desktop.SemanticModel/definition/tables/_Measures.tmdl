/// OPS-011 Measures (Warehouse Productivity & Picking Efficiency)
table _Measures

    /// ops.warehouse.lines_per_hour - Warehouse Lines per Hour
    /// Measure warehouse productivity in terms of processed order lines per working hour.
    measure 'Lines Picked per Hour' =
            BLANK()
        formatString: "0.0"
        displayFolder: "06_Warehouse"

    /// ops.warehouse.picks_per_hour - Picks per Hour
    /// Measure picking productivity per hour in the warehouse.
    measure 'Picks per Hour' =
            BLANK()
        formatString: "0.0"
        displayFolder: "06_Warehouse"

    /// ops.warehouse.cost_per_line.amount - Warehouse Cost per Line
    /// Measure warehouse operating cost per processed order line.
    measure 'Warehouse Cost per Order Line' =
            BLANK()
        formatString: "EUR #,0.000"
        displayFolder: "06_Warehouse"
