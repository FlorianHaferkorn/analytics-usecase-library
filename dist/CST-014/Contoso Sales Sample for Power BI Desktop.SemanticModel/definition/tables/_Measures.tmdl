/// CST-014 Measures (Subscription Churn & Next-Best-Action)
table _Measures

    /// crm.clv.amount - CLV (Customer Lifetime Value)
    /// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
    measure 'Customer Lifetime Value (CLV) Amount' =
            BLANK()
        formatString: "EUR #,0.00"

    /// crm.retention.pct - Customer Retention %
    /// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
    measure 'Customer Retention %' =
            DIVIDE([Active Customers End],[Active Customers Start])
        formatString: "0.0 %"

    /// crm.churn.pct - Customer Churn Rate %
    /// Measures proportion of customers lost during a period.
    measure 'Customer Churn Rate %' =
            DIVIDE([Churned Customers],[Active Customers Start])
