/// CST-008 Measures (Cross-Sell & Basket Analysis)
table _Measures

    /// crm.cross_sell_ratio.pct - Cross-Sell Ratio %
    /// Measure the share of customers buying more than one product category.
    measure 'Cross-Sell Ratio %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "06_CrossSell"

    /// crm.basket_size.amount - Average Basket Value
    /// Measure the average monetary value of a transaction or order.
    measure 'Average Basket Value' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "06_CrossSell"

    /// crm.basket_size.units - Average Basket Units
    /// Measure the average number of units per order.
    measure 'Average Basket Units' =
            BLANK()
        formatString: "0.0"
        displayFolder: "06_CrossSell"
