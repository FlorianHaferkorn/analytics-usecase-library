/// COR-002 Measures (Workforce Productivity & Turnover Analysis)
table _Measures

    /// Supporting: Revenue Amount
    /// Total revenue for the workforce productivity view.
    measure 'Revenue Amount' =
            SUM(fact_financials[RevenueAmount])
        formatString: "€ #,0.00"
        displayFolder: "COR Workforce"

    /// Supporting: Gross Margin Amount
    /// Gross margin attributed to workforce.
    measure 'Gross Margin Amount' =
            SUM(fact_financials[GrossMarginAmount])
        formatString: "€ #,0.00"
        displayFolder: "COR Workforce"

    /// Supporting: Personnel Cost Amount
    /// Personnel cost over the analysis period.
    measure 'Personnel Cost Amount' =
            SUM(fact_hr_cost[PersonnelCost])
        formatString: "€ #,0.00"
        displayFolder: "COR Workforce"

    /// Supporting: Average FTE
    /// Average full-time equivalents over the period.
    measure 'Average FTE' =
            AVERAGE(fact_hr_headcount[FTEFactor])
        formatString: "#,0.0"
        displayFolder: "COR Workforce"

    /// Supporting: Average Headcount
    /// Average headcount over the period.
    measure 'Average Headcount' =
            DISTINCTCOUNT(fact_hr_headcount[EmployeeID])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// Supporting: Absent Hours
    /// Total absent hours recorded.
    measure 'Absent Hours' =
            SUM(fact_hr_headcount[AbsentHours])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// Supporting: Scheduled Hours
    /// Total scheduled working hours.
    measure 'Scheduled Hours' =
            SUM(fact_hr_headcount[ScheduledHours])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// Supporting: Exits Count
    /// Number of employee exits in the period.
    measure 'Exits Count' =
            COUNTROWS(
                FILTER(
                    fact_hr_headcount,
                    NOT ISBLANK(fact_hr_headcount[LeaveDate])
                )
            )
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// hr.revenue_per_fte.amount - Revenue per FTE
    /// Measure how much revenue is generated per full-time equivalent to assess workforce productivity.
    measure 'Revenue per FTE' =
            DIVIDE([Revenue Amount],[Average FTE])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// hr.gm_per_fte.amount - Gross Margin per FTE
    /// Show how much gross margin is generated per full-time equivalent, factoring both productivity and margin quality.
    measure 'Gross Margin per FTE' =
            DIVIDE([Gross Margin Amount],[Average FTE])
        formatString: "#,0"
        displayFolder: "COR Workforce"

    /// hr.personnel_cost_ratio.pct - Personnel Cost Ratio %
    /// Track personnel cost as a share of revenue to understand workforce cost efficiency.
    measure 'Personnel Cost Ratio %' =
            DIVIDE([Personnel Cost Amount],[Revenue Amount])
        formatString: "0.0 %"
        displayFolder: "COR Workforce"

    /// hr.turnover.pct - Turnover Rate %
    /// Measure the share of employees leaving the organization over a period to assess retention risk.
    measure 'Turnover Rate %' =
            DIVIDE([Exits Count],[Average Headcount])
        formatString: "0.0 %"
        displayFolder: "COR Workforce"

    /// hr.absenteeism.pct - Absenteeism %
    /// Monitor absence behavior as an early indicator of engagement, wellbeing, and operational risk.
    measure 'Absenteeism %' =
            DIVIDE([Absent Hours],[Scheduled Hours])
        formatString: "0.0 %"
        displayFolder: "COR Workforce"

