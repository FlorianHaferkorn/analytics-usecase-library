/// CST-004 Measures (Campaign Effectiveness)
table _Measures

    /// Supporting: Campaign Spend Amount
    /// Total spend of the selected campaigns.
    measure 'Campaign Spend Amount' =
            SUM(fact_campaign[SpendAmount])
        formatString: "€ #,0.00"
        displayFolder: "01_Campaign"

    /// Supporting: Campaign Revenue Amount
    /// Revenue attributed to the selected campaigns.
    measure 'Campaign Revenue Amount' =
            SUM(fact_campaign[RevenueAmount])
        formatString: "€ #,0.00"
        displayFolder: "01_Campaign"

    /// Supporting: Responses Count
    /// Number of campaign responses.
    measure 'Responses Count' =
            COUNTROWS(FILTER(fact_campaign, fact_campaign[ResponseFlag] = TRUE()))
        formatString: "#,0"
        displayFolder: "01_Campaign"

    /// Supporting: Conversions Count
    /// Number of campaign conversions.
    measure 'Conversions Count' =
            COUNTROWS(FILTER(fact_campaign, fact_campaign[ConversionFlag] = TRUE()))
        formatString: "#,0"
        displayFolder: "01_Campaign"

    /// Campaign ROI % (alias auf sales.promo.roi.pct)
    /// Measures profitability of campaigns relative to spend.
    measure 'Campaign ROI %' =
            DIVIDE([Campaign Revenue Amount] - [Campaign Spend Amount],[Campaign Spend Amount])
        formatString: "0.0 %"
        displayFolder: "01_Campaign"

    /// Conversion Rate %
    /// Conversion share among all responses.
    measure 'Conversion Rate %' =
            DIVIDE([Conversions Count],[Responses Count])
        formatString: "0.0 %"
        displayFolder: "01_Campaign"

