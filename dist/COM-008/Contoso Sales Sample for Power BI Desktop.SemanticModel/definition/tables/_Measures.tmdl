/// COM-008 Measures (Sales Forecast Accuracy)
table _Measures

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Actual Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// sales.net_sales.amount.forecast - Forecast Net Sales Amount
    /// MISSING in KPI catalog: sales.net_sales.amount.forecast
    measure 'Forecast Net Sales Amount' =
            // TODO
            BLANK()

    /// sales.forecast.mape_pct - Forecast Accuracy (MAPE %)
    /// MISSING in KPI catalog: sales.forecast.mape_pct
    measure 'Forecast Accuracy (MAPE %)' =
            // TODO
            BLANK()

    /// sales.forecast.bias_pct - Forecast Bias %
    /// MISSING in KPI catalog: sales.forecast.bias_pct
    measure 'Forecast Bias %' =
            // TODO
            BLANK()
