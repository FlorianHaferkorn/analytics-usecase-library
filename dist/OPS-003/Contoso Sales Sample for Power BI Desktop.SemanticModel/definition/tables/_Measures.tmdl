/// OPS-003 Measures (Purchase Price Variance (PPV) & Supplier Performance)
table _Measures

    /// ops.ppv.pct - PPV %
    /// Relative variance between actual purchase price and contracted price.
    measure 'PPV %' =
            VAR _actualAmount =
                SUMX(
                    fact_purchase_orders,
                    fact_purchase_orders[Actual Unit Price] * fact_purchase_orders[Quantity]
                )
            VAR _contractAmount =
                SUMX(
                    fact_purchase_orders,
                    fact_purchase_orders[Contract Unit Price] * fact_purchase_orders[Quantity]
                )
            VAR _delta =
                _actualAmount - _contractAmount
            RETURN
                IF(
                    _contractAmount = 0,
                    BLANK(),
                    DIVIDE(_delta,_contractAmount)
                )
        formatString: "0.0 %"

    /// ops.ppv.amount - PPV Amount
    /// Absolute variance between actual price paid and contracted price for purchased quantity.
    measure 'PPV Amount' =
            VAR _actualAmount =
                SUMX(
                    fact_purchase_orders,
                    fact_purchase_orders[Actual Unit Price] * fact_purchase_orders[Quantity]
                )
            VAR _contractAmount =
                SUMX(
                    fact_purchase_orders,
                    fact_purchase_orders[Contract Unit Price] * fact_purchase_orders[Quantity]
                )
            RETURN
                _actualAmount - _contractAmount
        formatString: "€ #,0.00"

    /// ops.contract.compliance.pct - Contract Compliance %
    /// Share of purchases placed at contracted terms (price/conditions).
    measure 'Contract Compliance %' =
            VAR _totalLines =
                COUNTROWS(fact_purchase_orders)
            VAR _compliantLines =
                COUNTROWS(
                    FILTER(
                        fact_purchase_orders,
                        NOT ISBLANK(fact_purchase_orders[Contract Unit Price])
                            && fact_purchase_orders[Actual Unit Price] = fact_purchase_orders[Contract Unit Price]
                    )
                )
            RETURN
                IF(
                    _totalLines = 0,
                    BLANK(),
                    DIVIDE(_compliantLines,_totalLines)
                )
        formatString: "0.0 %"

    /// ops.otif.pct - OTIF %
    /// Delivery reliability measured by orders delivered on-time and in-full.
    measure 'OTIF %' =
            DIVIDE([OTIF Deliveries Count],[Total Deliveries Count])
        formatString: "0.0 %"


