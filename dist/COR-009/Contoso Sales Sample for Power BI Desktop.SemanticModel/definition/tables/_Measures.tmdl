/// COR-009 Measures (Investment & CapEx Tracking)
table _Measures

    /// fin.liquidity.capex.amount - CapEx Amount
    /// Track capital expenditures as part of liquidity and investment planning.
    measure 'CapEx Amount' =
            BLANK()
        formatString: "EUR #,0.00"

    /// fin.liquidity.capex_ratio.pct - CapEx to Net Sales Ratio %
    /// Measure investment intensity relative to company size.
    measure 'CapEx Ratio %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "02_Investments"

    /// fin.liquidity.operating_cash_flow - Operating Cash Flow
    /// Measure cash generated from core operations as basis for liquidity steering.
    measure 'Operating Cash Flow Amount' =
            BLANK()
        formatString: "EUR #,0.00"
