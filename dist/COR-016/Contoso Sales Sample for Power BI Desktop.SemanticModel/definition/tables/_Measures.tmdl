/// COR-016 Measures (Credit Risk Scorecard (PD/LGD/EAD))
table _Measures

    /// fin.risk.pd.pct - Probability of Default (PD) %
    /// Measure the probability that a counterparty or exposure defaults within a defined time horizon.
    measure 'Probability of Default (PD) %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "06_Risk\\Credit Risk"

    /// fin.risk.lgd.pct - Loss Given Default (LGD) %
    /// Estimate the percentage loss on an exposure if a default occurs.
    measure 'Loss Given Default (LGD) %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "06_Risk\\Credit Risk"

    /// fin.risk.ead.amount - Exposure at Default (EAD) Amount
    /// Measure the outstanding exposure amount expected at the time of default.
    measure 'Exposure at Default (EAD) Amount' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "06_Risk\\Credit Risk"
