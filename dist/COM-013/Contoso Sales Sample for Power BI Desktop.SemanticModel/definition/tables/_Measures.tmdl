/// COM-013 Measures (Assortment Efficiency & SKU Productivity)
table _Measures

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// margin.gm.pct - Gross Margin % (Operational)
    /// Provide the Gross Margin % used in commercial and management reporting at the same granularity as Net Sales.
    measure 'Gross Margin %' =
            DIVIDE([Net Sales Amount]-[COGS Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// ops.inventory.turnover - Inventory Turnover
    /// Measures how often inventory is sold and replaced over a period to assess stock efficiency.
    measure 'Inventory Turnover' =
            BLANK()
        formatString: "0.00"

    /// ops.inventory.days - Inventory Days
    /// Average number of days current inventory covers sales (on-hand duration).
    measure 'Inventory Days on Hand (DIO)' =
            BLANK()
        formatString: "0"

    /// sales.customer.revenue_share.pct - Customer Revenue Share %
    /// Show what share of total revenue is contributed by a given customer or segment.
    measure 'Customer Revenue Share %' =
            VAR _total = CALCULATE([Net Sales Amount], ALL(dim_customer)) RETURN DIVIDE([Net Sales Amount], _total)
        formatString: "0.0 %"
        displayFolder: "03_Customer"
