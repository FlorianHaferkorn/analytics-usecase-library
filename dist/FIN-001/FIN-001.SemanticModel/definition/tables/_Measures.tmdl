/// FIN-001 Measures
table _Measures

    /// fin.cash.balance - Cash Balance
    /// Tracks cash and cash equivalents at period end.
    measure 'Cash Balance' =
            BLANK()
        formatString: "#,0.00"

    /// fin.cash.ocf - Operating Cash Flow
    /// Measures cash generated by operating activities.
    measure 'Operating Cash Flow' =
            BLANK()
        formatString: "#,0.00"

    /// fin.cash.vs_plan.pct - Cash vs Plan %
    /// Measures deviation of cash balance versus plan.
    measure 'Cash vs Plan %' =
            BLANK()
        formatString: "0.0%"

    /// wc.ccc.days - CCC Days
    /// Measures cash conversion cycle length.
    measure 'CCC Days' =
            BLANK()
        formatString: "0"

    /// wc.dso.days - DSO Days
    /// Measures days sales outstanding for receivables.
    measure 'DSO Days' =
            BLANK()
        formatString: "0"

    /// wc.dio.days - DIO Days
    /// Measures days inventory outstanding.
    measure 'DIO Days' =
            BLANK()
        formatString: "0"

    /// wc.dpo.days - DPO Days
    /// Measures days payables outstanding.
    measure 'DPO Days' =
            BLANK()
        formatString: "0"
