table Stores

	column StoreKey
		dataType: double
		summarizeBy: sum
		sourceColumn: StoreKey

	column GeographyKey
		dataType: double
		summarizeBy: sum
		sourceColumn: GeographyKey

	column StoreType
		dataType: string
		summarizeBy: none
		sourceColumn: StoreType

	column StoreName
		dataType: string
		summarizeBy: none
		sourceColumn: StoreName

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	column CloseReason
		dataType: string
		summarizeBy: none
		sourceColumn: CloseReason

	column EmployeeCount
		dataType: double
		summarizeBy: sum
		sourceColumn: EmployeeCount

	column SellingAreaSize
		dataType: double
		summarizeBy: sum
		sourceColumn: SellingAreaSize

	partition Stores_Demo = m
		mode: import
		source = ```
				let
				    Source = #table({"StoreKey","GeographyKey","StoreType","StoreName","Status","CloseReason","EmployeeCount","SellingAreaSize"}, {
				        { 10.0, 1.0, "Retail", "Berlin Mitte", "Open", "", 25.0, 800.0 },
				        { 20.0, 2.0, "Retail", "Munich City", "Open", "", 30.0, 900.0 }
				    })
				in
				    Source
				```
