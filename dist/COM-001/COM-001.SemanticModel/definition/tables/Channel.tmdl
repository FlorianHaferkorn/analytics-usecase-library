table Channel

	column Channel
		dataType: int64
		summarizeBy: sum
		sourceColumn: Channel

	column ChannelName
		dataType: string
		summarizeBy: none
		sourceColumn: ChannelName

	partition Channel_Demo = m
		mode: import
		source = ```
				let
				    Source = #table({"Channel","ChannelName"}, {
				        { 1, "Online" },
				        { 2, "Store" }
				    })
				in
				    Source
				```
