/// COM-001 Measures (Sales Performance vs Plan & Last Year)
table _Measures

    /// sales.net_sales.amount - Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// Supporting: Net Sales Amount LY
    /// Net Sales Amount for the corresponding period last year.
    measure 'Net Sales Amount LY' =
            CALCULATE(
                [Net Sales Amount],
                SAMEPERIODLASTYEAR('Date'[Date])
            )
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// sales.net_sales.delta_amount.ly - Î” Net Sales Amount
    /// Absolute variance of Net Sales vs Last Year.
    measure 'Î” Net Sales Amount' =
            [Net Sales Amount] - [Net Sales Amount LY]
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// sales.net_sales.delta_pct.ly - Î”% Net Sales
    /// Relative variance of Net Sales vs Last Year.
    measure 'Î”% Net Sales' =
            DIVIDE([Î” Net Sales Amount],[Net Sales Amount LY])
        formatString: "0.0 %"
        displayFolder: "01_Sales"

    /// Supporting: List Price Amount
    /// Total list price value of invoiced units.
    measure 'List Price Amount' =
            SUM(fact_sales[List Price Amount])
        formatString: "€ #,0.00"
        displayFolder: "03_Price_Promo"

    /// Supporting: Promo Sales Amount
    /// Net Sales Amount during periods flagged as promotion.
    measure 'Promo Sales Amount' =
            CALCULATE(
                [Net Sales Amount],
                fact_sales[Promo Flag] = TRUE()
            )
        formatString: "€ #,0.00"
        displayFolder: "03_Price_Promo"

    /// Supporting: Baseline Sales Amount
    /// Net Sales Amount during periods without promotion, used as baseline.
    measure 'Baseline Sales Amount' =
            CALCULATE(
                [Net Sales Amount],
                fact_sales[Promo Flag] = FALSE()
            )
        formatString: "€ #,0.00"
        displayFolder: "03_Price_Promo"

    /// sales.price.realization_pct - Price Realization %
    /// Shows how much of list price is realized after discounts.
    measure 'Price Realization %' =
            DIVIDE([Net Sales Amount],[List Price Amount])
        formatString: "0.0 %"
        displayFolder: "03_Price_Promo"

    /// sales.promo.uplift_pct - Promo Uplift %
    /// Measure incremental sales impact of promotions versus baseline demand.
    measure 'Promo Uplift %' =
            DIVIDE([Promo Sales Amount]-[Baseline Sales Amount],[Baseline Sales Amount])
        formatString: "0.0 %"
        displayFolder: "01_Sales"

    /// sales.pvm.price_effect.amount - Price Effect Amount
    /// Quantifies the pure price impact in the PVM bridge.
    measure 'Price Effect Amount' =
            ([Actual Unit Price]-[Plan Unit Price]) * [Actual Units Qty]
        formatString: "€ #,0.00"
        displayFolder: "04_PVM"

    /// sales.pvm.volume_effect.amount - Volume Effect Amount
    /// Measures the variance caused purely by quantity changes at plan price.
    measure 'Volume Effect Amount' =
            ([Actual Units Qty]-[Plan Units Qty]) * [Plan Unit Price]
        formatString: "€ #,0.00"
        displayFolder: "04_PVM"

    /// sales.pvm.mix_effect.amount - Mix Effect Amount
    /// Captures the residual effect from changes in product, channel, or region mix.
    measure 'Mix Effect Amount' =
            [Î” Net Sales Amount] - [Price Effect Amount] - [Volume Effect Amount]
        formatString: "€ #,0.00"
        displayFolder: "04_PVM"

    /// Supporting: COGS Amount
    /// Cost of goods sold directly linked to sales.
    measure 'COGS Amount' =
            SUM(fact_sales[COGS Amount])
        formatString: "€ #,0.00"
        displayFolder: "02_Margin"

    /// margin.gm.amount - Gross Margin Amount
    /// Absolute gross margin in currency.
    measure 'Gross Margin Amount' =
            [Net Sales Amount] - [COGS Amount]
        formatString: "€ #,0.00"
        displayFolder: "02_Margin"

    /// margin.gm.pct - Gross Margin %
    /// Gross margin as a percentage of Net Sales.
    measure 'Gross Margin %' =
            DIVIDE([Gross Margin Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"


