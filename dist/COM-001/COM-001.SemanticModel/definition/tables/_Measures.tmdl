/// COM-001 Measures (Sales Performance vs Plan & Last Year)
table _Measures

    /// Total invoiced sales excl. returns
    measure 'Net Sales Amount' =
            SUMX(Sales, Sales[UnitPrice] * Sales[SalesQuantity]) - SUM(Sales[ReturnAmount])
        formatString: "EUR #,0.00"
        displayFolder: "01_Sales"

    /// Net Sales for same period last year (demo)
    measure 'Net Sales Amount LY' =
            CALCULATE([Net Sales Amount], SAMEPERIODLASTYEAR(Calendar[DateKey]))
        formatString: "EUR #,0.00"
        displayFolder: "01_Sales"

    /// Absolute variance of Net Sales vs LY
    measure 'Δ Net Sales Amount' =
            [Net Sales Amount] - [Net Sales Amount LY]
        formatString: "EUR #,0.00"
        displayFolder: "01_Sales"

    /// Relative variance of Net Sales vs LY
    measure 'Δ% Net Sales' =
            DIVIDE([Δ Net Sales Amount], [Net Sales Amount LY])
        formatString: "0.0 %"
        displayFolder: "01_Sales"

    /// Cost of goods sold (demo)
    measure 'COGS Amount' =
            SUMX(Sales, Sales[UnitCost] * Sales[SalesQuantity])
        formatString: "EUR #,0.00"
        displayFolder: "02_Margin"

    /// Gross margin in currency
    measure 'Gross Margin Amount' =
            [Net Sales Amount] - [COGS Amount]
        formatString: "EUR #,0.00"
        displayFolder: "02_Margin"

    /// Gross margin share of net sales
    measure 'Gross Margin %' =
            DIVIDE([Gross Margin Amount], [Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// Placeholder until list price exists
    measure 'Price Realization %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "03_Price_Promo"

    /// Placeholder (promo base not modeled)
    measure 'Promo Uplift %' =
            BLANK()
        formatString: "0.0 %"
        displayFolder: "03_Price_Promo"

    /// Placeholder PVM price effect
    measure 'Price Effect Amount' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "04_PVM"

    /// Placeholder PVM volume effect
    measure 'Volume Effect Amount' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "04_PVM"

    /// Placeholder PVM mix effect
    measure 'Mix Effect Amount' =
            BLANK()
        formatString: "EUR #,0.00"
        displayFolder: "04_PVM"
