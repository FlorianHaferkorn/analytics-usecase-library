table Sales

	column SalesKey
		dataType: int64
		summarizeBy: sum
		sourceColumn: SalesKey

	column DateKey
		dataType: dateTime
		summarizeBy: none
		sourceColumn: DateKey

	column channelKey
		dataType: int64
		summarizeBy: sum
		sourceColumn: channelKey

	column StoreKey
		dataType: int64
		summarizeBy: sum
		sourceColumn: StoreKey

	column ProductKey
		dataType: int64
		summarizeBy: sum
		sourceColumn: ProductKey

	column PromotionKey
		dataType: int64
		summarizeBy: sum
		sourceColumn: PromotionKey

	column UnitCost
		dataType: double
		summarizeBy: sum
		sourceColumn: UnitCost

	column UnitPrice
		dataType: double
		summarizeBy: sum
		sourceColumn: UnitPrice

	column SalesQuantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: SalesQuantity

	column ReturnQuantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: ReturnQuantity

	column ReturnAmount
		dataType: double
		summarizeBy: sum
		sourceColumn: ReturnAmount

	column DiscountQuantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: DiscountQuantity

	column DiscountAmount
		dataType: double
		summarizeBy: sum
		sourceColumn: DiscountAmount

	column TotalCost
		dataType: double
		summarizeBy: sum
		sourceColumn: TotalCost

	column SalesAmount
		dataType: double
		summarizeBy: sum
		sourceColumn: SalesAmount

	partition Sales_Demo = m
		mode: import
		source = ```
				let
				    Source = #table({"SalesKey","DateKey","channelKey","StoreKey","ProductKey","PromotionKey","UnitCost","UnitPrice","SalesQuantity","ReturnQuantity","ReturnAmount","DiscountQuantity","DiscountAmount","TotalCost","SalesAmount"}, {
				        { 1, #date(2024,10,1), 1, 10, 100, 0, 5.0, 9.0, 100, 0, 0.0, 0, 0.0, 500.0, 900.0 },
				        { 2, #date(2025,10,1), 2, 20, 200, 0, 8.0, 12.0, 80, 0, 0.0, 0, 0.0, 400.0, 960.0 }
				    })
				in
				    Source
				```
