table Calendar

	column DateKey
		dataType: dateTime
		summarizeBy: none
		sourceColumn: DateKey

	column DateInt
		dataType: double
		summarizeBy: sum
		sourceColumn: DateInt

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	column DayOfWeekName
		dataType: string
		summarizeBy: none
		sourceColumn: DayOfWeekName

	column Year
		dataType: int64
		summarizeBy: sum
		sourceColumn: Year

	column QuarterOfYear
		dataType: int64
		summarizeBy: sum
		sourceColumn: QuarterOfYear

	column MonthOfYear
		dataType: int64
		summarizeBy: sum
		sourceColumn: MonthOfYear

	column DayOfMonth
		dataType: int64
		summarizeBy: sum
		sourceColumn: DayOfMonth

	partition Calendar_Demo = m
		mode: import
		source = ```
				let
				    Source = #table({"DateKey","DateInt","MonthName","DayOfWeekName","Year","QuarterOfYear","MonthOfYear","DayOfMonth"}, {
				        { #date(2024,10,1), 20241001.0, "October", "Tuesday", 2024, 4, 10, 1 },
				        { #date(2025,10,1), 20251001.0, "October", "Wednesday", 2025, 4, 10, 1 }
				    })
				in
				    Source
				```
