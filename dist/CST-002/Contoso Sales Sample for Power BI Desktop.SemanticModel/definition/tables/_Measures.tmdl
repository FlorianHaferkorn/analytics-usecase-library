/// CST-002 Measures (Product Lifecycle Performance)
table _Measures

    /// Supporting: Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: COGS Amount
    /// Cost of goods sold for invoiced products.
    measure 'COGS Amount' =
            SUM(fact_sales[COGS Amount])
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Promo Cost Amount
    /// Promotional cost allocated to invoice lines.
    measure 'Promo Cost Amount' =
            SUM(fact_sales[Promo Cost Amount])
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Marketing Cost Amount
    /// Marketing investments per product.
    measure 'Marketing Cost Amount' =
            SUM(fact_product_investment[MarketingCost])
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Development Cost Amount
    /// One-time development investments per product.
    measure 'Development Cost Amount' =
            SUM(fact_product_investment[DevelopmentCost])
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Revenue Amount
    /// Total revenue across all products and phases.
    measure 'Revenue Amount' =
            [Net Sales Amount]
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Revenue New Products
    /// Revenue from products launched in the recent period.
    measure 'Revenue New Products' =
            VAR _cutoff =
                EDATE(MAX(dim_date[Date]), -12)
            RETURN
                CALCULATE(
                    [Net Sales Amount],
                    dim_product[LaunchDate] >= _cutoff
                )
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Gross Margin Amount
    /// Gross margin after COGS for invoiced products.
    measure 'Gross Margin Amount' =
            [Net Sales Amount] - [COGS Amount]
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Revenue Total All Phases
    /// Revenue across all lifecycle phases, ignoring phase filter.
    measure 'Revenue Total All Phases' =
            CALCULATE(
                [Revenue Amount],
                ALL(fact_product_investment[LifecycleStage])
            )
        formatString: "€ #,0.00"
        displayFolder: "CST Product Lifecycle"

    /// Supporting: Launch Date (measure wrapper)
    /// Launch date of the product for lifecycle age calculation.
    measure 'Launch Date' =
            MIN(dim_product[LaunchDate])

    /// Supporting: Today Date (reporting date)
    /// Current reporting date used in lifecycle age calculation.
    measure 'Today Date' =
            MAX(dim_date[Date])

    /// prod.lifecycle.new_share.pct - New Product Share %
    /// Measure how much of total revenue is generated by recently launched products.
    measure 'New Product Share %' =
            DIVIDE([Revenue New Products],[Revenue Amount])
        formatString: "0.0 %"
        displayFolder: "CST Product Lifecycle"

    /// prod.contribution_margin.pct - Product Contribution Margin %
    /// Assess profitability of individual products after direct variable costs and promotional spend.
    measure 'Product Contribution Margin %' =
            VAR _ns = [Net Sales Amount] RETURN IF(_ns=0, BLANK(), DIVIDE([Net Sales Amount]-[COGS Amount]-[Promo Cost Amount]-[Marketing Cost Amount], _ns))
        formatString: "0.0 %"
        displayFolder: "CST Product Lifecycle"

    /// prod.lifecycle.age.months - Lifecycle Age (months)
    /// Track how long a product has been in the market to support lifecycle phase classification.
    measure 'Lifecycle Age (months)' =
            DATEDIFF([Launch Date],[Today Date],MONTH)
        formatString: "0"
        displayFolder: "CST Product Lifecycle"

    /// prod.roi.pct - Product ROI %
    /// Evaluate whether individual products generate sufficient return relative to their development and marketing investments.
    measure 'Product ROI %' =
            VAR _den = [Development Cost Amount] + [Marketing Cost Amount] RETURN IF(_den=0, BLANK(), DIVIDE([Gross Margin Amount]-_den,_den))
        formatString: "0.0 %"
        displayFolder: "CST Product Lifecycle"

    /// prod.lifecycle.phase_distribution.pct - Lifecycle Phase Distribution %
    /// Show revenue mix across lifecycle phases (Launch, Growth, Maturity, Decline, Phase-Out).
    measure 'Phase Distribution %' =
            DIVIDE([Revenue Amount],[Revenue Total All Phases])
        formatString: "0.0 %"
        displayFolder: "CST Product Lifecycle"

