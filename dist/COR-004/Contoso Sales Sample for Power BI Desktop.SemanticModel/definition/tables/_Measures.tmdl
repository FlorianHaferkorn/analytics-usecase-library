/// COR-004 Measures (Strategic KPI Dashboard (Enterprise Performance Overview))
table _Measures

    /// Supporting: Net Sales Amount
    /// Total invoiced revenue net of discounts and returns.
    measure 'Net Sales Amount' =
            SUM(fact_sales[Net Sales Amount])
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// Supporting: Net Sales Amount LY
    /// Net Sales Amount for the corresponding period last year.
    measure 'Net Sales Amount LY' =
            CALCULATE(
                [Net Sales Amount],
                SAMEPERIODLASTYEAR('Date'[Date])
            )
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// Supporting: Î” Net Sales Amount
    /// Absolute variance of Net Sales vs Last Year.
    measure 'Î” Net Sales Amount' =
            [Net Sales Amount] - [Net Sales Amount LY]
        formatString: "€ #,0.00"
        displayFolder: "01_Sales"

    /// sales.net_sales.delta_pct.ly - Î”% Net Sales
    /// Relative variance of Net Sales vs Last Year.
    measure 'Î”% Net Sales' =
            DIVIDE([Î” Net Sales Amount],[Net Sales Amount LY])
        formatString: "0.0 %"
        displayFolder: "01_Sales"

    /// Supporting: COGS Amount
    /// Cost of goods sold directly linked to sales.
    measure 'COGS Amount' =
            SUM(fact_sales[COGS Amount])
        formatString: "€ #,0.00"
        displayFolder: "02_Margin"

    /// Supporting: Gross Margin Amount
    /// Absolute gross margin in currency.
    measure 'Gross Margin Amount' =
            [Net Sales Amount] - [COGS Amount]
        formatString: "€ #,0.00"
        displayFolder: "02_Margin"

    /// margin.gm.pct - Gross Margin %
    /// Gross margin as a percentage of Net Sales.
    measure 'Gross Margin %' =
            DIVIDE([Gross Margin Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "02_Margin"

    /// ops.working_capital.ccc.days - Cash Conversion Cycle (Days)
    /// Combines receivables, inventory, and payables days to show cash efficiency.
    measure 'Cash Conversion Cycle (Days)' =
            [DSO (Days)] + [DIO (Days)] - [DPO (Days)]
        formatString: "0"
        displayFolder: "02_WorkingCapital"

    /// hr.turnover.pct - Turnover Rate %
    /// Measure the share of employees leaving the organization over a period to assess retention risk.
    measure 'Turnover Rate %' =
            DIVIDE([Exits Count],[Average Headcount])
        formatString: "0.0 %"
        displayFolder: "COR Workforce"

    /// esg.aligned_revenue.pct - ESG-Aligned Revenue %
    /// Tracks portion of revenue classified as environmentally sustainable.
    measure 'ESG-Aligned Revenue %' =
            DIVIDE([ESG-Aligned Revenue Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "01_Strategy"

    /// corp.project.roi.pct - Project ROI %
    /// Measures realized return of strategic initiatives.
    measure 'Project ROI %' =
            DIVIDE([Realized Benefit Amount]-[Total Project Cost Amount],[Total Project Cost Amount])
        formatString: "0.0 %"
        displayFolder: "01_Strategy"


