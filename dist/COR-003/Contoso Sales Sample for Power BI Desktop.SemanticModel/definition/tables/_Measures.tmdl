/// COR-003 Measures (ESG & Compliance Monitoring)
table _Measures

    /// esg.aligned_revenue.pct - ESG-Aligned Revenue %
    /// Tracks portion of revenue classified as environmentally sustainable.
    measure 'ESG-Aligned Revenue %' =
            DIVIDE([ESG-Aligned Revenue Amount],[Net Sales Amount])
        formatString: "0.0 %"
        displayFolder: "01_Strategy"

    /// esg.carbon_intensity.tco2e_per_revenue - Carbon Emission Intensity (tCO2 / Î” Revenue)
    /// Measures greenhouse gas emissions relative to revenue.
    measure 'Carbon Emission Intensity' =
            DIVIDE([Total COÃ¢â€šâ€š Emissions (tCO2)],[Net Sales Amount])
        formatString: "0.00"

    /// esg.co2.total.tco2e - Total CO2 Emissions (tCO2e)
    /// Track total greenhouse gas emissions (CO2e) as core input for climate targets and disclosures.
    measure 'Total CO2 Emissions' =
            SUM(fact_esg_emissions[EmissionTons])
        formatString: "#,0"

    /// gov.compliance.incidents.count - Compliance Incidents Count
    /// Counts all reported compliance incidents (open + closed).
    measure 'Compliance Incidents Count' =
            COUNTROWS(fact_compliance)
        formatString: "0"

    /// esg.ltifr.rate - Lost Time Injury Frequency Rate
    /// Measures safety incidents resulting in lost time per hours worked.
    measure 'Lost Time Injury Frequency Rate' =
            DIVIDE([Lost Time Injuries],[Hours Worked]) * 1000000
        formatString: "0.00"
        displayFolder: "02_Safety"

