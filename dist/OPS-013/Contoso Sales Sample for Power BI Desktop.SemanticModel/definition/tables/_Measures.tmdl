/// OPS-013 Measures (Predictive Maintenance & Auto-Dispatch)
table _Measures

    /// ops.oee.pct - Overall Equipment Effectiveness (OEE) %
    /// Measures manufacturing performance combining availability, performance, and quality.
    measure 'Overall Equipment Effectiveness (OEE) %' =
            [Availability %] * [Performance %] * [Quality %]
        formatString: "0.0 %"

    /// ops.availability.pct - Availability %
    /// Uptime share relative to planned production time.
    measure 'Availability %' =
            BLANK()
        formatString: "0.0 %"

    /// ops.downtime.hours - Downtime Hours
    /// Total duration of machine/line unavailability impacting production.
    measure 'Downtime Hours' =
            BLANK()
        formatString: "0.00"

    /// ops.machine_downtime.pct - Machine Downtime %
    /// Measures proportion of time equipment is not running.
    measure 'Machine Downtime %' =
            DIVIDE([Downtime Hours],[Planned Hours])
        formatString: "0.0 %"
