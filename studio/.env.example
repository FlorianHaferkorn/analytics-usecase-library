# Auth (NextAuth.js v5)
# Generate a secret: npx auth secret
AUTH_SECRET="change-me-in-production"

# AuthZ backend (ADR-0016 Option A). Default 'local' = imperative checkAccess.
# 'rebac' = in-process declarative ReBAC model (src/lib/authz/, self-hosted, no engine).
# Leave unset for 'local'. 'fga' (OpenFGA service) is an optional future scale-swap.
AUTHZ_BACKEND=""

# GitHub OAuth — OPT-IN ONLY (nicht der Default). Wird gesetzt → GitHub ist ein
# Produktions-Login = externer Social-IdP → muss ein freigegebener IdP sein (Daten
# verlassen die EU-self-hosted-Grenze). Default (leer) = kein Social-IdP. Prod-Ziel
# ist passwortloser Magic-Link (T5 A, aufgeschoben) — s. compliance/auth_stack_data_residency.md.
GITHUB_ID=""
GITHUB_SECRET=""

# ── AI Provider (set ONE of the following) ──────────────────────────────────
# Priority order: Google → Anthropic → OpenAI
# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=""

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=""

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
