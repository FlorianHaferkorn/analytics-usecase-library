{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "layer": [
    { "mark": { "type": "bar", "width": { "band": 0.1 } },
      "encoding": {
        "x": { "field": "month", "type": "ordinal", "axis": { "title": null, "labelAngle": 0 } },
        "y": { "field": "delta_pl_pct", "type": "quantitative", "axis": { "title": null, "format": "+.0%" } },
        "color": { "condition": { "test": "datum['delta_pl_pct'] < 0", "value": "#A4262C" }, "value": "#107C10" } } },
    { "mark": { "type": "rule", "color": "#586472" }, "encoding": { "y": { "datum": 0 } } },
    { "mark": { "type": "point", "shape": "circle", "filled": true, "color": "#0F2430", "size": 36, "opacity": 1 },
      "encoding": {
        "x": { "field": "month", "type": "ordinal" },
        "y": { "field": "delta_pl_pct", "type": "quantitative" } } }
  ]
}
