{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "calculate": "min(isValid(datum['gm']) ? datum['gm'] : 1e300, isValid(datum['gm_plan']) ? datum['gm_plan'] : 1e300, isValid(datum['gm_py']) ? datum['gm_py'] : 1e300, isValid(datum['gm_fc']) ? datum['gm_fc'] : 1e300)", "as": "_yu_z" },
    { "calculate": "max(isValid(datum['gm']) ? datum['gm'] : -1e300, isValid(datum['gm_plan']) ? datum['gm_plan'] : -1e300, isValid(datum['gm_py']) ? datum['gm_py'] : -1e300, isValid(datum['gm_fc']) ? datum['gm_fc'] : -1e300)", "as": "_yo_z" },
    { "joinaggregate": [ { "op": "min", "field": "_yu_z", "as": "_yu" }, { "op": "max", "field": "_yo_z", "as": "_yo" } ] },
    { "calculate": "min(datum._yu, isValid(44.1) ? 44.1 : 1e300, isValid(42.0) ? 42.0 : 1e300)", "as": "_ylo" },
    { "calculate": "max(datum._yo, isValid(44.1) ? 44.1 : -1e300, isValid(42.0) ? 42.0 : -1e300)", "as": "_yhi" },
    { "calculate": "max(abs(datum._yhi), abs(datum._ylo))", "as": "_ytop" },
    { "calculate": "datum._yhi > -1e299 && datum._ytop > 0 && datum._ytop < 1e299 && datum._yhi - datum._ylo < 0.25 * datum._ytop", "as": "_yangepasst" },
    { "calculate": "datum._yangepasst ? datum._ylo - max((datum._yhi - datum._ylo) * 0.1, datum._ytop * 0.01) : 0", "as": "_ybasis" }
  ],
  "encoding": { "x": { "field": "month", "type": "temporal", "axis": { "title": null } } },
  "layer": [
    { "mark": { "type": "rule", "opacity": 0, "strokeWidth": 0 }, "encoding": { "y": { "field": "_ybasis", "type": "quantitative" } } },
    { "mark": { "type": "line", "interpolate": "monotone", "color": "#8C8C8C", "strokeWidth": 1.25, "strokeCap": "round", "strokeJoin": "round" },
      "encoding": { "y": { "field": "gm_py", "type": "quantitative" } } },
    { "transform": [ { "filter": "isValid(datum['gm_py'])" }, { "window": [ { "op": "row_number", "as": "_q" } ], "sort": [ { "field": "month", "order": "ascending" } ] }, { "filter": "datum._q == 1" } ],
      "mark": { "type": "text", "text": "PY", "align": "left", "dx": 4, "dy": 12, "color": "#8C8C8C" },
      "encoding": { "y": { "field": "gm_py", "type": "quantitative" } } },
    { "mark": { "type": "line", "interpolate": "monotone", "color": "#0F2430", "strokeWidth": 2, "strokeCap": "round", "strokeJoin": "round" },
      "encoding": { "y": { "field": "gm", "type": "quantitative", "scale": { "zero": false }, "axis": { "title": null, "domain": false, "ticks": false, "gridDash": [2, 4], "gridOpacity": 0.8 } } } },
    { "mark": { "type": "rule", "color": "#605E5C", "strokeWidth": 1, "strokeDash": [1, 4], "strokeCap": "round" },
      "encoding": { "y": { "datum": 44.1 } } },
    { "mark": { "type": "rule", "color": "#A4262C", "strokeWidth": 1, "strokeDash": [4, 2], "strokeCap": "round" },
      "encoding": { "y": { "datum": 42.0 } } },
    { "transform": [ { "window": [ { "op": "row_number", "as": "_a" } ] }, { "filter": "datum._a == 1" } ],
      "mark": { "type": "text", "text": "Alarm", "align": "left", "dx": 4, "dy": 10, "color": "#A4262C" },
      "encoding": { "x": { "value": 0 }, "y": { "datum": 42.0 } } },
    { "transform": [ { "filter": "datum._yangepasst" }, { "window": [ { "op": "row_number", "as": "_yb" } ] }, { "filter": "datum._yb == 1" } ],
      "mark": { "type": "text", "text": "≈", "fontSize": 14, "fontWeight": "bold", "color": "#605E5C", "align": "center", "baseline": "middle", "description": "Achse beginnt nicht bei null" },
      "encoding": { "x": { "value": 0 }, "y": { "value": { "expr": "height" } } } },
    { "mark": { "type": "line", "interpolate": "monotone", "color": "#605E5C", "strokeDash": [4, 4], "strokeWidth": 1.25, "strokeCap": "round", "strokeJoin": "round" },
      "encoding": { "y": { "field": "gm_plan", "type": "quantitative" } } },
    { "mark": { "type": "line", "interpolate": "monotone", "color": "#0F2430", "strokeDash": [1, 4], "strokeWidth": 1.75, "strokeCap": "round" },
      "encoding": { "y": { "field": "gm_fc", "type": "quantitative" } } },
    { "transform": [ { "window": [ { "op": "row_number", "as": "_p" } ], "sort": [ { "field": "month", "order": "ascending" } ] }, { "filter": "datum._p == 1" } ],
      "mark": { "type": "text", "text": "Plan", "align": "left", "dx": 4, "dy": -8, "color": "#605E5C" },
      "encoding": { "y": { "field": "gm_plan", "type": "quantitative" } } },
    { "transform": [ { "filter": "isValid(datum['gm'])" }, { "window": [ { "op": "row_number", "as": "_r" } ], "sort": [ { "field": "month", "order": "descending" } ] }, { "filter": "datum._r == 1" } ],
      "mark": { "type": "point", "shape": "circle", "filled": true, "size": 36, "color": "#F7630C" },
      "encoding": { "y": { "field": "gm", "type": "quantitative" } } },
    { "params": [ { "name": "hover", "select": { "type": "point", "fields": ["month"], "nearest": true, "on": "pointerover", "clear": "pointerout" } } ],
      "mark": { "type": "rule", "color": "#605E5C", "strokeWidth": 1 },
      "encoding": { "opacity": { "condition": { "param": "hover", "empty": false, "value": 0.5 }, "value": 0 } } },
    { "mark": { "type": "point", "shape": "circle", "filled": false, "fill": "transparent", "strokeWidth": 2, "size": 56, "color": "#0F2430" },
      "encoding": { "y": { "field": "gm", "type": "quantitative" },
                    "opacity": { "condition": { "param": "hover", "empty": false, "value": 1 }, "value": 0 } } },
    { "transform": [ { "filter": "isValid(datum['gm'])" }, { "window": [ { "op": "row_number", "as": "_r" } ], "sort": [ { "field": "month", "order": "descending" } ] }, { "filter": "datum._r == 1" } ],
      "mark": { "type": "text", "align": "right", "dx": -8, "dy": -10, "color": "#201F1E" },
      "encoding": { "y": { "field": "gm", "type": "quantitative" }, "text": { "field": "gm", "type": "quantitative", "format": ",.1~f" } } }
  ]
}
