{
  "idiom": "column_time",
  "profile": "ibcs",
  "notation": "ibcs",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "ordinal",
        "axis": {
          "title": null,
          "labelAngle": 0,
          "ticks": false,
          "domainColor": "#404040"
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "color": "#404040"
        },
        "encoding": {
          "y": {
            "field": "count",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "count",
              "type": "quantitative",
              "title": "count",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "dy": -6,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "count",
            "type": "quantitative"
          },
          "text": {
            "field": "count",
            "type": "quantitative",
            "format": ".0f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#404040",
      "labelColor": "#201F1E",
      "title": null,
      "labelFontSize": 11,
      "grid": false,
      "ticks": false
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333,
      "zero": true
    },
    "text": {
      "fontSize": 11
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    },
    "bar": {
      "cornerRadius": 0
    },
    "legend": {
      "disable": true
    }
  },
  "capabilities": {
    "disableCompactNumberFormatting": true,
    "disableLineChartCrosshairTooltip": true,
    "disableMinBarSize": true,
    "disableNiceAxisBounds": true,
    "disableStackedDataLabels": true,
    "disableTextTruncation": true
  }
}
