{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "joinaggregate": [ { "op": "count", "as": "_n" } ] },
    { "window": [ { "op": "sum", "field": "value", "as": "cum" } ], "frame": [null, 0] },
    { "calculate": "datum.cum - datum['value']", "as": "prev" }
  ],
  "encoding": {
    "x": { "field": "driver", "type": "ordinal", "sort": null, "axis": { "title": null, "labelAngle": 0 } }
  },
  "layer": [
    { "mark": { "type": "bar" },
      "encoding": {
      "y": { "field": "prev", "type": "quantitative", "axis": { "title": null }, "scale": { "padding": 16 } },
      "y2": { "field": "cum" },
      "color": { "condition": { "test": "datum['value'] < 0", "value": "#A4262C" }, "value": "#107C10" } } },
    { "mark": { "type": "text", "baseline": "bottom", "dy": { "expr": "datum['value'] < 0 ? 12 : -4" }, "color": "#201F1E" },
      "encoding": { "y": { "field": "cum", "type": "quantitative" }, "text": { "field": "value", "type": "quantitative", "format": "+,.1~f" }, "opacity": { "condition": { "test": "datum._n < 10", "value": 1 }, "value": 0 } } }
  ]
}
