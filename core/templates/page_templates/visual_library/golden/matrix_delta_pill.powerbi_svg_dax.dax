VAR _dlt = [Gross Margin % vs Plan]
VAR _col = IF ( _dlt < 0, "#A4262C", "#107C10" )
VAR _tint = IF ( _dlt < 0, "#FFE6E6", "#E6F5E6" )
VAR _dtxt = IF ( _dlt < 0, "▼ ", "▲ " ) & FORMAT ( _dlt, "+0.0%;-0.0%" )
RETURN
    IF ( HASONEVALUE ( 'dim_product'[Category] ),
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 20'>"
          & "<rect x='2' y='2' width='96' height='16' rx='8' fill='" & _tint & "'/>"
          & "<text x='50' y='14' text-anchor='middle' font-family='Segoe UI,sans-serif' font-size='11' font-weight='600' fill='" & _col & "'>" & _dtxt & "</text>"
          & "</svg>" )
