{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "mark": { "type": "area" },
  "encoding": {
    "x": { "field": "month", "type": "temporal", "axis": { "title": null } },
    "y": { "field": "sales", "type": "quantitative", "stack": "zero", "axis": { "title": null } },
    "color": { "field": "category", "type": "nominal", "scale": { "range": ["#0078D4", "#008575", "#EF6950"] }, "legend": { "title": null } }
  }
}
