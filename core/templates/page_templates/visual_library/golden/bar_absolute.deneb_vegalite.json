{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [ { "joinaggregate": [ { "op": "count", "as": "_n" } ] } ],
  "padding": { "right": 40 },
  "encoding": {
    "y": { "field": "unit", "type": "nominal", "sort": "-x", "axis": { "title": null } },
    "x": { "field": "net_sales", "type": "quantitative", "axis": { "title": null }, "scale": { "zero": true } }
  },
  "layer": [
    { "mark": { "type": "bar", "color": "#0F2430" } },
    { "mark": { "type": "text", "align": "left", "dx": 4, "color": "#201F1E" },
      "encoding": { "text": { "field": "net_sales", "type": "quantitative", "format": ",.1~f" }, "opacity": { "condition": { "test": "datum._n < 10", "value": 1 }, "value": 0 } } }
  ]
}
