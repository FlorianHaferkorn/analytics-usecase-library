{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "ticks": false,
        "domainColor": "#404040"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#404040"
      },
      "encoding": {
        "y": {
          "field": "count",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "zero": true
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -6,
        "color": "#201F1E"
      },
      "encoding": {
        "y": {
          "field": "count",
          "type": "quantitative"
        },
        "text": {
          "field": "count",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ]
}
