{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": { "right": 40 },
  "data": {
    "name": "dataset"
  },
  "transform": [
    { "calculate": "max(datum['gm'], isValid(datum['gm_py']) ? datum['gm_py'] : datum['gm'])", "as": "_lx" }
  ],
  "encoding": {
    "y": {
      "field": "unit",
      "type": "nominal",
      "sort": { "field": "gm", "order": "descending" },
      "axis": {
        "title": null,
        "ticks": false,
        "domainColor": "#404040"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#404040",
        "opacity": 0.5,
        "yOffset": -4
      },
      "encoding": {
        "x": {
          "field": "gm_py",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "zero": true
          }
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#404040",
        "yOffset": 2
      },
      "encoding": {
        "x": {
          "field": "gm",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "color": "#201F1E",
        "align": "left",
        "dx": 4,
        "yOffset": 2
      },
      "encoding": {
        "x": {
          "field": "_lx",
          "type": "quantitative"
        },
        "text": {
          "field": "gm",
          "type": "quantitative",
          "format": ",.1~f"
        }
      }
    }
  ]
}
