{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "calculate": "min(isValid(datum['gm']) ? datum['gm'] : 1e300)", "as": "_yu_z" },
    { "calculate": "max(isValid(datum['gm']) ? datum['gm'] : -1e300)", "as": "_yo_z" },
    { "joinaggregate": [ { "op": "min", "field": "_yu_z", "as": "_yu" }, { "op": "max", "field": "_yo_z", "as": "_yo" } ] },
    { "calculate": "min(datum._yu)", "as": "_ylo" },
    { "calculate": "max(datum._yo)", "as": "_yhi" },
    { "calculate": "max(abs(datum._yhi), abs(datum._ylo))", "as": "_ytop" },
    { "calculate": "datum._yhi > -1e299 && datum._ytop > 0 && datum._ytop < 1e299 && datum._yhi - datum._ylo < 0.25 * datum._ytop", "as": "_yangepasst" },
    { "calculate": "datum._yangepasst ? datum._ylo - max((datum._yhi - datum._ylo) * 0.1, datum._ytop * 0.01) : 0", "as": "_ybasis" }
  ],
  "encoding": {
    "x": { "field": "period", "type": "ordinal", "axis": { "title": null } },
    "y": { "field": "gm", "type": "quantitative", "scale": { "zero": false }, "axis": { "title": null } }
  },
  "layer": [
    { "mark": { "type": "rule", "opacity": 0, "strokeWidth": 0 }, "encoding": { "y": { "field": "_ybasis", "type": "quantitative" } } },
    { "mark": { "type": "line", "point": true },
      "encoding": { "color": { "field": "unit", "type": "nominal", "legend": null } } },
    { "transform": [ { "filter": "datum._yangepasst" }, { "window": [ { "op": "row_number", "as": "_yb" } ] }, { "filter": "datum._yb == 1" } ],
      "mark": { "type": "text", "text": "≈", "fontSize": 14, "fontWeight": "bold", "color": "#605E5C", "align": "center", "baseline": "middle", "description": "Achse beginnt nicht bei null" },
      "encoding": { "x": { "value": 0 }, "y": { "value": { "expr": "height" } } } }
  ]
}
