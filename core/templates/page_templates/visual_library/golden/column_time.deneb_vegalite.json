{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [ { "joinaggregate": [ { "op": "count", "as": "_n" } ] } ],
  "encoding": {
    "x": { "field": "month", "type": "ordinal", "axis": { "title": null, "labelAngle": 0 } },
    "y": { "field": "count", "type": "quantitative", "axis": { "title": null } }
  },
  "layer": [
    { "mark": { "type": "bar", "color": "#0078D4" } },
    { "mark": { "type": "text", "baseline": "bottom", "dy": -4, "color": "#201F1E" },
      "encoding": { "text": { "field": "count", "type": "quantitative", "format": ",.1~f" }, "opacity": { "condition": { "test": "datum._n < 10", "value": 1 }, "value": 0 } } }
  ]
}
