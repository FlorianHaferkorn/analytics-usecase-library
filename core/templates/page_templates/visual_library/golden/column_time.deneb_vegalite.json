{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "params": [ { "name": "_n_daten", "expr": "max(length(data('dataset')), length(data('source_0')))" }, { "name": "_beschriftet", "expr": "_n_daten > 0 && _n_daten < 10" } ],
  "transform": [
    { "calculate": "datum['laufend'] === true", "as": "_laufend" },
    { "window": [ { "op": "row_number", "as": "_rang" } ], "sort": [ { "field": "_laufend", "order": "ascending" }, { "field": "month", "order": "descending" } ] },
    { "calculate": "!datum._laufend && datum._rang == 1", "as": "_letzte" }
  ],
  "encoding": {
    "x": { "field": "month", "type": "ordinal", "axis": { "title": null, "labelAngle": 0 } },
    "y": { "field": "count", "type": "quantitative", "axis": { "title": null, "tickCount": { "expr": "_beschriftet ? 0 : ceil(height/40)" }, "domainOpacity": { "expr": "_beschriftet ? 0 : 1" } } }
  },
  "layer": [
    { "transform": [ { "filter": "!datum._laufend && !datum._letzte" } ],
      "mark": { "type": "bar", "width": { "expr": "min(bandwidth('x'), 24)" }, "fill": "#8C8C8C" } },
    { "transform": [ { "filter": "datum._letzte" } ],
      "mark": { "type": "bar", "width": { "expr": "min(bandwidth('x'), 24)" }, "fill": "#0F2430" } },
    { "transform": [ { "filter": { "field": "laufend", "equal": true } } ],
      "mark": { "type": "bar", "width": { "expr": "min(bandwidth('x'), 24)" }, "fill": "#FFFFFF", "stroke": "#0F2430", "strokeWidth": 1.5, "description": "laufende Periode" } },
    { "mark": { "type": "text", "baseline": "bottom", "dy": -4, "color": "#201F1E" },
      "encoding": { "text": { "field": "count", "type": "quantitative", "format": ",.1~f" }, "opacity": { "condition": { "test": "_beschriftet", "value": 1 }, "value": 0 } } },
    { "transform": [ { "filter": { "field": "laufend", "equal": true } } ],
      "mark": { "type": "text", "text": "laufend", "baseline": "top", "dy": 4, "color": "#605E5C" },
      "encoding": { "y": { "value": { "expr": "height" } } } },
    { "transform": [ { "window": [ { "op": "row_number", "as": "_e" } ] }, { "filter": "datum._e == 1" } ],
      "mark": { "type": "text", "text": "Stk.", "align": "left", "baseline": "bottom", "dy": -6, "color": "#605E5C", "description": "Einheit" },
      "encoding": { "x": { "value": 0 }, "y": { "value": 0 } } }
  ]
}
