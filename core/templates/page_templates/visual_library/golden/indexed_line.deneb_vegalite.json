{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "layer": [
    { "mark": { "type": "line", "interpolate": "monotone", "color": "#0078D4", "strokeWidth": 2 },
      "encoding": {
        "x": { "field": "month", "type": "temporal", "axis": { "title": null } },
        "y": { "field": "idx", "type": "quantitative", "scale": { "zero": false }, "axis": { "title": null } } } },
    { "mark": { "type": "rule", "color": "#605E5C", "strokeDash": [2, 2] }, "encoding": { "y": { "datum": 100 } } }
  ]
}
