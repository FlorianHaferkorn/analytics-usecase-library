{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "calculate": "datum['sales'] - datum['sales_py']", "as": "d_abs" },
    { "calculate": "datum['sales_py'] > 0 ? (datum['sales'] - datum['sales_py']) / datum['sales_py'] : null", "as": "d_rel" },
    { "window": [ { "op": "row_number", "as": "rn" } ] },
    { "joinaggregate": [
      { "op": "max", "field": "sales", "as": "ac_max" }, { "op": "min", "field": "sales", "as": "ac_min" },
      { "op": "max", "field": "sales_py", "as": "py_max" }, { "op": "min", "field": "sales_py", "as": "py_min" },
      { "op": "min", "field": "d_abs", "as": "d_min" } ] },
    { "calculate": "max(datum.ac_max, datum.py_max, 0)", "as": "v_top" },
    { "calculate": "datum.v_top + 0.3 * (datum.v_top - min(datum.ac_min, datum.py_min, 0)) + max(0, -datum.d_min)", "as": "tier_base" },
    { "calculate": "datum.tier_base + datum.d_abs", "as": "tier_end" }
  ],
  "resolve": { "scale": { "x": "shared" } },
  "spacing": 4,
  "vconcat": [
    { "width": 480, "height": 70,
      "layer": [
        { "mark": { "type": "bar", "width": { "band": 0.1 } },
          "encoding": {
            "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth", "axis": null },
            "y": { "field": "d_rel", "type": "quantitative", "axis": null, "scale": { "zero": true, "padding": 16 } },
            "color": { "condition": { "test": "datum.d_rel < 0", "value": "#A4262C" }, "value": "#107C10" } } },
        { "mark": { "type": "rule", "color": "#586472" }, "encoding": { "y": { "datum": 0 } } },
        { "mark": { "type": "point", "shape": "circle", "filled": true, "color": "#0F2430", "size": 36, "opacity": 1 },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" }, "y": { "field": "d_rel", "type": "quantitative" } } },
        { "mark": { "type": "text", "color": "#0F2430", "baseline": { "expr": "datum.d_rel < 0 ? 'top' : 'bottom'" }, "dy": { "expr": "datum.d_rel < 0 ? 6 : -6" } },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" }, "y": { "field": "d_rel", "type": "quantitative" },
            "text": { "field": "d_rel", "type": "quantitative", "format": "+.1~%" } } },
        { "transform": [ { "filter": "datum.rn === 1" } ],
          "mark": { "type": "text", "color": "#0F2430", "align": "right", "baseline": "middle", "dx": -8, "text": "ΔPY%" },
          "encoding": { "x": { "value": 0 }, "y": { "datum": 0 } } }
      ] },
    { "width": 480, "height": 230,
      "layer": [
        { "mark": { "type": "bar", "color": "#C8CED5", "xOffset": -4 },
          "encoding": {
            "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth", "axis": { "title": null, "labelAngle": 0, "format": "%m/%y", "labelOverlap": true, "labelSeparation": 6, "domainColor": "#586472" } },
            "y": { "field": "sales_py", "type": "quantitative", "axis": null, "scale": { "zero": true } } } },
        { "mark": { "type": "bar", "color": "#0078D4", "xOffset": 2 },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" }, "y": { "field": "sales", "type": "quantitative" } } },
        { "mark": { "type": "text", "color": "#0F2430", "baseline": "bottom", "dy": -4, "xOffset": 2 },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" }, "y": { "field": "sales", "type": "quantitative" },
            "text": { "field": "sales", "type": "quantitative", "format": ",.1f" } } },
        { "mark": { "type": "rule", "color": "#586472" }, "encoding": { "y": { "field": "tier_base", "aggregate": "max", "type": "quantitative" } } },
        { "mark": { "type": "bar" },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" },
            "y": { "field": "tier_end", "type": "quantitative" }, "y2": { "field": "tier_base" },
            "color": { "condition": { "test": "datum.d_abs < 0", "value": "#A4262C" }, "value": "#107C10" } } },
        { "mark": { "type": "text", "color": "#0F2430", "baseline": { "expr": "datum.d_abs < 0 ? 'top' : 'bottom'" }, "dy": { "expr": "datum.d_abs < 0 ? 4 : -4" } },
          "encoding": { "x": { "field": "month", "type": "ordinal", "timeUnit": "yearmonth" }, "y": { "field": "tier_end", "type": "quantitative" },
            "text": { "field": "d_abs", "type": "quantitative", "format": "+,.1f" } } },
        { "transform": [ { "filter": "datum.rn === 1" } ],
          "mark": { "type": "text", "color": "#0F2430", "align": "right", "baseline": "middle", "dx": -8, "text": "ΔPY" },
          "encoding": { "x": { "value": 0 }, "y": { "field": "tier_base", "type": "quantitative" } } },
        { "transform": [ { "filter": "datum.rn === 1" } ],
          "mark": { "type": "text", "color": "#0F2430", "align": "right", "baseline": "middle", "dx": -8, "text": "AC" },
          "encoding": { "x": { "value": 0 }, "y": { "field": "sales", "type": "quantitative" } } }
      ] }
  ]
}
