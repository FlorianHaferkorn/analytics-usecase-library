{
  "idiom": "line",
  "profile": "print_safe",
  "notation": "print_safe",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "padding": {
      "right": 36
    },
    "transform": [
      {
        "calculate": "min(isValid(datum['gm']) ? datum['gm'] : 1e300, isValid(datum['gm_plan']) ? datum['gm_plan'] : 1e300, isValid(datum['gm_py']) ? datum['gm_py'] : 1e300, isValid(datum['gm_fc']) ? datum['gm_fc'] : 1e300, isValid(datum['gm_fc_p10']) ? datum['gm_fc_p10'] : 1e300)",
        "as": "_yu_z"
      },
      {
        "calculate": "max(isValid(datum['gm']) ? datum['gm'] : -1e300, isValid(datum['gm_plan']) ? datum['gm_plan'] : -1e300, isValid(datum['gm_py']) ? datum['gm_py'] : -1e300, isValid(datum['gm_fc']) ? datum['gm_fc'] : -1e300, isValid(datum['gm_fc_p90']) ? datum['gm_fc_p90'] : -1e300)",
        "as": "_yo_z"
      },
      {
        "joinaggregate": [
          {
            "op": "min",
            "field": "_yu_z",
            "as": "_yu"
          },
          {
            "op": "max",
            "field": "_yo_z",
            "as": "_yo"
          }
        ]
      },
      {
        "calculate": "min(datum._yu, isValid(44.1) ? 44.1 : 1e300, isValid(42.0) ? 42.0 : 1e300, isValid(43.0) ? 43.0 : 1e300)",
        "as": "_ylo"
      },
      {
        "calculate": "max(datum._yo, isValid(44.1) ? 44.1 : -1e300, isValid(42.0) ? 42.0 : -1e300, isValid(46.0) ? 46.0 : -1e300)",
        "as": "_yhi"
      },
      {
        "calculate": "max(abs(datum._yhi), abs(datum._ylo))",
        "as": "_ytop"
      },
      {
        "calculate": "datum._yhi > -1e299 && datum._ytop > 0 && datum._ytop < 1e299 && datum._yhi - datum._ylo < 0.25 * datum._ytop",
        "as": "_yangepasst"
      },
      {
        "calculate": "datum._yangepasst ? datum._ylo - max((datum._yhi - datum._ylo) * 0.1, datum._ytop * 0.01) : 0",
        "as": "_ybasis"
      },
      {
        "calculate": "datum['laufend'] === true",
        "as": "_laufend"
      }
    ],
    "encoding": {
      "x": {
        "field": "month",
        "type": "temporal",
        "axis": {
          "title": null
        }
      }
    },
