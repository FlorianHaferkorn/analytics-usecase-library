{
  "idiom": "variance_pin",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "width": {
            "band": 0.1
          }
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "timeUnit": "yearmonth",
            "axis": {
              "title": null,
              "labelAngle": 0,
              "format": "%m/%y",
              "labelOverlap": true
            }
          },
          "y": {
            "field": "delta_pl_pct",
            "type": "quantitative",
            "axis": {
              "title": null,
              "format": "+.1~%"
            }
          },
          "color": {
            "condition": {
              "test": "datum['delta_pl_pct'] < 0",
              "value": "#A4262C"
            },
            "value": "#107C10"
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#586472"
        },
        "encoding": {
          "y": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "shape": "circle",
          "filled": true,
          "color": "#0F2430",
          "size": 36,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "timeUnit": "yearmonth"
          },
          "y": {
            "field": "delta_pl_pct",
            "type": "quantitative"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
