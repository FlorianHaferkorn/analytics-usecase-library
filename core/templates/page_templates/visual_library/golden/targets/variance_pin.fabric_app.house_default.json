{
  "idiom": "variance_pin",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "transform": [
      {
        "joinaggregate": [
          {
            "op": "count",
            "as": "_n"
          }
        ]
      }
    ],
    "layer": [
      {
        "mark": {
          "type": "bar",
          "width": {
            "band": 0.1
          }
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "timeUnit": "yearmonth",
            "axis": {
              "title": null,
              "labelAngle": 0,
              "format": "%m/%y",
              "labelOverlap": true,
              "labelSeparation": 6
            }
          },
          "y": {
            "field": "delta_pl_pct",
            "type": "quantitative",
            "axis": {
              "title": null,
              "format": "+.1~%"
            },
            "scale": {
              "padding": 18
            }
          },
          "color": {
            "condition": {
              "test": "datum['delta_pl_pct'] < 0",
              "value": "#A4262C"
            },
            "value": "#107C10"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "delta_pl_pct",
              "type": "quantitative",
              "title": "delta_pl_pct",
              "format": "+.1~%"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#586472"
        },
        "encoding": {
          "y": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "shape": "circle",
          "filled": true,
          "color": "#0F2430",
          "size": 36,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "timeUnit": "yearmonth"
          },
          "y": {
            "field": "delta_pl_pct",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "delta_pl_pct",
              "type": "quantitative",
              "title": "delta_pl_pct",
              "format": "+.1~%"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "baseline": "bottom",
          "dy": {
            "expr": "datum['delta_pl_pct'] < 0 ? 16 : -6"
          },
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "ordinal",
            "timeUnit": "yearmonth"
          },
          "y": {
            "field": "delta_pl_pct",
            "type": "quantitative"
          },
          "text": {
            "field": "delta_pl_pct",
            "type": "quantitative",
            "format": "+.1~%"
          },
          "opacity": {
            "condition": {
              "test": "datum._n < 10",
              "value": 1
            },
            "value": 0
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    }
  },
  "capabilities": {
    "disableLineChartCrosshairTooltip": true
  }
}
