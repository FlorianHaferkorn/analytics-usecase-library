{
  "idiom": "waterfall_variance",
  "profile": "ibcs",
  "notation": "ibcs",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "transform": [
      {
        "window": [
          {
            "op": "sum",
            "field": "value",
            "as": "cum"
          }
        ],
        "frame": [
          null,
          0
        ]
      },
      {
        "calculate": "datum.cum - datum['value']",
        "as": "prev"
      },
      {
        "window": [
          {
            "op": "lead",
            "field": "driver",
            "as": "next"
          }
        ]
      },
      {
        "calculate": "datum['value'] * 1 > 0 ? 'good' : (datum['value'] * 1 < 0 ? 'bad' : 'neutral')",
        "as": "rating"
      }
    ],
    "encoding": {
      "x": {
        "field": "driver",
        "type": "ordinal",
        "sort": null,
        "axis": {
          "title": null,
          "ticks": false,
          "labelAngle": 0,
          "domainColor": "#404040"
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar"
        },
        "encoding": {
          "y": {
            "field": "prev",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true,
              "padding": 16
            }
          },
          "y2": {
            "field": "cum"
          },
          "color": {
            "field": "rating",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "good",
                "bad",
                "neutral"
              ],
              "range": [
                "#5B9A35",
                "#A4262C",
                "#1F6FB5"
              ]
            }
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.next != null"
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#201F1E",
          "strokeWidth": 0.75
        },
        "encoding": {
          "y": {
            "field": "cum",
            "type": "quantitative"
          },
          "x2": {
            "field": "next"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "color": "#201F1E",
          "dy": {
            "expr": "datum['value'] < 0 ? 12 : -6"
          }
        },
        "encoding": {
          "y": {
            "field": "cum",
            "type": "quantitative"
          },
          "text": {
            "field": "value",
            "type": "quantitative",
            "format": "+.1~f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#404040",
      "labelColor": "#201F1E",
      "title": null,
      "labelFontSize": 11,
      "grid": false,
      "ticks": false
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333,
      "zero": true
    },
    "text": {
      "fontSize": 11
    },
    "bar": {
      "cornerRadius": 0
    },
    "legend": {
      "disable": true
    }
  },
  "capabilities": {
    "disableCompactNumberFormatting": true,
    "disableMinBarSize": true,
    "disableNiceAxisBounds": true,
    "disableStackedDataLabels": true
  }
}
