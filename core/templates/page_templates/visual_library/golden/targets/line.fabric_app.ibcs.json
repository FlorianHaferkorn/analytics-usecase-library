    }
  },
  "capabilities": {
    "disableCompactNumberFormatting": true,
    "disableLineChartCrosshairTooltip": true,
    "disableMinBarSize": true,
    "disableNiceAxisBounds": true,
    "disableStackedDataLabels": true,
    "disableTextTruncation": true
  }
