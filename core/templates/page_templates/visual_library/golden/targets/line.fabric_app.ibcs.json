{
  "idiom": "line",
  "profile": "ibcs",
  "notation": "ibcs",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "temporal",
        "axis": {
          "title": null,
          "grid": false,
          "ticks": false,
          "domainColor": "#404040"
        }
      }
    },
    "layer": [
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_fc_p10']) && isValid(datum['gm_fc_p90'])"
