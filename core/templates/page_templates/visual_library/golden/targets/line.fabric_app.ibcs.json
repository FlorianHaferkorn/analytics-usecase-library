          "type": "area",
          "interpolate": "monotone",
          "color": "#404040",
          "opacity": 0.12,
          "description": "Prognoseband P10-P90"
        },
        "encoding": {
          "y": {
            "field": "gm_fc_p10",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "y2": {
            "field": "gm_fc_p90"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p10",
              "type": "quantitative",
              "title": "gm_fc_p10",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p90",
              "type": "quantitative",
              "title": "gm_fc_p90",
              "format": ",.1~f"
            },
            {
              "field": "gm_py",
              "type": "quantitative",
              "title": "gm_py",
              "format": ",.1~f"
            },
            {
              "field": "gm_event",
              "type": "nominal",
              "title": "gm_event"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_fc_p90'])"
          },
          {
            "window": [
              {
                "op": "row_number",
                "as": "_bh"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "descending"
              }
            ]
          },
          {
            "filter": "datum._bh == 1"
          }
        ],
        "mark": {
          "type": "text",
          "text": "P90",
          "align": "right",
          "dx": -2,
          "dy": -7,
          "fontSize": 10,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm_fc_p90",
            "type": "quantitative",
            "axis": null
          }
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_fc_p10'])"
          },
          {
            "window": [
              {
                "op": "row_number",
                "as": "_bl"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "descending"
              }
            ]
          },
          {
            "filter": "datum._bl == 1"
          }
        ],
        "mark": {
          "type": "text",
          "text": "P10",
          "align": "right",
          "dx": -2,
          "dy": 11,
          "fontSize": 10,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm_fc_p10",
            "type": "quantitative",
            "axis": null
          }
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_event']) && datum['gm_event'] != '' && datum['gm_event'] != '(Blank)'"
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#605E5C",
          "strokeWidth": 1,
          "description": "Ereignis"
        },
        "encoding": {
          "tooltip": {
            "field": "gm_event",
            "type": "nominal"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_event']) && datum['gm_event'] != '' && datum['gm_event'] != '(Blank)'"
          },
          {
            "window": [
              {
                "op": "row_number",
                "as": "_ev"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "ascending"
              }
            ]
          }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "bottom",
          "dy": -3,
          "fontSize": 11,
          "color": "#605E5C",
          "description": "Ereignisnummer",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "value": 0
          },
          "text": {
            "field": "_ev",
            "type": "nominal"
          },
          "tooltip": {
            "field": "gm_event",
            "type": "nominal"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "color": "#404040",
          "opacity": 0.5,
          "strokeWidth": 1.5,
          "point": {
            "filled": true,
            "color": "#404040",
            "opacity": 0.5,
            "size": 20
          }
        },
        "encoding": {
          "y": {
            "field": "gm_py",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p10",
              "type": "quantitative",
              "title": "gm_fc_p10",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p90",
              "type": "quantitative",
              "title": "gm_fc_p90",
              "format": ",.1~f"
            },
            {
              "field": "gm_py",
              "type": "quantitative",
              "title": "gm_py",
              "format": ",.1~f"
            },
            {
              "field": "gm_event",
              "type": "nominal",
              "title": "gm_event"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm_py'])"
          },
          {
            "window": [
              {
                "op": "row_number",
                "as": "_q"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "ascending"
              }
            ]
          },
          {
            "filter": "datum._q == 1"
          }
        ],
        "mark": {
          "type": "text",
          "text": "PY",
          "align": "left",
          "dx": 4,
          "dy": 12,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm_py",
            "type": "quantitative",
            "axis": null
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "color": "#404040",
          "strokeWidth": 1.5,
          "point": {
            "filled": false,
            "fill": "white",
            "stroke": "#404040",
            "size": 30
          }
        },
        "encoding": {
          "y": {
            "field": "gm_plan",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p10",
              "type": "quantitative",
              "title": "gm_fc_p10",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p90",
              "type": "quantitative",
              "title": "gm_fc_p90",
              "format": ",.1~f"
            },
            {
              "field": "gm_py",
              "type": "quantitative",
              "title": "gm_py",
              "format": ",.1~f"
            },
            {
              "field": "gm_event",
              "type": "nominal",
              "title": "gm_event"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "color": "#404040",
          "strokeWidth": 1.5,
          "point": {
            "filled": true,
            "color": "#404040",
            "size": 30
          }
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p10",
              "type": "quantitative",
              "title": "gm_fc_p10",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p90",
              "type": "quantitative",
              "title": "gm_fc_p90",
              "format": ",.1~f"
            },
            {
              "field": "gm_py",
              "type": "quantitative",
              "title": "gm_py",
              "format": ",.1~f"
            },
            {
              "field": "gm_event",
              "type": "nominal",
              "title": "gm_event"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "color": "#404040",
          "strokeWidth": 1.5,
          "strokeDash": [
            3,
            2
          ]
        },
        "encoding": {
          "y": {
            "field": "gm_fc",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "zero": true
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p10",
              "type": "quantitative",
              "title": "gm_fc_p10",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc_p90",
              "type": "quantitative",
              "title": "gm_fc_p90",
              "format": ",.1~f"
            },
            {
              "field": "gm_py",
              "type": "quantitative",
              "title": "gm_py",
              "format": ",.1~f"
            },
            {
              "field": "gm_event",
              "type": "nominal",
              "title": "gm_event"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum['gm'])"
          },
          {
            "joinaggregate": [
              {
                "op": "min",
                "field": "gm",
                "as": "_min"
              },
              {
                "op": "max",
                "field": "gm",
                "as": "_max"
              },
              {
                "op": "count",
                "as": "_n"
              }
            ]
          },
          {
            "window": [
              {
                "op": "row_number",
                "as": "_i"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "ascending"
              }
            ]
          },
          {
            "calculate": "datum['gm'] == datum._min ? datum._i : null",
            "as": "_at_min"
          },
          {
            "calculate": "datum['gm'] == datum._max ? datum._i : null",
            "as": "_at_max"
          },
          {
            "calculate": "datum._i == 1 ? datum['gm'] : null",
            "as": "_at_first"
          },
          {
            "calculate": "datum._i == datum._n ? datum['gm'] : null",
            "as": "_at_last"
          },
          {
            "joinaggregate": [
              {
                "op": "min",
                "field": "_at_min",
                "as": "_imin"
              },
              {
                "op": "min",
                "field": "_at_max",
                "as": "_imax"
              },
              {
                "op": "max",
                "field": "_at_first",
                "as": "_v1"
              },
              {
                "op": "max",
                "field": "_at_last",
                "as": "_vn"
              }
            ]
          },
          {
            "calculate": "max(abs(datum._max), abs(datum._min), 1e-9)",
            "as": "_top"
          },
          {
            "calculate": "width / max(datum._n - 1, 1)",
            "as": "_step"
          },
          {
            "calculate": "abs(datum._imax - 1) * datum._step < 34 && abs(datum._max - datum._v1) / datum._top * height < 14 || abs(datum._n - datum._imax) * datum._step < 34 && abs(datum._max - datum._vn) / datum._top * height < 14",
            "as": "_max_hidden"
          },
          {
            "calculate": "abs(datum._imin - 1) * datum._step < 34 && abs(datum._min - datum._v1) / datum._top * height < 14 || abs(datum._n - datum._imin) * datum._step < 34 && abs(datum._min - datum._vn) / datum._top * height < 14 || !datum._max_hidden && abs(datum._imin - datum._imax) * datum._step < 34 && abs(datum._min - datum._max) / datum._top * height < 14",
            "as": "_min_hidden"
          },
          {
            "filter": "datum._n <= 6 || datum._i == 1 || datum._i == datum._n || datum._i == datum._imax && !datum._max_hidden || datum._i == datum._imin && !datum._min_hidden"
          }
        ],
        "mark": {
          "type": "text",
          "color": "#201F1E",
          "dy": -10,
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative"
          },
          "text": {
            "field": "gm",
            "type": "quantitative",
            "format": ",.1~f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
