{
  "idiom": "line",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "temporal",
        "axis": {
          "title": null
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "line",
          "color": "#0F2430",
          "strokeWidth": 2.5
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative",
            "scale": {
              "zero": false
            },
            "axis": {
              "title": null
            }
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#94A0AC",
          "strokeDash": [
            5,
            4
          ]
        },
        "encoding": {
          "y": {
            "datum": 44.1
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#94A0AC",
          "strokeDash": [
            5,
            4
          ],
          "strokeWidth": 1.5
        },
        "encoding": {
          "y": {
            "field": "gm_plan",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#0F2430",
          "strokeDash": [
            2,
            3
          ],
          "strokeWidth": 2
        },
        "encoding": {
          "y": {
            "field": "gm_fc",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "_p"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "ascending"
              }
            ]
          },
          {
            "filter": "datum._p == 1"
          }
        ],
        "mark": {
          "type": "text",
          "text": "Plan",
          "align": "left",
          "dx": 4,
          "dy": -8,
          "color": "#94A0AC",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm_plan",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "_r"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "descending"
              }
            ]
          },
          {
            "filter": "datum._r == 1"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 60,
          "color": "#A4262C"
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "params": [
          {
            "name": "hover",
            "select": {
              "type": "point",
              "fields": [
                "month"
              ],
              "nearest": true,
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#94A0AC"
        },
        "encoding": {
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 0.8
            },
            "value": 0
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 50,
          "color": "#0F2430"
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative"
          },
          "opacity": {
            "condition": {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            "value": 0
          },
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "gm",
              "type": "quantitative",
              "title": "gm",
              "format": ",.1~f"
            },
            {
              "field": "gm_plan",
              "type": "quantitative",
              "title": "gm_plan",
              "format": ",.1~f"
            },
            {
              "field": "gm_fc",
              "type": "quantitative",
              "title": "gm_fc",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "_r"
              }
            ],
            "sort": [
              {
                "field": "month",
                "order": "descending"
              }
            ]
          },
          {
            "filter": "datum._r == 1"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -8,
          "dy": -10,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "field": "gm",
            "type": "quantitative"
          },
          "text": {
            "field": "gm",
            "type": "quantitative",
            "format": ",.1~f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    }
  },
  "capabilities": {
    "disableLineChartCrosshairTooltip": true,
    "disableTextTruncation": true
  }
}
