{
  "idiom": "indexed_line",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "layer": [
      {
        "mark": {
          "type": "line",
          "color": "#0078D4",
          "strokeWidth": 2.5
        },
        "encoding": {
          "x": {
            "field": "month",
            "type": "temporal",
            "axis": {
              "title": null
            }
          },
          "y": {
            "field": "idx",
            "type": "quantitative",
            "scale": {
              "zero": false
            },
            "axis": {
              "title": null
            }
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#94A0AC",
          "strokeDash": [
            2,
            2
          ]
        },
        "encoding": {
          "y": {
            "datum": 100
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
