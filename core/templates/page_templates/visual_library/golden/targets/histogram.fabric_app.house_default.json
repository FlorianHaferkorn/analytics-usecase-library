{
  "idiom": "histogram",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "mark": {
      "type": "bar",
      "color": "#0078D4"
    },
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "bin": {
          "maxbins": 20
        },
        "axis": {
          "title": null
        }
      },
      "y": {
        "aggregate": "count",
        "axis": {
          "title": null
        }
      }
    }
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
