{
  "idiom": "column_time",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "ordinal",
        "axis": {
          "title": null,
          "labelAngle": 0
        }
      },
      "y": {
        "field": "count",
        "type": "quantitative",
        "axis": {
          "title": null
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "color": "#0078D4"
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "count",
                "as": "_n"
              }
            ]
          },
          {
            "filter": "datum._n < 10"
          }
        ],
        "mark": {
          "type": "text",
          "baseline": "bottom",
          "dy": -4,
          "color": "#201F1E"
        },
        "encoding": {
          "text": {
            "field": "count",
            "type": "quantitative",
            "format": ",.1~f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
