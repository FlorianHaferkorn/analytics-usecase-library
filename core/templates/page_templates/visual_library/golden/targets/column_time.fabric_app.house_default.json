{
  "idiom": "column_time",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "params": [
      {
        "name": "_n_daten",
        "expr": "max(length(data('dataset')), length(data('source_0')))"
      },
      {
        "name": "_beschriftet",
        "expr": "_n_daten > 0 && _n_daten < 10"
      }
    ],
    "transform": [
      {
        "calculate": "datum['laufend'] === true",
        "as": "_laufend"
      },
      {
        "window": [
          {
            "op": "row_number",
            "as": "_rang"
          }
        ],
        "sort": [
          {
            "field": "_laufend",
            "order": "ascending"
          },
          {
            "field": "month",
            "order": "descending"
          }
        ]
      },
      {
        "calculate": "!datum._laufend && datum._rang == 1",
        "as": "_letzte"
      }
    ],
    "encoding": {
      "x": {
        "field": "month",
        "type": "ordinal",
        "axis": {
          "title": null,
          "labelAngle": 0
        }
      },
      "y": {
        "field": "count",
        "type": "quantitative",
        "axis": {
          "title": null,
          "tickCount": {
            "expr": "_beschriftet ? 0 : ceil(height/40)"
          },
          "domainOpacity": {
            "expr": "_beschriftet ? 0 : 1"
          }
        }
      }
    },
    "layer": [
      {
        "transform": [
          {
            "filter": "!datum._laufend && !datum._letzte"
          }
        ],
        "mark": {
          "type": "bar",
          "width": {
            "expr": "min(bandwidth('x'), 24)"
          },
          "fill": "#8C8C8C"
        },
        "encoding": {
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "count",
              "type": "quantitative",
              "title": "count",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum._letzte"
          }
        ],
        "mark": {
          "type": "bar",
          "width": {
            "expr": "min(bandwidth('x'), 24)"
          },
          "fill": "#0F2430"
        },
        "encoding": {
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "count",
              "type": "quantitative",
              "title": "count",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": {
              "field": "laufend",
              "equal": true
            }
          }
        ],
        "mark": {
          "type": "bar",
          "width": {
            "expr": "min(bandwidth('x'), 24)"
          },
          "fill": "#FFFFFF",
          "stroke": "#0F2430",
          "strokeWidth": 1.5,
          "description": "laufende Periode"
        },
        "encoding": {
          "tooltip": [
            {
              "field": "month",
              "type": "temporal",
              "title": "month",
              "format": "%m/%Y"
            },
            {
              "field": "count",
              "type": "quantitative",
              "title": "count",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "baseline": "bottom",
          "dy": -4,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "text": {
            "field": "count",
            "type": "quantitative",
            "format": ",.1~f"
          },
          "opacity": {
            "condition": {
              "test": "_beschriftet",
              "value": 1
            },
            "value": 0
          }
        }
      },
      {
        "transform": [
          {
            "filter": {
              "field": "laufend",
              "equal": true
            }
          }
        ],
        "mark": {
          "type": "text",
          "text": "laufend",
          "baseline": "top",
          "dy": 4,
          "color": "#605E5C",
          "tooltip": null
        },
        "encoding": {
          "y": {
            "value": {
              "expr": "height"
            }
          }
        }
      },
      {
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "_e"
              }
            ]
          },
          {
            "filter": "datum._e == 1"
          }
        ],
        "mark": {
          "type": "text",
          "text": "Stk.",
          "align": "left",
          "baseline": "bottom",
          "dy": -6,
          "color": "#605E5C",
          "description": "Einheit",
          "tooltip": null
        },
        "encoding": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisDiscrete": {
      "grid": false
    },
    "axisTemporal": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    }
  },
  "capabilities": {
    "disableCompactNumberFormatting": true,
    "disableLineChartCrosshairTooltip": true,
    "disableMinBarSize": true,
    "disableNiceAxisBounds": true,
    "disableTextTruncation": true
  }
}
