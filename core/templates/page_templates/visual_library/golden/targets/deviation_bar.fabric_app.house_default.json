{
  "idiom": "deviation_bar",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "height": 12,
          "cornerRadius": 3
        },
        "encoding": {
          "x": {
            "field": "gm_vs_plan",
            "type": "quantitative",
            "axis": {
              "title": null
            },
            "scale": {
              "domainMid": 0
            }
          },
          "color": {
            "condition": {
              "test": "datum['gm_vs_plan'] < 0",
              "value": "#A4262C"
            },
            "value": "#107C10"
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#586472"
        },
        "encoding": {
          "x": {
            "datum": 0
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
