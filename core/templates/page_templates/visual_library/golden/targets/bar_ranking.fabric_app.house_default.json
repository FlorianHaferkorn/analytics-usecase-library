{
  "idiom": "bar_ranking",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "layer": [
      {
        "mark": {
          "type": "bar"
        },
        "encoding": {
          "y": {
            "field": "unit",
            "type": "nominal",
            "sort": "x",
            "axis": {
              "title": null
            }
          },
          "x": {
            "field": "gm",
            "type": "quantitative",
            "axis": {
              "title": null
            }
          },
          "color": {
            "condition": {
              "test": "datum['gm'] < 44.1",
              "value": "#A4262C"
            },
            "value": "#0F2430"
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#94A0AC",
          "strokeDash": [
            4,
            3
          ]
        },
        "encoding": {
          "x": {
            "datum": 44.1
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null
    },
    "axisX": {
      "grid": false
    }
  },
  "capabilities": {}
}
