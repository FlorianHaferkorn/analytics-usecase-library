{
  "idiom": "bar_absolute",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "transform": [
      {
        "joinaggregate": [
          {
            "op": "count",
            "as": "_n"
          }
        ]
      }
    ],
    "padding": {
      "right": 40
    },
    "encoding": {
      "y": {
        "field": "unit",
        "type": "nominal",
        "sort": "-x",
        "axis": {
          "title": null
        }
      },
      "x": {
        "field": "net_sales",
        "type": "quantitative",
        "axis": {
          "title": null
        },
        "scale": {
          "zero": true
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "color": "#0F2430"
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 4,
          "color": "#201F1E"
        },
        "encoding": {
          "text": {
            "field": "net_sales",
            "type": "quantitative",
            "format": ",.1~f"
          },
          "opacity": {
            "condition": {
              "test": "datum._n < 10",
              "value": 1
            },
            "value": 0
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
