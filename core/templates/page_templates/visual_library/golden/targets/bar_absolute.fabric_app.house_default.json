{
  "idiom": "bar_absolute",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "params": [
      {
        "name": "_n_daten",
        "expr": "max(length(data('dataset')), length(data('source_0')))"
      },
      {
        "name": "_beschriftet",
        "expr": "_n_daten > 0 && _n_daten < 10"
      }
    ],
    "padding": {
      "right": 40
    },
    "transform": [
      {
        "calculate": "datum['net_sales'] === 0 ? 0 : null",
        "as": "_nullstrich"
      },
      {
        "calculate": "isValid(datum['net_sales']) || datum._rest === true ? null : 0",
        "as": "_fehlt"
      }
    ],
    "encoding": {
      "y": {
        "field": "unit",
        "type": "nominal",
        "sort": {
          "field": "net_sales",
          "order": "descending"
        },
        "axis": {
          "title": null
        }
      },
      "x": {
        "field": "net_sales",
        "type": "quantitative",
        "axis": {
          "title": null,
          "tickCount": {
            "expr": "_beschriftet ? 0 : ceil(width/40)"
          },
          "domainOpacity": {
            "expr": "_beschriftet ? 0 : 1"
          }
        },
        "scale": {
          "zero": true
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "height": {
            "expr": "min(bandwidth('y'), 24)"
          }
        },
        "encoding": {
          "color": {
            "condition": {
              "test": "datum['unit'] != 'Nord'",
              "value": "#8C8C8C"
            },
            "value": "#0F2430"
          },
          "tooltip": [
            {
              "field": "unit",
              "type": "nominal",
              "title": "unit"
            },
            {
              "field": "net_sales",
              "type": "quantitative",
              "title": "net_sales",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "tick",
          "orient": "vertical",
          "thickness": 2,
          "color": "#0F2430",
          "description": "Null"
        },
        "encoding": {
          "x": {
            "field": "_nullstrich",
            "type": "quantitative"
          },
          "size": {
            "value": {
              "expr": "min(bandwidth('y'), 24)"
            }
          },
          "tooltip": [
            {
              "field": "unit",
              "type": "nominal",
              "title": "unit"
            },
            {
              "field": "net_sales",
              "type": "quantitative",
              "title": "net_sales",
              "format": ",.1~f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 4,
          "color": "#201F1E",
          "tooltip": null
        },
        "encoding": {
          "text": {
            "field": "net_sales",
            "type": "quantitative",
            "format": ",.1~f"
          },
          "opacity": {
            "condition": {
              "test": "_beschriftet",
              "value": 1
            },
            "value": 0
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "text": "–",
          "align": "left",
          "dx": 4,
          "color": "#8C8C8C",
          "description": "fehlender Wert",
          "tooltip": null
        },
        "encoding": {
          "x": {
            "field": "_fehlt",
            "type": "quantitative"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisDiscrete": {
      "grid": false
    },
    "axisTemporal": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    }
  },
  "capabilities": {
    "disableLineChartCrosshairTooltip": true,
    "disableTextTruncation": true
  }
}
