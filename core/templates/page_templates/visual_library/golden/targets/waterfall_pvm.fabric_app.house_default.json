{
  "idiom": "waterfall_pvm",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "transform": [
      {
        "window": [
          {
            "op": "sum",
            "field": "value",
            "as": "cum"
          }
        ],
        "frame": [
          null,
          0
        ]
      },
      {
        "calculate": "datum.cum - datum['value']",
        "as": "prev"
      }
    ],
    "encoding": {
      "x": {
        "field": "driver",
        "type": "ordinal",
        "sort": null,
        "axis": {
          "title": null,
          "labelAngle": 0
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar"
        },
        "encoding": {
          "y": {
            "field": "prev",
            "type": "quantitative",
            "axis": {
              "title": null
            }
          },
          "y2": {
            "field": "cum"
          },
          "color": {
            "condition": {
              "test": "datum['value'] < 0",
              "value": "#A4262C"
            },
            "value": "#107C10"
          }
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "count",
                "as": "_n"
              }
            ]
          },
          {
            "filter": "datum._n < 10"
          }
        ],
        "mark": {
          "type": "text",
          "baseline": "bottom",
          "dy": {
            "expr": "datum['value'] < 0 ? 12 : -4"
          },
          "color": "#201F1E"
        },
        "encoding": {
          "y": {
            "field": "cum",
            "type": "quantitative"
          },
          "text": {
            "field": "value",
            "type": "quantitative",
            "format": "+,.1~f"
          }
        }
      }
    ]
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisX": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    }
  },
  "capabilities": {}
}
