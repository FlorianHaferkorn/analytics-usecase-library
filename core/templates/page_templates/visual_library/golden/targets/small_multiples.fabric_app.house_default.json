{
  "idiom": "small_multiples",
  "profile": "house_default",
  "notation": "house_default",
  "data_name": "dataset",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "dataset"
    },
    "transform": [
      {
        "joinaggregate": [
          {
            "op": "min",
            "field": "gm",
            "as": "_ylo"
          },
          {
            "op": "max",
            "field": "gm",
            "as": "_yhi"
          }
        ]
      },
      {
        "calculate": "max(abs(datum._yhi), abs(datum._ylo))",
        "as": "_ytop"
      },
      {
        "calculate": "isValid(datum._yhi) && datum._ytop > 0 && datum._yhi - datum._ylo < 0.25 * datum._ytop",
        "as": "_yangepasst"
      },
      {
        "calculate": "datum._yangepasst ? datum._ylo - max((datum._yhi - datum._ylo) * 0.1, datum._ytop * 0.01) : 0",
        "as": "_ybasis"
      }
    ],
    "facet": {
      "field": "unit",
      "type": "nominal"
    },
    "columns": 3,
    "spec": {
      "encoding": {
        "x": {
          "field": "month",
          "type": "temporal",
          "axis": {
            "title": null
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "opacity": 0,
            "strokeWidth": 0
          },
          "encoding": {
            "y": {
              "field": "_ybasis",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "interpolate": "monotone",
            "color": "#0F2430",
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "gm",
              "type": "quantitative",
              "scale": {
                "zero": false
              },
              "axis": {
                "title": null
              }
            },
            "tooltip": [
              {
                "field": "unit",
                "type": "nominal",
                "title": "unit"
              },
              {
                "field": "month",
                "type": "temporal",
                "title": "month",
                "format": "%m/%Y"
              },
              {
                "field": "gm",
                "type": "quantitative",
                "title": "gm",
                "format": ",.1~f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum._yangepasst"
            }
          ],
          "mark": {
            "type": "text",
            "text": "≈",
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#605E5C",
            "align": "center",
            "baseline": "middle",
            "description": "Achse beginnt nicht bei null",
            "tooltip": null
          },
          "encoding": {
            "x": {
              "field": "month",
              "type": "temporal",
              "aggregate": "min"
            },
            "y": {
              "field": "_ybasis",
              "type": "quantitative",
              "aggregate": "min"
            }
          }
        }
      ]
    }
  },
  "configVegaLite": {
    "font": "Segoe UI, Inter, system-ui, -apple-system, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E1DFDD",
      "domainColor": "#E1DFDD",
      "labelColor": "#605E5C",
      "title": null,
      "labelFontSize": 11
    },
    "axisDiscrete": {
      "grid": false
    },
    "axisTemporal": {
      "grid": false
    },
    "scale": {
      "bandPaddingInner": 0.3333
    },
    "text": {
      "fontSize": 11
    },
    "legend": {
      "columns": 2,
      "labelLimit": 170
    },
    "locale": {
      "number": {
        "decimal": ",",
        "thousands": ".",
        "grouping": [
          3
        ],
        "currency": [
          "",
          " €"
        ]
      },
      "time": {
        "dateTime": "%A, der %e. %B %Y, %X",
        "date": "%d.%m.%Y",
        "time": "%H:%M:%S",
        "periods": [
          "AM",
          "PM"
        ],
        "days": [
          "Sonntag",
          "Montag",
          "Dienstag",
          "Mittwoch",
          "Donnerstag",
          "Freitag",
          "Samstag"
        ],
        "shortDays": [
          "So",
          "Mo",
          "Di",
          "Mi",
          "Do",
          "Fr",
          "Sa"
        ],
        "months": [
          "Januar",
          "Februar",
          "März",
          "April",
          "Mai",
          "Juni",
          "Juli",
          "August",
          "September",
          "Oktober",
          "November",
          "Dezember"
        ],
        "shortMonths": [
          "Jan",
          "Feb",
          "Mär",
          "Apr",
          "Mai",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Okt",
          "Nov",
          "Dez"
        ]
      }
    }
  },
  "capabilities": {
    "disableCompactNumberFormatting": true,
    "disableLegendTruncation": true,
    "disableLineChartCrosshairTooltip": true,
    "disableMinBarSize": true,
    "disableNiceAxisBounds": true,
    "disableTextTruncation": true
  }
}
