{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "window": [ { "op": "sum", "field": "value", "as": "cum" } ], "frame": [null, 0] },
    { "calculate": "datum.cum - datum['value']", "as": "prev" }
  ],
  "mark": { "type": "bar", "color": "#0078D4" },
  "encoding": {
    "x": { "field": "part", "type": "ordinal", "sort": null, "axis": { "title": null } },
    "y": { "field": "prev", "type": "quantitative", "axis": { "title": null } },
    "y2": { "field": "cum" }
  }
}
