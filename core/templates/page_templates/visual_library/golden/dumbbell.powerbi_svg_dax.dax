VAR _max = CALCULATE ( MAXX ( ALLSELECTED ( 'dim_org'[OrgName] ), [Gross Margin %] ), REMOVEFILTERS ( 'dim_org'[OrgName] ) )
VAR _x = DIVIDE ( [Gross Margin % PY], _max ) * 92 + 4
VAR _a = DIVIDE ( [Gross Margin %], _max ) * 92 + 4
VAR _pfeil = "circle" = "arrow"
VAR _dir = IF ( _a >= _x, 1, -1 )
VAR _col = IF ( _pfeil, IF ( ( [Gross Margin %] - [Gross Margin % PY] ) * 1 < 0, "#A4262C", "#107C10" ), "#0F2430" )
VAR _ende = IF ( _pfeil,
    "<polygon points='" & _a & ",7 " & ( _a - 6 * _dir ) & ",2 " & ( _a - 6 * _dir ) & ",12' fill='" & _col & "'/>",
    "<circle cx='" & _a & "' cy='7' r='4' fill='" & _col & "'/>" )
RETURN
    IF ( HASONEVALUE ( 'dim_org'[OrgName] ),
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
          & "<line x1='" & _x & "' y1='7' x2='" & _a & "' y2='7' stroke='#C8CED5' stroke-width='3'/>"
          & "<circle cx='" & _x & "' cy='7' r='4' fill='#8C8C8C'/>"
          & _ende
          & "</svg>" )
