{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "encoding": { "y": { "field": "unit", "type": "nominal", "sort": "-x", "axis": { "title": null } } },
  "layer": [
    { "mark": { "type": "rule", "color": "#D6DCE2", "size": 2 }, "encoding": { "x": { "datum": 0 }, "x2": { "field": "gm" } } },
    { "mark": { "type": "circle", "size": 90 }, "encoding": { "x": { "field": "gm", "type": "quantitative", "axis": { "title": null } }, "color": { "condition": { "test": "datum['gm'] < 44.1", "value": "#A4262C" }, "value": "#0F2430" } } }
  ]
}
