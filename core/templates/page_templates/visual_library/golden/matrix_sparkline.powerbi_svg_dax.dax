VAR _P = CALCULATETABLE ( VALUES ( 'dim_date'[Date] ), DATESINPERIOD ( 'dim_date'[Date], MAX ( 'dim_date'[Date] ), -12, MONTH ) )
VAR _S = ADDCOLUMNS ( _P, "@v", IF ( "break" = "zero", [Gross Margin %] + 0, [Gross Margin %] ) )
VAR _alle = CALCULATETABLE ( ADDCOLUMNS ( CROSSJOIN ( VALUES ( 'dim_product'[Category] ), _P ), "@v", [Gross Margin %] ), ALLSELECTED ( 'dim_product'[Category] ) )
VAR _geteilt = "shared" = "shared"
VAR _bl = BLANK ()
VAR _bh = BLANK ()
VAR _band = _geteilt && NOT ISBLANK ( _bl ) && NOT ISBLANK ( _bh )
VAR _lo0 = IF ( _geteilt, MINX ( _alle, [@v] ), MINX ( _S, [@v] ) )
VAR _hi0 = IF ( _geteilt, MAXX ( _alle, [@v] ), MAXX ( _S, [@v] ) )
VAR _min = IF ( _band, MIN ( _lo0, _bl ), _lo0 )
VAR _max = IF ( _band, MAX ( _hi0, _bh ), _hi0 )
VAR _xmin = MINX ( _S, 'dim_date'[Date] )
VAR _xmax = MAXX ( _S, 'dim_date'[Date] )
VAR _N = ADDCOLUMNS ( FILTER ( _S, NOT ISBLANK ( [@v] ) ),
    "@x", INT ( 4 + 92 * DIVIDE ( 'dim_date'[Date] - _xmin, _xmax - _xmin ) ),
    "@y", INT ( 24 - 22 * DIVIDE ( [@v] - _min, _max - _min ) ),
    "@luecke", 'dim_date'[Date] > MINX ( _S, 'dim_date'[Date] ) && ISBLANK ( MAXX ( TOPN ( 1, FILTER ( _S, 'dim_date'[Date] < EARLIER ( 'dim_date'[Date] ) ), 'dim_date'[Date], DESC ), [@v] ) ) )
VAR _erst = MINX ( _N, 'dim_date'[Date] )
VAR _letzt = MAXX ( _N, 'dim_date'[Date] )
VAR _d = CONCATENATEX ( _N, IF ( 'dim_date'[Date] = _erst || ( [@luecke] && "break" = "break" ), " M", " L" ) & [@x] & "," & [@y], "", 'dim_date'[Date] )
VAR _marken = "<circle cx='" & MAXX ( FILTER ( _N, 'dim_date'[Date] = _erst ), [@x] ) & "' cy='" & MAXX ( FILTER ( _N, 'dim_date'[Date] = _erst ), [@y] ) & "' r='2' fill='#FFFFFF' stroke='#0F2430' stroke-width='1'/>"
    & "<circle cx='" & MAXX ( FILTER ( _N, 'dim_date'[Date] = _letzt ), [@x] ) & "' cy='" & MAXX ( FILTER ( _N, 'dim_date'[Date] = _letzt ), [@y] ) & "' r='2.5' fill='#0F2430'/>"
VAR _bandsvg = IF ( _band, "<rect x='4' y='" & INT ( 24 - 22 * DIVIDE ( _bh - _min, _max - _min ) ) & "' width='92' height='" & INT ( 22 * DIVIDE ( _bh - _bl, _max - _min ) ) & "' fill='#ECECEC'/>", "" )
VAR _ref = IF ( _geteilt, "", "<title>je Zeile skaliert</title><line x1='4' x2='96' y1='" & INT ( 24 - 22 * DIVIDE ( AVERAGEX ( _N, [@v] ) - _min, _max - _min ) ) & "' y2='" & INT ( 24 - 22 * DIVIDE ( AVERAGEX ( _N, [@v] ) - _min, _max - _min ) ) & "' stroke='#605E5C' stroke-width='0.75' stroke-dasharray='2 2'/>" )
RETURN
    IF ( HASONEVALUE ( 'dim_product'[Category] ),
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 26'>"
          & _bandsvg
          & _ref
          & "<path fill='none' stroke='#0F2430' stroke-width='1.5' d='" & _d & "'/>"
          & _marken
          & "</svg>" )
