{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "mark": { "type": "bar", "color": "#0078D4" },
  "encoding": {
    "x": { "field": "value", "type": "quantitative", "bin": { "maxbins": 20 }, "axis": { "title": null } },
    "y": { "aggregate": "count", "axis": { "title": null } }
  }
}
