{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": { "right": 40 },
  "data": { "name": "dataset" },
  "layer": [
    { "mark": { "type": "bar" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": "x", "axis": { "title": null } },
        "x": { "field": "gm", "type": "quantitative", "axis": { "title": null } },
        "color": { "condition": { "test": "datum['gm'] < 44.1", "value": "#A4262C" }, "value": "#0F2430" } } },
    { "mark": { "type": "rule", "color": "#94A0AC", "strokeDash": [4, 3] }, "encoding": { "x": { "datum": 44.1 } } },
    { "transform": [ { "joinaggregate": [ { "op": "count", "as": "_n" } ] }, { "filter": "datum._n < 10" } ],
      "mark": { "type": "text", "align": "left", "dx": 4, "color": "#201F1E" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": "x" },
        "x": { "field": "gm", "type": "quantitative" },
        "text": { "field": "gm", "type": "quantitative", "format": ",.1~f" } } }
  ]
}
