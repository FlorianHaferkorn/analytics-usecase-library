{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": { "right": 40 },
  "data": { "name": "dataset" },
  "transform": [ { "joinaggregate": [ { "op": "count", "as": "_n" } ] } ],
  "layer": [
    { "mark": { "type": "bar" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": { "field": "gm", "order": "ascending" }, "axis": { "title": null } },
        "x": { "field": "gm", "type": "quantitative", "axis": { "title": null } },
        "color": { "condition": { "test": "(datum['gm'] - 44.1) * 1 < 0", "value": "#A4262C" }, "value": "#0F2430" } } },
    { "mark": { "type": "rule", "color": "#94A0AC", "strokeDash": [4, 3] }, "encoding": { "x": { "datum": 44.1 } } },
    { "mark": { "type": "text", "align": "left", "dx": 4, "color": "#201F1E" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": { "field": "gm", "order": "ascending" } },
        "x": { "field": "gm", "type": "quantitative" },
        "text": { "field": "gm", "type": "quantitative", "format": ",.1~f" }, "opacity": { "condition": { "test": "datum._n < 10", "value": 1 }, "value": 0 } } }
  ]
}
