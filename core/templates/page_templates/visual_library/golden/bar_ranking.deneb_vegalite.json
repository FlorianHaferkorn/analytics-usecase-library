{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": { "right": 40 },
  "data": { "name": "dataset" },
  "params": [ { "name": "_n_daten", "expr": "max(length(data('dataset')), length(data('source_0')))" }, { "name": "_beschriftet", "expr": "_n_daten > 0 && _n_daten < 10" } ],
  "layer": [
    { "mark": { "type": "bar" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": { "field": "gm", "order": "ascending" }, "axis": { "title": null } },
        "x": { "field": "gm", "type": "quantitative", "axis": { "title": null, "tickCount": { "expr": "_beschriftet ? 0 : ceil(width/40)" }, "domainOpacity": { "expr": "_beschriftet ? 0 : 1" } } },
        "color": { "condition": { "test": "(datum['gm'] - 44.1) * 1 < 0", "value": "#A4262C" }, "value": "#0F2430" } } },
    { "mark": { "type": "rule", "color": "#605E5C", "strokeDash": [4, 3] }, "encoding": { "x": { "datum": 44.1 } } },
    { "mark": { "type": "text", "align": "left", "dx": 4, "color": "#201F1E" },
      "encoding": {
        "y": { "field": "unit", "type": "nominal", "sort": { "field": "gm", "order": "ascending" } },
        "x": { "field": "gm", "type": "quantitative" },
        "text": { "field": "gm", "type": "quantitative", "format": ",.1~f" }, "opacity": { "condition": { "test": "_beschriftet", "value": 1 }, "value": 0 } } }
  ]
}
