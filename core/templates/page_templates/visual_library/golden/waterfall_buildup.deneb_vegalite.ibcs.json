{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "dataset" },
  "transform": [
    { "window": [ { "op": "sum", "field": "value", "as": "cum" } ], "frame": [null, 0] },
    { "calculate": "datum.cum - datum['value']", "as": "prev" }
  ],
  "encoding": { "x": { "field": "part", "type": "ordinal", "sort": null, "axis": { "title": null } } },
  "layer": [
    { "mark": { "type": "bar", "color": "#0078D4" }, "encoding": { "y": { "field": "prev", "type": "quantitative", "axis": { "title": null } }, "y2": { "field": "cum" } } },
    { "mark": { "type": "text", "dy": -6, "fontWeight": "bold", "color": "#0F2430" }, "encoding": { "y": { "field": "cum", "type": "quantitative" }, "text": { "field": "value", "type": "quantitative", "format": ".0f" } } }
  ]
}
