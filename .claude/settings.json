{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit *)",
      "Bash(curl -s *)",
      "PowerShell(.\\tooling\\run_stage1_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\tooling\\run_stage1_checks.ps1 *)",
      "PowerShell(.\\tooling\\run_all_checks.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\run_fabric_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\products\\fabric\\powerbi\\tooling\\run_fabric_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; py -3 tooling/audit_pbir_issues.py *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; py -3 tooling/check_kpi_catalog_gaps.py *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_syntax.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_vs_measure_dictionary.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_measures_vs_kpi.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\products\\fabric\\powerbi\\tooling\\validation\\check_measures_vs_kpi.ps1 *)",
      "PowerShell(py -3 products/fabric/powerbi/tooling/validation/check_page_template_compliance.py *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_pbip_readiness.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_report_layout.ps1 *)",
      "Bash(python3 scripts/check_index.py *)",
      "Bash(python scripts/check_index.py *)",
      "Bash(make check)",
      "Bash(make check-index)"
    ],
    "deny": [
      "Read(./**/*.parquet)",
      "Read(./**/node_modules/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate_tmdl_style.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate_pbir_structure.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate_measure_metadata.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check_pbi_desktop.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/activate_git_hooks.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/check_index.py\"; [ -f \"$f\" ] || exit 0; if command -v python3 >/dev/null 2>&1; then py=python3; else py=python; fi; \"$py\" \"$f\" --claude-hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/check_index.py\"; [ -f \"$f\" ] || exit 0; if command -v python3 >/dev/null 2>&1; then py=python3; else py=python; fi; \"$py\" \"$f\" --claude-hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "fabric-collection": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-fabric",
        "ref": "v0.3.18"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "fabric-skills@fabric-collection": true,
    "powerbi-authoring@fabric-collection": false
  }
}
