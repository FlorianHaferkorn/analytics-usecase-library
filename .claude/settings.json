{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit *)",
      "Bash(curl -s *)",
      "PowerShell(.\\tooling\\run_stage1_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\tooling\\run_stage1_checks.ps1 *)",
      "PowerShell(.\\tooling\\run_all_checks.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\run_fabric_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\products\\fabric\\powerbi\\tooling\\run_fabric_checks.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; py -3 tooling/audit_pbir_issues.py *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; py -3 tooling/check_kpi_catalog_gaps.py *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_syntax.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_vs_measure_dictionary.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_measures_vs_kpi.ps1 *)",
      "PowerShell($env:PYTHONIOENCODING=\"utf-8\"; .\\products\\fabric\\powerbi\\tooling\\validation\\check_measures_vs_kpi.ps1 *)",
      "PowerShell(py -3 products/fabric/powerbi/tooling/validation/check_page_template_compliance.py *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_tmdl_pbip_readiness.ps1 *)",
      "PowerShell(.\\products\\fabric\\powerbi\\tooling\\validation\\check_report_layout.ps1 *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate_tmdl_style.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate_pbir_structure.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
