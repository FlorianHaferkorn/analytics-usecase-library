{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Stage 1 checks (CI gate)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "./tooling/run_stage1_checks.ps1"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run all checks",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "./tooling/run_all_checks.ps1"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Generate measures for Use Case",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "./tooling/generation/generate_tmdl_measures.ps1",
        "-UseCase",
        "${input:usecaseId}",
        "-OverwriteExisting"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Generate all measures (stub only)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "./tooling/generation/generate_all_measures.ps1",
        "-StubOnly"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Generate all measures",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "./tooling/generation/generate_all_measures.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Generate all & run all checks",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "./tooling/generation/generate_all_measures.ps1; ./tooling/run_all_checks.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PBI: Watch Desktop errors (bridge)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "./watch_pbi.ps1"],
      "group": "none",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "PBI: Auto-fix daemon (LLM)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "./tooling/pbi_auto_fix_daemon.ps1"],
      "group": "none",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always" }
    }
  ],
  "inputs": [
    {
      "id": "usecaseId",
      "type": "promptString",
      "description": "Use Case ID (e.g. COM-001, OPS-002, ...)"
    }
  ]
}