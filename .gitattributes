# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.db-shm binary
*.db-wal binary
*.parquet binary
*.pbix binary

# Generator output — edit the sources/generators, then regenerate (see dist/README.md).
# linguist-generated collapses these in GitHub diffs; it changes nothing on checkout.
products/fabric/powerbi/dist/** linguist-generated=true
skills/*/SKILL.md linguist-generated=true
.claude/skills/*/SKILL.md linguist-generated=true
.github/copilot-instructions.md linguist-generated=true
