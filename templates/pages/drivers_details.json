{
  "name": "drivers_details",
  "version": 1,
  "layout": {
    "sections": [
      { "id": "drivers", "visuals": ["driver_cards","decomposition_or_bridge"] },
      { "id": "details", "visuals": ["ranking_table","matrix_breakdown"] }
    ],
    "slicers_from_segments": true
  },
  "bindings": {
    "kpis": "@required_kpi_ids",
    "segments": "@segments",
    "filters": "@filters_default"
  },
  "notes": "Use when emphasis is on drivers and detail tables; Agent assigns visuals to appropriate measures."
}

