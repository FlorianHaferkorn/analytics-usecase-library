#!/usr/bin/env sh
# claude-repo-kit: strict Drift-Gate (zero-dependency; `make check` bleibt für lokal/CI).
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
"$PY" scripts/check_index.py --strict || exit 1
# Secret-Baseline-Tor (07.10.2026): gestagte Dateien gegen .secrets.baseline (detect-secrets-hook,
# Pin = "version" der Baseline). 1 = neuer Fund -> Commit abbrechen. 2 = nicht gelaufen (Werkzeug
# fehlt / falsche Version) -> laut melden, nicht blockieren: der versionierte Hook reist in
# Umgebungen ohne die Abhaengigkeit (repo_kit_init.py, v3.24); hart prueft CI python-checks.
"$PY" products/fabric/powerbi/deployment/scripts/secret_scan_gate.py --baseline --staged
rc=$?
if [ "$rc" -eq 1 ]; then exit 1; fi
if [ "$rc" -ne 0 ]; then
  echo "[UNGEPRUEFT] Secret-Baseline-Tor nicht gelaufen (Exit $rc) - Commit ohne Secret-Scan." >&2
fi
# Ruff-Sperrklinke (07.10.2026): nur wenn .py gestagt ist; die Baseline zaehlt je Regel ueber den
# ganzen Baum, deshalb ohne Dateifilter. 1 = Regel ueber eingefrorenem Stand -> Commit abbrechen.
# 2 = nicht gelaufen (kein ruff) -> [UNGEPRUEFT], nicht blockieren (gleiche Linie wie das
# Secret-Tor); hart prueft CI stage1.yml (--pin-pflicht). Vorlage: Gate 1.6 in
# tooling/git-hooks/pre-commit.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.py$'; then
  "$PY" scripts/check_lint_ratchet.py
  rc=$?
  if [ "$rc" -eq 1 ]; then exit 1; fi
  if [ "$rc" -ne 0 ]; then
    echo "[UNGEPRUEFT] Ruff-Sperrklinke nicht gelaufen (Exit $rc) - Commit ohne Lint-Pruefung." >&2
  fi
fi
