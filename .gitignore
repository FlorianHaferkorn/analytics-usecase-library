**/.pbi/localSettings.json
**/.pbi/cache.abf

# Ephemeral agent worktrees (Claude Code agent isolation)
.claude/worktrees/

# Deployment generated artifacts (snapshots and reports)
products/fabric/powerbi/deployment/snapshots/
products/fabric/powerbi/deployment/reports/

# Generated theme documentation output
products/fabric/powerbi/tooling/theme_generator/themes/**/*.md

# Generated review outputs
internal/reviews/*.md
!internal/reviews/full_repo_quality_audit.md

# Node.js dependencies (reproducible via npm ci)
tooling/validation/node_modules/

# Generated validation results (produced by Stage 1 runner)
tooling/validation/results/

# Python bytecode cache
__pycache__/
*.pyc

# Python virtual environments (bootstrap)
tooling/.venv/
.venv/

# Generated registry outputs (produced by registry_builder.py)
tooling/ontology/out/

# Generated IR outputs (derived from registry outputs)
tooling/ir/out/

# Customer export packages (generated)
dist/customer_exports/

# Local env (token etc.) – never commit
.env
.env.local

# Project snapshot for Assistant briefing (generated by refresh_project_snapshot.ps1)
internal/project_mgmt/PROJECT_SNAPSHOT.md

# Power BI bridge file (watch_pbi.ps1 → Cursor); local only
.cursor/pbi_errors.log
# Daemon log (pbi_auto_fix_daemon.ps1)
.cursor/pbi_auto_fix.log
# Post-implementation validation result (pbi_validate_after_impl.ps1)
.cursor/pbi_validate_result.json
# TMDL renderer error log (tmdl_render_and_fix.ps1)
.cursor/tmdl_errors.log

# Root-level registry outputs (ignore if someone runs registry_builder without --out-dir)
master_registry.json
value_map.json
governance_gaps.json
orphans_report.json
# Root-level Node artifacts (Studio lives in /studio)
node_modules/
package.json
package-lock.json

# Next.js build artifacts
studio/.next/

# Studio local/dev artifacts (should not be committed)
# - SQLite WAL/SHM files created by better-sqlite3
studio/data/*.db-wal
studio/data/*.db-shm
studio/data/*.db-journal

# - Playwright local report/test run metadata
studio/playwright-report/index.html
studio/test-results/.last-run.json

# CI run logs (local only – not versioned)
internal/metrics/runs/*.json
internal/metrics/generation_runs/*.json

# Backup files
*.bak

# External tool binaries (download via .tools/README.md; not committed)
.tools/pbi-tools/
.tools/dotnet/
.tools/*.zip
drift_report.json

# Local agent / IDE artifacts (machine-specific, never commit)
.claude/settings.local.json
.cursor/publish_staging/
.cursor/*result*.json
.cursor/pbi_errors.log
.pytest_cache/

# Python build artifacts (`python -m build`) — root-anchored so the tracked
# products/fabric/powerbi/dist/ is never affected
/build/
/*.egg-info/
/dist/*.whl
/dist/*.tar.gz


# START Ruler Generated Files
/.agent/rules/ruler.md
/.amazonq/mcp.json
/.amazonq/rules/ruler_q_rules.md
/.augment/rules/ruler_augment_instructions.md
/.clinerules
/.crush.json
/.goosehints
/.idx/airules.md
/.junie/guidelines.md
/.kiro/steering/ruler_kiro_instructions.md
/.openhands/microagents/repo.md
/.trae/rules/project_rules.md
/CRUSH.md
/WARP.md
/firebender.json
# END Ruler Generated Files
