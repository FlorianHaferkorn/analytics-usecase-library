{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["use_cases"],
  "properties": {
    "use_cases": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z]{2,3}-\\d{3}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_codes"],
          "properties": {
            "action_codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
