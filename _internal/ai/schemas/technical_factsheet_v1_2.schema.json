{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical Factsheet v1.2",
  "type": "object",
  "required": [
    "metadata",
    "model_references",
    "kpi_measure_map",
    "data_contract_scope",
    "semantic_model",
    "measure_inventory",
    "dax_definitions",
    "security",
    "technical_assumptions",
    "deployment",
    "qa_rules"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["use_case_id", "domain", "technical_owner", "model_id"],
      "properties": {
        "use_case_id": {"type": "string"},
        "domain": {"type": "string"},
        "technical_owner": {"type": "string"},
        "model_id": {"type": "string"},
        "source_systems": {"type": "array", "items": {"type": "string"}},
        "business_factsheet_link": {"type": "string"}
      },
      "additionalProperties": false
    },
    "model_references": {
      "type": "object",
      "properties": {
        "domain_data_contracts": {"type": "array", "items": {"type": "string"}},
        "source_contracts": {"type": "array", "items": {"type": "string"}},
        "semantic_models": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "kpi_measure_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kpi_id", "measure_name", "format", "folder", "type"],
        "properties": {
          "kpi_id": {"type": "string"},
          "measure_name": {"type": "string"},
          "format": {"type": "string"},
          "folder": {"type": "string"},
          "type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "data_contract_scope": {
      "type": "object",
      "properties": {
        "facts": {"type": "array", "items": {"type": "object"}},
        "dimensions": {"type": "array", "items": {"type": "object"}},
        "security": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "semantic_model": {
      "type": "object",
      "properties": {
        "tables": {"type": "array", "items": {"type": "string"}},
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_table", "from_column", "to_table", "to_column", "cardinality", "direction"],
            "properties": {
              "from_table": {"type": "string"},
              "from_column": {"type": "string"},
              "to_table": {"type": "string"},
              "to_column": {"type": "string"},
              "cardinality": {"type": "string"},
              "direction": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "hierarchies": {"type": "array", "items": {"type": "string"}},
        "sort_by_rules": {"type": "array", "items": {"type": "string"}},
        "modeling_rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "measure_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure_name", "kpi_or_supporting", "purpose", "folder", "format", "measure_type"],
        "properties": {
          "measure_name": {"type": "string"},
          "kpi_or_supporting": {"type": "string"},
          "purpose": {"type": "string"},
          "folder": {"type": "string"},
          "format": {"type": "string"},
          "measure_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "dax_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "definition"],
        "properties": {
          "name": {"type": "string"},
          "definition": {"type": "string"},
          "comment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "rls": {"type": "string"},
        "ols": {"type": "string"},
        "security_tables": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "technical_assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deployment": {
      "type": "object",
      "properties": {
        "mode": {"type": "string"},
        "refresh": {"type": "string"},
        "aggregations": {"type": "string"},
        "workspace": {"type": "string"}
      },
      "additionalProperties": false
    },
    "qa_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "rule", "threshold", "automated", "owner"],
        "properties": {
          "check": {"type": "string"},
          "rule": {"type": "string"},
          "threshold": {"type": "string"},
          "automated": {"type": "boolean"},
          "owner": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
