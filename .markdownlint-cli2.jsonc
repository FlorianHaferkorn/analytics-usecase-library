{
  // markdownlint-cli2 config - globs with ! negations control what is linted.
  // Keep rules explicit here so markdownlint-cli2 never falls back to defaults.
  "config": {
    "default": false,
    "MD010": { "ignore_code_languages": ["tmdl"] },
    "MD041": { "front_matter_title": "" },
    "MD047": true
  },
  "globs": [
    "**/*.md",
    "!**/node_modules/**",
    "!products/fabric/powerbi/dist/**",
    "!internal/archive/**",
    "!CHANGELOG.md",
    "!.cursor/**",
    "!.claude/**",
    "!studio/playwright-report/**",
    "!studio/test-results/**"
  ]
}
