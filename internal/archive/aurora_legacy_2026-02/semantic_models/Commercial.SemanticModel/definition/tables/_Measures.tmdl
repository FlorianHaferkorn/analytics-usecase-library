/// Consolidated Measures for: COM-001, COM-002, COM-003, COM-004
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' =
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.amount - Net Sales Amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' =
			SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.plan - Net Sales % vs Plan
	/// Relative variance of Net Sales vs Plan.
	measure 'Net Sales % vs Plan' =
			VAR Actual = [Net Sales Amount]
			VAR Plan   = SUM ( fact_sales[Plan Sales Amount] )
			RETURN DIVIDE ( Actual - Plan, Plan )
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.ly - Delta% Net Sales
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' =
			VAR Actual = [Net Sales Amount]
			VAR LY     = SUM ( fact_sales[Last Year Sales Amount] )
			RETURN DIVIDE ( Actual - LY, LY )
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.pvm.price_effect.amount - Price Effect Amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'Price Effect Amount' =
			SUMX (
			fact_sales,
			VAR ActualPrice = DIVIDE ( fact_sales[Net Sales Amount], fact_sales[Quantity] )
			VAR PlanPrice   = DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] )
			RETURN ( ActualPrice - PlanPrice ) * fact_sales[Quantity]
			)
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.pvm.volume_effect.amount - Volume Effect Amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'Volume Effect Amount' =
			SUMX (
			fact_sales,
			VAR ActualQty = fact_sales[Quantity]
			VAR PlanQty   = fact_sales[Plan Quantity]
			VAR PlanPrice = DIVIDE ( fact_sales[Plan Sales Amount], PlanQty )
			RETURN ( ActualQty - PlanQty ) * PlanPrice
			)
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.pvm.mix_effect.amount - Mix Effect Amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' =
			[Net Sales Amount]
			- SUM ( fact_sales[Plan Sales Amount] )
			- [Price Effect Amount]
			- [Volume Effect Amount]
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' =
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// margin.gm.amount - Gross Margin Amount
	/// Absolute gross margin in currency.
	measure 'Gross Margin Amount' =
			[Net Sales Amount] - [Cost of Goods Sold Amount]
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' =
			DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// sales.pvm.mix_effect.amount - Mix Effect Amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' =
			[Net Sales Amount]
			- SUM ( fact_sales[Plan Sales Amount] )
			- [Price Effect Amount]
			- [Volume Effect Amount]
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// cost.cogs_per_unit.amount - COGS per Unit
	/// Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' =
			DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		formatString: "#,0"
		displayFolder: "COM-002"

	/// margin.gm.vs_plan.pct - Gross Margin % vs Plan
	/// Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' =
			VAR GMAct =
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
			VAR GMPlan =
			DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] ),
			SUM ( fact_sales[Plan Sales Amount] ) )
			RETURN
			DIVIDE ( GMAct - GMPlan, GMPlan )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// crm.clv.amount - CLV
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure 'CLV' =
			AVERAGEX (
			VALUES ( fact_sales[CustomerKey] ),
			CALCULATE (
			SUM ( fact_sales[Net Sales Amount] ) - SUM ( fact_sales[Cost of Goods Sold Amount] )
			) * 3
			)
		formatString: "#,0.00"
		displayFolder: "COM-003"

	/// crm.lifetime_revenue.amount - Customer Lifetime Revenue Amount
	/// Sum of realized revenue across the customer lifecycle.
	measure 'Customer Lifetime Revenue Amount' =
			CALCULATE (
			SUM ( fact_sales[Net Sales Amount] ),
			ALLSELECTED ( dim_date )
			)
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.retention.pct - Customer Retention %
	/// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'Customer Retention %' =
			VAR CurrentPeriodCustomers =
			CALCULATE (
			DISTINCTCOUNT ( fact_sales[CustomerKey] ),
			FILTER ( ALLSELECTED ( dim_date ), dim_date[Date] = MAX ( dim_date[Date] ) )
			)
			VAR PreviousPeriodCustomers =
			CALCULATE (
			DISTINCTCOUNT ( fact_sales[CustomerKey] ),
			DATEADD ( dim_date[Date], -1, MONTH )
			)
			RETURN DIVIDE ( CurrentPeriodCustomers, PreviousPeriodCustomers )
		formatString: "0.0%"
		displayFolder: "COM-003"

	/// crm.churned_customers.count - Churned Customers
	/// Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'Churned Customers' =
			VAR PreviousMonthCustomers =
			CALCULATETABLE (
			VALUES ( fact_sales[CustomerKey] ),
			DATEADD ( dim_date[Date], -1, MONTH )
			)
			VAR CurrentMonthCustomers =
			VALUES ( fact_sales[CustomerKey] )
			RETURN
			COUNTROWS ( EXCEPT ( PreviousMonthCustomers, CurrentMonthCustomers ) )
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.revenue_at_risk.amount - Revenue at Risk Amount
	/// Quantify revenue exposure from customers flagged as churn-risk.
	measure 'Revenue at Risk Amount' =
			VAR ChurnRiskPct = 0.15
			RETURN [CLV] * ChurnRiskPct
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.active_customers.count - Active Customers
	/// Number of unique active customers in the reporting period.
	measure 'Active Customers' =
			DISTINCTCOUNT ( fact_sales[CustomerKey] )
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.nps.index - NPS Score
	/// Measures customer advocacy and likelihood to recommend.
	measure 'NPS Score' =
			VAR Promoters = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[Is Promoter] = TRUE () )
			VAR Detractors = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[Is Detractor] = TRUE () )
			VAR Total = COUNTROWS ( fact_nps )
			RETURN DIVIDE ( Promoters - Detractors, Total ) * 100
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.complaint.count - Complaint Count
	/// Provide the absolute number of logged complaints.
	measure 'Complaint Count' =
			COUNTROWS ( fact_experience )
		formatString: "#,0"
		displayFolder: "COM-003"

	/// sales.promo.roi.pct - Promo ROI %
	/// Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' =
			DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: "0.0%"
		displayFolder: "COM-004"

	/// sales.promo.incremental.amount - Incremental Sales Amount
	/// Additional sales due to promotion.
	measure 'Incremental Sales Amount' =
			[Net Sales Amount] - [Baseline Sales Amount]
		formatString: "#,0.00"
		displayFolder: "COM-004"

	/// margin.promo.gm.pct - GM % During Promo
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' =
			CALCULATE (
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ),
			fact_sales[Promo Flag] = "Yes"
			)
		formatString: "0.0%"
		displayFolder: "COM-004"

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' =
			DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"

	/// sales.promo.cannibalization.pct - Cannibalization %
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' =
			DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"
