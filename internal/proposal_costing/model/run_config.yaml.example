# Proposal Costing – Run config for reproducible calculation.
# Use: py tooling/run_costing.py --config model/run_config.yaml
# Same config + same model files = same output.
# For offers: set package_id, template_path, customer_name, offer_date.

scenario_id: compact
# package_id: starter   # optional; overrides scenario (scenario from package)
use_reservation: false
storage_gb: null
implementation_fte: null
implementation_months: null
maintenance_fte: null
role_allocation_path: null
projection: true
tco_years: [3, 5]
contract_term_months: 12
region: West Europe          # set it explicitly; unset = default region + open customer question
# region: Germany West Central  # EUR +2.5 % per CU hour vs West Europe (01.10.2026)
# currency: EUR                 # USD default; EUR from Microsoft's EUR list, never converted
quote_valid_days: 30
output_path: dist/last_calculation.md
# Capacity overage (on by default for new F capacities, billed at 3x PAYG). Ask the
# customer: switched off, or threshold X CU hours per rolling 24 h? Unset = open question.
# overage_enabled: false
# overage_threshold_cu_hours: 96
# Fabric Planning sessions per 30-day window (consume CU of the prod capacity).
# planning_sessions: {planner: 2, stakeholder: 10, viewer: 50}
# template_path: templates/offer_snippet.md   # optional; for offer output
# customer_name: ""                            # optional; for offer
# offer_date: ""                               # optional; for offer (e.g. 2025-02-15)
