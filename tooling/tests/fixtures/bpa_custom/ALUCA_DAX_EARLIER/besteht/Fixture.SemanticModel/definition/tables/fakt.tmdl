/// Fixture-Tabelle.
table fakt
	lineageTag: 11111111-1111-1111-1111-111111111111

	column 'Rang' = VAR _b = fakt[Betrag] RETURN COUNTROWS ( FILTER ( fakt, fakt[Betrag] > _b ) ) + 1
		dataType: double
		summarizeBy: none
		lineageTag: 33333333-3333-3333-3333-333333333333

	column Betrag
		dataType: double
		sourceColumn: Betrag
		summarizeBy: none
		lineageTag: 22222222-2222-2222-2222-222222222222

	partition fakt = m
		mode: import
		source =
			let
				Source = #table(type table[Betrag = number], {})
			in
				Source
