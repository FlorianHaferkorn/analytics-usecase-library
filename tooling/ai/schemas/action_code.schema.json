    "trigger": {"type": "string"},
    "expected_impact": {"type": "string"},
    "level": {"type": "string"},
    "owner": {"type": "string"},
    "linked_kpis": {"type": "array", "items": {"type": "string"}},
    "linked_use_cases": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
