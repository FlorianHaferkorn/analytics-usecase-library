{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UseCase Bracket v2.0 (Lean)",
  "description": "Machine-readable SSOT for a use case. Links strategic KPI, influencing KPIs, action codes, governance roles, value driver model, and structured UX layout rules.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "governance",
    "orchestration",
    "value_driver_model",
    "ux_layout_rules",
    "documentation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-\\d{3}$",
      "description": "Use case ID (e.g. COM-001, FIN-002, XD-003)."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Human-readable use case title."
    },
    "domain": {
      "type": "string",
      "description": "Business domain (Commercial, Finance, Operations, SupplyChain, XD)."
    },
    "governance": {
      "type": "object",
      "required": ["owner_role", "steward_role"],
      "additionalProperties": false,
      "properties": {
        "owner_role": {
          "type": "string",
          "minLength": 2,
          "description": "Business accountability role ID (must exist in org_roles.yaml)."
        },
        "steward_role": {
          "type": "string",
          "minLength": 2,
          "description": "Data/definition accountability role ID (must exist in org_roles.yaml)."
        }
      }
    },
    "orchestration": {
      "type": "object",
      "required": ["strategic_kpi_id", "influencing_kpi_ids", "action_code_ids"],
      "additionalProperties": false,
      "properties": {
        "strategic_kpi_id": {
          "type": "string",
          "minLength": 3,
          "description": "Exactly 1 strategic (North Star) KPI ID from KPI catalog."
        },
        "influencing_kpi_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "description": "Diagnostic lever KPI IDs from KPI catalog."
        },
        "action_code_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "description": "Subscribed action code IDs from core/action_codes."
        },
        "supporting_kpi_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "description": "KPI IDs required to calculate strategic/influencing/action KPIs (report BoM). Registry validates bracket completeness via depends_on closure."
        }
      }
    },
    "value_driver_model": {
      "type": "object",
      "required": ["formula", "impact_direction"],
      "additionalProperties": false,
      "properties": {
        "formula": {
          "type": "string",
          "description": "Mathematical relationship: StrategicKPI = f(InfluencingKPIs...)."
        },
        "impact_direction": {
          "type": "string",
          "enum": ["maximize", "minimize"],
          "description": "Whether the strategic KPI should be maximized or minimized."
        },
        "primary_driver": {
          "type": "string",
          "description": "The main influencing KPI ID that drives the strategic KPI."
        },
        "impact_logic": {
          "type": "string",
          "description": "Narrative explaining how the primary driver affects the strategic KPI."
        },
        "critical_threshold": {
          "type": "number",
          "description": "Optional deviation trigger (e.g. 0.05 = 5%)."
        }
      }
    },
    "ux_layout_rules": {
      "type": "object",
      "required": ["report_structure", "page_1_summary", "page_2_execution"],
      "additionalProperties": false,
      "properties": {
        "report_structure": {
          "type": "string",
          "description": "Report pattern (e.g. 2-Page-Lead)."
        },
        "report_canvas": {
          "type": "object",
          "description": "Optional canvas size for grid-based report (default 1920×1080). Enables proportional scaling when changed.",
          "properties": {
            "width": { "type": "integer", "minimum": 1280, "description": "Page width in pixels (Full HD: 1920)." },
            "height": { "type": "integer", "minimum": 720, "description": "Page height in pixels (Full HD: 1080)." }
          },
          "additionalProperties": false
        },
        "page_1_summary": {
          "type": "object",
          "required": ["title", "component_3s", "component_30s"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "template_id": {
              "type": "string",
              "enum": ["pulse", "investigator"],
              "description": "Grid page template for Overview (3s/30s): pulse = 6 KPI slots + 3 main; investigator = left slicer + focus + support."
            },
            "component_3s": {
              "type": "object",
              "required": ["kpi_id", "visual_type"],
              "additionalProperties": false,
              "properties": {
                "kpi_id": { "type": "string", "description": "North Star KPI ID." },
                "visual_type": { "type": "string", "description": "Visual type (e.g. kpi_card, gauge)." }
              }
            },
            "component_30s": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kpi_id": { "type": "string", "description": "Single KPI ID." },
                  "kpi_ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Multiple KPI IDs for composite visuals."
                  },
                  "visual_type": { "type": "string", "description": "Visual type (e.g. trend_line, bar_chart, bridge_chart)." },
                  "slot_id": {
                    "type": "string",
                    "enum": ["Main_1", "Main_2", "Main_3"],
                    "description": "Explicit slot assignment for Overview (when set, overrides heuristic)."
                  }
                },
                "required": ["visual_type"]
              },
              "description": "Diagnostic visuals for the 30-second layer."
            }
          }
        },
        "page_2_execution": {
          "type": "object",
          "required": ["title", "component_300s"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "template_id": {
              "type": "string",
              "enum": ["investigator", "action_matrix"],
              "description": "Grid page template for Detail (300s): investigator = left slicer + focus + support; action_matrix = narrative + matrix."
            },
            "component_300s": {
              "type": "object",
              "required": ["evidence_grain", "evidence_columns", "action_panel", "payload_mode"],
              "additionalProperties": false,
              "properties": {
                "evidence_grain": {
                  "type": "string",
                  "minLength": 1,
                  "not": { "const": "transaction_line" },
                  "description": "Grain of the evidence table — must match a governed fact-table grain from core/data_contracts/domains/*.yaml. Placeholder 'transaction_line' is forbidden; refer to internal/evidence_grain_audit_results.md for correct values."
                },
                "evidence_columns": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Columns for the evidence table."
                },
                "evidence_measures": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "KPI IDs or measure names for Detail_Matrix value columns (optional)."
                },
                "action_panel": { "type": "boolean", "description": "Whether to show the action panel." },
                "payload_mode": {
                  "type": "string",
                  "enum": ["full", "summary", "minimal"],
                  "description": "How much action code detail to inject."
                }
              }
            }
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "required": ["business_factsheet"],
      "additionalProperties": false,
      "properties": {
        "business_factsheet": {
          "type": "string",
          "description": "Relative path to Business_Factsheet.md."
        }
      }
    },
    "ux_bindings": {
      "type": "object",
      "description": "Optional visual bindings (axis, legend, rows, values, sort, topN) per page/slot. Written by UX Layout Editor; do not edit by hand.",
      "additionalProperties": true
    },
    "overrides": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "measure_folder": {
          "type": "string",
          "description": "Custom folder name in Power BI semantic model."
        },
        "data_contract_ref": {
          "type": "string",
          "description": "Path to the related data contract YAML."
        }
      }
    }
  }
}
