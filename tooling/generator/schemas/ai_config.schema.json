{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aluca.dev/schemas/ai_config/1.0.0/ai_config.schema.json",
  "title": "AI Config Layer v1.0.0",
  "description": "Layered AI-orchestration config (ADR-0008, I-6.6). One schema for all three layers (L0 universal-optimal, L1 customer, L2 domain); the 'layer' discriminator marks which. Precedence L2 > L1 > L0. Per-field 'x-merge' annotations encode the merge kind the pure resolver applies (override | clamp-min | clamp-max | clamp-strict | intersect | or); JSON-Schema validators ignore unknown keywords, so x-merge is safe. Governing rule: a customer/domain layer may only TIGHTEN L0, never loosen it. This file is the single source of truth for ai-config schema validation; the resolver's MERGE_SPEC mirrors the x-merge values (parity-tested).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layer"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "layer": { "type": "string", "enum": ["L0", "L1", "L2"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "What this layer instance applies to. tenantId required for L1/L2; domainId required for L2.",
      "properties": {
        "tenantId": { "type": ["string", "null"] },
        "domainId": { "type": ["string", "null"] }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "description": "Maps a task-role to an abstract capability-role. Never a model ID — the capability-role->model map lives in L0 only.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskRole", "capabilityRole"],
            "properties": {
              "taskRole": { "type": "string" },
              "capabilityRole": {
                "type": "string",
                "enum": ["fast-cheap", "balanced", "deep-reasoner", "long-context"],
                "x-merge": "override"
              },
              "minCapabilityTier": { "type": "integer", "minimum": 0, "x-merge": "clamp-max" }
            }
          }
        }
      }
    },
    "tokenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": { "type": "integer", "minimum": 1, "x-merge": "clamp-min" },
        "maxContextTokens": { "type": "integer", "minimum": 1, "x-merge": "clamp-min" },
        "temperatureDefault": { "type": "number", "minimum": 0, "maximum": 2, "x-merge": "override" }
      }
    },
    "providerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedProviders": {
          "type": "array",
          "items": { "type": "string" },
          "x-merge": "intersect"
        },
        "preferenceOrder": {
          "type": "array",
          "items": { "type": "string" },
          "x-merge": "override"
        },
        "dataResidency": {
          "type": "string",
          "enum": ["any", "eu-only", "us-only"],
          "x-merge": "clamp-strict"
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thresholds": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "x-merge": "clamp-max-per-key"
        },
        "requireHumanReview": { "type": "boolean", "x-merge": "or" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleRate": { "type": "number", "minimum": 0, "maximum": 1, "x-merge": "clamp-max" },
        "redactPII": { "type": "boolean", "x-merge": "or" }
      }
    },
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attributionMethod": {
          "type": "string",
          "enum": ["before_after", "diff_in_diff", "holdout"],
          "x-merge": "override"
        },
        "weighting": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "x-merge": "override"
        }
      }
    }
  }
}
