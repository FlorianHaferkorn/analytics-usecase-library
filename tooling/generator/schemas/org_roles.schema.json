{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Org-Registry v1.0",
  "description": "Governed SSOT for organization role definitions. All owner_role and steward_role references in brackets and action codes must exist here.",
  "type": "object",
  "required": ["schema_version", "roles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "domain"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Snake_case role identifier (e.g. head_of_sales)."
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "description": "Human-readable role title."
          },
          "domain": {
            "type": "string",
            "description": "Business domain this role belongs to."
          },
          "description": {
            "type": "string",
            "description": "Optional longer description of the role's responsibilities."
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Legacy display names that map to this role (for migration)."
          }
        }
      }
    }
  }
}
