{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/project-package/capability-state/1.0.0",
  "title": "Project capability discovery state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_ref", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_ref": {"$ref": "#/$defs/id"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability_state"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "ref": {"type": "string", "minLength": 1},
    "evidence_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "evidence_refs", "measured_at", "decision_ref", "note"],
      "properties": {
        "provenance": {"enum": ["customer_decision", "measured", "derived", "proposed"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true},
        "measured_at": {"type": ["string", "null"], "format": "date-time"},
        "decision_ref": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "value": {},
        "evidence": {"$ref": "#/$defs/evidence_state"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_ref", "state", "response", "owner_ref", "due_date", "evidence"],
      "properties": {
        "question_ref": {"$ref": "#/$defs/id"},
        "state": {"enum": ["open", "answered", "deferred", "not_applicable"]},
        "response": {},
        "owner_ref": {"type": ["string", "null"]},
        "due_date": {"type": ["string", "null"], "format": "date"},
        "evidence": {"$ref": "#/$defs/evidence_state"}
      }
    },
    "capability_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_ref", "capability_version", "scope_level", "facts", "answers"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "capability_ref": {"$ref": "#/$defs/id"},
        "capability_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "scope_level": {"enum": ["not_in_scope", "assess", "design", "implement", "operate"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "answers": {"type": "array", "items": {"$ref": "#/$defs/answer"}}
      }
    }
  }
}
