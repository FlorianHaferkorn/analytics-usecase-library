{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/project-package/architecture-input/2.0.0",
  "title": "Project architecture compiler input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stack", "reference_date", "tenant", "region", "ledger_ref", "model_ref", "blueprint_ref",
    "mapping_ref", "domains", "use_cases", "environments", "contracts", "compiler_policy"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "stack": {"type": "string", "minLength": 1},
    "reference_date": {"type": "string", "format": "date"},
    "tenant": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "ledger_ref": {"type": "string", "minLength": 1},
    "model_ref": {"type": "string", "minLength": 1},
    "blueprint_ref": {"type": "string", "minLength": 1},
    "mapping_ref": {"type": "string", "minLength": 1},
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "delivery_scope", "capacity", "use_case_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "delivery_scope": {"enum": ["detailed", "independent_blueprint_consumer", "out_of_scope"]},
          "capacity": {"type": "string", "minLength": 1},
          "use_case_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain_ref", "architecture_detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "domain_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "architecture_detail": {"enum": ["full", "contract_pending", "blueprint_only"]}
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "decision_ref", "accepted"],
      "properties": {
        "recommended": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_ref": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"}
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source_ref", "required_for"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "kind": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "required_for": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "physical_workspaces": {
      "description": "Explicit authored Fabric workspace creation scope. No resource names or environments are inferred.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "domain_ref", "environment", "capacity_id", "domain_id", "decision_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "domain_ref": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "capacity_id": {"type": "string", "format": "uuid"},
          "domain_id": {"type": "string", "format": "uuid"},
          "description": {"type": "string", "maxLength": 4000},
          "decision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "physical_items": {
      "description": "Explicit native item definitions. Transport validation and released inputs do not establish tenant acceptance.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "type", "workspace_ref", "environment", "decision_refs", "depends_on", "environment_bindings", "definition"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["Notebook", "DataPipeline", "SemanticModel", "Report"]},
          "description": {"type": "string", "maxLength": 256},
          "workspace_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "environment": {"type": "string", "minLength": 1},
          "decision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "environment_bindings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["part_path", "json_pointer", "expected_value", "authority_ref"],
              "properties": {
                "part_path": {"type": "string", "minLength": 1},
                "json_pointer": {"type": "string", "pattern": "^(/.*)?$"},
                "expected_value": {"type": ["string", "number", "boolean", "null"]},
                "authority_ref": {"type": "string", "minLength": 1}
              }
            }
          },
          "definition": {
            "type": "object", "additionalProperties": false,
            "required": ["parts"],
            "properties": {
              "format": {"type": "string", "minLength": 1},
              "parts": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "payload", "payloadType"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "payload": {"type": "string", "minLength": 1},
                    "payloadType": {"const": "InlineBase64"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "compiler_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generated_ref", "fail_closed_for_apply", "allow_review_with_blockers"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "generated_ref": {"type": "string", "minLength": 1},
        "fail_closed_for_apply": {"type": "boolean"},
        "allow_review_with_blockers": {"type": "boolean"}
      }
    }
  }
}
