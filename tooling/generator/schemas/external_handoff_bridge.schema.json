{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/external-handoff-bridge/1.0.0",
  "title": "External delivery handoff bridge descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_ref", "use_case_ref", "authority_ref",
    "handoff_manifest_ref", "package_manifest_ref", "required_source_keys",
    "required_package_refs", "decision_refs", "open_gate_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_ref": {"$ref": "#/$defs/id"},
    "use_case_ref": {"$ref": "#/$defs/id"},
    "authority_ref": {"$ref": "#/$defs/path"},
    "handoff_manifest_ref": {"$ref": "#/$defs/path"},
    "package_manifest_ref": {"$ref": "#/$defs/path"},
    "required_source_keys": {"$ref": "#/$defs/keys"},
    "required_package_refs": {"$ref": "#/$defs/paths"},
    "decision_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:E|K|O)-[0-9]+$"}
    },
    "open_gate_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^O-[0-9]+$"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
  }
}
