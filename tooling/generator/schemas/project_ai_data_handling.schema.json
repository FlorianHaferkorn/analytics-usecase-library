{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/project-package/ai-data-handling/1.0.0",
  "title": "Project-bound AI data-handling policy intake",
  "description": "A versioned Project Package module. A valid module or approved decision does not authorize model egress.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "project_ref", "routes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "ai-data-handling-policy/1.0.0"},
    "project_ref": {"$ref": "#/$defs/id"},
    "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "ref": {"type": "string", "minLength": 1},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "task_role", "decision_ref", "profile", "allowed_inputs",
        "provider_region", "provider_geography", "credential_ref", "provider_terms_evidence_refs", "expires_at"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "task_role": {"type": "string", "minLength": 1},
        "decision_ref": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/profile"},
        "allowed_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/allowed_input"}},
        "provider_region": {"type": ["string", "null"], "minLength": 1},
        "provider_geography": {"type": ["string", "null"], "enum": ["eu", "us", "local", "other", null]},
        "credential_ref": {"type": ["string", "null"], "pattern": "^secret://[^\\s]+$"},
        "provider_terms_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "allowed_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "data_form", "purpose", "source_refs"],
      "properties": {
        "classification": {"enum": ["public", "internal_generic", "customer_confidential"]},
        "data_form": {"enum": ["metadata", "aggregates", "schema", "code", "document_excerpt", "raw_rows", "synthetic"]},
        "purpose": {"enum": ["studio_authoring", "enduser_question", "analytics_reasoning", "analytics_advisory"]},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "profile": {
      "type": "object",
      "required": ["provider", "data_handling"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "minLength": 1},
        "data_residency": {"type": "string", "enum": ["any", "local", "eu-only", "us-only"]},
        "data_handling": {"$ref": "#/$defs/policy"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["processing_boundary", "allowed_classifications", "allowed_data_forms", "allowed_purposes", "provider_training_allowed", "prompt_retention_days", "require_redaction_for_egress"],
      "properties": {
        "processing_boundary": {"type": "string", "enum": ["local", "customer_managed_cloud", "external_cloud"]},
        "boundary_evidence_ref": {"type": "string", "minLength": 1},
        "allowed_classifications": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "enum": ["public", "internal_generic", "customer_confidential"]}
        },
        "allowed_data_forms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "enum": ["metadata", "aggregates", "schema", "code", "document_excerpt", "raw_rows", "synthetic"]}
        },
        "allowed_purposes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "enum": ["studio_authoring", "enduser_question", "analytics_reasoning", "analytics_advisory"]}
        },
        "provider_training_allowed": {"const": false},
        "prompt_retention_days": {"type": "integer", "minimum": 0},
        "require_redaction_for_egress": {"type": "boolean"},
        "scan_policy": {
          "type": "object",
          "properties": {
            "max_payload_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
            "blocked_terms": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 200 } },
            "allowlist": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 200 } }
          },
          "additionalProperties": false
        }
      },
      "allOf": [{
        "if": {"properties": {"processing_boundary": {"const": "customer_managed_cloud"}}, "required": ["processing_boundary"]},
        "then": {"required": ["boundary_evidence_ref"]}
      }],
      "additionalProperties": false
    }
  }
}
