{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Action Code Definition v2.0",
  "description": "Action Code Definition (Lean v2.0). Removed lifecycle, category, tags, strategic_alignment; KPI lists as IDs only; governance roles at top level. This file is the single source of truth for action-code schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "owner_domain",
    "impact_dimension",
    "status",
    "owner_role",
    "steward_role",
    "kpis",
    "scope",
    "trigger",
    "impact",
    "operational_execution",
    "quality_rules",
    "parameters",
    "preconditions",
    "permitted_role",
    "review"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },
    "inherits_decision_spine": { "type": ["string", "null"] },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "owner_domain": { "type": "string" },
    "impact_dimension": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
    "owner_role": { "type": "string", "description": "Accountable governance role for this action (not a person name)." },
    "steward_role": { "type": "string", "description": "Data quality / implementation governance role (must differ from owner_role)." },
    "use_case_links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core_use_cases": { "type": "array", "items": { "type": "string" } },
        "related_use_cases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "kpis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_kpis"],
      "properties": {
        "trigger_kpis": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "KPI IDs (must exist in KPI catalog)." },
        "guardrail_kpis": { "type": "array", "items": { "type": "string" }, "description": "KPI IDs used as guardrails." },
        "outcome_kpis": { "type": "array", "items": { "type": "string" }, "description": "KPI IDs used to measure action outcome." }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_grain", "default_perspective", "supported_slices", "exclusions"],
      "properties": {
        "default_grain": { "type": "string" },
        "default_perspective": { "type": "array", "items": { "type": "string" } },
        "supported_slices": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Deviation", "Pattern", "CompositeDeviation", "LifecycleDeviation", "Webhook", "Forecast"],
          "description": "Forecast (ADR-0028): the levels compare the KPI forecast at the end of forecast.horizon, not the actual value."
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["horizon", "forecast_measure", "compare"],
          "description": "Only with type Forecast (ADR-0028). Which forecast value the level thresholds test, and over which horizon.",
          "properties": {
            "horizon": {
              "type": "object",
              "additionalProperties": false,
              "required": ["length", "unit"],
              "properties": {
                "length": { "type": "integer", "minimum": 1 },
                "unit": { "type": "string", "enum": ["periods", "days", "weeks", "months"] }
              }
            },
            "forecast_measure": { "type": "string", "minLength": 1, "description": "Name of the measure that returns the KPI forecast at the horizon." },
            "compare": { "type": "string", "enum": ["point", "band_lower", "band_upper"], "description": "point = central forecast; band_lower/band_upper = edge of the prediction interval (the cautious reading)." },
            "band": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "level", "lower_measure", "upper_measure"],
              "description": "Prediction interval at the horizon; its edges come from their own measures (Florian 30.10.2026).",
              "properties": {
                "kind": { "type": "string", "enum": ["prediction_interval"] },
                "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                "lower_measure": { "type": "string", "minLength": 1 },
                "upper_measure": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grain", "window", "persistence", "minimum_data"],
          "properties": {
            "grain": { "type": "string" },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "length", "unit"],
              "properties": {
                "kind": { "type": "string" },
                "length": { "type": "number" },
                "unit": { "type": "string" }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "min_consecutive_periods"],
              "properties": {
                "required": { "type": "boolean" },
                "min_consecutive_periods": { "type": "number" }
              }
            },
            "minimum_data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_observations"],
              "properties": {
                "min_observations": { "type": "number" },
                "volume_guardrail": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["enabled", "metric_kpi_id", "comparator", "value", "unit"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "metric_kpi_id": { "type": "string" },
                    "comparator": { "type": "string" },
                    "value": { "type": ["number", "string"] },
                    "unit": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L1", "L2", "L3"],
          "properties": {
            "L1": { "$ref": "#/definitions/level" },
            "L2": { "$ref": "#/definitions/level" },
            "L3": { "$ref": "#/definitions/level" }
          }
        },
        "gating_rules": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "type": { "const": "Forecast" } }, "required": ["type"] },
          "then": { "type": "object", "properties": { "forecast": true }, "required": ["forecast"] },
          "else": { "not": { "type": "object", "properties": { "forecast": true }, "required": ["forecast"] } }
        },
        {
          "if": { "type": "object", "properties": { "forecast": { "type": "object", "properties": { "compare": { "enum": ["band_lower", "band_upper"] } }, "required": ["compare"] } }, "required": ["forecast"] },
          "then": { "type": "object", "properties": { "forecast": { "type": "object", "properties": { "band": true }, "required": ["band"] } } }
        }
      ]
    },
    "impact_valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "currency", "success_window", "calculation_logic"],
      "properties": {
        "method": { "type": "string", "enum": ["DirectMarginImprovement", "CostAvoidance", "RevenueUplift", "CashRelease", "RiskAvoidance"] },
        "currency": { "type": "string", "minLength": 3 },
        "success_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration", "metric_kpi_id", "success_criteria"],
          "properties": {
            "duration": { "type": "string" },
            "metric_kpi_id": { "type": "string" },
            "success_criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "type": "string", "enum": ["return_to_baseline", "threshold_met"] },
                "baseline_window": { "type": "string" },
                "comparator": { "type": "string" },
                "threshold": { "type": ["number", "string"] },
                "unit": { "type": "string" }
              }
            }
          }
        },
        "calculation_logic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standardized"],
          "properties": {
            "standardized": { "type": "string", "minLength": 10 },
            "latex": { "type": "string" }
          }
        },
        "required_measures": { "type": "array", "items": { "type": "string" } },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": { "type": "string", "enum": ["before_after", "diff_in_diff", "holdout"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "impact": { "type": "object" },
    "operational_execution": { "type": "object" },
    "data_requirements": { "type": "object" },
    "automation": { "type": "object" },
    "tracking": { "type": "object" },
    "governance": { "type": "object" },
    "execution_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "endpoint_template", "payload_definition", "audit"],
      "properties": {
        "type": { "type": "string", "enum": ["Webhook", "PowerAutomate", "API"] },
        "mode": { "type": "string", "enum": ["dry_run", "live"] },
        "endpoint_template": { "type": "string" },
        "http": { "type": "object" },
        "auth_reference": { "type": "object" },
        "payload_definition": { "type": "object" },
        "audit": { "type": "object" }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "description": "D-833 step 1 (action contract, SOM-001): typed parameters of one execution. Derived from scope and trigger.levels (source_field); what the existing fields do not state is nicht_belegt (a gap, never estimated).",
      "items": {
        "$ref": "#/definitions/parameter"
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combine",
        "checks"
      ],
      "description": "D-833: machine-checkable preconditions. Each check references a catalog KPI and the threshold in this action code (ref) instead of copying it (Golden Thread). Executable when every guardrail check holds and at least one trigger check holds. Prose stays as evidence in trigger.gating_rules and operational_execution.prerequisites.",
      "properties": {
        "combine": {
          "type": "string",
          "const": "guardrails_all_and_trigger_any"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/precondition"
          }
        }
      }
    },
    "permitted_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_field",
        "roles"
      ],
      "description": "D-833: roles allowed to approve an execution, as references to core/organization/org_roles.yaml (role_id). Derived from governance.approvals_required (approver = existing text); without a role of the same title or alias in the registry, role_id is nicht_belegt.",
      "properties": {
        "source_field": {
          "type": "string",
          "const": "governance.approvals_required"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approver",
              "role_id"
            ],
            "properties": {
              "approver": {
                "type": "string",
                "minLength": 1,
                "description": "Entry of governance.approvals_required, unchanged."
              },
              "role_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "not": {
                      "const": "nicht_belegt"
                    }
                  },
                  {
                    "const": "nicht_belegt"
                  }
                ],
                "description": "id of a role in core/organization/org_roles.yaml, or nicht_belegt."
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state"
      ],
      "description": "D-833: review step before execution. state is the start state of every new execution (definition: vorgeschlagen); the runtime (Meridian DI) moves it per attempt and logs every attempt.",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "true when governance.approvals_required has at least one entry."
        },
        "state": {
          "$ref": "#/definitions/review_state"
        }
      }
    },
    "quality_rules": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "review_state": {
      "type": "string",
      "enum": [
        "vorgeschlagen",
        "freigegeben",
        "ausgefuehrt",
        "abgelehnt",
        "fehlgeschlagen"
      ],
      "description": "State of one execution: vorgeschlagen -> freigegeben -> ausgefuehrt | fehlgeschlagen; vorgeschlagen -> abgelehnt. Same enum for the definition (start state) and the runtime log."
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "source_field"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "period",
            "trigger_level",
            "dimension_member"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "source_field": {
          "type": "string",
          "minLength": 1,
          "description": "Existing field the parameter is derived from."
        },
        "grain": {
          "type": "string",
          "description": "type period only: grain from scope.default_grain."
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "type trigger_level only: the levels of trigger.levels."
        },
        "binding": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_ ]*$"
            },
            {
              "const": "nicht_belegt"
            }
          ],
          "description": "type dimension_member only: column (table.column) whose values are allowed; nicht_belegt while the existing fields do not name the column."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "period"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "grain"
            ],
            "properties": {
              "allowed_values": false,
              "binding": false,
              "grain": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "trigger_level"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "allowed_values"
            ],
            "properties": {
              "grain": false,
              "binding": false,
              "allowed_values": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dimension_member"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "binding",
              "label"
            ],
            "properties": {
              "grain": false,
              "allowed_values": false,
              "binding": true,
              "label": true
            }
          }
        }
      ]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "kind",
        "ref",
        "pruefbar"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "type": "string",
          "enum": [
            "trigger",
            "guardrail"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "kpi_level",
            "volume_guardrail",
            "composite_rule",
            "lifecycle_rule"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^trigger\\.",
          "description": "Path of the condition in this action code; comparator and threshold live there."
        },
        "kpi_id": {
          "type": "string",
          "pattern": "^KPI-[A-Z]+-[0-9]{3}$",
          "description": "Catalog KPI; equals metric_kpi_id under ref."
        },
        "pruefbar": {
          "type": "boolean"
        },
        "status": {
          "const": "nicht_belegt",
          "description": "pruefbar false only: the condition exists only as prose."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pruefbar": {
                "const": true
              }
            },
            "required": [
              "pruefbar"
            ]
          },
          "then": {
            "required": [
              "kpi_id"
            ],
            "properties": {
              "status": false,
              "kpi_id": true
            }
          },
          "else": {
            "required": [
              "status"
            ],
            "properties": {
              "kpi_id": false,
              "status": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "composite_rule",
                  "lifecycle_rule"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "pruefbar": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "condition"],
      "properties": {
        "severity": { "type": "string" },
        "condition": { "type": "object" }
      }
    }
  }
}
