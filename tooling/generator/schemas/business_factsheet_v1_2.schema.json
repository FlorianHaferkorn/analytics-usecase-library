{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Factsheet v1.2",
  "type": "object",
  "required": [
    "metadata",
    "summary",
    "business_questions",
    "required_kpis",
    "business_logic",
    "action_codes",
    "layout_330300",
    "data_requirements",
    "dependencies",
    "success_criteria",
    "risks"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["use_case_id", "use_case_name", "domain", "business_owner", "decision_owner", "reporting_level", "analytics_stage"],
      "properties": {
        "use_case_id": {"type": "string"},
        "use_case_name": {"type": "string"},
        "domain": {"type": "string"},
        "business_owner": {"type": "string"},
        "decision_owner": {"type": "string"},
        "kpi_owner": {"type": "string"},
        "reporting_level": {"type": "string"},
        "analytics_stage": {"type": "string"},
        "status": {"type": "string"},
        "links": {
          "type": "object",
          "properties": {
            "dataset_model": {"type": "string"},
            "page_template": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["purpose", "business_value", "out_of_scope"],
      "properties": {
        "purpose": {"type": "string"},
        "business_value": {"type": "string"},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "business_questions": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string"}
    },
    "required_kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "definition_short", "unit", "grain", "agg", "target", "interpretation"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "definition_short": {"type": "string"},
          "unit": {"type": "string"},
          "grain": {"type": "string"},
          "agg": {"type": "string"},
          "target": {"type": "string"},
          "interpretation": {"type": "string"},
          "lineage": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "business_logic": {
      "type": "object",
      "properties": {
        "logic_summary": {"type": "string"},
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kpi", "condition", "threshold", "scope", "action_code"],
            "properties": {
              "kpi": {"type": "string"},
              "condition": {"type": "string"},
              "threshold": {"type": "string"},
              "scope": {"type": "string"},
              "exclusion": {"type": "string"},
              "action_code": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "action_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "trigger", "description", "expected_kpi_impact", "level", "owner"],
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "trigger": {"type": "string"},
          "description": {"type": "string"},
          "expected_kpi_impact": {"type": "string"},
          "level": {"type": "string"},
          "owner": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "layout_330300": {
      "type": "object",
      "required": ["kpi_cards", "visuals_30s", "diagnostics_300s", "slicers"],
      "properties": {
        "kpi_cards": {"type": "array", "items": {"type": "string"}},
        "visuals_30s": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["visual_name", "visual_type", "x_axis", "y_axis", "segment", "default_filters"],
            "properties": {
              "visual_name": {"type": "string"},
              "visual_type": {"type": "string"},
              "x_axis": {"type": "string"},
              "y_axis": {"type": "string"},
              "segment": {"type": "string"},
              "default_filters": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "diagnostics_300s": {
          "type": "array",
          "items": {"type": "string"}
        },
        "slicers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "data_requirements": {
      "type": "object",
      "properties": {
        "required_facts": {"type": "array", "items": {"type": "string"}},
        "required_dimensions": {"type": "array", "items": {"type": "string"}},
        "required_grain": {"type": "string"},
        "required_time_range": {"type": "string"},
        "required_slicers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "success_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
