{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_registry.schema.json",
  "title": "Visual Registry",
  "description": "Machine-readable contracts for every information block: purpose, slot compatibility, required inputs, allowed visuals, forbidden visuals, quality rules. Authority: studio/docs/rebuild/VISUAL_BAUKASTEN.md.",
  "type": "object",
  "required": ["registry_version", "information_blocks"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "information_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/information_block"}
    }
  },
  "additionalProperties": false,

  "$defs": {

    "block_id": {
      "type": "string",
      "enum": [
        "status_signal", "time_trend", "variance_explanation",
        "entity_ranking", "exception_list", "structural_mix",
        "prescriptive_action", "detail_matrix", "root_cause_context"
      ]
    },

    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },

    "layer": {
      "type": "string",
      "enum": ["3s", "30s", "300s"]
    },

    "input_field": {
      "type": "object",
      "required": ["field", "mandatory"],
      "properties": {
        "field":     {"type": "string"},
        "type":      {"type": "string"},
        "mandatory": {"type": "boolean"},
        "note":      {"type": "string"},
        "values":    {"type": "array", "items": {"type": "string"}},
        "computed":  {"type": "string"},
        "formula":   {"type": "string"},
        "validation":{"type": "string"},
        "grain":     {"type": "array", "items": {"type": "string"}},
        "example":   {"type": "string"},
        "format":    {"type": "string"},
        "max_items": {"type": "integer"},
        "max_words": {"type": "integer"},
        "max_sentences": {"type": "integer"},
        "item_schema": {"type": "object"}
      },
      "additionalProperties": false
    },

    "allowed_visual": {
      "type": "object",
      "required": ["visual_id", "pbip_type", "is_default", "condition", "source"],
      "properties": {
        "visual_id":           {"type": "string"},
        "pbip_type":           {"type": "string"},
        "is_default":          {"type": "boolean"},
        "condition":           {"type": ["string", "null"]},
        "source":              {"type": "string"},
        "orientation":         {"type": "string", "enum": ["horizontal", "vertical"]},
        "small_multiples":     {"type": "boolean"},
        "custom_visual_name":  {"type": "string"}
      },
      "additionalProperties": false
    },

    "forbidden_visual": {
      "type": "object",
      "required": ["visual_id", "reason"],
      "properties": {
        "visual_id":   {"type": "string"},
        "pbip_type":   {"type": ["string", "null"]},
        "reason":      {"type": "string"},
        "applies_when":{"type": "string"}
      },
      "additionalProperties": false
    },

    "quality_rule": {
      "type": "object",
      "required": ["rule_id", "description", "source", "severity"],
      "properties": {
        "rule_id":     {"type": "string"},
        "description": {"type": "string"},
        "source":      {"type": "string"},
        "severity":    {"$ref": "#/$defs/severity"},
        "applies_when":{"type": "string"}
      },
      "additionalProperties": false
    },

    "information_block": {
      "type": "object",
      "required": ["block_id", "purpose", "primary_layer", "slot_compatibility",
                   "page_types", "required_inputs", "allowed_visuals",
                   "forbidden_visuals", "quality_rules"],
      "properties": {
        "block_id":             {"$ref": "#/$defs/block_id"},
        "purpose":              {"type": "string"},
        "primary_layer":        {"$ref": "#/$defs/layer"},
        "slot_compatibility":   {"type": "array", "items": {"type": "string"}},
        "page_types":           {"type": "array", "items": {"type": "string", "enum": ["T1","T2","T3","T4"]}},
        "layer_restriction":    {"type": "string"},
        "action_code_required": {"type": "boolean"},
        "activation_condition": {"type": "string"},
        "required_inputs":      {"type": "array", "items": {"$ref": "#/$defs/input_field"}},
        "allowed_visuals":      {"type": "array", "items": {"$ref": "#/$defs/allowed_visual"}},
        "forbidden_visuals":    {"type": "array", "items": {"$ref": "#/$defs/forbidden_visual"}},
        "quality_rules":        {"type": "array", "items": {"$ref": "#/$defs/quality_rule"}}
      },
      "additionalProperties": false
    }
  }
}
