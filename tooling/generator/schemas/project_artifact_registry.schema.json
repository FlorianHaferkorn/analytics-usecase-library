{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/project-package/artifact-registry/2.0.0",
  "title": "Project artifact and publication lifecycle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts", "publication_events"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "publication_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/publication_event"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "revision", "audience", "authority", "source_ref",
        "source_sha256", "content_state", "share_approval", "publication_state",
        "customer_decision", "decision_refs", "evidence_refs", "generated_from_refs",
        "generated_outputs", "superseded_by_ref"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "audience": {"enum": ["internal", "customer"]},
        "authority": {
          "enum": ["authored_source", "generated_projection", "evidence"]
        },
        "source_ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "content_state": {
          "enum": ["draft", "review_ready", "approved", "superseded"]
        },
        "share_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decided_by_ref", "evidence_refs"],
          "properties": {
            "state": {"enum": ["not_requested", "pending", "approved", "rejected"]},
            "decided_by_ref": {"type": ["string", "null"]},
            "evidence_refs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "publication_state": {
          "enum": ["never_shared", "shared_unverified", "shared_for_review", "sent_frozen"]
        },
        "customer_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decided_by_ref", "evidence_refs"],
          "properties": {
            "state": {"enum": ["not_requested", "pending", "accepted", "rejected"]},
            "decided_by_ref": {"type": ["string", "null"]},
            "evidence_refs": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "generated_from_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "generated_outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/generated_output"}
        },
        "superseded_by_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/identifier"}
          ]
        }
      }
    },
    "generated_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "output_ref", "media_type", "sha256", "generated_at", "generator_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "output_ref": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "generated_at": {"type": "string", "format": "date-time"},
        "generator_ref": {"type": "string", "minLength": 1}
      }
    },
    "publication_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "artifact_ref", "artifact_revision", "event_type", "occurred_at",
        "actor_ref", "channel", "destination_ref", "file_ref", "file_sha256",
        "evidence_refs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "artifact_ref": {"$ref": "#/$defs/identifier"},
        "artifact_revision": {"type": "integer", "minimum": 1},
        "event_type": {"enum": ["shared_for_review", "sent_frozen"]},
        "occurred_at": {"type": "string", "format": "date-time"},
        "actor_ref": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "destination_ref": {"type": "string", "minLength": 1},
        "file_ref": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
