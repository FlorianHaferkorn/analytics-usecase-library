{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Contract",
  "type": "object",
  "required": [
    "domain",
    "version",
    "owner",
    "dimension",
    "fact"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "dimension": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "name",
              "columns"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "string"
                    },
                    "nullable": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    },
                    "allowed_values": {
                      "type": "array",
                      "description": "Enumerated domain of values — grounds NL -> column-value mapping and the column `Values:` projection.",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "synonyms": {
                      "type": "array",
                      "description": "Curated natural-language synonyms — projected into the model linguistic schema (cultures/linguisticMetadata) for Copilot/Q&A and into the `///` Synonyms facet.",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "uses_columns": {
                "$ref": "#/$defs/uses_columns"
              }
            },
            "additionalProperties": true,
            "not": {
              "required": [
                "conformed_from"
              ]
            }
          },
          {
            "$ref": "#/$defs/conformed_reference"
          }
        ]
      }
    },
    "fact": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "name",
              "grain",
              "columns"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "grain": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "agg": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "string"
                    },
                    "nullable": {
                      "type": "boolean"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "cardinality": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "allowed_values": {
                      "type": "array",
                      "description": "Enumerated domain of values — grounds NL -> column-value mapping and the column `Values:` projection.",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "synonyms": {
                      "type": "array",
                      "description": "Curated natural-language synonyms — projected into the model linguistic schema (cultures/linguisticMetadata) for Copilot/Q&A and into the `///` Synonyms facet.",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "uses_columns": {
                "$ref": "#/$defs/uses_columns"
              }
            },
            "additionalProperties": true,
            "not": {
              "required": [
                "conformed_from"
              ]
            }
          },
          {
            "$ref": "#/$defs/conformed_reference"
          }
        ]
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "grain_rules": {
          "type": "string"
        },
        "naming": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "time_zone": {
          "type": "string"
        },
        "storage_mode": {
          "type": "string",
          "enum": [
            "Import",
            "DirectLake"
          ],
          "description": "Partition mode for all tables in this contract. Import = M/Power Query partitions (local parquet). DirectLake = entity partitions pointing to Fabric Lakehouse Delta tables."
        },
        "lakehouse_id": {
          "type": "string",
          "description": "Fabric Lakehouse item GUID. Required when storage_mode = DirectLake. Used to build the DL_Lakehouse named expression in expressions.tmdl."
        },
        "workspace_id": {
          "type": "string",
          "description": "Fabric Workspace GUID. Required when storage_mode = DirectLake."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "conformed_reference": {
      "type": "object",
      "description": "Conformed reference (Bus-Matrix, 29.09.2026): the table is defined once, in the owning domain named by conformed_from; this domain only uses it. No columns, no own table fields.",
      "required": [
        "name",
        "conformed_from"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "conformed_from": {
          "type": "string",
          "description": "Owning domain (its `domain:` value) that holds the only definition."
        },
        "uses_columns": {
          "$ref": "#/$defs/uses_columns"
        }
      },
      "additionalProperties": false
    },
    "uses_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Columns of the definition this domain's model uses (domain view); default all."
    }
  }
}
