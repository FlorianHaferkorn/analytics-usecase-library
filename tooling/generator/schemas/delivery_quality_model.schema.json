{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.local/schemas/delivery-quality-model/1.0.0",
  "title": "Delivery quality reference model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "dimensions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "text": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "strength_adopted", "reviewed_at", "review_interval_days"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "strength_adopted": {"$ref": "#/$defs/text"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_interval_days": {"type": "integer", "minimum": 1, "maximum": 365}
      }
    },
    "detector": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["module_present", "package_approved", "approved_decisions_evidenced", "capability_questions_resolved", "identity_contract_ready", "architecture_maintenance_ready", "observed_evidence_collected"]},
        "module_type": {"type": "string"}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "requirement", "weight", "gate", "source", "detector"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "requirement": {"$ref": "#/$defs/text"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 10},
        "gate": {"enum": ["advisory", "build_ready", "apply_ready", "acceptance_ready"]},
        "source": {"$ref": "#/$defs/source"},
        "detector": {"$ref": "#/$defs/detector"}
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "intent", "controls"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "intent": {"$ref": "#/$defs/text"},
        "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}}
      }
    }
  }
}
