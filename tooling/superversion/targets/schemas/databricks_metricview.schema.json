{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aluca.dev/schemas/databricks_metricview.schema.json",
  "title": "Databricks Metric View (docs-derived, ALUCA-authored — NOT the vendor validator)",
  "description": "Structural JSON Schema authored from the official Databricks Metric View YAML reference (docs.databricks.com/.../metric-views/yaml-reference, version 1.1, retrieved 2026-06-25). The authoritative validator is a Databricks workspace; this schema is the local structural gate (Ehrlichkeit v3).",
  "type": "object",
  "required": ["version", "source"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Metric view spec version (defaults to 1.1).",
      "oneOf": [{ "type": "string" }, { "type": "number" }]
    },
    "source": {
      "type": "string",
      "description": "Source table-like asset or SQL query."
    },
    "filter": { "type": "string", "description": "SQL boolean expression applied to all queries." },
    "comment": { "type": "string", "description": "Description of the metric view." },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "on": { "type": "string" },
          "using": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expr"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "expr": { "type": "string" },
          "comment": { "type": "string" }
        }
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expr"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "expr": { "type": "string" },
          "comment": { "type": "string" }
        }
      }
    }
  }
}
