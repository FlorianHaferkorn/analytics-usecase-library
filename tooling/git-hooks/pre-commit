#!/bin/sh
# Pre-commit hook (drei Gates):
#   1.   claude-repo-kit strict drift/quality gate — laeuft bei JEDEM Commit (guenstig;
#        prueft nur _INDEX.md-Bereiche + CLAUDE.md/GOI_DOKTRIN.md-Platzhalter).
#   1.5  Kundenkennungen — laeuft bei JEDEM Commit, nur auf gestagten Dateien.
#   2.   ontology registry builder (strict) — nur wenn core/-Pfade gestagt sind.
# Install/refresh via: .\tooling\git-hooks\install_precommit.ps1
set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
export PYTHONUTF8=1  # avoid cp1252 UnicodeEncodeError on Windows when findings contain ä/ü/ß

# Prefer py -3 (Windows launcher), fallback to python3/python
if command -v py >/dev/null 2>&1; then
  PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
elif command -v python >/dev/null 2>&1; then
  PY="python"
else
  echo "pre-commit: Python 3 not found. Install Python or run: .\tooling\git-hooks\install_precommit.ps1"
  exit 1
fi

# Gate 1: claude-repo-kit strict drift/quality gate (blocks unfilled {{…}}, dead paths, index drift)
$PY scripts/check_index.py --strict || exit 1

# Gate 1.5: Kundenkennungen (04.09.2026). Steht vor dem core/-Fastpath, damit auch ein
# reiner Docs- oder Studio-Commit geprueft wird — genau dort kommen solche Kennungen
# ueblicherweise herein.
#
# Nur gestagte Dateien, dieselbe Doktrin wie die Nachbar-Gates: ein Hook, der den ganzen
# Baum scannte, blockierte jeden Commit bis der Rueckstand weg ist — und waere ab dem
# zweiten Mal umgangen. Der vollstaendige Durchlauf ist ein eigener, bewusster Aufruf
# (`python tooling/validation/check_kundendaten.py`).
#
# Dieses Repository bekommt weitere Leser, deshalb gehoert das Gate, das das Solo-Produkt
# seit Monaten hat, auch hierher. Ohne seine Sperrliste bricht der Pruefer ab, statt Erfolg
# zu melden — ein Pruefer, der ohne seine Regeln gruen meldet, ist schlimmer als keiner.
# Die Sperrliste ist gitignoriert; in Cloud-Sitzungen und frischen Klonen fehlt sie. Dann
# laeuft der Pruefer nicht und der Commit traegt ein lautes [UNGEPRUEFT] statt eines
# Abbruchs, der jeden Commit anhaelt (29.09.2026, gleiche Linie wie Freelancing).
# Bereitstellen: `.kundendaten-sperrliste.json` im Repo-Wurzelordner oder
# `KUNDENDATEN_SPERRLISTE=<pfad>` (z. B. aus einem Umgebungs-Secret).
if [ -n "${KUNDENDATEN_SPERRLISTE:-}" ] && [ -f "$KUNDENDATEN_SPERRLISTE" ]; then
  $PY tooling/validation/check_kundendaten.py --staged --leise --sperrliste "$KUNDENDATEN_SPERRLISTE" || exit 1
elif [ -f .kundendaten-sperrliste.json ]; then
  $PY tooling/validation/check_kundendaten.py --staged --leise || exit 1
else
  echo "pre-commit: [UNGEPRUEFT] Kundendaten -- keine Sperrliste (.kundendaten-sperrliste.json" >&2
  echo "            bzw. KUNDENDATEN_SPERRLISTE). Dieser Commit ist NICHT auf Kundenkennungen geprueft." >&2
fi

# Gate 2: ontology registry — fast path: skip if no core/ paths staged.
# --cached = staged only · --name-only = paths only · --diff-filter=ACMR excludes Deleted
CORE_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^core/' || true)
if [ -z "$CORE_STAGED" ]; then
  echo "pre-commit: no core/ changes staged — skipping ontology registry build."
  exit 0
fi

echo "pre-commit: core/ changes detected — running ontology registry build (strict)..."
exec $PY tooling/ontology/registry_builder.py --out-dir tooling/ontology/out --strict
