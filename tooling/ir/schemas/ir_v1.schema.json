{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionReady Intermediate Representation (IR) v1.0",
  "description": "Stable, tool-agnostic adapter ABI derived from Core ABI (registry outputs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "generated_at_utc",
    "source",
    "objects"
  ],
  "properties": {
    "measure_spec": {
      "type": "object",
      "description": "Optional. kpi_id -> measure_spec_item for IR-first adapters.",
      "additionalProperties": { "$ref": "#/$defs/measure_spec_item" }
    },
    "ir_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)(?:\\.[0-9]+)?$",
      "description": "IR major version 1.x (minor/patch optional)."
    },
    "generated_at_utc": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_abi"
      ],
      "properties": {
        "core_abi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "master_registry_path",
            "value_map_path"
          ],
          "properties": {
            "master_registry_path": { "type": "string" },
            "value_map_path": { "type": "string" },
            "core_abi_version": { "type": "string" }
          }
        }
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_cases",
        "kpis",
        "action_codes"
      ],
      "properties": {
        "use_cases": {
          "type": "object",
          "description": "Use cases keyed by use_case_id.",
          "additionalProperties": { "$ref": "#/$defs/use_case" }
        },
        "kpis": {
          "type": "object",
          "description": "KPIs keyed by kpi_id.",
          "additionalProperties": { "$ref": "#/$defs/kpi" }
        },
        "action_codes": {
          "type": "object",
          "description": "Action codes keyed by action_code_id.",
          "additionalProperties": { "$ref": "#/$defs/action_code" }
        }
      }
    }
  },
  "$defs": {
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_role": { "type": ["string", "null"] },
        "steward_role": { "type": ["string", "null"] }
      }
    },
    "use_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "governance",
        "orchestration"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "domain": { "type": "string" },
        "governance": { "$ref": "#/$defs/governance" },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategic_kpi_id",
            "influencing_kpi_ids",
            "action_code_ids"
          ],
          "properties": {
            "strategic_kpi_id": { "type": ["string", "null"] },
            "influencing_kpi_ids": { "type": "array", "items": { "type": "string" } },
            "supporting_kpi_ids": { "type": "array", "items": { "type": "string" } },
            "action_code_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "value_driver_model": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "ux_layout_rules": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Copied from bracket for tool adapters (3-30-300 primitives)."
        },
        "documentation": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "edges": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true },
          "description": "Optional derived edges for adapter convenience."
        }
      }
    },
    "kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": { "type": "string" },
        "kpi_role": { "type": ["string", "null"] },
        "computed_role_global": { "type": ["string", "null"] },
        "governance": { "type": ["object", "null"], "additionalProperties": true },
        "trust_score": { "type": ["integer", "null"] },
        "linked_domain_contracts": { "type": "array", "items": { "type": "string" } },
        "data_contract_risk": { "type": ["string", "null"] },
        "causal_links": { "type": ["object", "null"], "additionalProperties": true },
        "source": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "action_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "owner_domain": { "type": ["string", "null"] },
        "governance": { "$ref": "#/$defs/governance" },
        "impact_valuation": { "type": ["object", "null"], "additionalProperties": true },
        "execution_bridge": { "type": ["object", "null"], "additionalProperties": true },
        "source": { "type": ["object", "null"], "additionalProperties": true },
        "trigger_summary": { "type": ["string", "null"] },
        "owner_role": { "type": ["string", "null"] },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "measure_spec_item": {
      "type": "object",
      "description": "Per-KPI measure spec for IR-first adapters (no direct Core reads).",
      "additionalProperties": false,
      "properties": {
        "dax_expression": { "type": ["string", "null"] },
        "format_string": { "type": "string" },
        "dax_name": { "type": ["string", "null"] },
        "display_folder": { "type": "string" },
        "description": { "type": "string" },
        "purpose": { "type": "string" },
        "kpi_key": { "type": ["string", "null"] }
      }
    }
  }
}

