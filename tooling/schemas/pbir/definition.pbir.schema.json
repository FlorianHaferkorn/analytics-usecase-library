{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://developer.microsoft.com/json-schemas/fabric/item/report/definitionProperties/2.0.0/schema.json",
  "title": "PBIR definition.pbir",
  "description": "Cached schema for definition.pbir (report-to-model binding). Source: Microsoft Fabric JSON Schemas.",
  "type": "object",
  "required": ["$schema", "version", "datasetReference"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "PBIR format version.",
      "enum": ["4.0", "4.1", "4.2", "5.0"]
    },
    "datasetReference": {
      "type": "object",
      "description": "Reference to the semantic model. Exactly one of byPath or byConnection must be set.",
      "oneOf": [
        {
          "required": ["byPath"],
          "properties": {
            "byPath": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Relative path to the .SemanticModel directory. Local Desktop use only; use byConnection for Fabric deployment."
                }
              }
            }
          }
        },
        {
          "required": ["byConnection"],
          "properties": {
            "byConnection": {
              "type": "object",
              "required": ["sourceType", "pbiModelVirtualServerName", "pbiModelDatabaseName", "connectionString"],
              "properties": {
                "sourceType": {
                  "type": "string",
                  "const": "Model"
                },
                "pbiModelVirtualServerName": {
                  "type": "string",
                  "const": "sobe_wowvirtualserver"
                },
                "pbiModelDatabaseName": {
                  "type": "string",
                  "description": "Fabric SemanticModel item GUID.",
                  "minLength": 36,
                  "maxLength": 36
                },
                "connectionString": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  }
}
