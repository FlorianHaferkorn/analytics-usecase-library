# =============================================================================
# Example environment variables. Copy to .env and set your values.
# The Studio loads .env from the repo root when you run it (python-dotenv).
# For Discovery Chat: set one LLM provider below.
# =============================================================================

# --- Google Gemini (Discovery Chat) ---
# Get key: https://aistudio.google.com/app/apikey or Google Cloud Console
# Enable "Generative Language API" for the key.
GOOGLE_API_KEY=
# Alternative name (same key):
# GEMINI_API_KEY=
# Optional model (default: gemini-2.5-flash). If 404, try gemini-2.0-flash or see ai.google.dev/gemini-api/docs/models:
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (Discovery Chat, fallback if no Gemini/Azure) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (Discovery Chat) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Repo / project (optional) ---
# ANALYTICS_SHOWCASE=aurora_group
# GITHUB_TOKEN=
# PROJECT_NUMBER=
# PROJECT_SCOPE=user
# PROJECT_OWNER=
