{
  "standardVersion": "1.0.0",
  "name": "oss-report-production",
  "description": "Verbindlicher Produktionsstandard fuer den OSS Evidence/dbt Adapter.",
  "referenceUseCases": [
    "COM-001",
    "COM-004"
  ],
  "requirements": {
    "stage1": {
      "required": true,
      "command": ".\\tooling\\run_stage1_checks.ps1"
    },
    "adapterBuild": {
      "required": true,
      "command": ".\\products\\open_source_stack\\tooling\\adapter_build.ps1"
    },
    "ossValidate": {
      "required": true,
      "command": ".\\products\\open_source_stack\\tooling\\validate_oss.py"
    }
  },
  "slos": {
    "consecutiveGreenRuns": 3,
    "maxUnknownErrorClasses": 1,
    "requireManualIntervention": false
  },
  "supervisor": {
    "maxIterations": 5,
    "stopOnStage1Failure": true,
    "writeRunManifest": true
  }
}