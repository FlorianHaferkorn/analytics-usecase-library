# Fabric Enterprise Orchestrator v2.0 - Configuration
# Copy to config.yaml and adjust for your tenant

# Default strategy: enterprise (9 workspaces) or compact (3 workspaces)
default_strategy: enterprise

strategy:
  enterprise:
    folder_pattern: "domains/{domain}/{layer}"
  compact:
    folder_pattern: "domains/{domain}/{env}"

fabric:
  tenant_id: "YOUR_TENANT_ID"  # Azure AD Tenant ID
  authority: "https://login.microsoftonline.com/{tenant_id}"
  api_base: "https://api.fabric.microsoft.com/v1"
  scopes:
    - "https://api.fabric.microsoft.com/.default"

# Capacity mapping per environment
# Provide either SKU name or direct capacity_id
capacities:
  dev:
    sku: "F2"
    capacity_id: "00000000-0000-0000-0000-000000000000"  # Replace with actual ID
  test:
    sku: "F4"
    capacity_id: "11111111-1111-1111-1111-111111111111"
  prod:
    sku: "F8"
    capacity_id: "22222222-2222-2222-2222-222222222222"

# Git provider configuration (GitHub or Azure DevOps)
git_provider:
  type: "github"  # or "azuredevops"
  repo_url: "https://github.com/your-org/your-repo"
  organization: "your-org"
  project: "your-project"  # Azure DevOps only
  repository: "your-repo"
  branches:
    dev: "dev"
    test: "test"
    prod: "main"
  folder_pattern: "domains/{domain}/{layer}"  # Workspace folder pattern

# Governance settings
governance:
  sensitivity_labels:
    # purview_policy (default) — a Purview default/mandatory label policy applies the
    #   label; the orchestrator only reports the requirement. No API call.
    #   There is NO workspace-level label API; labels attach to items.
    # admin_api — call POST https://api.fabric.microsoft.com/v1/admin/items/bulkSetLabels
    #   (Learn rest/api/fabric/admin/labels/bulk-set-labels, read 01.10.2026): all Fabric
    #   item types of its ItemType enumeration, not only reports/semantic models.
    #   Requires: label GUIDs below (not names), a Fabric Administrator *user* with
    #   Tenant.ReadWrite.All and the label in that user's label policy; caps 25 req/h and
    #   2,000 items/req. Service principals and managed identities are NOT supported, so
    #   this SPN-only orchestrator refuses the call and records a manual step.
    # off — labelling out of scope for this deployment.
    mode: "purview_policy"
    dev: "General"        # display name in purview_policy mode, label GUID in admin_api mode
    test: "General"
    prod: "Confidential"
  endorsement:
    # Recorded as a manual step only: Promoted/Certified/Master data have no documented
    # write REST API. 'Certified' additionally needs the tenant certification setting
    # plus membership in an authorized security group.
    anl_layer: "Promoted"  # Endorsement for Analytics layer items
    semantic_models: true

# Deployment pipelines policy
deployment_pipelines:
  auto_create: true  # Create pipeline automatically in init-domain
  naming_pattern: "{domain}_Pipeline"
  stages:
    - order: 0
      name: "Development"
      env: "dev"
    - order: 1
      name: "Test"
      env: "test"
    - order: 2
      name: "Production"
      env: "prod"

# Domain definitions
domains:
  - name: "Sales"
    layers:
      - "Src"
      - "Trf"
      - "Anl"
    description: "Sales domain - Medallion architecture"
  
  - name: "Finance"
    layers:
      - "Src"
      - "Trf"
      - "Anl"
    description: "Finance domain - Medallion architecture"

# Layer definitions
layers:
  Src:
    full_name: "Source"
    description: "Bronze/Silver - Lakehouse ingestion and cleansing"
    item_types:
      - "Lakehouse"
      - "Notebook"
      - "DataPipeline"
  
  Trf:
    full_name: "Transform"
    description: "Gold - Warehouse transformation (dbt)"
    item_types:
      - "Warehouse"
      - "Notebook"
  
  Anl:
    full_name: "Analytics"
    description: "Semantic Models and Reports (Direct Lake)"
    item_types:
      - "SemanticModel"
      - "Report"

# Environment-specific parameters for deployment
parameters:
  dev:
    connection_string_pattern: "dev-sql.database.windows.net"
  test:
    connection_string_pattern: "test-sql.database.windows.net"
  prod:
    connection_string_pattern: "prod-sql.database.windows.net"

# OneLake shortcuts configuration
onelake_shortcuts:
  enabled: true
  auto_create: true  # Auto-create shortcuts from Src to Trf
  source_layer: "Src"
  target_layer: "Trf"
  shortcut_pattern: "/Tables/{table_name}"

# Retry and rate limit settings
retry:
  max_retries: 3
  initial_delay: 1.0  # seconds
  backoff_multiplier: 2.0
  # HTTP 429 by errorCode (Learn rest/api/fabric/articles/throttling):
  #   RequestBlocked        -> wait exactly Retry-After; above max_retry_after the call fails
  #   CapacityLimitExceeded -> exponential backoff with jitter from capacity_initial_delay,
  #                            capped at capacity_max_delay (never an immediate retry)
  capacity_initial_delay: 30.0  # seconds
  capacity_max_delay: 300.0     # seconds
  max_retry_after: 300.0        # seconds
  transient_status_codes:
    - 429  # Too Many Requests
    - 500  # Internal Server Error
    - 502  # Bad Gateway
    - 503  # Service Unavailable
    - 504  # Gateway Timeout

# Logging
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  format: "json"  # json or text
  output: "stdout"  # stdout or file path
