/// Cost breakdown (COGS, material, overhead) per plant-line-product-month
table fact_cost
	lineageTag: 360259ee-a545-5fde-bc7d-086f89c12271
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		sourceColumn: ProductKey
		summarizeBy: none
	column 'COGS Amount'
		dataType: Decimal
		sourceColumn: COGS Amount
		summarizeBy: none
	column 'Material Cost Amount'
		dataType: Decimal
		sourceColumn: Material Cost Amount
		summarizeBy: none
	column 'Overhead Amount'
		dataType: Decimal
		sourceColumn: Overhead Amount
		summarizeBy: none
	partition fact_cost = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_cost"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
