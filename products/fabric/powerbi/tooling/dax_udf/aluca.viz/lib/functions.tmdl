/// Deviation bar - signed variance as bar length from a zero=target line, semantic colour by sign.
/// Governed ALUCA idiom `deviation_bar`. House vs IBCS differ only by params (IBCS: colZero = "#201F1E").
/// @param {numeric expr} delta - variance measure (Delta vs plan/target), e.g. a fraction like -0.018
/// @param {string} [colPos] - hex for favourable (>=0). Default "#107C10"
/// @param {string} [colNeg] - hex for unfavourable (<0). Default "#A4262C"
/// @param {double} [fullScale] - the absolute delta that fills half the track. Default 0.05
/// @param {string} [colTrack] - hex for the track. Default "#EFF2F5"
/// @param {string} [colZero] - hex for the zero/target line (IBCS: "#201F1E"). Default "#586472"
/// @returns {string} SVG data URI
function 'AlucaViz.DeviationBar' =
	(
		delta: NUMERIC EXPR,
		colPos: STRING = "#107C10",
		colNeg: STRING = "#A4262C",
		fullScale: DOUBLE = 0.05,
		colTrack: STRING = "#EFF2F5",
		colZero: STRING = "#586472"
	) =>
		VAR _dlt = delta
		VAR _col = IF ( _dlt < 0, colNeg, colPos )
		VAR _len = MIN ( ABS ( _dlt ) / fullScale * 146, 146 )
		VAR _x = IF ( _dlt < 0, 170 - _len, 170 )
		RETURN
			IF ( NOT ISBLANK ( _dlt ),
				"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 340 60'>"
					& "<rect x='24' y='24' width='292' height='12' rx='6' fill='" & colTrack & "'/>"
					& "<rect x='" & _x & "' y='24' width='" & _len & "' height='12' rx='3' fill='" & _col & "'/>"
					& "<line x1='170' y1='19' x2='170' y2='41' stroke='" & colZero & "' stroke-width='1.5'/>"
					& "</svg>" )

	annotation DAXLIB_PackageId = AlucaViz
	annotation DAXLIB_PackageVersion = 0.2.0

/// Bullet graph - actual bar vs a target tick. House shows Few grey bands; IBCS drops them
/// (showBands = 0) with a neutral tick. Governed ALUCA idiom `bullet`.
/// @param {numeric expr} actual - the actual measure (0..1 fraction)
/// @param {numeric expr} target - the target measure (0..1 fraction)
/// @param {int64} [showBands] - 1 = Few grey bands (house), 0 = clean (IBCS). Default 1
/// @param {double} [bandOk] - upper bound of the poor band (0..100). Default 80
/// @param {double} [bandGood] - upper bound of the ok band (0..100). Default 92
/// @param {string} [colActual] - hex actual bar. Default "#0F2430"
/// @param {string} [colTarget] - hex target tick (IBCS: neutral "#605E5C"). Default "#A4262C"
/// @returns {string} SVG data URI
function 'AlucaViz.Bullet' =
	(
		actual: NUMERIC EXPR,
		target: NUMERIC EXPR,
		showBands: INT64 = 1,
		bandOk: DOUBLE = 80,
		bandGood: DOUBLE = 92,
		colActual: STRING = "#0F2430",
		colTarget: STRING = "#A4262C"
	) =>
		VAR _a = actual * 100
		VAR _t = target * 100
		VAR _bands =
			IF ( showBands = 1,
				"<rect x='0' y='0' width='" & bandOk & "' height='14' fill='#E7EAEE'/>"
					& "<rect x='" & bandOk & "' y='0' width='" & ( bandGood - bandOk ) & "' height='14' fill='#D6DCE2'/>"
					& "<rect x='" & bandGood & "' y='0' width='" & ( 100 - bandGood ) & "' height='14' fill='#C6CED5'/>",
				"" )
		RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
				& _bands
				& "<rect x='0' y='4' width='" & _a & "' height='6' fill='" & colActual & "'/>"
				& "<line x1='" & _t & "' y1='1' x2='" & _t & "' y2='13' stroke='" & colTarget & "' stroke-width='2'/>"
				& "</svg>"

	annotation DAXLIB_PackageId = AlucaViz
	annotation DAXLIB_PackageVersion = 0.2.0
/// Horizontal ranking bar - length = value / max(value) across the visible scope, semantic colour vs a threshold.
/// Governed ALUCA idiom `bar_ranking`. Bind in a table/matrix keyed by the scope column (imageHeight/Width on the grid).
/// @param {numeric expr} value - the ranked measure, e.g. [Gross Margin %]
/// @param {columnref expr} scope - the category column the ranking is over, e.g. 'dim_org'[OrgName]
/// @param {double} [threshold] - values below this get colBad (0..1 fraction). Default 0 (never bad)
/// @param {string} [colBar] - hex for at/above threshold. Default "#0F2430"
/// @param {string} [colBad] - hex for below threshold. Default "#A4262C"
/// @returns {string} SVG data URI, blank on subtotal/total rows
function 'AlucaViz.BarRanking' =
	(
		value: NUMERIC EXPR,
		scope: COLUMNREF EXPR,
		threshold: DOUBLE = 0,
		colBar: STRING = "#0F2430",
		colBad: STRING = "#A4262C"
	) =>
		VAR _v = value
		VAR _max = CALCULATE ( MAXX ( ALLSELECTED ( scope ), value ), REMOVEFILTERS ( scope ) )
		VAR _w = DIVIDE ( _v, _max ) * 100
		VAR _col = IF ( _v < threshold, colBad, colBar )
		RETURN
			IF ( HASONEVALUE ( scope ),
				"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
					& "<rect x='0' y='2' width='" & _w & "' height='10' fill='" & _col & "'/>"
					& "</svg>" )

	annotation DAXLIB_PackageId = AlucaViz
	annotation DAXLIB_PackageVersion = 0.2.0

/// Lollipop - stem + dot at value / max(value) across the visible scope; lighter ink weight than a full bar.
/// Governed ALUCA idiom `lollipop`. Bind in a table/matrix keyed by the scope column.
/// @param {numeric expr} value - the plotted measure, e.g. [Gross Margin %]
/// @param {columnref expr} scope - the category column, e.g. 'dim_org'[OrgName]
/// @param {double} [threshold] - values below this get colBad (0..1 fraction). Default 0 (never bad)
/// @param {string} [colDot] - hex for the dot at/above threshold. Default "#0F2430"
/// @param {string} [colBad] - hex for below threshold. Default "#A4262C"
/// @param {string} [colStem] - hex for the stem. Default "#D6DCE2"
/// @returns {string} SVG data URI, blank on subtotal/total rows
function 'AlucaViz.Lollipop' =
	(
		value: NUMERIC EXPR,
		scope: COLUMNREF EXPR,
		threshold: DOUBLE = 0,
		colDot: STRING = "#0F2430",
		colBad: STRING = "#A4262C",
		colStem: STRING = "#D6DCE2"
	) =>
		VAR _v = value
		VAR _max = CALCULATE ( MAXX ( ALLSELECTED ( scope ), value ), REMOVEFILTERS ( scope ) )
		VAR _x = DIVIDE ( _v, _max ) * 92 + 4
		VAR _col = IF ( _v < threshold, colBad, colDot )
		RETURN
			IF ( HASONEVALUE ( scope ),
				"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
					& "<line x1='4' y1='7' x2='" & _x & "' y2='7' stroke='" & colStem & "' stroke-width='2'/>"
					& "<circle cx='" & _x & "' cy='7' r='4' fill='" & _col & "'/>"
					& "</svg>" )

	annotation DAXLIB_PackageId = AlucaViz
	annotation DAXLIB_PackageVersion = 0.2.0

/// Sparkline - compact trend polyline of a measure over the last N months, autoscaled to its own min/max.
/// Governed ALUCA idiom `line` (svg_dax realization). Use in a single card/cell; no per-row guard needed.
/// @param {numeric expr} value - the trended measure, e.g. [Gross Margin %]
/// @param {columnref expr} dateCol - the date column to walk, e.g. 'dim_date'[Date]
/// @param {int64} [months] - trailing window length in months. Default 12
/// @param {string} [colLine] - hex for the line. Default "#0F2430"
/// @returns {string} SVG data URI
function 'AlucaViz.Sparkline' =
	(
		value: NUMERIC EXPR,
		dateCol: COLUMNREF EXPR,
		months: INT64 = 12,
		colLine: STRING = "#0F2430"
	) =>
		VAR _S = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( dateCol ), DATESINPERIOD ( dateCol, MAX ( dateCol ), - months, MONTH ) ), "@v", value )
		VAR _min = MINX ( _S, [@v] )
		VAR _max = MAXX ( _S, [@v] )
		VAR _xmin = MINX ( _S, dateCol )
		VAR _xmax = MAXX ( _S, dateCol )
		VAR _pts = CONCATENATEX ( _S, INT ( 100 * DIVIDE ( dateCol - _xmin, _xmax - _xmin ) ) & "," & INT ( 30 - 30 * DIVIDE ( [@v] - _min, _max - _min ) ), " ", dateCol )
		RETURN
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 30'>"
				& "<polyline fill='none' stroke='" & colLine & "' stroke-width='2' points='" & _pts & "'/>"
				& "</svg>"

	annotation DAXLIB_PackageId = AlucaViz
	annotation DAXLIB_PackageVersion = 0.2.0
