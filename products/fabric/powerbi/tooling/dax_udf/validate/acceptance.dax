// ============================================================================
// AlucaViz acceptance query — engine-level validation of the governed UDFs.
//
// HOW TO RUN: open any semantic model in Power BI Desktop (compat level 1702+),
// open DAX query view, paste this whole file, and Run. It DEFINEs the functions
// query-scoped (identical bodies to lib/functions.tmdl), so it validates the DAX
// parses and evaluates WITHOUT installing the package.
//
// PASS CRITERIA (Block A): every returned cell is a string beginning with
//   "data:image/svg+xml;utf8,<svg ...>" and ending with "</svg>". Copy any cell
//   into a browser address bar to eyeball the actual micro-chart.
//
// Block B (context-heavy idioms) needs real model columns — fill the <...>
// placeholders with a measure + a category/date column from YOUR model, then
// uncomment and run it in a table/matrix keyed by that column.
// ============================================================================

DEFINE
    FUNCTION 'DeviationBar' =
        (
            delta: NUMERIC EXPR,
            colPos: STRING = "#107C10",
            colNeg: STRING = "#A4262C",
            fullScale: DOUBLE = 0.05,
            colTrack: STRING = "#EFF2F5",
            colZero: STRING = "#586472"
        ) =>
            VAR _dlt = delta
            VAR _col = IF ( _dlt < 0, colNeg, colPos )
            VAR _len = MIN ( ABS ( _dlt ) / fullScale * 146, 146 )
            VAR _x = IF ( _dlt < 0, 170 - _len, 170 )
            RETURN
                IF ( NOT ISBLANK ( _dlt ),
                    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 340 60'>"
                        & "<rect x='24' y='24' width='292' height='12' rx='6' fill='" & colTrack & "'/>"
                        & "<rect x='" & _x & "' y='24' width='" & _len & "' height='12' rx='3' fill='" & _col & "'/>"
                        & "<line x1='170' y1='19' x2='170' y2='41' stroke='" & colZero & "' stroke-width='1.5'/>"
                        & "</svg>" )

    FUNCTION 'Bullet' =
        (
            actual: NUMERIC EXPR,
            target: NUMERIC EXPR,
            showBands: INT64 = 1,
            bandOk: DOUBLE = 80,
            bandGood: DOUBLE = 92,
            colActual: STRING = "#0F2430",
            colTarget: STRING = "#A4262C"
        ) =>
            VAR _a = actual * 100
            VAR _t = target * 100
            VAR _bands =
                IF ( showBands = 1,
                    "<rect x='0' y='0' width='" & bandOk & "' height='14' fill='#E7EAEE'/>"
                        & "<rect x='" & bandOk & "' y='0' width='" & ( bandGood - bandOk ) & "' height='14' fill='#D6DCE2'/>"
                        & "<rect x='" & bandGood & "' y='0' width='" & ( 100 - bandGood ) & "' height='14' fill='#C6CED5'/>",
                    "" )
            RETURN
                "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
                    & _bands
                    & "<rect x='0' y='4' width='" & _a & "' height='6' fill='" & colActual & "'/>"
                    & "<line x1='" & _t & "' y1='1' x2='" & _t & "' y2='13' stroke='" & colTarget & "' stroke-width='2'/>"
                    & "</svg>"

// ---- Block A: scalar idioms (model-independent) --------------------------------
// NOTE: DAX UDFs are called POSITIONALLY; there is no named-argument syntax. To pass a
// later optional, leave the earlier optionals empty. colZero is DeviationBar's 6th param
// (delta, colPos, colNeg, fullScale, colTrack, colZero); colTarget is Bullet's 7th.
EVALUATE
    SELECTCOLUMNS (
        { 1 },
        "case_DeviationBar_pos", DeviationBar ( 0.03 ),
        "case_DeviationBar_neg", DeviationBar ( -0.03 ),
        "case_DeviationBar_ibcs", DeviationBar ( -0.03, , , , , "#201F1E" ),
        "case_Bullet_house", Bullet ( 0.85, 0.92 ),
        "case_Bullet_ibcs", Bullet ( 0.85, 0.92, 0, , , , "#605E5C" )
    )

// ---- Block B: context-heavy idioms (need real columns) ------------------------
// Uncomment, replace <...>, and evaluate keyed by <SCOPE COLUMN> / <DATE COLUMN>.
//
// DEFINE
//     FUNCTION 'BarRanking' =
//         ( value: NUMERIC EXPR, scope: COLUMNREF EXPR, threshold: DOUBLE = 0,
//           colBar: STRING = "#0F2430", colBad: STRING = "#A4262C" ) =>
//             VAR _v = value
//             VAR _max = CALCULATE ( MAXX ( ALLSELECTED ( scope ), value ), REMOVEFILTERS ( scope ) )
//             VAR _w = DIVIDE ( _v, _max ) * 100
//             VAR _col = IF ( _v < threshold, colBad, colBar )
//             RETURN
//                 IF ( HASONEVALUE ( scope ),
//                     "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 14' preserveAspectRatio='none'>"
//                         & "<rect x='0' y='2' width='" & _w & "' height='10' fill='" & _col & "'/></svg>" )
// EVALUATE
//     ADDCOLUMNS ( VALUES ( <SCOPE COLUMN> ), "@bar", BarRanking ( <MEASURE>, <SCOPE COLUMN>, 0.441 ) )
//
// Sparkline (single cell): EVALUATE ROW ( "@spark", 'Sparkline' ( <MEASURE>, <DATE COLUMN> ) )
