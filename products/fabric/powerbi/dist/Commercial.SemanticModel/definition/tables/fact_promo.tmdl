/// Promotion costs and baseline (sales, quantity, non-promo baseline) per promotion.
table fact_promo
	lineageTag: 976724c4-73f1-487c-a663-2c0ccab95699

	column PromoKey
		dataType: int64
		isHidden
		lineageTag: ff22d92c-67b6-47f4-890b-40157317e88f
		summarizeBy: none
		sourceColumn: PromoKey

	column 'Promo Cost'
		dataType: double
		lineageTag: 840e252e-2338-40cb-8c78-f15d49908ce9
		summarizeBy: none
		sourceColumn: Promo Cost

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Funding Amount'
		dataType: double
		lineageTag: a00ac37a-23ba-4930-ad2b-ae99eacf8fa3
		summarizeBy: none
		sourceColumn: Funding Amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Baseline Sales Amount'
		dataType: double
		lineageTag: 6bfc4fce-866c-41d3-bcdc-9a2387755825
		summarizeBy: none
		sourceColumn: Baseline Sales Amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Baseline Quantity'
		dataType: double
		lineageTag: e36f83c9-ccd5-4893-bf7e-8c044cbe95fe
		summarizeBy: none
		sourceColumn: Baseline Quantity

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Baseline Non-Promo Sales Amount'
		dataType: double
		lineageTag: d6280ca3-a269-407f-a5cf-233aaa9e5c7c
		summarizeBy: none
		sourceColumn: Baseline Non-Promo Sales Amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition fact_promo = m
		mode: import
		source =
				let
					Source = Folder.Files(GoldDataPath & "/facts/fact_promo"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
				in
					ParquetData

