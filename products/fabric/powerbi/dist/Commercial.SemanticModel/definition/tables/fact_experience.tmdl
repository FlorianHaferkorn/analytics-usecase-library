/// Customer complaint and experience events (customer, org, date, severity).
table fact_experience
	lineageTag: eb274a44-dc59-459f-bc7c-ffae0c847c2c

	column 'Complaint ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 2dee2667-d34a-492a-9271-445ddc5a1050
		summarizeBy: none
		sourceColumn: Complaint ID

	column CustomerKey
		dataType: int64
		isHidden
		lineageTag: 2741bcae-0da1-41f3-b39a-f88a1cc3b6ad
		summarizeBy: none
		sourceColumn: CustomerKey

	column OrgKey
		dataType: int64
		isHidden
		lineageTag: 9d04d920-0737-4395-aa8c-86e08fbfd7d3
		summarizeBy: none
		sourceColumn: OrgKey

	column DateKey
		dataType: int64
		isHidden
		lineageTag: 5e819811-a746-40f5-adfa-9ce1c9f1d222
		summarizeBy: none
		sourceColumn: DateKey

	column Severity
		dataType: string
		lineageTag: 8836c671-54e8-4e7d-8026-2d75113b7976
		summarizeBy: none
		sourceColumn: Severity

	column 'Complaint Type'
		dataType: string
		lineageTag: a4ac1bae-5c0f-4dc5-ad53-e62a34f818e0
		summarizeBy: none
		sourceColumn: Complaint Type

		annotation SummarizationSetBy = Automatic

	partition fact_experience = m
		mode: import
		source =
				let
					ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_experience"),
					ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
				in
					ParquetData

