/// Conformed date dimension with fiscal calendar (Aurora: FY starts Apr 1)
table dim_date
	lineageTag: b7092211-8c3d-5eb1-8077-824e2c9fe8f7
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
		isHidden
	column Date
		dataType: DateTime
		sourceColumn: Date
		summarizeBy: none
	column Year
		dataType: Int64
		sourceColumn: Year
		summarizeBy: none
	column Quarter
		dataType: String
		sourceColumn: Quarter
		summarizeBy: none
	column Month
		dataType: String
		sourceColumn: Month
		summarizeBy: none
	column MonthNumber
		dataType: Int64
		sourceColumn: MonthNumber
		summarizeBy: none
	column Week
		dataType: String
		sourceColumn: Week
		summarizeBy: none
	partition dim_date = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_date"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

	calculatedColumn CalendarYearMonth
		dataType: String
		expression = FORMAT([Date], "YYYY-MM")
		summarizeBy: none
		/// YYYY-MM format enables correct chronological sorting in slicers
	hierarchy 'Fiscal Calendar'
		lineageTag: 0ec04f63-07ef-587b-9a60-ddb21de22d22
		level Fiscal Year
			column: Fiscal Year
		level Fiscal Quarter
			column: Fiscal Quarter
		level Fiscal Month
			column: Fiscal Month
		level Date
			column: Date
	hierarchy 'ISO Calendar'
		lineageTag: b1d10635-c888-56d0-b8d8-917e3033d921
		level Calendar Year
			column: Calendar Year
		level Calendar Quarter
			column: Calendar Quarter
		level Calendar Month
			column: Calendar Month
		level Date
			column: Date
