/// Consolidated Measures for: COM-004
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// sales.price.list.amount - List Price Amount
	/// Total list price (before discounts) for price realization and discount analysis.
	measure 'List Price Amount' = SUM ( fact_sales[List Price Amount] )
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.baseline_sales.amount - Baseline Sales Amount
	/// Baseline sales for incremental calculation.
	measure 'Baseline Sales Amount' = SUM ( fact_promo[Baseline Sales Amount] )
		displayFolder: "COM-004"

	/// sales.price.net.amount - Net Price Amount
	/// Total net price (after discounts) for price realization and discount analysis.
	measure 'Net Price Amount' = SUM ( fact_sales[Net Price Amount] )
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cost.amount - Promo Cost
	/// Total promotion cost for ROI and spend analysis.
	measure 'Promo Cost' = SUM ( fact_promo[Promo Cost] )
		displayFolder: "COM-004"

	/// cost.cogs.amount - Cost of Goods Sold Amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.net_sales.amount - Net Sales Amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.incremental.amount - Incremental Sales Amount
	/// Additional sales due to promotion.
	measure 'Incremental Sales Amount' = [Net Sales Amount] - [Baseline Sales Amount]
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cannibalized_sales.amount - Cannibalized Sales Amount
	/// Sales lost on non-promoted items versus baseline (cannibalization in value).
	measure 'Cannibalized Sales Amount' = VAR ActualNonPromoSales = CALCULATE ( SUM ( fact_sales[Net Sales Amount] ), fact_sales[Promo Flag] = FALSE () ) VAR BaselineNonPromoSales = SUM ( fact_promo[Baseline Non-Promo Sales Amount] ) RETURN MAX ( 0, BaselineNonPromoSales - ActualNonPromoSales )
		displayFolder: "COM-004"

	/// sales.promo.incremental_gm.amount - Incremental Gross Margin Amount
	/// Incremental gross margin from promotions for ROI numerator.
	measure 'Incremental Gross Margin Amount' = [Incremental Sales Amount] * 0.35
		displayFolder: "COM-004"

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.roi.pct - Promo ROI %
	/// Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' = DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// margin.promo.gm.pct - GM % During Promo
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' = CALCULATE ( DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ), fact_sales[Promo Flag] = "Yes" )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cannibalization.pct - Cannibalization %
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' = DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR(10) & "  2. FREEZE discretionary discounts for this {entity}" & UNICHAR(10) & "  3. ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW realization recovery for this {entity} monthly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_lead"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = "Trigger: Pattern (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: category_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR(10) & "  2. RANK SKUs by margin contribution for this {entity}" & UNICHAR(10) & "  3. ADJUST sales targets and focus lists for this {entity}" & UNICHAR(10) & "  4. MONITOR mix and margin for this {entity} monthly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "category_manager"
		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: trade_marketing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with repeated negative ROI" & UNICHAR(10) & "  2. REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR(10) & "  3. STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR(10) & "  4. VALIDATE ROI improvement for this {entity} in next cycle"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "trade_marketing_lead"
		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR(10) & "  2. FREEZE new discretionary discounts for this {entity}" & UNICHAR(10) & "  3. REQUIRE approval for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW net price realization for this {entity} weekly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_manager"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: sales_director" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this {entity} within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this {entity}" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this {entity} after one cycle"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"
