		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "category_manager"
		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = VAR _v0 = [Promo ROI %] RETURN IF ( ( _v0 < -0.1 ) && [Incremental Sales Amount] >= 100000, "🔴 L3 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with repeated negative ROI" & UNICHAR ( 10 ) & "→ REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR ( 10 ) & "→ STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR ( 10 ) & "→ VALIDATE ROI improvement for this {entity} in next cycle", IF ( ( _v0 < -0.05 ) && [Incremental Sales Amount] >= 100000, "🟠 L2 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with repeated negative ROI" & UNICHAR ( 10 ) & "→ REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR ( 10 ) & "→ STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR ( 10 ) & "→ VALIDATE ROI improvement for this {entity} in next cycle", IF ( ( _v0 < 0 ) && [Incremental Sales Amount] >= 100000, "🟡 L1 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with repeated negative ROI" & UNICHAR ( 10 ) & "→ REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR ( 10 ) & "→ STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR ( 10 ) & "→ VALIDATE ROI improvement for this {entity} in next cycle", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "trade_marketing_lead"
		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = VAR _v0 = [Gross Margin %] VAR _v1 = [Price Effect Amount] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < 0.22 ) && CALCULATE ( [Gross Margin %] < 0.22, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 100000, "🔴 L3 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR ( 10 ) & "→ FREEZE new discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ REQUIRE approval for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW net price realization for this {entity} weekly", IF ( ( _v1 < 0 ) && CALCULATE ( [Price Effect Amount] < 0, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 100000, "🟠 L2 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( _v1, "€#,0" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR ( 10 ) & "→ FREEZE new discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ REQUIRE approval for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW net price realization for this {entity} weekly", IF ( ( _v0 < 0.25 ) && CALCULATE ( [Gross Margin %] < 0.25, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 100000, "🟡 L1 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR ( 10 ) & "→ FREEZE new discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ REQUIRE approval for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW net price realization for this {entity} weekly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_manager"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = VAR _v0 = [Net Sales % vs Plan] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < -0.08 ) && CALCULATE ( [Net Sales % vs Plan] < -0.08, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 200000, "🔴 L3 — C-S1.2 — Sales Gap Recovery via Price & Pack Adjustment" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching plan thresholds" & UNICHAR ( 10 ) & "→ SELECT eligible products for this {entity} within GM guardrails" & UNICHAR ( 10 ) & "→ APPLY temporary price or pack adjustments to this {entity}" & UNICHAR ( 10 ) & "→ REVIEW Net Sales uplift for this {entity} after one cycle", IF ( ( _v0 < -0.05 ) && CALCULATE ( [Net Sales % vs Plan] < -0.05, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 200000, "🟠 L2 — C-S1.2 — Sales Gap Recovery via Price & Pack Adjustment" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching plan thresholds" & UNICHAR ( 10 ) & "→ SELECT eligible products for this {entity} within GM guardrails" & UNICHAR ( 10 ) & "→ APPLY temporary price or pack adjustments to this {entity}" & UNICHAR ( 10 ) & "→ REVIEW Net Sales uplift for this {entity} after one cycle", IF ( ( _v0 < -0.02 ) && CALCULATE ( [Net Sales % vs Plan] < -0.02, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Net Sales Amount] >= 200000, "🟡 L1 — C-S1.2 — Sales Gap Recovery via Price & Pack Adjustment" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} breaching plan thresholds" & UNICHAR ( 10 ) & "→ SELECT eligible products for this {entity} within GM guardrails" & UNICHAR ( 10 ) & "→ APPLY temporary price or pack adjustments to this {entity}" & UNICHAR ( 10 ) & "→ REVIEW Net Sales uplift for this {entity} after one cycle", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"

	/// ActionReady Logic: C-C3.1 - Customer Retention Intervention
	measure 'Action_C-C3.1_Text' = VAR _v0 = [Customer Retention %] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < 0.9 ) && CALCULATE ( [Customer Retention %] < 0.9, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Active Customers] >= 50, "🔴 L3 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or customers with persistent retention deterioration" & UNICHAR ( 10 ) & "→ PRIORITIZE the book of business by crm.revenue_at_risk.amount and crm.clv.amount" & UNICHAR ( 10 ) & "→ ASSIGN targeted recovery actions to account or CRM owners" & UNICHAR ( 10 ) & "→ REVIEW retention and CLV recovery for the targeted population monthly", IF ( ( _v0 < 0.94 ) && CALCULATE ( [Customer Retention %] < 0.94, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Active Customers] >= 50, "🟠 L2 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or customers with persistent retention deterioration" & UNICHAR ( 10 ) & "→ PRIORITIZE the book of business by crm.revenue_at_risk.amount and crm.clv.amount" & UNICHAR ( 10 ) & "→ ASSIGN targeted recovery actions to account or CRM owners" & UNICHAR ( 10 ) & "→ REVIEW retention and CLV recovery for the targeted population monthly", IF ( ( _v0 < 0.97 ) && CALCULATE ( [Customer Retention %] < 0.97, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Active Customers] >= 50, "🟡 L1 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or customers with persistent retention deterioration" & UNICHAR ( 10 ) & "→ PRIORITIZE the book of business by crm.revenue_at_risk.amount and crm.clv.amount" & UNICHAR ( 10 ) & "→ ASSIGN targeted recovery actions to account or CRM owners" & UNICHAR ( 10 ) & "→ REVIEW retention and CLV recovery for the targeted population monthly", BLANK () ) ) )
		isHidden
