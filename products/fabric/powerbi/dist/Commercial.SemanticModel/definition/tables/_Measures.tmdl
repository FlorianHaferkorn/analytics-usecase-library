/// Consolidated Measures for: COM-001, COM-002, COM-003, COM-004
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text' = VAR _s = [Net Sales Amount] VAR _g = [Gross Margin %] VAR _p = [Net Sales % vs Plan] VAR _pr = [Price Realization %] VAR _r = [Customer Retention %] VAR _d = SWITCH ( TRUE (), ABS ( [Price Effect Amount] ) >= ABS ( [Volume Effect Amount] ) && ABS ( [Price Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Price: " & FORMAT ( [Price Effect Amount], "+€#,0;-€#,0" ), ABS ( [Volume Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Volume: " & FORMAT ( [Volume Effect Amount], "+€#,0;-€#,0" ), "Mix: " & FORMAT ( [Mix Effect Amount], "+€#,0;-€#,0" ) ) RETURN "Sales: " & FORMAT ( _s, "€#,0" ) & "  |  vs Plan: " & FORMAT ( _p, "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "GM: " & FORMAT ( _g, "0.0%" ) & "  |  Price Realiz.: " & FORMAT ( _pr, "0.0%" ) & "  |  Retention: " & FORMAT ( _r, "0.0%" ) & UNICHAR ( 10 ) & "Top driver: " & _d
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 3ad8de7c-7774-4630-8bfa-dbdd04372fd0

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text' = VAR _rows = FILTER ( { [Action_C-C3.1_Text], [Action_C-C3.2_Text], [Action_C-M2.1_Text], [Action_C-M2.2_Text], [Action_C-P4.1_Text], [Action_C-S1.1_Text], [Action_C-S1.2_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: e8f01d6f-95ec-4b18-a1b4-4ce5b77884fc

	/// Purpose: Domain-suffixed alias for COM visuals.
	measure 'Active Actions Text (COM)' = [Active Actions Text]
		formatString: @
		isHidden
		displayFolder: 0_Summary

	/// Purpose: Freshness timestamp for AI narrative — binds Last_Refresh visuals.
	measure 'Last Refresh (COM)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// sales.net_sales.amount - Net Sales Amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// fact_sales[Plan Sales Amount] - Plan Sales Amount
	/// Planned net sales used as comparison baseline in COM-001 visuals.
	measure 'Plan Sales Amount' =
			SUM ( fact_sales[Plan Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"

	/// fact_sales[Last Year Sales Amount] - Last Year Net Sales Amount
	/// Prior-year net sales used as comparison baseline in COM-001 visuals.
	measure 'Last Year Net Sales Amount' =
			SUM ( fact_sales[Last Year Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.plan - Net Sales % vs Plan
	/// Relative variance of Net Sales vs Plan.
	measure 'Net Sales % vs Plan' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// cost.cogs.amount - Cost of Goods Sold Amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'Cost of Goods Sold Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// sales.pvm.volume_effect.amount - Volume Effect Amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'Volume Effect Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// sales.net_sales.delta_pct.ly - Delta% Net Sales
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// sales.pvm.price_effect.amount - Price Effect Amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'Price Effect Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// sales.pvm.mix_effect.amount - Mix Effect Amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// sales.price.list.amount - List Price Amount
	/// Total list price (before discounts) for price realization and discount analysis.
	measure 'List Price Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// sales.price.net.amount - Net Price Amount
	/// Total net price (after discounts) for price realization and discount analysis.
	measure 'Net Price Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// cost.cogs_per_unit.amount - COGS per Unit
	/// Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// margin.gm.amount - Gross Margin Amount
	/// Absolute gross margin in currency.
	measure 'Gross Margin Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// margin.gm.vs_plan.pct - Gross Margin % vs Plan
	/// Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// crm.churned_customers.count - Churned Customers
	/// Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'Churned Customers' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.retention.pct - Customer Retention %
	/// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'Customer Retention %' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.nps.index - Net Promoter Score (NPS)
	/// Measures customer advocacy and likelihood to recommend.
	measure 'Net Promoter Score (NPS)' = BLANK()
		formatString: "#,0.0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.complaint.count - Complaint Count
	/// Provide the absolute number of logged complaints.
	measure 'Complaint Count' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.active_customers.count - Active Customers
	/// Number of unique active customers in the reporting period.
	measure 'Active Customers' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.lifetime_revenue.amount - Customer Lifetime Revenue Amount
	/// Sum of realized revenue across the customer lifecycle.
	measure 'Customer Lifetime Revenue Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.clv.amount - CLV (Customer Lifetime Value)
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure 'CLV (Customer Lifetime Value)' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// crm.revenue_at_risk.amount - Revenue at Risk Amount
	/// Quantify revenue exposure from customers flagged as churn-risk.
	measure 'Revenue at Risk Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.baseline_sales.amount - Baseline Sales Amount
	/// Baseline sales for incremental calculation.
	measure 'Baseline Sales Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-004"

	/// sales.promo.cost.amount - Promo Cost
	/// Total promotion cost for ROI and spend analysis.
	measure 'Promo Cost' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-004"

	/// sales.promo.incremental.amount - Incremental Sales Amount
	/// Additional sales due to promotion.
	measure 'Incremental Sales Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cannibalized_sales.amount - Cannibalized Sales Amount
	/// Sales lost on non-promoted items versus baseline (cannibalization in value).
	measure 'Cannibalized Sales Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-004"

	/// sales.promo.incremental_gm.amount - Incremental Gross Margin Amount
	/// Incremental gross margin from promotions for ROI numerator.
	measure 'Incremental Gross Margin Amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-004"

	/// sales.promo.roi.pct - Promo ROI %
	/// Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// margin.promo.gm.pct - GM % During Promo
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cannibalization.pct - Cannibalization %
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = IF ( [Price Realization %] < 0.9, "🔴 L3 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( [Price Realization %], "0.0%" ) & UNICHAR ( 10 ) & "→ Freeze discretionary discounts — Enforce approvals — Review realization monthly", IF ( [Price Realization %] < 0.92, "🟠 L2 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( [Price Realization %], "0.0%" ) & UNICHAR ( 10 ) & "→ Freeze discretionary discounts — Enforce approvals — Review realization monthly", IF ( [Price Realization %] < 0.95, "🟡 L1 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( [Price Realization %], "0.0%" ) & UNICHAR ( 10 ) & "→ Freeze discretionary discounts — Enforce approvals — Review realization monthly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_lead"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = IF ( [Mix Effect Amount] < -200000, "🔴 L3 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( [Mix Effect Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify negative-mix entities — Rank SKUs by margin — Monitor mix monthly", IF ( [Mix Effect Amount] < -75000, "🟠 L2 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( [Mix Effect Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify negative-mix entities — Rank SKUs by margin — Monitor mix monthly", IF ( [Mix Effect Amount] < 0, "🟡 L1 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( [Mix Effect Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify negative-mix entities — Rank SKUs by margin — Monitor mix monthly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "category_manager"
		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = IF ( [Promo ROI %] < -0.1, "🔴 L3 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( [Promo ROI %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify negative-ROI promos — Review and resequence — Validate ROI next cycle", IF ( [Promo ROI %] < -0.05, "🟠 L2 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( [Promo ROI %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify negative-ROI promos — Review and resequence — Validate ROI next cycle", IF ( [Promo ROI %] < 0.0, "🟡 L1 — C-P4.1 — Promo Calendar Discipline" & UNICHAR ( 10 ) & "Owner: trade_marketing_lead | " & FORMAT ( [Promo ROI %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify negative-ROI promos — Review and resequence — Validate ROI next cycle", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "trade_marketing_lead"
		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = IF ( [Gross Margin %] < 0.22, "🔴 L3 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( [Gross Margin %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify GM-breaching entities — Freeze new discounts — Review realization weekly", IF ( [Gross Margin %] < 0.23, "🟠 L2 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( [Gross Margin %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify GM-breaching entities — Freeze new discounts — Review realization weekly", IF ( [Gross Margin %] < 0.25, "🟡 L1 — C-S1.1 — Price Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: pricing_manager | " & FORMAT ( [Gross Margin %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify GM-breaching entities — Freeze new discounts — Review realization weekly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_manager"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = IF ( [Net Sales % vs Plan] < -0.08, "🔴 L3 — C-S1.2 — Sales Gap Recovery" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( [Net Sales % vs Plan], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify plan-breaching entities — Apply price/pack adjustments — Review uplift", IF ( [Net Sales % vs Plan] < -0.05, "🟠 L2 — C-S1.2 — Sales Gap Recovery" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( [Net Sales % vs Plan], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify plan-breaching entities — Apply price/pack adjustments — Review uplift", IF ( [Net Sales % vs Plan] < -0.02, "🟡 L1 — C-S1.2 — Sales Gap Recovery" & UNICHAR ( 10 ) & "Owner: sales_director | " & FORMAT ( [Net Sales % vs Plan], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify plan-breaching entities — Apply price/pack adjustments — Review uplift", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"

	/// ActionReady Logic: C-C3.1 - Customer Retention Intervention
	measure 'Action_C-C3.1_Text' = IF ( [Customer Retention %] < 0.9, "🔴 L3 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Customer Retention %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify at-risk segments — Prioritize by revenue at risk/CLV — Assign recovery actions — Review CLV monthly", IF ( [Customer Retention %] < 0.94, "🟠 L2 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Customer Retention %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify at-risk segments — Prioritize by revenue at risk/CLV — Assign recovery actions — Review CLV monthly", IF ( [Customer Retention %] < 0.97, "🟡 L1 — C-C3.1 — Customer Retention Intervention" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Customer Retention %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify at-risk segments — Prioritize by revenue at risk/CLV — Assign recovery actions — Review CLV monthly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "commercial_controlling_lead"
		annotation ActionReady_ActionCodeId = "C-C3.1"

	/// ActionReady Logic: C-C3.2 - Complaint & Advocacy Recovery
	measure 'Action_C-C3.2_Text' = IF ( [Net Promoter Score (NPS)] < -5, "🔴 L3 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Net Promoter Score (NPS)], "#,0.0" ) & UNICHAR ( 10 ) & "→ Close high-value complaint clusters — Restore advocacy — Review quarterly", IF ( [Net Promoter Score (NPS)] < 5, "🟠 L2 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Net Promoter Score (NPS)], "#,0.0" ) & UNICHAR ( 10 ) & "→ Close high-value complaint clusters — Restore advocacy — Review quarterly", IF ( [Net Promoter Score (NPS)] < 20, "🟡 L1 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( [Net Promoter Score (NPS)], "#,0.0" ) & UNICHAR ( 10 ) & "→ Close high-value complaint clusters — Restore advocacy — Review quarterly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "commercial_controlling_lead"
		annotation ActionReady_ActionCodeId = "C-C3.2"
