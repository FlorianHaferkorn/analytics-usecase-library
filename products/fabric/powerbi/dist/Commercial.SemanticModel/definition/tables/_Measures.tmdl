/// Consolidated Measures for: COM-001, COM-002, COM-003, COM-004
table _Measures
	lineageTag: b1c2fb2b-ce7b-414c-8c62-306e56a68937

	/// Gross Margin % - margin.gm.pct
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin Amount], [Net Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: 10b2b718-b1a3-4e8f-8d9a-f95b9c5961c3

	/// Cost of Goods Sold Amount - cost.cogs.amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 1e99b2a8-324b-402e-bc36-7cb17a72ccd2

	/// Net Sales Amount - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: b3b3dc9a-b1c6-4e73-a22a-0d10f0e34c74

	/// Net Sales % vs Plan - sales.net_sales.delta_pct.plan
	/// Relative variance of Net Sales vs Plan.
	measure 'Net Sales % vs Plan' = DIVIDE ( [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ), ABS ( SUM ( fact_sales[Plan Sales Amount] ) ) )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: b2f7a0cd-ec9f-4019-9545-8d8e600a94a6

	/// Delta% Net Sales - sales.net_sales.delta_pct.ly
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' = DIVIDE ( [Net Sales Amount] - SUM ( fact_sales[Last Year Sales Amount] ), ABS ( SUM ( fact_sales[Last Year Sales Amount] ) ) )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: c2d3b6fc-63b3-4a35-8e35-8a1813849c9b

	/// Price Effect Amount - sales.pvm.price_effect.amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'Price Effect Amount' = SUMX ( fact_sales, ( DIVIDE ( fact_sales[Net Price Amount], fact_sales[Quantity] ) - DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] ) ) * fact_sales[Quantity] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 41545bc4-a6ac-4a31-9358-56df9fdb2aac

	/// Volume Effect Amount - sales.pvm.volume_effect.amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'Volume Effect Amount' = SUMX ( fact_sales, ( fact_sales[Quantity] - fact_sales[Plan Quantity] ) * DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] ) )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 580b2dec-362e-4e44-9bd1-deac41df833c

	/// Mix Effect Amount - sales.pvm.mix_effect.amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' = [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ) - [Price Effect Amount] - [Volume Effect Amount]
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: ab2d5d57-cae3-4582-abea-92ff9d3b271a

	/// Gross Margin Amount - margin.gm.amount
	/// Absolute gross margin in currency.
	measure 'Gross Margin Amount' = [Net Sales Amount] - [Cost of Goods Sold Amount]
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 03f08d7f-23da-4831-9935-ae83e07e3c8e

	/// List Price Amount - sales.price.list.amount
	/// Total list price (before discounts) for price realization and discount analysis.
	measure 'List Price Amount' = SUM ( fact_sales[List Price Amount] )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: d17712ff-6b3c-4b55-9b34-22e9f97ff5a5

	/// Net Price Amount - sales.price.net.amount
	/// Total net price (after discounts) for price realization and discount analysis.
	measure 'Net Price Amount' = SUM ( fact_sales[Net Price Amount] )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: ee4b6ee4-4571-425a-9e3f-d8370692f1c3

	/// Price Realization % - sales.price.realization_pct
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: 910c92c2-da5b-4fba-b7b8-004ce0856170

	/// COGS per Unit - cost.cogs_per_unit.amount
	/// Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' = DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 92e31c4c-5f77-412f-97dd-754a65e78152

	/// Gross Margin % vs Plan - margin.gm.vs_plan.pct
	/// Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' =
		VAR ActualGM =
			[Gross Margin Amount]
		VAR PlanGM =
			SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] )
		RETURN
			DIVIDE ( ActualGM - PlanGM, ABS ( PlanGM ) )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: e0113c41-42e6-499e-a751-b2df2801d43f

	/// CLV (Customer Lifetime Value) - crm.clv.amount
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure 'CLV (Customer Lifetime Value)' = AVERAGEX ( VALUES ( fact_customer_value[CustomerKey] ), CALCULATE ( SUM ( fact_customer_value[CLV Amount] ) ) )
		formatString: #,0.00
		displayFolder: COM-003
		lineageTag: 03246498-dfec-4236-8de6-ed9a6e551634

	/// Customer Lifetime Revenue Amount - crm.lifetime_revenue.amount
	/// Sum of realized revenue across the customer lifecycle.
	measure 'Customer Lifetime Revenue Amount' = SUMX ( VALUES ( fact_sales[CustomerKey] ), CALCULATE ( SUM ( fact_sales[Net Sales Amount] ) ) )
		formatString: #,0.00
		displayFolder: COM-003
		lineageTag: 227ed712-5388-496e-b813-5f70f32b336a

	/// Customer Retention % - crm.retention.pct
	/// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'Customer Retention %' =
		VAR ActiveRetained =
			CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE (), fact_customer_events[Churn Flag] = FALSE () )
		VAR TotalActive =
			CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
		RETURN
			DIVIDE ( ActiveRetained, TotalActive )
		formatString: 0.0%
		displayFolder: COM-003
		lineageTag: 4f295ec4-6dc4-4c21-b4c9-3bf7320a80d2

	/// Churned Customers - crm.churned_customers.count
	/// Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'Churned Customers' = CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Churn Flag] = TRUE () )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: ccba5dd6-2da4-4192-b00f-d0aac7eac4bf

	/// Active Customers - crm.active_customers.count
	/// Number of unique active customers in the reporting period.
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 4cf0a970-adc2-43fa-8110-b36c161189e6

	/// Net Promoter Score (NPS) - crm.nps.index
	/// Measures customer advocacy and likelihood to recommend.
	measure 'Net Promoter Score (NPS)' =
		VAR Promoters =
			CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] >= 9 )
		VAR Detractors =
			CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] <= 6 )
		VAR TotalResponses =
			COUNTROWS ( fact_nps )
		RETURN
			ROUND ( DIVIDE ( Promoters - Detractors, TotalResponses ) * 100, 0 )
		formatString: #,0.0
		displayFolder: COM-003
		lineageTag: 423ca51b-6145-4a39-93c9-1b82d1d2b7ef

	/// Complaint Count - crm.complaint.count
	/// Provide the absolute number of logged complaints.
	measure 'Complaint Count' = SUM ( fact_complaints[Complaint Count] )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 34267a54-b7df-455f-bdfb-7cd5cc05f14a

	/// Revenue at Risk Amount - crm.revenue_at_risk.amount
	/// Net Sales weighted by customer churn risk rate.
	measure 'Revenue at Risk Amount' =
		VAR ChurnedCount =
			CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Churn Flag] = TRUE () )
		VAR ActiveCount =
			CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
		RETURN
			[Net Sales Amount] * DIVIDE ( ChurnedCount, ActiveCount )
		formatString: #,0.00
		displayFolder: COM-003

	/// Promo ROI % - sales.promo.roi.pct
	/// Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' = DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 196a4a51-8c51-4776-8d03-e514518eef0f

	/// Incremental Sales Amount - sales.promo.incremental.amount
	/// Additional sales due to promotion.
	measure 'Incremental Sales Amount' = [Net Sales Amount] - [Baseline Sales Amount]
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: d6029ff3-2184-423c-9e45-c9bffb2d6eb2

	/// GM % During Promo - margin.promo.gm.pct
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' = DIVIDE ( [Incremental Gross Margin Amount], [Incremental Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: fa91fbea-f202-4e1b-99cf-9d5a40cf4e2d

	/// Cannibalization % - sales.promo.cannibalization.pct
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' = DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: e9fa718c-ee1d-45ec-896e-f75929ef5cc5

	/// Baseline Sales Amount - sales.promo.baseline_sales.amount
	/// Additional sales generated during promotion period above the non-promoted baseline.
	measure 'Baseline Sales Amount' = SUM ( fact_promo[Baseline Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 601dff29-03a0-46cd-8adc-81a574037a44

	/// Cannibalized Sales Amount - sales.promo.cannibalized_sales.amount
	/// Sales volume from non-promoted products lost due to consumer switching to promoted SKUs.
	measure 'Cannibalized Sales Amount' = [Baseline Sales Amount] * 0.15
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 7872106a-0a2b-40d3-ad29-b894adac4616

	/// Promo Cost - sales.promo.cost.amount
	/// Total spend on promotional activities including media, trade, and execution costs.
	measure 'Promo Cost' = SUM ( fact_promo[Promo Cost] )
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: c892ab8a-b5eb-4c39-a53b-895469dd733a

	/// Incremental Gross Margin Amount - sales.promo.incremental_gm.amount
	/// Gross margin contribution attributable to promotional uplift net of promo costs.
	measure 'Incremental Gross Margin Amount' = [Incremental Sales Amount] * DIVIDE ( [Gross Margin Amount], [Net Sales Amount] ) - [Promo Cost]
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: 6ce6a631-7d86-4e74-858e-bb3e331cd569

	/// ActionReady Logic: C-C3.1 - Customer Retention Intervention
	measure 'Action_C-C3.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY segments or customers with persistent retention deterioration" & UNICHAR(10) & "  2. PRIORITIZE the book of business by crm.revenue_at_risk.amount and crm.clv.amount" & UNICHAR(10) & "  3. ASSIGN targeted recovery actions to account or CRM owners" & UNICHAR(10) & "  4. REVIEW retention and CLV recovery for the targeted population monthly"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 7058923c-7285-4196-9ea8-290dc84d3478

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-C3.1"

	/// ActionReady Logic: C-C3.2 - Complaint & Advocacy Recovery
	measure 'Action_C-C3.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY segments or products with falling advocacy and rising complaints" & UNICHAR(10) & "  2. MAP the complaint pattern to channel, product, and customer ownership" & UNICHAR(10) & "  3. EXECUTE recovery actions and close the highest-value issue clusters first" & UNICHAR(10) & "  4. REVIEW complaint volume, NPS, and retention response monthly"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 7ad6611e-a4b4-41c0-a73f-3cb3d1c6ec9b

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-C3.2"

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR(10) & "  2. FREEZE discretionary discounts for this {entity}" & UNICHAR(10) & "  3. ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW realization recovery for this {entity} monthly"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: b08a8653-d0c1-4437-ab5c-ed12c9a710b8

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = "Trigger: Pattern (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR(10) & "  2. RANK SKUs by margin contribution for this {entity}" & UNICHAR(10) & "  3. ADJUST sales targets and focus lists for this {entity}" & UNICHAR(10) & "  4. MONITOR mix and margin for this {entity} monthly"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 7625780f-655b-402e-85e9-ab84efbc3579

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with repeated negative ROI" & UNICHAR(10) & "  2. REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR(10) & "  3. STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR(10) & "  4. VALIDATE ROI improvement for this {entity} in next cycle"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: d627406e-31bd-4233-9b7f-75213545ef92

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR(10) & "  2. FREEZE new discretionary discounts for this {entity}" & UNICHAR(10) & "  3. REQUIRE approval for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW net price realization for this {entity} weekly"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 7278170f-70f6-4b54-9f25-fedf05c4778f

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this {entity} within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this {entity}" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this {entity} after one cycle"
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: ca6ac992-ac43-4b0f-aed7-e7b460716be2

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-S1.2"

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI %' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// Purpose: Average EUR impact per achieved action execution — realized KPI delta per code.
	/// enterprise.action_effectiveness_delta.amount - Action Effectiveness Delta
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		isHidden
		lineageTag: b525edd9-3ac2-485b-b5ab-1a3dd31865d2
		summarizeBy: none
		sourceColumn: Column1

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source
