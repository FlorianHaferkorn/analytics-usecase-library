/// Consolidated Measures for: COM-004
table _Measures
	lineageTag: e85884fd-c813-4242-bf38-81821b00901b

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		lineageTag: f15966da-ced2-43c9-a25b-3c45c84bd448
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// margin.gm.pct - margin.gm.pct
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'margin.gm.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// cost.cogs.amount - cost.cogs.amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'cost.cogs.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.net_sales.amount - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'sales.net_sales.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.plan - sales.net_sales.delta_pct.plan
	/// Relative variance of Net Sales vs Plan.
	measure 'sales.net_sales.delta_pct.plan' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.ly - sales.net_sales.delta_pct.ly
	/// Relative variance of Net Sales vs Last Year.
	measure 'sales.net_sales.delta_pct.ly' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.pvm.price_effect.amount - sales.pvm.price_effect.amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'sales.pvm.price_effect.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.pvm.volume_effect.amount - sales.pvm.volume_effect.amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'sales.pvm.volume_effect.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// sales.pvm.mix_effect.amount - sales.pvm.mix_effect.amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'sales.pvm.mix_effect.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-001"

	/// margin.gm.amount - margin.gm.amount
	/// Absolute gross margin in currency.
	measure 'margin.gm.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// sales.price.list.amount - sales.price.list.amount
	/// Total list price (before discounts) for price realization and discount analysis.
	measure 'sales.price.list.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// sales.price.net.amount - sales.price.net.amount
	/// Total net price (after discounts) for price realization and discount analysis.
	measure 'sales.price.net.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// sales.price.realization_pct - sales.price.realization_pct
	/// Shows how much of list price is realized after discounts.
	measure 'sales.price.realization_pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// cost.cogs_per_unit.amount - cost.cogs_per_unit.amount
	/// Shows unit cost level relative to sold volume.
	measure 'cost.cogs_per_unit.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-002"

	/// margin.gm.vs_plan.pct - margin.gm.vs_plan.pct
	/// Measures gross margin rate variance versus plan.
	measure 'margin.gm.vs_plan.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// crm.clv.amount - crm.clv.amount
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure 'crm.clv.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-003"

	/// crm.lifetime_revenue.amount - crm.lifetime_revenue.amount
	/// Sum of realized revenue across the customer lifecycle.
	measure 'crm.lifetime_revenue.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-003"

	/// crm.retention.pct - crm.retention.pct
	/// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'crm.retention.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-003"

	/// crm.churned_customers.count - crm.churned_customers.count
	/// Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'crm.churned_customers.count' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.active_customers.count - crm.active_customers.count
	/// Number of unique active customers in the reporting period.
	measure 'crm.active_customers.count' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"

	/// crm.nps.index - crm.nps.index
	/// Measures customer advocacy and likelihood to recommend.
	measure 'crm.nps.index' = BLANK()
		formatString: "#,0.0"
		displayFolder: "COM-003"

	/// crm.complaint.count - crm.complaint.count
	/// Provide the absolute number of logged complaints.
	measure 'crm.complaint.count' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-003"

	/// sales.promo.roi.pct - sales.promo.roi.pct
	/// Measures profitability of promotions relative to spend.
	measure 'sales.promo.roi.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"

	/// sales.promo.incremental.amount - sales.promo.incremental.amount
	/// Additional sales due to promotion.
	measure 'sales.promo.incremental.amount' = BLANK()
		formatString: "#,0.00"
		displayFolder: "COM-004"

	/// margin.promo.gm.pct - margin.promo.gm.pct
	/// Gross margin rate during promo periods.
	measure 'margin.promo.gm.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// sales.promo.cannibalization.pct - sales.promo.cannibalization.pct
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'sales.promo.cannibalization.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// ActionReady Logic: C-C3.1 - Customer Retention Intervention
	measure 'Action_C-C3.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY segments or customers with persistent retention deterioration" & UNICHAR(10) & "  2. PRIORITIZE the book of business by crm.revenue_at_risk.amount and crm.clv.amount" & UNICHAR(10) & "  3. ASSIGN targeted recovery actions to account or CRM owners" & UNICHAR(10) & "  4. REVIEW retention and CLV recovery for the targeted population monthly"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "TBD"
		annotation ActionReady_ActionCodeId = "C-C3.1"

	/// ActionReady Logic: C-C3.2 - Complaint & Advocacy Recovery
	measure 'Action_C-C3.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY segments or products with falling advocacy and rising complaints" & UNICHAR(10) & "  2. MAP the complaint pattern to channel, product, and customer ownership" & UNICHAR(10) & "  3. EXECUTE recovery actions and close the highest-value issue clusters first" & UNICHAR(10) & "  4. REVIEW complaint volume, NPS, and retention response monthly"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "TBD"
		annotation ActionReady_ActionCodeId = "C-C3.2"

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR(10) & "  2. FREEZE discretionary discounts for this {entity}" & UNICHAR(10) & "  3. ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW realization recovery for this {entity} monthly"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_lead"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = "Trigger: Pattern (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: category_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR(10) & "  2. RANK SKUs by margin contribution for this {entity}" & UNICHAR(10) & "  3. ADJUST sales targets and focus lists for this {entity}" & UNICHAR(10) & "  4. MONITOR mix and margin for this {entity} monthly"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "category_manager"
		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: trade_marketing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with repeated negative ROI" & UNICHAR(10) & "  2. REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR(10) & "  3. STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR(10) & "  4. VALIDATE ROI improvement for this {entity} in next cycle"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "trade_marketing_lead"
		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR(10) & "  2. FREEZE new discretionary discounts for this {entity}" & UNICHAR(10) & "  3. REQUIRE approval for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW net price realization for this {entity} weekly"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_manager"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: sales_director" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this {entity} within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this {entity}" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this {entity} after one cycle"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"
