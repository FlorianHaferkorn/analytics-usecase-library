		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "commercial_controlling_lead"
		annotation ActionReady_ActionCodeId = "C-C3.2"

	/// Number of action codes with a recorded outcome in fact_action_outcome.
	/// Formula: COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
	/// Grain: month · Unit: count
	/// Owner: Commercial BI · Status: active
	measure 'Actions Executed Count' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"
		lineageTag: 8a1dc24e-d854-4fb6-a63d-763d6560da2a

	/// Share of routed actions that achieved the intended outcome.
	/// Formula: Successful Actions / Routed Actions.
	/// Grain: action_instance · Unit: %
	/// Owner: Executive Office · Status: active
	measure 'Action Outcome Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"
		lineageTag: d94de4fe-7447-4eef-a048-4c9ecb1f2f12

	/// Average days between action execution and outcome confirmation.
	/// Formula: AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
	/// Grain: month · Unit: days
	/// Owner: Commercial BI · Status: active
	measure 'Avg Time-to-Outcome Days' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"
		lineageTag: 9df5ed96-85c9-4c33-a63e-85d7e7b6cbc6

	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	/// Formula: DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
	/// Grain: month · Unit: %
	/// Owner: Commercial BI · Status: active
	measure 'Action ROI %' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"
		lineageTag: 3a0eba01-7388-4c8d-b11c-0cd00de4aa17

	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (COM)' = VAR _s = [Net Sales Amount] VAR _g = [Gross Margin %] VAR _p = [Net Sales % vs Plan] VAR _pr = [Price Realization %] VAR _r = [Customer Retention %] VAR _d = SWITCH ( TRUE (), ABS ( [Price Effect Amount] ) >= ABS ( [Volume Effect Amount] ) && ABS ( [Price Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Price: " & FORMAT ( [Price Effect Amount], "+€#,0;-€#,0" ), ABS ( [Volume Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Volume: " & FORMAT ( [Volume Effect Amount], "+€#,0;-€#,0" ), "Mix: " & FORMAT ( [Mix Effect Amount], "+€#,0;-€#,0" ) ) RETURN "Sales: " & FORMAT ( _s, "€#,0" ) & "  |  vs Plan: " & FORMAT ( _p, "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "GM: " & FORMAT ( _g, "0.0%" ) & "  |  Price Realiz.: " & FORMAT ( _pr, "0.0%" ) & "  |  Retention: " & FORMAT ( _r, "0.0%" ) & UNICHAR ( 10 ) & "Top driver: " & _d
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 8204f978-f3e2-42aa-8331-705090a1d6ed

	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"
		lineageTag: 753c3ac0-719e-471c-8890-280ecebf38a1
