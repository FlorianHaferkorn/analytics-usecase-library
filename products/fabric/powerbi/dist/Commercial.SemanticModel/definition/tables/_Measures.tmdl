/// Consolidated Measures for: COM-001, COM-002, COM-003, COM-004
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text' = VAR _s = [Net Sales Amount] VAR _g = [Gross Margin %] VAR _p = [Net Sales % vs Plan] VAR _pr = [Price Realization %] VAR _r = [Customer Retention %] VAR _d = SWITCH ( TRUE (), ABS ( [Price Effect Amount] ) >= ABS ( [Volume Effect Amount] ) && ABS ( [Price Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Price: " & FORMAT ( [Price Effect Amount], "+€#,0;-€#,0" ), ABS ( [Volume Effect Amount] ) >= ABS ( [Mix Effect Amount] ), "Volume: " & FORMAT ( [Volume Effect Amount], "+€#,0;-€#,0" ), "Mix: " & FORMAT ( [Mix Effect Amount], "+€#,0;-€#,0" ) ) RETURN "Sales: " & FORMAT ( _s, "€#,0" ) & "  |  vs Plan: " & FORMAT ( _p, "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "GM: " & FORMAT ( _g, "0.0%" ) & "  |  Price Realiz.: " & FORMAT ( _pr, "0.0%" ) & "  |  Retention: " & FORMAT ( _r, "0.0%" ) & UNICHAR ( 10 ) & "Top driver: " & _d
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 3ad8de7c-7774-4630-8bfa-dbdd04372fd0

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text' = VAR _rows = FILTER ( { [Action_C-C3.1_Text], [Action_C-C3.2_Text], [Action_C-M2.1_Text], [Action_C-M2.2_Text], [Action_C-P4.1_Text], [Action_C-S1.1_Text], [Action_C-S1.2_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: e8f01d6f-95ec-4b18-a1b4-4ce5b77884fc

	/// Purpose: Domain-suffixed alias for COM visuals.
	measure 'Active Actions Text (COM)' = [Active Actions Text]
		formatString: @
		isHidden
		displayFolder: 0_Summary

	/// Purpose: Freshness timestamp for AI narrative — binds Last_Refresh visuals.
	measure 'Last Refresh (COM)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary

	/// Purpose: Vorjahreswert von CLV (Customer Lifetime Value) (comparison: vs_py): die ausgewaehlten Monate um zwoelf verschoben, Monatsindex-Muster wie 'CCC Days PM' (dim_date ist keine markierte Datumstabelle, SAMEPERIODLASTYEAR liefe neben einem Monats-Slicer leer).
	measure 'CLV (Customer Lifetime Value) PY' = VAR _idx = SELECTCOLUMNS ( SUMMARIZE ( 'dim_date', 'dim_date'[Year], 'dim_date'[MonthNumber] ), "i", 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] - 12 ) RETURN CALCULATE ( [CLV (Customer Lifetime Value)], REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] IN _idx ) )
		formatString: "#,0"
		displayFolder: 8_Comparison
		lineageTag: c9cbaa3f-8e54-560d-8d75-43624a3374a1

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung CLV (Customer Lifetime Value) gegen CLV (Customer Lifetime Value) PY; leer ohne Referenzwert.
	measure 'CLV (Customer Lifetime Value) vs PY' = VAR _r = [CLV (Customer Lifetime Value) PY] RETURN IF ( ISBLANK ( _r ), BLANK (), [CLV (Customer Lifetime Value)] - _r )
		formatString: "#,0"
		displayFolder: 8_Comparison
		lineageTag: d7ac9747-4dbf-5e47-a707-5da22050c0ca

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Planwert von Promo ROI % aus fact_target (comparison: vs_plan); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Promo ROI % Plan (Target Table)' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "sales.promo.roi.pct", fact_target[scenario] = "plan" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 9390ccd7-dd5d-533d-8d8f-f2898a2ff4e5

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Promo ROI % gegen Promo ROI % Plan (Target Table); leer ohne Referenzwert.
	measure 'Promo ROI % vs Plan (Target Table)' = VAR _r = [Promo ROI % Plan (Target Table)] RETURN IF ( ISBLANK ( _r ), BLANK (), [Promo ROI %] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 8cd7ac5f-ffc6-58e2-aa9c-c209b2dd932f

		annotation ALUCA_Generated = "comparison_measures"


	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// Sum of net sales after discounts and rebates.
	/// Formula: SUM ( fact_sales[Net Sales Amount] )
	/// Grain: invoice_line, reported monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-S1.1, C-S1.2
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// fact_sales[Plan Sales Amount] - Plan Sales Amount
	/// Planned net sales used as comparison baseline in COM-001 visuals.
	measure 'Plan Sales Amount' =
			SUM ( fact_sales[Plan Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"

	/// fact_sales[Last Year Sales Amount] - Last Year Net Sales Amount
	/// Prior-year net sales used as comparison baseline in COM-001 visuals.
	measure 'Last Year Net Sales Amount' =
			SUM ( fact_sales[Last Year Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"

	/// Variance of net sales versus plan as a percentage.
	/// Formula: ([Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] )) / (SUM ( fact_sales[Plan Sales Amount] ))
	/// Grain: month · Unit: %
	/// Owner: Commercial BI · Status: active · Actions: C-S1.2
	measure 'Net Sales % vs Plan' = DIVIDE ( [Net Sales Amount] - [Plan Sales Amount], ABS ( [Plan Sales Amount] ) )
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// Total cost of goods sold aligned to invoiced revenue.
	/// Formula: SUM ( fact_sales[Cost of Goods Sold Amount] )
	/// Grain: invoice_line, reported monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// PVM driver quantifying the net sales impact from volume change.
	/// Formula: ( SUM(fact_sales[Quantity]) - SUM(fact_sales[Plan Quantity]) ) * DIVIDE ( SUM(fact_sales[Plan Sales Amount]), SUM(fact_sales[Plan Quantity]) )  — blended plan price (3-way PVM; Mix = residual)
	/// Grain: invoice_line aggregated monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Volume Effect Amount' = ( SUM ( fact_sales[Quantity] ) - SUM ( fact_sales[Plan Quantity] ) ) * DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ), SUM ( fact_sales[Plan Quantity] ) )
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// Alias for Net Sales % vs LY (TMDL display name).
	/// Formula: ([Net Sales Amount] - SUM ( fact_sales[Last Year Sales Amount] )) / (SUM ( fact_sales[Last Year Sales Amount] ))
	/// Owner: Commercial BI · Status: active
	measure 'Delta% Net Sales' = DIVIDE ( [Net Sales Amount] - [Last Year Net Sales Amount], ABS ( [Last Year Net Sales Amount] ) )
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// PVM driver quantifying the net sales impact from price change.
	/// Formula: ( (fact_sales[Net Sales Amount]) / (fact_sales[Quantity]) - (fact_sales[Plan Sales Amount]) / (fact_sales[Plan Quantity]) ) * fact_sales[Quantity] )
	/// Grain: invoice_line aggregated monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-S1.1
	measure 'Price Effect Amount' = SUMX ( fact_sales, ( DIVIDE ( fact_sales[Net Sales Amount], fact_sales[Quantity] ) - DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] ) ) * fact_sales[Quantity] )
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// Gross margin divided by net sales.
	/// Formula: (Net Sales Amount - COGS Amount) / Net Sales Amount
	/// Grain: month (aggregated from invoice_line) · Unit: % · Good: higher_is_better
	/// Drivers: Net Sales Amount (positive), Cost of Goods Sold Amount (negative), Net Sales % vs Plan (positive)
	/// Owner: Profitability Analytics · Status: active · Actions: C-M2.1, C-M2.2, C-S1.1
	/// Synonyms: GM%, Gross Margin Rate, Bruttomarge %
	/// Example question: Why did Gross Margin % drop in Region North last quarter?
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin Amount], [Net Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// Residual PVM driver capturing mix impact after price and volume effects.
	/// Formula: [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ) - [Price Effect Amount] - [Volume Effect Amount]
	/// Grain: month · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-M2.2
	measure 'Mix Effect Amount' = [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ) - [Price Effect Amount] - [Volume Effect Amount]
		formatString: "#,0"
		displayFolder: "COM-001"
		annotation ActionReady_TrustScore = "1"

	/// Disconnected-table selector for the Main_2 PVM bridge waterfall (COM-002):
	/// reads the current dim_pvm_driver[Driver] category bar and returns that
	/// driver's existing effect measure -- lets a single Y-role measure serve
	/// a 3-bar breakdown, since waterfallChart's real capabilities only allow
	/// one measure in Y (Category carries the per-bar breakdown instead).
	/// Formula: SWITCH ( SELECTEDVALUE ( dim_pvm_driver[Driver] ), "Price Effect", [Price Effect Amount], "Volume Effect", [Volume Effect Amount], "Mix Effect", [Mix Effect Amount] )
	/// Grain: dim_pvm_driver[Driver] (3 rows, disconnected) · Unit: EUR
	/// Owner: Commercial BI Pricing Analytics · Status: active
	/// DAX runtime not verified against a live Power BI engine (authoring
	/// sandbox has none) -- structurally reuses three already-verified
	/// measures via a standard SWITCH+SELECTEDVALUE pattern; pending Desktop
	/// confirmation (R1.6 follow-up).
	measure 'PVM Bridge Value' = SWITCH ( SELECTEDVALUE ( dim_pvm_driver[Driver] ), "Plan Sales", [Plan Sales Amount], "Price Effect", [Price Effect Amount], "Volume Effect", [Volume Effect Amount], "Mix Effect", [Mix Effect Amount], BLANK () )
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Sum of list price amount before discounts.
	/// Formula: SUM ( fact_sales[List Price Amount] )
	/// Grain: invoice_line, reported monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'List Price Amount' = SUM ( fact_sales[List Price Amount] )
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Sum of net price amount after discounts.
	/// Formula: SUM ( fact_sales[Net Price Amount] )
	/// Grain: invoice_line, reported monthly · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Net Price Amount' = SUM ( fact_sales[Net Price Amount] )
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Unit cost calculated as COGS divided by quantity sold.
	/// Formula: ([Cost of Goods Sold Amount]) / (SUM ( fact_sales[Quantity] ))
	/// Grain: invoice_line, reported monthly · Unit: EUR per unit
	/// Owner: Commercial BI · Status: active
	measure 'COGS per Unit' = DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Discount discipline metric comparing net price to list price.
	/// Formula: ([Net Price Amount]) / ([List Price Amount])
	/// Grain: month or promo · Unit: %
	/// Owner: Commercial BI · Status: active · Actions: C-M2.1
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: "0.0%"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Gross margin amount for the selected period.
	/// Formula: [Net Sales Amount] - [Cost of Goods Sold Amount]
	/// Grain: month · Unit: EUR
	/// Owner: Innovation Analytics · Status: active · Actions: C-M2.1, C-M2.2
	/// Synonyms: Gross Profit, Gross Income, Rohertrag, Bruttoergebnis vom Umsatz
	/// Example question: What drove the change in gross margin amount this month?
	measure 'Gross Margin Amount' = [Net Sales Amount] - [Cost of Goods Sold Amount]
		formatString: "#,0"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Relative variance of GM% versus plan.
	/// Formula: (Gross Margin % - Plan Gross Margin %) / Plan Gross Margin %.
	/// Grain: month · Unit: percentage-point
	/// Owner: Profitability Analytics · Status: active
	measure 'Gross Margin % vs Plan' =
			VAR ActualGM =
				[Gross Margin Amount]
			VAR PlanGM =
				SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] )
			RETURN
				DIVIDE ( ActualGM - PlanGM, ABS ( PlanGM ) )
		formatString: "0.0%"
		displayFolder: "COM-002"
		annotation ActionReady_TrustScore = "1"

	/// Alias for Churned Customers Count (TMDL display name).
	/// Formula: Distinct customers with no qualifying transactions in the current period but active in the look-back window.
	/// Owner: CRM BI · Status: active
	measure 'Churned Customers' = CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Churn Flag] = TRUE () )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Retained customers as share of opening active base in the period.
	/// Formula: (Active Customers at end of period) / (Active Customers at start of period).
	/// Owner: CRM BI · Status: active · Actions: C-C3.1
	measure 'Customer Retention %' =
			VAR ActiveRetained =
				CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE (), fact_customer_events[Churn Flag] = FALSE () )
			VAR TotalActive =
				CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
			RETURN
				DIVIDE ( ActiveRetained, TotalActive )
		formatString: "0.0%"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Measures customer advocacy and likelihood to recommend.
	/// Formula: VAR Promoters = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] >= 9 ) VAR Detractors = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] <= 6 ) VAR TotalResponses = COUNTROWS ( fact_nps ) RETURN ROUND ( DIVIDE ( Promoters - Detractors, TotalResponses ) * 100, 0 )
	/// Grain: month · Unit: NPS index (-100 to +100)
	/// Owner: Commercial BI · Status: active · Actions: C-C3.2
	/// Synonyms: Net Promoter Score, Promoter Score, Weiterempfehlungsrate, NPS
	/// Example question: Which segments are driving the change in NPS this quarter?
	measure 'Net Promoter Score (NPS)' =
			VAR Promoters =
				CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] >= 9 )
			VAR Detractors =
				CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] <= 6 )
			VAR TotalResponses =
				COUNTROWS ( fact_nps )
			RETURN
				ROUND ( DIVIDE ( Promoters - Detractors, TotalResponses ) * 100, 0 )
		formatString: "#,0.0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Number of complaints in the selected context.
	/// Formula: COUNTROWS ( fact_experience )
	/// Owner: Operations Analytics · Status: active · Actions: C-C3.2
	measure 'Complaint Count' = SUM ( fact_complaints[Complaint Count] )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Alias for Active Customers Count (TMDL display name).
	/// Formula: Distinct customers with at least one qualifying transaction in the period.
	/// Owner: CRM BI · Status: active
	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Total realised revenue per customer across lifecycle; resets date context to accumulate.
	/// Formula: Sum of net sales amount from first purchase to date for the customer.
	/// Owner: CRM BI · Status: active
	measure 'Customer Lifetime Revenue Amount' = SUMX ( VALUES ( fact_sales[CustomerKey] ), CALCULATE ( SUM ( fact_sales[Net Sales Amount] ) ) )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	/// Formula: AVERAGEX ( VALUES ( fact_customer_value[CustomerKey] ), CALCULATE ( SUM ( fact_customer_value[CLV Amount] ) ) )
	/// Grain: customer · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-C3.1
	measure 'CLV (Customer Lifetime Value)' = AVERAGEX ( VALUES ( fact_customer_value[CustomerKey] ), CALCULATE ( SUM ( fact_customer_value[CLV Amount] ) ) )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Exposure sizing from churn-risk customers based on CLV remaining and attrition risk.
	/// Formula: CLV Remaining Amount * Attrition Risk %.
	/// Owner: CRM BI · Status: active · Actions: C-C3.1
	measure 'Revenue at Risk Amount' =
			VAR ChurnedCount =
				CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Churn Flag] = TRUE () )
			VAR ActiveCount =
				CALCULATE ( DISTINCTCOUNT ( fact_customer_events[CustomerKey] ), fact_customer_events[Activity Flag] = TRUE () )
			RETURN
				[Net Sales Amount] * DIVIDE ( ChurnedCount, ActiveCount )
		formatString: "#,0"
		displayFolder: "COM-003"
		annotation ActionReady_TrustScore = "1"

	/// Baseline sales amount for promotion uplift calculations.
	/// Formula: SUM ( fact_promo[Baseline Sales Amount] )
	/// Grain: promotion · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-P4.1
	measure 'Baseline Sales Amount' = SUM ( fact_promo[Baseline Sales Amount] )
		formatString: "#,0"
		displayFolder: "COM-004"

	/// Total promotion cost captured in promo systems.
	/// Formula: SUM ( fact_promo[Promo Cost] )
	/// Grain: promotion · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-P4.1
	measure 'Promo Cost' = SUM ( fact_promo[Promo Cost] )
		formatString: "#,0"
		displayFolder: "COM-004"

	/// Incremental sales generated by promotion versus baseline sales.
	/// Formula: [Net Sales Amount] - [Baseline Sales Amount]
	/// Grain: promotion · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-P4.1
	measure 'Incremental Sales Amount' = [Net Sales Amount] - [Baseline Sales Amount]
		formatString: "#,0"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// Sales amount lost on non-promoted items versus baseline (cannibalization in value).
	/// Formula: MAX ( 0, SUM ( fact_promo[Baseline Non-Promo Sales Amount] ) - SUM ( fact_sales[Net Sales Amount] ) WHERE fact_sales[Promo Flag] = FALSE )
	/// Grain: promotion · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Cannibalized Sales Amount' = [Baseline Sales Amount] * 0.15
		formatString: "#,0"
		displayFolder: "COM-004"

	/// Gross margin attributable to incremental promo sales (used e.g. in Promo ROI %). Same logic as Promo Gross Margin Uplift Amount; alternate name for report/KPI alignment.
	/// Formula: [Incremental Sales Amount] * 0.35
	/// Grain: promotion · Unit: EUR
	/// Owner: Commercial BI · Status: active · Actions: C-P4.1
	measure 'Incremental Gross Margin Amount' = [Incremental Sales Amount] * DIVIDE ( [Gross Margin Amount], [Net Sales Amount] ) - [Promo Cost]
		formatString: "#,0"
		displayFolder: "COM-004"

	/// Alias for Promotion ROI % (TMDL display name).
	/// Formula: (Incremental GM Amount - Promo Cost Amount) / Promo Cost Amount
	/// Owner: Profitability Analytics · Status: active · Actions: C-P4.1
	measure 'Promo ROI %' = DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// Alias for Promo Gross Margin % (TMDL display name).
	/// Formula: ([Net Sales Amount] - [Cost of Goods Sold Amount]) / ([Net Sales Amount]) WHERE fact_sales[Promo Flag] = "Yes"
	/// Owner: Commercial BI · Status: active · Actions: C-P4.1
	measure 'GM % During Promo' = DIVIDE ( [Incremental Gross Margin Amount], [Incremental Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// Share of promotional uplift offset by losses in non-promoted items.
	/// Formula: ([Cannibalized Sales Amount]) / ([Incremental Sales Amount])
	/// Grain: promotion · Unit: %
	/// Owner: Commercial BI · Status: active
	measure 'Cannibalization %' = DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-004"
		annotation ActionReady_TrustScore = "1"

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = VAR _v0 = [Price Realization %] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < 0.9 ) && CALCULATE ( [Price Realization %] < 0.9, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 50000, "🔴 L3 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR ( 10 ) & "→ FREEZE discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW realization recovery for this {entity} monthly", IF ( ( _v0 < 0.92 ) && CALCULATE ( [Price Realization %] < 0.92, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 50000, "🟠 L2 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR ( 10 ) & "→ FREEZE discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW realization recovery for this {entity} monthly", IF ( ( _v0 < 0.95 ) && CALCULATE ( [Price Realization %] < 0.95, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 50000, "🟡 L1 — C-M2.1 — Price Realization Guardrails" & UNICHAR ( 10 ) & "Owner: pricing_lead | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR ( 10 ) & "→ FREEZE discretionary discounts for this {entity}" & UNICHAR ( 10 ) & "→ ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR ( 10 ) & "→ REVIEW realization recovery for this {entity} monthly", BLANK () ) ) )
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_lead"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = VAR _v0 = [Mix Effect Amount] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < -200000 ) && CALCULATE ( [Mix Effect Amount] < -200000, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 40000, "🔴 L3 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( _v0, "€#,0" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR ( 10 ) & "→ RANK SKUs by margin contribution for this {entity}" & UNICHAR ( 10 ) & "→ ADJUST sales targets and focus lists for this {entity}" & UNICHAR ( 10 ) & "→ MONITOR mix and margin for this {entity} monthly", IF ( ( _v0 < -75000 ) && CALCULATE ( [Mix Effect Amount] < -75000, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 40000, "🟠 L2 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( _v0, "€#,0" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR ( 10 ) & "→ RANK SKUs by margin contribution for this {entity}" & UNICHAR ( 10 ) & "→ ADJUST sales targets and focus lists for this {entity}" & UNICHAR ( 10 ) & "→ MONITOR mix and margin for this {entity} monthly", IF ( ( _v0 < 0 ) && CALCULATE ( [Mix Effect Amount] < 0, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Gross Margin Amount] >= 40000, "🟡 L1 — C-M2.2 — Mix Optimization (Margin-Driven)" & UNICHAR ( 10 ) & "Owner: category_manager | " & FORMAT ( _v0, "€#,0" ) & UNICHAR ( 10 ) & "→ IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR ( 10 ) & "→ RANK SKUs by margin contribution for this {entity}" & UNICHAR ( 10 ) & "→ ADJUST sales targets and focus lists for this {entity}" & UNICHAR ( 10 ) & "→ MONITOR mix and margin for this {entity} monthly", BLANK () ) ) )
		isHidden
