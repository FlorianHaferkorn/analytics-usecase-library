/// Consolidated Measures for: COM-001
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// margin.gm.pct - margin.gm.pct
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'margin.gm.pct' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.plan - sales.net_sales.delta_pct.plan
	/// Relative variance of Net Sales vs Plan.
	measure 'sales.net_sales.delta_pct.plan' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.delta_pct.ly - sales.net_sales.delta_pct.ly
	/// Relative variance of Net Sales vs Last Year.
	measure 'sales.net_sales.delta_pct.ly' = BLANK()
		formatString: "0.0%"
		displayFolder: "COM-001"

	/// sales.net_sales.amount - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'sales.net_sales.amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"

	/// sales.pvm.price_effect.amount - sales.pvm.price_effect.amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'sales.pvm.price_effect.amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"

	/// sales.pvm.volume_effect.amount - sales.pvm.volume_effect.amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'sales.pvm.volume_effect.amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"

	/// sales.pvm.mix_effect.amount - sales.pvm.mix_effect.amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'sales.pvm.mix_effect.amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"

	/// cost.cogs.amount - cost.cogs.amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'cost.cogs.amount' = BLANK()
		formatString: "#,0"
		displayFolder: "COM-001"

	/// ActionReady Logic: C-M2.1 - C-M2.1
	measure 'Action_C-M2.1_Text' = "Trigger: (no trigger defined)" & UNICHAR(10) & "Owner: TBD"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "TBD"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-S1.1 - C-S1.1
	measure 'Action_C-S1.1_Text' = "Trigger: (no trigger defined)" & UNICHAR(10) & "Owner: TBD"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "TBD"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - C-S1.2
	measure 'Action_C-S1.2_Text' = "Trigger: (no trigger defined)" & UNICHAR(10) & "Owner: TBD"
		isHidden
		formatString: "@"
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "TBD"
		annotation ActionReady_ActionCodeId = "C-S1.2"
