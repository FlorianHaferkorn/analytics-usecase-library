	/// ActionReady Logic: C-C3.2 - Complaint & Advocacy Recovery
	measure 'Action_C-C3.2_Text' = VAR _v0 = [Net Promoter Score (NPS)] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( _v0 < -5 ) && CALCULATE ( [Net Promoter Score (NPS)] < -5, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Complaint Count] >= 10, "🔴 L3 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "+0;-0" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or products with falling advocacy and rising complaints" & UNICHAR ( 10 ) & "→ MAP the complaint pattern to channel, product, and customer ownership" & UNICHAR ( 10 ) & "→ EXECUTE recovery actions and close the highest-value issue clusters first" & UNICHAR ( 10 ) & "→ REVIEW complaint volume, NPS, and retention response monthly", IF ( ( _v0 < 5 ) && CALCULATE ( [Net Promoter Score (NPS)] < 5, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Complaint Count] >= 10, "🟠 L2 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "+0;-0" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or products with falling advocacy and rising complaints" & UNICHAR ( 10 ) & "→ MAP the complaint pattern to channel, product, and customer ownership" & UNICHAR ( 10 ) & "→ EXECUTE recovery actions and close the highest-value issue clusters first" & UNICHAR ( 10 ) & "→ REVIEW complaint volume, NPS, and retention response monthly", IF ( ( _v0 < 20 ) && CALCULATE ( [Net Promoter Score (NPS)] < 20, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Complaint Count] >= 10, "🟡 L1 — C-C3.2 — Complaint & Advocacy Recovery" & UNICHAR ( 10 ) & "Owner: commercial_controlling_lead | " & FORMAT ( _v0, "+0;-0" ) & UNICHAR ( 10 ) & "→ IDENTIFY segments or products with falling advocacy and rising complaints" & UNICHAR ( 10 ) & "→ MAP the complaint pattern to channel, product, and customer ownership" & UNICHAR ( 10 ) & "→ EXECUTE recovery actions and close the highest-value issue clusters first" & UNICHAR ( 10 ) & "→ REVIEW complaint volume, NPS, and retention response monthly", BLANK () ) ) )
		isHidden
