/// Consolidated Measures for: COM-002
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' = DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// margin.gm.amount - Gross Margin Amount
	/// Absolute gross margin in currency.
	measure 'Gross Margin Amount' = [Net Sales Amount] - [Cost of Goods Sold Amount]
		displayFolder: "COM-002"

	/// sales.price.list.amount - List Price Amount
	/// Total list price (before discounts) for price realization and discount analysis.
	measure 'List Price Amount' = SUM ( fact_sales[List Price Amount] )
		displayFolder: "COM-002"

	/// sales.price.net.amount - Net Price Amount
	/// Total net price (after discounts) for price realization and discount analysis.
	measure 'Net Price Amount' = SUM ( fact_sales[Net Price Amount] )
		displayFolder: "COM-002"

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// sales.pvm.mix_effect.amount - Mix Effect Amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' = [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ) - [Price Effect Amount] - [Volume Effect Amount]
		displayFolder: "COM-002"

	/// cost.cogs_per_unit.amount - COGS per Unit
	/// Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' = DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		displayFolder: "COM-002"

	/// margin.gm.vs_plan.pct - Gross Margin % vs Plan
	/// Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' = VAR GMAct = DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ) VAR GMPlan = DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] ), SUM ( fact_sales[Plan Sales Amount] ) ) RETURN DIVIDE ( GMAct - GMPlan, GMPlan )
		formatString: "0.0%"
		displayFolder: "COM-002"

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = "Trigger: Pattern (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: category_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR(10) & "  2. RANK SKUs by margin contribution for this {entity}" & UNICHAR(10) & "  3. ADJUST sales targets and focus lists for this {entity}" & UNICHAR(10) & "  4. MONITOR mix and margin for this {entity} monthly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "category_manager"
		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: trade_marketing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with repeated negative ROI" & UNICHAR(10) & "  2. REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR(10) & "  3. STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR(10) & "  4. VALIDATE ROI improvement for this {entity} in next cycle"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "trade_marketing_lead"
		annotation ActionReady_ActionCodeId = "C-P4.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: sales_director" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this {entity} within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this {entity}" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this {entity} after one cycle"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"
