/// Product dimension with category hierarchy (Category > Sub Category > Brand > Product Name).
table dim_product
	 lineageTag: daef4ca0-5338-4c49-a9b4-d997c069349b

	 column ProductKey
		 dataType: Int64
		 sourceColumn: ProductKey
		 summarizeBy: none
		 isHidden

	 column ProductCode
		 dataType: String
		 sourceColumn: ProductCode
		 summarizeBy: none

	 column ProductName
		 dataType: String
		 sourceColumn: ProductName
		 summarizeBy: none

	 column Category
		 dataType: String
		 sourceColumn: Category
		 summarizeBy: none

	 column Subcategory
		 dataType: String
		 sourceColumn: Subcategory
		 summarizeBy: none

	 column Brand
		 dataType: String
		 sourceColumn: Brand
		 summarizeBy: none

	 column ProductFamily
		 dataType: String
		 sourceColumn: ProductFamily
		 summarizeBy: none

	 partition dim_product = m
		 mode: import
		 source =
			let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_product"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

