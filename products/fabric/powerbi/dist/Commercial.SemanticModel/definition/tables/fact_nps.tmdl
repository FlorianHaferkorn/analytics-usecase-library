/// NPS survey responses (score, promoter/detractor flags) per response.
table fact_nps
	lineageTag: 2db4f272-60ab-4738-be75-315e7490a7b1

	column ResponseID
		dataType: String
		sourceColumn: ResponseID
		summarizeBy: none
		isHidden

	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none

	column CustomerKey
		dataType: Int64
		sourceColumn: CustomerKey
		summarizeBy: none

	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none

	column 'NPS Score'
		dataType: Double
		sourceColumn: NPS Score
		summarizeBy: none

	column 'Is Promoter'
		dataType: Boolean
		sourceColumn: Is Promoter
		summarizeBy: none

	column 'Is Detractor'
		dataType: Boolean
		sourceColumn: Is Detractor
		summarizeBy: none

	partition fact_nps = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_nps"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

