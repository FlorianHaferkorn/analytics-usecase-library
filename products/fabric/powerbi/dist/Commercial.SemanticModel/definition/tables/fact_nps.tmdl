/// NPS survey responses (score, promoter/detractor flags) per response.
table fact_nps
	 lineageTag: a72b9b1b-0437-418f-a924-912e90858d55

	 column ResponseID
		 dataType: String
		 sourceColumn: ResponseID
		 summarizeBy: none
		 isHidden

	 column DateKey
		 dataType: Int64
		 sourceColumn: DateKey
		 summarizeBy: none

	 column CustomerKey
		 dataType: Int64
		 sourceColumn: CustomerKey
		 summarizeBy: none

	 column OrgKey
		 dataType: Int64
		 sourceColumn: OrgKey
		 summarizeBy: none

	 column 'NPS Score'
		 dataType: Double
		 sourceColumn: NPS Score
		 summarizeBy: none

	 column 'Is Promoter'
		 dataType: Boolean
		 sourceColumn: Is Promoter
		 summarizeBy: none

	 column 'Is Detractor'
		 dataType: Boolean
		 sourceColumn: Is Detractor
		 summarizeBy: none

	 partition fact_nps = m
		 mode: import
		 source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_nps"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

