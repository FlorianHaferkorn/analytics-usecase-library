/// Customer dimension (segment, region, country) for CRM and value reporting.
table dim_customer
	 lineageTag: 15824da1-e1ca-4ece-9f93-6b5fe153525e

	 column CustomerKey
		 dataType: Int64
		 sourceColumn: CustomerKey
		 summarizeBy: none
		 isHidden

	 column CustomerCode
		 dataType: String
		 sourceColumn: CustomerCode
		 summarizeBy: none

	 column CustomerName
		 dataType: String
		 sourceColumn: CustomerName
		 summarizeBy: none

	 column Segment
		 dataType: String
		 sourceColumn: Segment
		 summarizeBy: none

	 column Channel
		 dataType: String
		 sourceColumn: Channel
		 summarizeBy: none

	 column Region
		 dataType: String
		 sourceColumn: Region
		 summarizeBy: none

	 partition dim_customer = m
		 mode: import
		 source =
			let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_customer"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

