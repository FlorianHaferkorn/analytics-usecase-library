/// Customer activity and churn flags plus attrition risk at customer-month grain.
table fact_customer_events
	lineageTag: 2315563b-b7fe-428a-9c73-fa67b7abf4a9

	column DateKey
		dataType: int64
		lineageTag: 26ef791b-d865-4a3e-a46a-3056a69845b3
		summarizeBy: none
		sourceColumn: DateKey

	column CustomerKey
		dataType: int64
		lineageTag: 91ff3a4d-5978-40d3-bfab-0414d8d5a73d
		summarizeBy: none
		sourceColumn: CustomerKey

	column OrgKey
		dataType: int64
		lineageTag: 77caa6ad-f632-4fee-b2a6-52c3a0871940
		summarizeBy: none
		sourceColumn: OrgKey

	column 'Activity Flag'
		dataType: boolean
		lineageTag: 00f41a5a-bfcb-43d8-aec5-476fe3d157e1
		summarizeBy: none
		sourceColumn: Activity Flag

	column 'Churn Flag'
		dataType: boolean
		lineageTag: 0ab0d9ad-09e2-4f74-973b-bc6a9826a56d
		summarizeBy: none
		sourceColumn: Churn Flag

	column 'Attrition Risk %'
		dataType: double
		lineageTag: 4ce544bd-b40a-45d7-b5ba-0cd95267c328
		summarizeBy: none
		sourceColumn: Attrition Risk %

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition fact_customer_events = m
		mode: import
		source =
				let
					Source = Folder.Files(GoldDataPath & "/facts/fact_customer_events"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
				in
					ParquetData

