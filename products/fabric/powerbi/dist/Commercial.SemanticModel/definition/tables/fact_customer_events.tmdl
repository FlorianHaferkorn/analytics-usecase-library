/// Customer activity and churn flags plus attrition risk at customer-month grain.
table fact_customer_events
	 lineageTag: fdbd1efb-d79a-4b04-8254-f930c596070f

	 column DateKey
		 dataType: Int64
		 sourceColumn: DateKey
		 summarizeBy: none

	 column CustomerKey
		 dataType: Int64
		 sourceColumn: CustomerKey
		 summarizeBy: none

	 column OrgKey
		 dataType: Int64
		 sourceColumn: OrgKey
		 summarizeBy: none

	 column 'Activity Flag'
		 dataType: Boolean
		 sourceColumn: Activity Flag
		 summarizeBy: none

	 column 'Churn Flag'
		 dataType: Boolean
		 sourceColumn: Churn Flag
		 summarizeBy: none

	 column 'Attrition Risk %'
		 dataType: Decimal
		 sourceColumn: Attrition Risk %
		 summarizeBy: none

	 partition fact_customer_events = m
		 mode: import
		 source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_customer_events"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

