/// Organization dimension (region, country, channel, org name) for reporting and RLS.
table dim_org
	lineageTag: 9fbcb3ff-2811-427f-9c8b-821902f95294

	column OrgKey
		dataType: int64
		isHidden
		lineageTag: ce83f39d-834b-41dd-bb92-e499a27eb510
		summarizeBy: none
		sourceColumn: OrgKey

	column OrgCode
		dataType: string
		lineageTag: 59db5753-a9be-4d60-adb7-0ca3e0a653c2
		summarizeBy: none
		sourceColumn: OrgCode

	column OrgName
		dataType: string
		lineageTag: caa64957-c3d5-440a-9d57-a2a44543a5c7
		summarizeBy: none
		sourceColumn: OrgName

	column Country
		dataType: string
		lineageTag: f3ac155e-9357-4713-b174-7c065c647b17
		summarizeBy: none
		sourceColumn: Country

	column Region
		dataType: string
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890
		summarizeBy: none
		sourceColumn: Region

	column Channel
		dataType: string
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678901
		summarizeBy: none
		sourceColumn: Channel

	column OrgLevel
		dataType: string
		lineageTag: dad7d672-656a-4b88-94cd-bd6ab467b065
		summarizeBy: none
		sourceColumn: OrgLevel

		annotation SummarizationSetBy = Automatic

	column ParentOrgKey
		dataType: int64
		formatString: 0
		lineageTag: 5378ad63-be0b-440a-9ad1-3339bac5dbf4
		summarizeBy: none
		sourceColumn: ParentOrgKey

		annotation SummarizationSetBy = Automatic

	column 'Currency Code'
		dataType: string
		lineageTag: 86bd0f2f-e941-4589-964b-f9fb7418c5c5
		summarizeBy: none
		sourceColumn: Currency Code

		annotation SummarizationSetBy = Automatic

	column OrgType
		dataType: string
		lineageTag: 6a49dba0-c90e-4c63-8eab-cb32ba2a174e
		summarizeBy: none
		sourceColumn: OrgType

		annotation SummarizationSetBy = Automatic

	column 'Open DateKey'
		dataType: int64
		formatString: 0
		lineageTag: 2c45bb63-bffe-4c3c-b49f-cc5b7835d447
		summarizeBy: none
		sourceColumn: Open DateKey

		annotation SummarizationSetBy = Automatic

	column 'Close DateKey'
		dataType: int64
		formatString: 0
		lineageTag: a7a5f7e9-59d3-465e-8ea6-2f0d1ff0baae
		summarizeBy: none
		sourceColumn: Close DateKey

		annotation SummarizationSetBy = Automatic

	hierarchy 'Org Hierarchy'
		lineageTag: a3b64ab7-cd5b-5759-b4b7-bd1c98dbce02

		level Country
			lineageTag: ddbb4129-31bf-448b-bd51-d2f8c098db33
			column: Country

		level OrgName
			lineageTag: 4dbeb5f3-acdd-4c88-a4be-85619c3b1059
			column: OrgName

	partition dim_org = m
		mode: import
		source =
				let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
				in
					ParquetData

