/// Organization hierarchy (Region → Country → Channel → Org)
table dim_org
	lineageTag: 96b30fb7-9cfa-5f8c-9cf7-396e9577cf54
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
	column OrgCode
		dataType: String
		sourceColumn: OrgCode
		summarizeBy: none
	column OrgName
		dataType: String
		sourceColumn: OrgName
		summarizeBy: none
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	column Channel
		dataType: String
		sourceColumn: Channel
		summarizeBy: none
	partition dim_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
	hierarchy 'Org Hierarchy'
		lineageTag: a3b64ab7-cd5b-5759-b4b7-bd1c98dbce02
		level Region Name
			column: Region Name
		level Country Name
			column: Country Name
		level Channel Name
			column: Channel Name
		level Org Name
			column: Org Name
