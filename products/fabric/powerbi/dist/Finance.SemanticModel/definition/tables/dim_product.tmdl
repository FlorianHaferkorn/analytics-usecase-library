/// Product dimension for inventory valuation and cost analysis
table dim_product
	lineageTag: e893a0e0-2433-58df-a3a7-2cbe8e5cfe01
	column ProductKey
		dataType: Int64
		sourceColumn: ProductKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column ProductCode
		dataType: String
		sourceColumn: ProductCode
		summarizeBy: none
	column ProductName
		dataType: String
		sourceColumn: ProductName
		summarizeBy: none
	column Category
		dataType: String
		sourceColumn: Category
		summarizeBy: none
	partition dim_product = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/dimensions/dim_product"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
