/// Cost fact table: material cost, OpEx, unit cost per plant/product/period.
table fact_cost
		lineageTag: 7a8b9c0d-1e2f-3456-7a8b-9c0d1e2f3a4b

		column DateKey
			dataType: Int64
			sourceColumn: DateKey
			summarizeBy: none

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none

		column 'Material Cost Amount'
			dataType: Decimal
			sourceColumn: Material Cost Amount
			summarizeBy: none

		column 'OpEx Amount'
			dataType: Decimal
			sourceColumn: OpEx Amount
			summarizeBy: none

		column 'Plan OpEx Amount'
			dataType: Decimal
			sourceColumn: Plan OpEx Amount
			summarizeBy: none

		column 'Total Revenue Amount'
			dataType: Decimal
			sourceColumn: Total Revenue Amount
			summarizeBy: none

		column 'COGS Amount'
			dataType: Decimal
			sourceColumn: COGS Amount
			summarizeBy: none

		partition fact_cost = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_cost"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

