/// Cost breakdown (COGS, material, overhead) per plant-line-product-month
table fact_cost
	lineageTag: 360259ee-a545-5fde-bc7d-086f89c12271
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'COGS Amount'
		dataType: Decimal
		sourceColumn: COGS Amount
		summarizeBy: none
	column 'Material Cost Amount'
		dataType: Decimal
		sourceColumn: Material Cost Amount
		summarizeBy: none
	column 'Overhead Amount'
		dataType: Decimal
		sourceColumn: Overhead Amount
		summarizeBy: none
	partition fact_cost = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_cost"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
