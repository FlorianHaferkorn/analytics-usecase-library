/// Order-level fulfillment facts (OTIF, on-time, in-full) per entity-month.
table fact_fulfillment
	lineageTag: f256ee67-528f-42be-99fd-4076ff3085a2
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'OTIF Flag'
		dataType: Boolean
		sourceColumn: OTIF Flag
		summarizeBy: none
	column 'On-Time Flag'
		dataType: Boolean
		sourceColumn: On-Time Flag
		summarizeBy: none
	column 'In-Full Flag'
		dataType: Boolean
		sourceColumn: In-Full Flag
		summarizeBy: none
	column 'Order Qty'
		dataType: Decimal
		sourceColumn: Order Qty
		summarizeBy: none
	partition fact_fulfillment = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_fulfillment"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
