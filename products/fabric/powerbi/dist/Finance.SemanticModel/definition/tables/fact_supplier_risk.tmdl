/// Supplier risk scores per supplier and month (composite risk index, delivery risk, quality risk).
/// Source: Gold Layer — showcases/aurora_group/data/gold/facts/fact_supplier_risk (Parquet, 2020–2024).
table fact_supplier_risk
	lineageTag: a7c3e218-6b4f-4d9a-8e31-2f5c7b1a9d04
	column SupplierKey
		dataType: Int64
		sourceColumn: SupplierKey
		summarizeBy: none
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column 'Risk Score'
		dataType: Decimal
		sourceColumn: Risk Score
		summarizeBy: none
	column 'Delivery Risk Score'
		dataType: Decimal
		sourceColumn: Delivery Risk Score
		summarizeBy: none
	column 'Quality Risk Score'
		dataType: Decimal
		sourceColumn: Quality Risk Score
		summarizeBy: none
	column 'Financial Risk Score'
		dataType: Decimal
		sourceColumn: Financial Risk Score
		summarizeBy: none
	partition fact_supplier_risk = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_supplier_risk"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet") and not Text.Contains([Folder Path], "_delta_log")),
				SortedFiles = Table.Sort(FilteredFiles, {{"Date modified", Order.Descending}}),
				FirstFile = SortedFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
