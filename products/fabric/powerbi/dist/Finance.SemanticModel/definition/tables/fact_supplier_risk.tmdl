/// Supplier risk scores per supplier and month (composite risk index, delivery risk, quality risk).
/// Data contract pending: source table fact_supplier_risk in Gold Layer not yet available.
/// Stub: returns empty partition until Gold Layer table is provisioned.
table fact_supplier_risk
	lineageTag: a7c3e218-6b4f-4d9a-8e31-2f5c7b1a9d04
	column SupplierKey
		dataType: Int64
		sourceColumn: SupplierKey
		summarizeBy: none
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column 'Risk Score'
		dataType: Decimal
		sourceColumn: Risk Score
		summarizeBy: none
	column 'Delivery Risk Score'
		dataType: Decimal
		sourceColumn: Delivery Risk Score
		summarizeBy: none
	column 'Quality Risk Score'
		dataType: Decimal
		sourceColumn: Quality Risk Score
		summarizeBy: none
	column 'Financial Risk Score'
		dataType: Decimal
		sourceColumn: Financial Risk Score
		summarizeBy: none
	partition fact_supplier_risk = m
		mode: import
		source =
			let
				Source = #table(
					type table [SupplierKey = Int64, DateKey = Int64,
						#"Risk Score" = Decimal.Type, #"Delivery Risk Score" = Decimal.Type,
						#"Quality Risk Score" = Decimal.Type, #"Financial Risk Score" = Decimal.Type],
					{}
				)
			in
				Source
