/// Labor fact table: FTE counts, labor hours, and productivity for operations cost analysis.
table fact_labor
		lineageTag: 9c0d1e2f-3a4b-5678-9c0d-1e2f3a4b5c6d

		column DateKey
			dataType: Int64
			sourceColumn: DateKey
			summarizeBy: none

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none

		column 'Labor Hours'
			dataType: Decimal
			sourceColumn: Labor Hours
			summarizeBy: none

		column 'Output Units'
			dataType: Decimal
			sourceColumn: Output Units
			summarizeBy: none

		column 'Plan Output Units'
			dataType: Decimal
			sourceColumn: Plan Output Units
			summarizeBy: none

		partition fact_labor = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_labor"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

