/// Labor hours per plant-line-month
table fact_labor
	lineageTag: 7fc2929f-2791-54f3-87dc-b249edff6d5c
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Labor Hours'
		dataType: Decimal
		sourceColumn: Labor Hours
		summarizeBy: none
	partition fact_labor = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_labor"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
