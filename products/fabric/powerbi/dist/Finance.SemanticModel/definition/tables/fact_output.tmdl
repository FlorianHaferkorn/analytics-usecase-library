/// Output units per plant-line-product-month
table fact_output
	lineageTag: a2deee00-83cf-58da-a8cf-2c649beac779
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Output Units'
		dataType: Decimal
		sourceColumn: Output Units
		summarizeBy: none
	partition fact_output = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_output"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
