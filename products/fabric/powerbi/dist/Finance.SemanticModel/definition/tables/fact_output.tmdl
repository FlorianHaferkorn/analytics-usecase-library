/// Output units per plant-line-product-month
table fact_output
	lineageTag: a2deee00-83cf-58da-a8cf-2c649beac779
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Output Units'
		dataType: Decimal
		sourceColumn: Output Units
		summarizeBy: none
	column 'Good Units'
		dataType: Decimal
		sourceColumn: Good Units
		summarizeBy: none
	column 'Defect Count'
		dataType: Decimal
		sourceColumn: Defect Count
		summarizeBy: none
	partition fact_output = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_output"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
