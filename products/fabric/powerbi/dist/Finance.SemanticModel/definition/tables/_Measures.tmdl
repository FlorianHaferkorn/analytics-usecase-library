/// Consolidated Measures for: FIN-001, FIN-002 (Finance)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (FIN)' = VAR _cf = [Operating Cash Flow] VAR _ccc = [CCC Days] VAR _dso = [DSO Days] VAR _dpo = [DPO Days] VAR _opex = [OpEx vs Plan %] VAR _mat = [Material Cost %] RETURN "Cash Flow: " & FORMAT ( _cf, "€#,0" ) & "  |  CCC: " & FORMAT ( _ccc, "0.0" ) & "d" & UNICHAR ( 10 ) & "DSO: " & FORMAT ( _dso, "0.0" ) & "d  |  DPO: " & FORMAT ( _dpo, "0.0" ) & "d" & UNICHAR ( 10 ) & "OpEx vs Plan: " & FORMAT ( _opex, "+0.0%;-0.0%" ) & "  |  Material Cost: " & FORMAT ( _mat, "0.0%" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 97f0296c-70eb-469d-87da-5eb6c73cbdc0

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (FIN)' = VAR _rows = FILTER ( { [Action_F-C1.1_Text], [Action_F-C1.2_Text], [Action_F-C1.4_Text], [Action_F-K2.1_Text], [Action_F-K2.2_Text], [Action_F-K2.3_Text], [Action_F-K2.4_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: ab82a076-0fdf-4efe-b79b-9b32fafff082


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (FIN)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: 0cf48a68-c720-4ae5-882f-a9ed0a8e47cd
	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// Working capital cycle time.
	/// Formula: [DSO Days] + [DIO Days] - [DPO Days]
	/// Grain: month · Unit: days
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1
	/// Synonyms: Cash Conversion Cycle, Net Operating Cycle, Cash Cycle, Geldumschlagsdauer
	/// Example question: What pushed the cash conversion cycle higher this month?
	measure 'CCC Days' =
			VAR DaysSalesOutstanding =
				[DSO Days]
			VAR DaysInventoryOutstanding =
				[DIO Days]
			VAR DaysPayablesOutstanding =
				[DPO Days]
			RETURN
				DaysSalesOutstanding + DaysInventoryOutstanding - DaysPayablesOutstanding
		formatString: "0"
		displayFolder: "FIN-001"

	/// Cash and cash equivalents.
	/// Formula: SUM(fact_cash_position[Cash Balance Amount]) at MAX(DateKey) in filter context
	/// Grain: day · Unit: EUR
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1, F-C1.2
	/// Synonyms: Cash and Cash Equivalents, Cash Position, Liquide Mittel, Kassenbestand
	/// Example question: How has our cash balance tracked versus plan this year?
	measure 'Cash Balance' = SUM ( fact_cash_position[Cash Balance Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Cash generated from operating activities.
	/// Formula: Net cash flows from operations for the period.
	/// Grain: month · Unit: EUR
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.2, S-I1.2, F-C1.4
	/// Synonyms: Operating Cash Flow, Cash Flow from Operations, OCF, Operativer Cashflow
	/// Example question: Why did operating cash flow fall short of plan in Q2?
	measure 'Operating Cash Flow' = SUM ( fact_cash_flow[Operating Cash Flow Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Performance vs plan for cash position.
	/// Formula: (Cash Balance - Cash Plan) / Cash Plan.
	/// Grain: month · Unit: %
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1
	/// Synonyms: Cash Plan Variance %, Cash Budget Variance, Liquiditätsplanabweichung
	/// Example question: How far is cash tracking from the liquidity plan this month?
	measure 'Cash vs Plan %' =
			VAR ActualCashBalance =
				SUM ( fact_cash_position[Cash Balance Amount] )
			VAR PlannedCashBalance =
				SUM ( fact_cash_position[Plan Cash Amount] )
			VAR CashVariance =
				ActualCashBalance - PlannedCashBalance
			RETURN
				DIVIDE ( CashVariance, PlannedCashBalance )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// Receivables efficiency: AR / (Revenue/365).
	/// Formula: SUM(fact_ar[AR Amount]) / (SUM(fact_ar[Revenue Amount]) / 365)
	/// Grain: month · Unit: days
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.2
	/// Synonyms: Days Sales Outstanding, Receivables Days, Average Collection Period, Debitorenlaufzeit, Forderungslaufzeit
	/// Example question: Why did DSO increase in the Nordics region last quarter?
	measure 'DSO Days' =
			VAR AccountsReceivableAmount =
				SUM ( fact_accounts_receivable[AR Amount] )
			VAR RevenueAmount =
				SUM ( fact_accounts_receivable[Revenue Amount] )
			VAR AnnualizedReceivables =
				AccountsReceivableAmount * 365
			RETURN
				DIVIDE ( AnnualizedReceivables, RevenueAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// Inventory efficiency: Inventory / (COGS/365).
	/// Formula: SUM(fact_inventory[Inventory Amount]) / (SUM(fact_ap[COGS Amount]) / 365)
	/// Grain: month · Unit: days
	/// Owner: Finance Analytics · Status: active · Actions: S-I1.2
	/// Synonyms: Days Inventory Outstanding, Days Sales of Inventory, Inventory Days, Lagerreichweite, Bestandsreichweite
	/// Example question: Which product categories are driving up DIO this quarter?
	measure 'DIO Days' =
			VAR InventoryAmount =
				SUM ( fact_inventory[Inventory Amount] )
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_inventory[COGS Amount] )
			VAR AnnualizedInventory =
				InventoryAmount * 365
			RETURN
				DIVIDE ( AnnualizedInventory, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// Payables efficiency: AP / (COGS/365).
	/// Formula: SUM(fact_ap[AP Amount]) / (SUM(fact_ap[COGS Amount]) / 365)
	/// Grain: month · Unit: days
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.4
	/// Synonyms: Days Payable Outstanding, Payables Days, Creditor Days, Kreditorenlaufzeit
	/// Example question: Are we extending DPO with our largest suppliers this year?
	measure 'DPO Days' =
			VAR AccountsPayableAmount =
				SUM ( fact_accounts_payable[AP Amount] )
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_accounts_payable[COGS Amount] )
			VAR AnnualizedPayables =
				AccountsPayableAmount * 365
			RETURN
				DIVIDE ( AnnualizedPayables, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// OTIF % - supply.otif.pct
	/// On-time in-full rate for customer fulfillment (governed OTIF, Finance view).
	/// Formula: On-Time In-Full Orders / Total Orders.
	/// Grain: order_line_day · Unit: %
	/// Owner: Supply Chain Analytics · Status: active
	measure 'OTIF % (FIN)' =
			VAR OTIFFulfillments =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
			VAR TotalFulfillments =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// Average supplier risk score across the selected scope.
	/// Formula: Composite risk score derived from supplier risk factors.
	/// Grain: supplier_month · Unit: score
	/// Owner: Risk Analytics · Status: active
	/// Synonyms: Supplier Risk Rating, Vendor Risk Index, Lieferantenrisiko-Score, Lieferantenrisikobewertung
	/// Example question: Which suppliers carry the highest risk score?
	measure 'Supplier Risk Score' = VAR _pending = "Requires fact_supplier_risk table (not yet in data contract)" RETURN BLANK()
		formatString: "0"
		displayFolder: "FIN-001"

	/// Inventory balance used in DIO calculations.
	/// Formula: SUM(fact_inventory[Inventory Amount])
	/// Owner: Finance Analytics · Status: active
	measure 'Inventory Amount' = SUM ( fact_inventory[Average Inventory Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Total COGS / units produced or sold.
	/// Formula: SUM(fact_cost[COGS Amount]) / SUM(fact_output[Output Units])
	/// Grain: plant_line_product_month · Unit: EUR per unit
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.1, F-K2.2, F-K2.3, F-K2.4
	/// Synonyms: Cost per Unit, Average Cost per Unit, Stückkosten, Selbstkosten je Stück
	/// Example question: How did unit cost change after the plant ramp-up?
	measure 'Unit Cost Amount' = VAR TotalCost = SUM ( fact_cost[COGS Amount] ) VAR OutputUnits = SUM ( fact_output[Output Units] ) RETURN DIVIDE ( TotalCost, OutputUnits )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// Cost share: COGS / Net Sales.
	/// Formula: SUM(fact_finance[COGS Amount]) / SUM(fact_finance[Net Sales Amount])
	/// Grain: month · Unit: %
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.1
	/// Synonyms: COGS Ratio, Cost of Sales %, Umsatzkostenquote, Materialaufwandsquote
	/// Example question: Why did COGS % of sales rise in Consumer Electronics?
	measure 'COGS % of Sales' = VAR COGS = SUM ( fact_finance[COGS Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( COGS, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Overhead control: (OpEx - Plan) / Plan.
	/// Formula: (OpEx Amount - OpEx Plan Amount) / OpEx Plan Amount.
	/// Grain: month · Unit: %
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.4
	/// Synonyms: OpEx Budget Variance %, Operating Expense Variance, Betriebskostenabweichung
	/// Example question: Where is OpEx running over plan this quarter?
	measure 'OpEx vs Plan %' =
			VAR ActualOperatingExpense =
				SUM ( fact_finance[OpEx Amount] )
			VAR PlannedOperatingExpense =
				SUM ( fact_finance[Plan OpEx Amount] )
			VAR OperatingExpenseVariance =
				ActualOperatingExpense - PlannedOperatingExpense
			RETURN
				DIVIDE ( OperatingExpenseVariance, PlannedOperatingExpense )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Material cost / Net Sales.
	/// Formula: Material Cost Amount / Net Sales Amount.
	/// Grain: month · Unit: %
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.2
	/// Synonyms: Material Cost Ratio, Material Intensity, Materialkostenquote, Materialintensität
	/// Example question: Which products have the highest material cost ratio?
	measure 'Material Cost %' = VAR MaterialCost = SUM ( fact_finance[Material Cost Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( MaterialCost, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Output vs labor hours (or revenue per labor hour).
	/// Formula: Output Units or Net Sales divided by Labor Hours (normalized to % baseline).
	/// Grain: month · Unit: % / index
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.3
	measure 'Labor Productivity %' =
			VAR OutputUnits =
				SUM ( fact_output[Output Units] )
			VAR LaborHours =
				SUM ( fact_labor[Labor Hours] )
			VAR BaselineRate = 100.0
			VAR OutputPerLaborHour =
				DIVIDE ( OutputUnits, LaborHours ) * 100
			RETURN
				DIVIDE ( OutputPerLaborHour, BaselineRate )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Baseline cost volume amount for variance analysis.
	/// Formula: Baseline amount of cost volume for the selected period.
	/// Grain: cost_center_month · Unit: EUR
	/// Owner: Profitability Analytics · Status: active · Actions: F-K2.1, F-K2.2
	measure 'Cost Base Volume Amount' = SUM ( fact_cost[COGS Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Baseline operating expense amount.
	/// Formula: Baseline operating expense amount for the selected period.
	/// Grain: cost_center_month · Unit: EUR
	/// Owner: Profitability Analytics · Status: active · Actions: F-K2.4
	measure 'Opex Base Amount' = SUM ( fact_finance[Plan OpEx Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Throughput Units - ops.throughput.units
	/// Total produced units in the period (governed throughput, Finance view).
	/// Formula: Sum of produced units for the period.
	/// Grain: line_day · Unit: units
	/// Owner: Operations Analytics · Status: active · Actions: F-K2.3
	measure 'Throughput Units (FIN)' = SUM ( fact_output[Output Units] )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// Defect count divided by total output units.
	/// Formula: Defective Units / Total Produced Units.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active
	measure 'Quality Defect Rate %' = VAR Defects = SUM ( fact_quality[Defect Count] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( Defects, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Quality % - ops.quality.pct
	/// Good units divided by total output (governed quality/yield, Finance view).
	/// Formula: Good Units / Total Units Produced.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active
	/// Synonyms: Process Yield, Throughput Yield, Ausbeute, Gutausbeute, Ausbeutegrad
	/// Example question: How has process yield trended since the line upgrade?
	/// NOTE: fact_ops (Good Units) is an Operations-model table; the Finance model
	/// carries only fact_output[Output Units], so this proxy cannot be evaluated in
	/// the Finance model until a Good-Units source is added — pre-existing data gap.
	measure 'Quality % (FIN)' = VAR GoodUnits = SUM ( fact_ops[Good Units] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Net Sales Amount (FIN) - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns, Finance domain view.
	measure 'Net Sales Amount (FIN)' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Accounts payable balance at period end
	/// Formula: SUM(fact_ap[AP Amount]) at latest DateKey in filter context
	/// Owner: Finance BI · Status: active
	measure 'Payables Amount' = SUM ( fact_accounts_payable[Payables Amount] )
		formatString: #,0.00
		displayFolder: FIN-001
		lineageTag: 58cf11a3-6134-4d19-91ec-5e86f803a386

	/// ActionReady Logic: F-C1.1
	measure 'Action_F-C1.1_Text' = IF ( [Cash vs Plan %] < -0.1, "🔴 L3 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [CCC Days], "0.0" ) & "d" & UNICHAR ( 10 ) & "→ Accelerate receivables — Extend payables discipline — Review CCC weekly", IF ( [CCC Days] > 5, "🟠 L2 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [CCC Days], "0.0" ) & "d" & UNICHAR ( 10 ) & "→ Accelerate receivables — Extend payables discipline — Review CCC weekly", IF ( [Cash vs Plan %] < -0.05, "🟡 L1 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [Cash vs Plan %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Accelerate receivables — Extend payables discipline — Review CCC weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "finance_director"
		annotation ActionReady_ActionCodeId = "F-C1.1"

	/// ActionReady Logic: F-C1.2
	measure 'Action_F-C1.2_Text' = IF ( [DSO Days] > 42, "🔴 L3 — F-C1.2 — DSO Reduction Programme" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DSO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Identify overdue accounts — Accelerate collections — Review DSO weekly", IF ( [DSO Days] > 37, "🟠 L2 — F-C1.2 — DSO Reduction Programme" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DSO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Identify overdue accounts — Accelerate collections — Review DSO weekly", IF ( [DSO Days] > 33, "🟡 L1 — F-C1.2 — DSO Reduction Programme" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DSO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Identify overdue accounts — Accelerate collections — Review DSO weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_credit_and_collections"
		annotation ActionReady_ActionCodeId = "F-C1.2"

	/// ActionReady Logic: S-I1.2
	measure 'Action_S-I1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: inventory_manager" & UNICHAR(10) & "Steps:"
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "inventory_manager"
		annotation ActionReady_ActionCodeId = "S-I1.2"

	/// ActionReady Logic: F-C1.4
	measure 'Action_F-C1.4_Text' = IF ( [DPO Days] < 18, "🔴 L3 — F-C1.4 — DPO Extension Discipline" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DPO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Review payment terms — Negotiate extensions — Monitor DPO monthly", IF ( [DPO Days] < 23, "🟠 L2 — F-C1.4 — DPO Extension Discipline" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DPO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Review payment terms — Negotiate extensions — Monitor DPO monthly", IF ( [DPO Days] < 27, "🟡 L1 — F-C1.4 — DPO Extension Discipline" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [DPO Days], "0.0" ) & UNICHAR ( 10 ) & "→ Review payment terms — Negotiate extensions — Monitor DPO monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_accounts_payable"
		annotation ActionReady_ActionCodeId = "F-C1.4"

	/// ActionReady Logic: F-K2.1
	measure 'Action_F-K2.1_Text' = IF ( [Material Cost %] > 0.7, "🔴 L3 — F-K2.1 — Cost Take-Out Orchestration" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify cost overrun categories — Initiate take-out actions — Review unit cost monthly", IF ( [Material Cost %] > 0.65, "🟠 L2 — F-K2.1 — Cost Take-Out Orchestration" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify cost overrun categories — Initiate take-out actions — Review unit cost monthly", IF ( [Material Cost %] > 0.6, "🟡 L1 — F-K2.1 — Cost Take-Out Orchestration" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify cost overrun categories — Initiate take-out actions — Review unit cost monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "finance_director"
		annotation ActionReady_ActionCodeId = "F-K2.1"

	/// ActionReady Logic: F-K2.2
	measure 'Action_F-K2.2_Text' = IF ( [Material Cost %] > 0.7, "🔴 L3 — F-K2.2 — Material Cost Containment" & UNICHAR ( 10 ) & "Owner: operations_controller | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify high-cost materials — Renegotiate supplier terms — Monitor monthly", IF ( [Material Cost %] > 0.65, "🟠 L2 — F-K2.2 — Material Cost Containment" & UNICHAR ( 10 ) & "Owner: operations_controller | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify high-cost materials — Renegotiate supplier terms — Monitor monthly", IF ( [Material Cost %] > 0.6, "🟡 L1 — F-K2.2 — Material Cost Containment" & UNICHAR ( 10 ) & "Owner: operations_controller | " & FORMAT ( [Material Cost %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify high-cost materials — Renegotiate supplier terms — Monitor monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_procurement"
		annotation ActionReady_ActionCodeId = "F-K2.2"

	/// ActionReady Logic: F-K2.3
	measure 'Action_F-K2.3_Text' = IF ( [Labor Productivity %] < -0.1, "🔴 L3 — F-K2.3 — Labor Productivity Recovery" & UNICHAR ( 10 ) & "Owner: hr_operations_lead | " & FORMAT ( [Labor Productivity %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify low-productivity lines — Review scheduling — Monitor weekly", IF ( [Labor Productivity %] < -0.06, "🟠 L2 — F-K2.3 — Labor Productivity Recovery" & UNICHAR ( 10 ) & "Owner: hr_operations_lead | " & FORMAT ( [Labor Productivity %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify low-productivity lines — Review scheduling — Monitor weekly", IF ( [Labor Productivity %] < -0.03, "🟡 L1 — F-K2.3 — Labor Productivity Recovery" & UNICHAR ( 10 ) & "Owner: hr_operations_lead | " & FORMAT ( [Labor Productivity %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify low-productivity lines — Review scheduling — Monitor weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "plant_manager"
		annotation ActionReady_ActionCodeId = "F-K2.3"

	/// ActionReady Logic: F-K2.4
	measure 'Action_F-K2.4_Text' = IF ( [OpEx vs Plan %] > 0.08, "🔴 L3 — F-K2.4 — OpEx Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [OpEx vs Plan %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify opex overruns — Apply cost freeze — Review vs plan monthly", IF ( [OpEx vs Plan %] > 0.05, "🟠 L2 — F-K2.4 — OpEx Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [OpEx vs Plan %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify opex overruns — Apply cost freeze — Review vs plan monthly", IF ( [OpEx vs Plan %] > 0.02, "🟡 L1 — F-K2.4 — OpEx Discipline Enforcement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( [OpEx vs Plan %], "+0.0%;-0.0%" ) & UNICHAR ( 10 ) & "→ Identify opex overruns — Apply cost freeze — Review vs plan monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_controlling"
		annotation ActionReady_ActionCodeId = "F-K2.4"
