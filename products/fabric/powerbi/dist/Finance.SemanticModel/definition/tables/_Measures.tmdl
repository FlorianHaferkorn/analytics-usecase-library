/// Consolidated Measures for: FIN-001, FIN-002 (Finance)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI %' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_effectiveness_delta.amount - Action Effectiveness Delta
	/// Purpose: Average signed impact value for actions with outcome_status = "achieved"; proves the action loop moves the KPI, not just instruments it.
	measure 'Action Effectiveness Delta' =
			VAR AchievedRows = FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" )
			VAR Delta = AVERAGEX ( AchievedRows, fact_action_outcome[impact_value] )
			RETURN Delta
		formatString: #,0.00
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// FIN-001
	/// CCC Days - wc.ccc.days
	/// Measures cash conversion cycle length.
	measure 'CCC Days' =
		VAR DaysSalesOutstanding =
			[DSO Days]
		VAR DaysInventoryOutstanding =
			[DIO Days]
		VAR DaysPayablesOutstanding =
			[DPO Days]
		RETURN
			DaysSalesOutstanding + DaysInventoryOutstanding - DaysPayablesOutstanding
		formatString: "0"
		displayFolder: "FIN-001"

	/// Cash Balance - fin.cash.balance
	/// Tracks cash and cash equivalents at period end.
	measure 'Cash Balance' = SUM ( fact_cash_position[Cash Balance Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Operating Cash Flow - fin.cash.ocf
	/// Measures cash generated by operating activities.
	measure 'Operating Cash Flow' = SUM ( fact_cash_flow[Operating Cash Flow Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Cash vs Plan % - fin.cash.vs_plan.pct
	/// Measures deviation of cash balance versus plan.
	measure 'Cash vs Plan %' =
		VAR ActualCashBalance =
			SUM ( fact_cash_position[Cash Balance Amount] )
		VAR PlannedCashBalance =
			SUM ( fact_cash_position[Plan Cash Amount] )
		VAR CashVariance =
			ActualCashBalance - PlannedCashBalance
		RETURN
			DIVIDE ( CashVariance, PlannedCashBalance )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// DSO Days - wc.dso.days
	/// Measures days sales outstanding for receivables.
	measure 'DSO Days' =
		VAR AccountsReceivableAmount =
			SUM ( fact_accounts_receivable[AR Amount] )
		VAR RevenueAmount =
			SUM ( fact_accounts_receivable[Revenue Amount] )
		VAR AnnualizedReceivables =
			AccountsReceivableAmount * 365
		RETURN
			DIVIDE ( AnnualizedReceivables, RevenueAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// DIO Days - wc.dio.days
	/// Measures days inventory outstanding.
	measure 'DIO Days' =
		VAR InventoryAmount =
			SUM ( fact_inventory[Inventory Amount] )
		VAR CostOfGoodsSoldAmount =
			SUM ( fact_inventory[COGS Amount] )
		VAR AnnualizedInventory =
			InventoryAmount * 365
		RETURN
			DIVIDE ( AnnualizedInventory, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// DPO Days - wc.dpo.days
	/// Measures days payables outstanding.
	measure 'DPO Days' =
		VAR AccountsPayableAmount =
			SUM ( fact_accounts_payable[AP Amount] )
		VAR CostOfGoodsSoldAmount =
			SUM ( fact_accounts_payable[COGS Amount] )
		VAR AnnualizedPayables =
			AccountsPayableAmount * 365
		RETURN
			DIVIDE ( AnnualizedPayables, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "FIN-001"

	/// Supply Chain Service Level % - scm.service_level.pct
	/// Measures supply chain service level performance.
	measure 'Supply Chain Service Level %' =
		VAR OTIFFulfillments =
			CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
		VAR TotalFulfillments =
			COUNTROWS ( fact_fulfillment )
		RETURN
			DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// Supplier Risk Score - scm.supplier_risk.score
	/// Rates suppliers based on risk indicators.
	measure 'Supplier Risk Score' = VAR _pending = "Requires fact_supplier_risk table (not yet in data contract)" RETURN BLANK()
		formatString: "0"
		displayFolder: "FIN-001"

	/// Inventory Amount - fin.liquidity.inventory.amount
	/// Inventory value at period end
	measure 'Inventory Amount' = SUM ( fact_inventory[Average Inventory Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// FIN-002
	/// Unit Cost Amount - cost.unit.amount
	/// Measures total cost per unit produced or sold.
	measure 'Unit Cost Amount' = VAR TotalCost = SUM ( fact_cost[COGS Amount] ) VAR OutputUnits = SUM ( fact_output[Output Units] ) RETURN DIVIDE ( TotalCost, OutputUnits )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// COGS % of Sales - margin.cogs.pct
	/// Shows cost share relative to net sales.
	measure 'COGS % of Sales' = VAR COGS = SUM ( fact_finance[COGS Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( COGS, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// OpEx vs Plan % - cost.opex.vs_plan.pct
	/// Measures OpEx variance versus plan.
	measure 'OpEx vs Plan %' =
		VAR ActualOperatingExpense =
			SUM ( fact_finance[OpEx Amount] )
		VAR PlannedOperatingExpense =
			SUM ( fact_finance[Plan OpEx Amount] )
		VAR OperatingExpenseVariance =
			ActualOperatingExpense - PlannedOperatingExpense
		RETURN
			DIVIDE ( OperatingExpenseVariance, PlannedOperatingExpense )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Material Cost % - cost.material.pct
	/// Shows material cost share of net sales.
	measure 'Material Cost %' = VAR MaterialCost = SUM ( fact_finance[Material Cost Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( MaterialCost, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Labor Productivity % - ops.labor.productivity.pct
	/// Shows output efficiency relative to labor input.
	measure 'Labor Productivity %' =
		VAR OutputUnits =
			SUM ( fact_output[Output Units] )
		VAR LaborHours =
			SUM ( fact_labor[Labor Hours] )
		VAR BaselineRate = 100.0
		VAR OutputPerLaborHour =
			DIVIDE ( OutputUnits, LaborHours ) * 100
		RETURN
			DIVIDE ( OutputPerLaborHour, BaselineRate )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Cost Base Volume Amount - cost.base_volume.amount
	/// Baseline cost volume used for variance analysis.
	measure 'Cost Base Volume Amount' = SUM ( fact_cost[COGS Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Opex Base Amount - cost.opex.base.amount
	/// Baseline operating expense amount for variance tracking.
	measure 'Opex Base Amount' = SUM ( fact_finance[Plan OpEx Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Production Volume Units - ops.production.volume
	/// Measures total produced volume in units.
	measure 'Production Volume Units' = SUM ( fact_ops[Output Units] )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// Quality Defect Rate % - ops.quality.defect_rate.pct
	/// Measures share of defective units in production.
	measure 'Quality Defect Rate %' = VAR Defects = SUM ( fact_quality[Defect Count] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( Defects, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Operations Service Level % - ops.service_level.pct
	/// Measures on-time or in-full performance for operational delivery.
	measure 'Operations Service Level %' =
		VAR OTIFFulfillments =
			CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
		VAR TotalFulfillments =
			COUNTROWS ( fact_fulfillment )
		RETURN
			DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Yield % - ops.yield.pct
	/// Measures ratio of good output to total input.
	measure 'Yield %' = VAR GoodUnits = SUM ( fact_ops[Good Units] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Net Sales Amount - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// ActionReady Logic
	/// ActionReady Logic: F-C1.1
	measure 'Action_F-C1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: finance_director" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "finance_director"
		annotation ActionReady_ActionCodeId = "F-C1.1"

	/// ActionReady Logic: F-C1.2
	measure 'Action_F-C1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_credit_and_collections" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_credit_and_collections"
		annotation ActionReady_ActionCodeId = "F-C1.2"

	/// ActionReady Logic: S-I1.2
	measure 'Action_S-I1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: inventory_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "inventory_manager"
		annotation ActionReady_ActionCodeId = "S-I1.2"

	/// ActionReady Logic: F-C1.4
	measure 'Action_F-C1.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_accounts_payable" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_accounts_payable"
		annotation ActionReady_ActionCodeId = "F-C1.4"

	/// ActionReady Logic: F-K2.1
	measure 'Action_F-K2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: finance_director" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "finance_director"
		annotation ActionReady_ActionCodeId = "F-K2.1"

	/// ActionReady Logic: F-K2.2
	measure 'Action_F-K2.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_procurement" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_procurement"
		annotation ActionReady_ActionCodeId = "F-K2.2"

	/// ActionReady Logic: F-K2.3
	measure 'Action_F-K2.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: plant_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "plant_manager"
		annotation ActionReady_ActionCodeId = "F-K2.3"

	/// ActionReady Logic: F-K2.4
	measure 'Action_F-K2.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_controlling" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_controlling"
		annotation ActionReady_ActionCodeId = "F-K2.4"
