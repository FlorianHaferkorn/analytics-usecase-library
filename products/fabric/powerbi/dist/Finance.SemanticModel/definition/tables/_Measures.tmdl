/// Consolidated Measures for: FIN-001, FIN-002 (Finance)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (FIN)' = VAR _cf = [Operating Cash Flow] VAR _ccc = [CCC Days] VAR _dso = [DSO Days] VAR _dpo = [DPO Days] VAR _opex = [OpEx vs Plan %] VAR _mat = [Material Cost %] RETURN "Cash Flow: " & FORMAT ( _cf, "€#,0" ) & "  |  CCC: " & FORMAT ( _ccc, "0.0" ) & "d" & UNICHAR ( 10 ) & "DSO: " & FORMAT ( _dso, "0.0" ) & "d  |  DPO: " & FORMAT ( _dpo, "0.0" ) & "d" & UNICHAR ( 10 ) & "OpEx vs Plan: " & FORMAT ( _opex, "+0.0%;-0.0%" ) & "  |  Material Cost: " & FORMAT ( _mat, "0.0%" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 97f0296c-70eb-469d-87da-5eb6c73cbdc0

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (FIN)' = VAR _rows = FILTER ( { [Action_F-C1.1_Text], [Action_F-C1.2_Text], [Action_F-C1.4_Text], [Action_F-K2.1_Text], [Action_F-K2.2_Text], [Action_F-K2.3_Text], [Action_F-K2.4_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: ab82a076-0fdf-4efe-b79b-9b32fafff082


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (FIN)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: 0cf48a68-c720-4ae5-882f-a9ed0a8e47cd
	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR · Good: higher_is_better
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// Purpose: Zielwert von CCC Days aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'CCC Days Target' = CALCULATE ( SUM ( fact_target[Target Value] ), fact_target[kpi_id] = "wc.ccc.days", fact_target[scenario] = "target" )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: 28768637-77d3-5f48-8fcd-15134bdd387d

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung CCC Days gegen CCC Days Target; leer ohne Referenzwert.
	measure 'CCC Days vs Target' = VAR _r = [CCC Days Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [CCC Days] - _r )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: 214befd9-fb2e-51c1-ba6d-72e7712bab9a

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Planwert von Unit Cost Amount aus fact_target (comparison: vs_plan); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Unit Cost Amount Plan (Target Table)' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "cost.unit.amount", fact_target[scenario] = "plan" )
		formatString: "#,0"
		displayFolder: 8_Comparison
		lineageTag: f33a32b4-acea-5406-9b30-7fb3fcb15de0

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Unit Cost Amount gegen Unit Cost Amount Plan (Target Table); leer ohne Referenzwert.
	measure 'Unit Cost Amount vs Plan (Target Table)' = VAR _r = [Unit Cost Amount Plan (Target Table)] RETURN IF ( ISBLANK ( _r ), BLANK (), [Unit Cost Amount] - _r )
		formatString: "#,0"
		displayFolder: 8_Comparison
		lineageTag: d6a604f4-7553-5900-a6a6-67c9d3cd24b5

		annotation ALUCA_Generated = "comparison_measures"


	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// Signed CCC bridge step value: DSO (+), DIO (+), DPO (−); falls back to total CCC Days when no step is in context.
	/// Drives the Main_3 CCC decomposition waterfall over the disconnected _CCC_Bridge[Step] dimension.
	/// Grain: bridge_step · Unit: days · Owner: Finance Analytics · Status: active
	measure 'CCC Bridge Value' =
			SWITCH (
				SELECTEDVALUE ( _CCC_Bridge[Step] ),
				"DSO", [DSO Days],
				"DIO", [DIO Days],
				"DPO", -[DPO Days],
				[CCC Days]
			)
		formatString: "0"
		displayFolder: "FIN-001"

	/// Letzter Datenmonat als Monatsindex (Jahr*12+Monat) mit Cash-Daten — Anker aller (Now)-Measures.
	/// Macht die Headline-KPIs slicer-unabhaengig: Cards zeigen immer den aktuellen Stand.
	measure '_NowIdx' =
			CALCULATE (
				MAXX (
					FILTER ( ALL ( dim_date ), NOT ISBLANK ( CALCULATE ( SUM ( fact_cash_position[Cash Balance Amount] ) ) ) ),
					dim_date[Year] * 12 + dim_date[MonthNumber]
				),
				REMOVEFILTERS ( dim_date )
			)
		formatString: "0"
		displayFolder: "FIN-001 (Now)"
		isHidden

	/// DSO im letzten Datenmonat (slicer-unabhaengig).
	measure 'DSO Days (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// DIO im letzten Datenmonat (slicer-unabhaengig).
	measure 'DIO Days (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [DIO Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// DPO im letzten Datenmonat (slicer-unabhaengig).
	measure 'DPO Days (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// CCC im letzten Datenmonat (slicer-unabhaengig). Headline-KPI der Overview-Cards.
	measure 'CCC Days (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// Cash Balance im letzten Datenmonat (bereits semi-additiv; hier explizit gepinnt).
	measure 'Cash Balance (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [Cash Balance], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "#,0"
		displayFolder: "FIN-001 (Now)"

	/// Operating Cash Flow im letzten Datenmonat (Monatswert statt Lifetime-Summe).
	measure 'Operating Cash Flow (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [Operating Cash Flow], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "#,0"
		displayFolder: "FIN-001 (Now)"

	/// Cash vs Plan % im letzten Datenmonat (slicer-unabhaengig).
	measure 'Cash vs Plan % (Now)' =
			VAR _n = [_NowIdx]
			RETURN CALCULATE ( [Cash vs Plan %], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
		formatString: "0.0%"
		displayFolder: "FIN-001 (Now)"

	/// CCC-Bridge-Wert im letzten Datenmonat (Bridge-Total = Headline-CCC, konsistent).
	measure 'CCC Bridge Value (Now)' =
			SWITCH (
				SELECTEDVALUE ( _CCC_Bridge[Step] ),
				"DSO", [DSO Days (Now)],
				"DIO", [DIO Days (Now)],
				"DPO", -[DPO Days (Now)],
				[CCC Days (Now)]
			)
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// CCC-Gesundheit (numerisch fuer Karten-Ampel): 45 - CCC(Now). >0 = unter Ziel = gut.
	measure 'CCC Health' = 45 - [CCC Days (Now)]
		formatString: "0.0"
		displayFolder: "FIN-001 (Now)"

	/// Cash-Gesundheit (numerisch): Cash vs Plan % im letzten Datenmonat. >0 = ueber Plan = gut.
	measure 'Cash Health' = [Cash vs Plan % (Now)]
		formatString: "0.0%"
		displayFolder: "FIN-001 (Now)"

	/// OCF-Gesundheit (numerisch): OCF(Now) - OCF-Plan(Now). >0 = ueber Plan = gut.
	measure 'OCF Health' =
			VAR _n = [_NowIdx]
			VAR _ocf = [Operating Cash Flow (Now)]
			VAR _plan = CALCULATE ( [OCF Plan], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
			RETURN _ocf - _plan
		formatString: "#,0"
		displayFolder: "FIN-001 (Now)"

	/// CCC Delta je Vergleichsmodus, auf letzten Datenmonat gepinnt. Niedriger = besser.
	measure 'CCC Delta (Now)' =
			VAR _n = [_NowIdx]
			VAR _now = [CCC Days (Now)]
			VAR _pm = CALCULATE ( [CCC Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n - 1 ) )
			RETURN
				SWITCH ( SELECTEDVALUE ( Vergleich[Sort] ), 0, BLANK ( ), 2, _now - 45, _now - _pm )
		formatString: "+0.0;-0.0;0.0"
		displayFolder: "FIN-001 (Now)"

	/// Cash Balance Delta je Vergleichsmodus, auf letzten Datenmonat gepinnt. Hoeher = besser.
	measure 'Cash Balance Delta (Now)' =
			VAR _n = [_NowIdx]
			VAR _now = [Cash Balance (Now)]
			VAR _pm = CALCULATE ( [Cash Balance], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n - 1 ) )
			VAR _plan = CALCULATE ( [Cash Plan], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
			RETURN
				SWITCH ( SELECTEDVALUE ( Vergleich[Sort] ), 1, _now - _pm, _now - _plan )
		formatString: "+#,0;-#,0"
		displayFolder: "FIN-001 (Now)"

	/// Operating Cash Flow Delta je Vergleichsmodus, auf letzten Datenmonat gepinnt.
	measure 'Operating Cash Flow Delta (Now)' =
			VAR _n = [_NowIdx]
			VAR _now = [Operating Cash Flow (Now)]
			VAR _pm = CALCULATE ( [Operating Cash Flow], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n - 1 ) )
			VAR _plan = CALCULATE ( [OCF Plan], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _n ) )
			RETURN
				SWITCH ( SELECTEDVALUE ( Vergleich[Sort] ), 1, _now - _pm, _now - _plan )
		formatString: "+#,0;-#,0"
		displayFolder: "FIN-001 (Now)"

	/// Working capital cycle time.
	/// Formula: [DSO Days] + [DIO Days] - [DPO Days]
	/// Grain: month · Unit: days · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1
	/// Synonyms: Cash Conversion Cycle, Net Operating Cycle, Cash Cycle, Geldumschlagsdauer
	/// Example question: What pushed the cash conversion cycle higher this month?
	measure 'CCC Days' =
			VAR DaysSalesOutstanding =
				[DSO Days]
			VAR DaysInventoryOutstanding =
				[DIO Days]
			VAR DaysPayablesOutstanding =
				[DPO Days]
			RETURN
				DaysSalesOutstanding + DaysInventoryOutstanding - DaysPayablesOutstanding
		formatString: "0"
		displayFolder: "FIN-001"

	/// Cash-Plan-Referenz (letzter Datenmonat) — Basis für 'vs Plan'.
	measure 'Cash Plan' = LASTNONBLANKVALUE ( dim_date[Date], SUM ( fact_cash_position[Plan Cash Amount] ) )
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// OCF-Plan-Referenz.
	measure 'OCF Plan' = SUM ( fact_cash_flow[Plan OCF Amount] )
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// CCC im Vormonat (rastersicherer Monatsindex-Shift statt DATEADD).
	measure 'CCC Days PM' =
			VAR _idx = MAX ( dim_date[Year] ) * 12 + MAX ( dim_date[MonthNumber] )
			RETURN
				CALCULATE ( [CCC Days], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _idx - 1 ) )
		formatString: "0.0"
		displayFolder: "0_Vergleich"

	/// Cash Balance im Vormonat.
	measure 'Cash Balance PM' =
			VAR _idx = MAX ( dim_date[Year] ) * 12 + MAX ( dim_date[MonthNumber] )
			RETURN
				CALCULATE ( [Cash Balance], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _idx - 1 ) )
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// Operating Cash Flow im Vormonat.
	measure 'Operating Cash Flow PM' =
			VAR _idx = MAX ( dim_date[Year] ) * 12 + MAX ( dim_date[MonthNumber] )
			RETURN
				CALCULATE ( [Operating Cash Flow], REMOVEFILTERS ( dim_date ), FILTER ( ALL ( dim_date ), dim_date[Year] * 12 + dim_date[MonthNumber] = _idx - 1 ) )
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// CCC Δ je Vergleichsmodus (Feldparameter 'Vergleich'). Niedriger = besser.
	measure 'CCC Delta' =
			SWITCH (
				SELECTEDVALUE ( Vergleich[Sort] ),
				0, BLANK ( ),
				2, [CCC Days] - 45,
				[CCC Days] - [CCC Days PM]
			)
		formatString: "+0.0;-0.0;0.0"
		displayFolder: "0_Vergleich"

	/// Cash Balance Δ je Vergleichsmodus. Höher = besser.
	measure 'Cash Balance Delta' =
			SWITCH (
				SELECTEDVALUE ( Vergleich[Sort] ),
				1, [Cash Balance] - [Cash Balance PM],
				[Cash Balance] - [Cash Plan]
			)
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// Operating Cash Flow Δ je Vergleichsmodus.
	measure 'Operating Cash Flow Delta' =
			SWITCH (
				SELECTEDVALUE ( Vergleich[Sort] ),
				1, [Operating Cash Flow] - [Operating Cash Flow PM],
				[Operating Cash Flow] - [OCF Plan]
			)
		formatString: "#,0"
		displayFolder: "0_Vergleich"

	/// CCC Ampel (Hex): <45 grün · 45–60 amber · >60 rot.
	measure 'CCC Ampel' = SWITCH ( TRUE ( ), ISBLANK ( [CCC Days] ), "#98A2B3", [CCC Days] > 60, "#EF4444", [CCC Days] > 45, "#F59E0B", "#16A34A" )
		formatString: @
		displayFolder: "0_Vergleich"

	/// Cash-vs-Plan Ampel (Hex): ≥−5% grün · −5..−10% amber · <−10% rot.
	measure 'Cash vs Plan Ampel' = SWITCH ( TRUE ( ), ISBLANK ( [Cash vs Plan %] ), "#98A2B3", [Cash vs Plan %] < -0.10, "#EF4444", [Cash vs Plan %] < -0.05, "#F59E0B", "#16A34A" )
		formatString: @
		displayFolder: "0_Vergleich"

	/// Cash and cash equivalents.
	/// Formula: SUM(fact_cash_position[Cash Balance Amount]) at MAX(DateKey) in filter context
	/// Grain: day · Unit: EUR · Good: higher_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1, F-C1.2
	/// Synonyms: Cash and Cash Equivalents, Cash Position, Liquide Mittel, Kassenbestand
	/// Example question: How has our cash balance tracked versus plan this year?
	measure 'Cash Balance' = LASTNONBLANKVALUE ( dim_date[Date], SUM ( fact_cash_position[Cash Balance Amount] ) )
		formatString: "#,0"
		displayFolder: "FIN-001"

	/// Cash generated from operating activities.
	/// Formula: SUM(fact_cashflow[Operating Cash Flow Amount]) for the reporting period
	/// Grain: month · Unit: EUR · Good: higher_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.2, S-I1.2, F-C1.4
	/// Synonyms: Operating Cash Flow, Cash Flow from Operations, OCF, Operativer Cashflow
	/// Example question: Why did operating cash flow fall short of plan in Q2?
	measure 'Operating Cash Flow' = SUM ( fact_cash_flow[Operating Cash Flow Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Performance vs plan for cash position.
	/// Formula: (Cash Balance - Cash Plan) / Cash Plan.
	/// Grain: month · Unit: % · Good: higher_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.1
	/// Synonyms: Cash Plan Variance %, Cash Budget Variance, Liquiditätsplanabweichung
	/// Example question: How far is cash tracking from the liquidity plan this month?
	measure 'Cash vs Plan %' =
			VAR ActualCashBalance =
				SUM ( fact_cash_position[Cash Balance Amount] )
			VAR PlannedCashBalance =
				SUM ( fact_cash_position[Plan Cash Amount] )
			VAR CashVariance =
				ActualCashBalance - PlannedCashBalance
			RETURN
				DIVIDE ( CashVariance, PlannedCashBalance )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// Receivables efficiency: AR / (Revenue/365).
	/// Formula: SUM(fact_ar[AR Amount]) / (SUM(fact_ar[Revenue Amount]) / 365)
	/// Grain: month · Unit: days · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.2
	/// Synonyms: Days Sales Outstanding, Receivables Days, Average Collection Period, Debitorenlaufzeit, Forderungslaufzeit
	/// Example question: Why did DSO increase in the Nordics region last quarter?
	measure 'DSO Days' =
			VAR AvgReceivablesBalance =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_accounts_receivable[AR Amount] ) ) )
			VAR AnnualRevenue =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_accounts_receivable[Revenue Amount] ) ) ) * 12
			RETURN
				DIVIDE ( AvgReceivablesBalance * 365, AnnualRevenue )
		formatString: "0"
		displayFolder: "FIN-001"

	/// Inventory efficiency: Inventory / (COGS/365).
	/// Formula: SUM(fact_inventory[Inventory Amount]) / (SUM(fact_ap[COGS Amount]) / 365)
	/// Grain: month · Unit: days · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: S-I1.2
	/// Synonyms: Days Inventory Outstanding, Days Sales of Inventory, Inventory Days, Lagerreichweite, Bestandsreichweite
	/// Example question: Which product categories are driving up DIO this quarter?
	measure 'DIO Days' =
			VAR AvgInventoryBalance =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_inventory[Average Inventory Amount] ) ) )
			VAR AnnualCOGS =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_accounts_payable[COGS Amount] ) ) ) * 12
			RETURN
				DIVIDE ( AvgInventoryBalance * 365, AnnualCOGS )
		formatString: "0"
		displayFolder: "FIN-001"

	/// Payables efficiency: AP / (COGS/365).
	/// Formula: SUM(fact_ap[AP Amount]) / (SUM(fact_ap[COGS Amount]) / 365)
	/// Grain: month · Unit: days · Good: higher_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-C1.4
	/// Synonyms: Days Payable Outstanding, Payables Days, Creditor Days, Kreditorenlaufzeit
	/// Example question: Are we extending DPO with our largest suppliers this year?
	measure 'DPO Days' =
			VAR AvgPayablesBalance =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_accounts_payable[AP Amount] ) ) )
			VAR AnnualCOGS =
				AVERAGEX ( VALUES ( dim_date[CalendarYearMonth] ), CALCULATE ( SUM ( fact_accounts_payable[COGS Amount] ) ) ) * 12
			RETURN
				DIVIDE ( AvgPayablesBalance * 365, AnnualCOGS )
		formatString: "0"
		displayFolder: "FIN-001"

	/// OTIF % - supply.otif.pct
	/// On-time in-full rate for customer fulfillment (governed OTIF, Finance view).
	/// Formula: On-Time In-Full Orders / Total Orders.
	/// Grain: order_line_day · Unit: %
	/// Owner: Supply Chain Analytics · Status: active
	measure 'OTIF % (FIN)' =
			VAR OTIFFulfillments =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
			VAR TotalFulfillments =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// Average supplier risk score across the selected scope.
	/// Formula: Composite risk score derived from supplier risk factors.
	/// Grain: supplier_month · Unit: score · Good: lower_is_better
	/// Owner: Risk Analytics · Status: active
	/// Synonyms: Supplier Risk Rating, Vendor Risk Index, Lieferantenrisiko-Score, Lieferantenrisikobewertung
	/// Example question: Which suppliers carry the highest risk score?
	measure 'Supplier Risk Score' = AVERAGE ( fact_supplier_risk[Risk Score] )
		formatString: "0.0"
		displayFolder: "FIN-001"

	/// AP-exposure-weighted supplier risk for the entity in filter context.
	/// Formula: SUMX over suppliers of (entity AP exposure × supplier Risk Score) / total entity AP exposure, over risk-scored suppliers only.
	/// Grain: entity_month · Unit: score (payables-weighted) · Owner: Risk Analytics · Status: active · Actions: F-C1.4
	/// Rationale: risk-weighted payables exposure surfaces the liquidity risk a risky supplier base carries into the cash conversion cycle — makes supplier risk a legitimate entity-level column on the cash matrix rather than a global constant.
	measure 'Supplier Risk Score (Entity)' =
			VAR _Suppliers =
				ADDCOLUMNS (
					VALUES ( dim_supplier[SupplierKey] ),
					"@AP", CALCULATE ( SUM ( fact_accounts_payable[AP Amount] ) ),
					"@Risk", CALCULATE ( AVERAGE ( fact_supplier_risk[Risk Score] ) )
				)
			VAR _Scored =
				FILTER ( _Suppliers, NOT ISBLANK ( [@Risk] ) )
			RETURN
				DIVIDE (
					SUMX ( _Scored, [@AP] * [@Risk] ),
					SUMX ( _Scored, [@AP] )
				)
		formatString: "0.0"
		displayFolder: "FIN-001"

	/// Inventory balance used in DIO calculations.
	/// Formula: SUM(fact_inventory[Inventory Amount])
	/// Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: O-A2.5
	measure 'Inventory Amount' = SUM ( fact_inventory[Average Inventory Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// Total COGS / units produced or sold.
	/// Formula: SUM(fact_cost[COGS Amount]) / SUM(fact_output[Output Units])
	/// Grain: plant_line_product_month · Unit: EUR per unit · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.1, F-K2.2, F-K2.3, F-K2.4
	/// Synonyms: Cost per Unit, Average Cost per Unit, Stückkosten, Selbstkosten je Stück
	/// Example question: How did unit cost change after the plant ramp-up?
	measure 'Unit Cost Amount' = VAR TotalCost = SUM ( fact_cost[COGS Amount] ) VAR OutputUnits = SUM ( fact_output[Output Units] ) RETURN DIVIDE ( TotalCost, OutputUnits )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// Cost share: COGS / Net Sales.
	/// Formula: SUM(fact_finance[COGS Amount]) / SUM(fact_finance[Net Sales Amount])
	/// Grain: month · Unit: % · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.1
	/// Synonyms: COGS Ratio, Cost of Sales %, Umsatzkostenquote, Materialaufwandsquote
	/// Example question: Why did COGS % of sales rise in Consumer Electronics?
	measure 'COGS % of Sales' = VAR COGS = SUM ( fact_finance[COGS Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( COGS, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Overhead control: (OpEx - Plan) / Plan.
	/// Formula: (OpEx Amount - OpEx Plan Amount) / OpEx Plan Amount.
	/// Grain: month · Unit: % · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.4
	/// Synonyms: OpEx Budget Variance %, Operating Expense Variance, Betriebskostenabweichung
	/// Example question: Where is OpEx running over plan this quarter?
	measure 'OpEx vs Plan %' =
			VAR ActualOperatingExpense =
				SUM ( fact_finance[OpEx Amount] )
			VAR PlannedOperatingExpense =
				SUM ( fact_finance[Plan OpEx Amount] )
			VAR OperatingExpenseVariance =
				ActualOperatingExpense - PlannedOperatingExpense
			RETURN
				DIVIDE ( OperatingExpenseVariance, PlannedOperatingExpense )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Material cost / Net Sales.
	/// Formula: Material Cost Amount / Net Sales Amount.
	/// Grain: month · Unit: % · Good: lower_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.2
	/// Synonyms: Material Cost Ratio, Material Intensity, Materialkostenquote, Materialintensität
	/// Example question: Which products have the highest material cost ratio?
	measure 'Material Cost %' = VAR MaterialCost = SUM ( fact_finance[Material Cost Amount] ) VAR NetSales = SUM ( fact_finance[Net Sales Amount] ) RETURN DIVIDE ( MaterialCost, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Output vs labor hours (or revenue per labor hour).
	/// Formula: Output Units or Net Sales divided by Labor Hours (normalized to % baseline).
	/// Grain: month · Unit: % / index · Good: higher_is_better
	/// Owner: Finance Analytics · Status: active · Actions: F-K2.3
	measure 'Labor Productivity %' =
			VAR OutputUnits =
				SUM ( fact_output[Output Units] )
			VAR LaborHours =
				SUM ( fact_labor[Labor Hours] )
			VAR BaselineRate = 100.0
			VAR OutputPerLaborHour =
				DIVIDE ( OutputUnits, LaborHours ) * 100
			RETURN
				DIVIDE ( OutputPerLaborHour, BaselineRate )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Baseline cost volume amount for variance analysis.
	/// Formula: Baseline amount of cost volume for the selected period.
	/// Grain: cost_center_month · Unit: EUR
	/// Owner: Profitability Analytics · Status: active · Actions: F-K2.1, F-K2.2
	measure 'Cost Base Volume Amount' = SUM ( fact_cost[COGS Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Baseline operating expense amount.
	/// Formula: Baseline operating expense amount for the selected period.
	/// Grain: cost_center_month · Unit: EUR
	/// Owner: Profitability Analytics · Status: active · Actions: F-K2.4
	measure 'Opex Base Amount' = SUM ( fact_finance[Plan OpEx Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Throughput Units - ops.throughput.units
	/// Total produced units in the period (governed throughput, Finance view).
	/// Formula: Sum of produced units for the period.
	/// Grain: line_day · Unit: units
	/// Owner: Operations Analytics · Status: active · Actions: F-K2.3
	measure 'Throughput Units (FIN)' = SUM ( fact_output[Output Units] )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// Defect count divided by total output units.
	/// Formula: Defective Units / Total Produced Units.
	/// Grain: line_day · Unit: % · Good: lower_is_better
	/// Owner: Operations Analytics · Status: active
	measure 'Quality Defect Rate %' = VAR Defects = SUM ( fact_output[Defect Count] ) VAR TotalUnits = SUM ( fact_output[Output Units] ) RETURN DIVIDE ( Defects, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Quality % - ops.quality.pct
	/// Good units divided by total output (governed quality/yield, Finance view).
	/// Formula: Good Units / Total Units Produced.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active
	/// Synonyms: Process Yield, Throughput Yield, Ausbeute, Gutausbeute, Ausbeutegrad
	/// Example question: How has process yield trended since the line upgrade?
	/// NOTE: fact_ops (Good Units) is an Operations-model table; the Finance model
	/// carries only fact_output[Output Units], so this proxy cannot be evaluated in
	/// the Finance model until a Good-Units source is added — pre-existing data gap.
	measure 'Quality % (FIN)' = VAR GoodUnits = SUM ( fact_output[Good Units] ) VAR TotalUnits = SUM ( fact_output[Output Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// Net Sales Amount (FIN) - sales.net_sales.amount
	/// Total invoiced revenue net of discounts and returns, Finance domain view.
	measure 'Net Sales Amount (FIN)' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// Accounts payable balance at period end
	/// Formula: SUM(fact_ap[AP Amount]) at latest DateKey in filter context
	/// Owner: Finance BI · Status: active
	measure 'Payables Amount' = SUM ( fact_accounts_payable[AP Amount] )
		formatString: #,0.00
		displayFolder: FIN-001
		lineageTag: 58cf11a3-6134-4d19-91ec-5e86f803a386

	/// ActionReady Logic: F-C1.1
	measure 'Action_F-C1.1_Text' = VAR _v0 = [CCC Days] VAR _b0 = VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) VAR _v1 = [Cash vs Plan %] VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 + 10 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [CCC Days] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + 10, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 500000, "🔴 L3 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ DETECT sustained CCC or cash-vs-plan deterioration for this entity" & UNICHAR ( 10 ) & "→ IDENTIFY the dominant working capital driver (DSO, DIO, or DPO) for this entity" & UNICHAR ( 10 ) & "→ TRIGGER the corresponding execution Action Code for this entity" & UNICHAR ( 10 ) & "→ REVIEW working capital impact for this entity monthly", IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 + 5 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [CCC Days] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [CCC Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + 5, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 500000, "🟠 L2 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ DETECT sustained CCC or cash-vs-plan deterioration for this entity" & UNICHAR ( 10 ) & "→ IDENTIFY the dominant working capital driver (DSO, DIO, or DPO) for this entity" & UNICHAR ( 10 ) & "→ TRIGGER the corresponding execution Action Code for this entity" & UNICHAR ( 10 ) & "→ REVIEW working capital impact for this entity monthly", IF ( ( _v1 < -0.05 ) && CALCULATE ( [Cash vs Plan %] < -0.05, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 500000, "🟡 L1 — F-C1.1 — Working Capital Improvement" & UNICHAR ( 10 ) & "Owner: finance_director | " & FORMAT ( _v1, "0.0%" ) & UNICHAR ( 10 ) & "→ DETECT sustained CCC or cash-vs-plan deterioration for this entity" & UNICHAR ( 10 ) & "→ IDENTIFY the dominant working capital driver (DSO, DIO, or DPO) for this entity" & UNICHAR ( 10 ) & "→ TRIGGER the corresponding execution Action Code for this entity" & UNICHAR ( 10 ) & "→ REVIEW working capital impact for this entity monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "finance_director"
		annotation ActionReady_ActionCodeId = "F-C1.1"

	/// ActionReady Logic: F-C1.2
	measure 'Action_F-C1.2_Text' = VAR _v0 = [DSO Days] VAR _b0 = VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 + 12 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DSO Days] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + 12, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 300000, "🔴 L3 — F-C1.2 — Collections Acceleration" & UNICHAR ( 10 ) & "Owner: head_of_credit_and_collections | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY customers driving DSO deterioration for this entity" & UNICHAR ( 10 ) & "→ PRIORITISE invoices by age and exposure within this entity" & UNICHAR ( 10 ) & "→ EXECUTE reminders, calls, and escalations for this entity" & UNICHAR ( 10 ) & "→ REVIEW cash-in impact for this entity weekly", IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 + 7 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DSO Days] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + 7, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 300000, "🟠 L2 — F-C1.2 — Collections Acceleration" & UNICHAR ( 10 ) & "Owner: head_of_credit_and_collections | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY customers driving DSO deterioration for this entity" & UNICHAR ( 10 ) & "→ PRIORITISE invoices by age and exposure within this entity" & UNICHAR ( 10 ) & "→ EXECUTE reminders, calls, and escalations for this entity" & UNICHAR ( 10 ) & "→ REVIEW cash-in impact for this entity weekly", IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 + 3 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DSO Days] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 60, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DSO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + 3, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Cash Balance] >= 300000, "🟡 L1 — F-C1.2 — Collections Acceleration" & UNICHAR ( 10 ) & "Owner: head_of_credit_and_collections | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY customers driving DSO deterioration for this entity" & UNICHAR ( 10 ) & "→ PRIORITISE invoices by age and exposure within this entity" & UNICHAR ( 10 ) & "→ EXECUTE reminders, calls, and escalations for this entity" & UNICHAR ( 10 ) & "→ REVIEW cash-in impact for this entity weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_credit_and_collections"
		annotation ActionReady_ActionCodeId = "F-C1.2"

	/// ActionReady Logic: S-I1.2
	measure 'Action_S-I1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: inventory_manager" & UNICHAR(10) & "Steps:"
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "inventory_manager"
		annotation ActionReady_ActionCodeId = "S-I1.2"

	/// ActionReady Logic: F-C1.4
	measure 'Action_F-C1.4_Text' = VAR _v0 = [DPO Days] VAR _b0 = VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( NOT ISBLANK ( _b0 ) && _v0 < _b0 + -12 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DPO Days] < ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + -12, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Payables Amount] >= 250000, "🔴 L3 — F-C1.4 — Payables Optimisation" & UNICHAR ( 10 ) & "Owner: head_of_accounts_payable | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY suppliers driving early payment behaviour for this entity" & UNICHAR ( 10 ) & "→ ASSESS contractual flexibility and risk for this entity" & UNICHAR ( 10 ) & "→ ADJUST payment runs or renegotiate terms for this entity" & UNICHAR ( 10 ) & "→ MONITOR supplier performance and cash impact for this entity", IF ( ( NOT ISBLANK ( _b0 ) && _v0 < _b0 + -7 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DPO Days] < ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + -7, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Payables Amount] >= 250000, "🟠 L2 — F-C1.4 — Payables Optimisation" & UNICHAR ( 10 ) & "Owner: head_of_accounts_payable | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY suppliers driving early payment behaviour for this entity" & UNICHAR ( 10 ) & "→ ASSESS contractual flexibility and risk for this entity" & UNICHAR ( 10 ) & "→ ADJUST payment runs or renegotiate terms for this entity" & UNICHAR ( 10 ) & "→ MONITOR supplier performance and cash impact for this entity", IF ( ( NOT ISBLANK ( _b0 ) && _v0 < _b0 + -3 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [DPO Days] < ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [DPO Days], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) + -3, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Payables Amount] >= 250000, "🟡 L1 — F-C1.4 — Payables Optimisation" & UNICHAR ( 10 ) & "Owner: head_of_accounts_payable | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ IDENTIFY suppliers driving early payment behaviour for this entity" & UNICHAR ( 10 ) & "→ ASSESS contractual flexibility and risk for this entity" & UNICHAR ( 10 ) & "→ ADJUST payment runs or renegotiate terms for this entity" & UNICHAR ( 10 ) & "→ MONITOR supplier performance and cash impact for this entity", BLANK () ) ) )
		formatString: @
		isHidden
