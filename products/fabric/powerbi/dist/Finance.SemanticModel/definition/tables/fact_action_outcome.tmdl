/// Action-code outcome facts (Wirkungs-Loop, ADR-0009): one row per executed action
/// code with its recorded effect, filtered to the Finance domain.
/// Source: Gold Layer — showcases/aurora_group/data/gold/facts/fact_action_outcome (Parquet).
table fact_action_outcome
	lineageTag: f38ec014-31ba-4e81-a27e-0862fba0ce3f

	column action_code_id
		dataType: string
		isHidden
		lineageTag: b520d6c2-9069-4220-bb12-9b204d5ce48d
		summarizeBy: none
		sourceColumn: action_code_id

	column use_case_id
		dataType: string
		isHidden
		lineageTag: ec8e8b66-f321-441d-a1ce-81de882d14c5
		summarizeBy: none
		sourceColumn: use_case_id

	column domain
		dataType: string
		isHidden
		lineageTag: 6470a22c-6e41-4be2-9c65-067a25349f39
		summarizeBy: none
		sourceColumn: domain

	column execution_date
		dataType: string
		isHidden
		lineageTag: b4fb6d07-8515-4e88-be14-e2e6d76ab076
		summarizeBy: none
		sourceColumn: execution_date

	column outcome_date
		dataType: string
		isHidden
		lineageTag: 4cd40933-2835-42ff-bab3-0eccece4ab74
		summarizeBy: none
		sourceColumn: outcome_date

	column outcome_status
		dataType: string
		lineageTag: fe71c1a1-9a36-49e5-bf27-88289a0014a3
		summarizeBy: none
		sourceColumn: outcome_status

	column days_to_outcome
		dataType: double
		lineageTag: 0de610cd-a3d6-46a9-8eef-e20050004974
		summarizeBy: none
		sourceColumn: days_to_outcome

	column impact_value
		dataType: double
		lineageTag: 12bed54b-fa0c-44b0-bfc6-4705f255d8f2
		summarizeBy: none
		sourceColumn: impact_value

	column cost_to_execute
		dataType: double
		lineageTag: c515a22a-8556-4bb0-804e-815a47648996
		summarizeBy: none
		sourceColumn: cost_to_execute

	column severity_level
		dataType: string
		lineageTag: 140ae46e-8be1-4168-a76b-04cf41df509d
		summarizeBy: none
		sourceColumn: severity_level

	column fiscal_year
		dataType: int64
		isHidden
		lineageTag: 44c06a7b-6e43-4c4c-9ed7-e579253eb6a8
		summarizeBy: none
		sourceColumn: fiscal_year

	partition fact_action_outcome = m
		mode: import
		source =
				let
					Source = Folder.Files(GoldDataPath & "/facts/fact_action_outcome"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_))),
					FilteredDomain = Table.SelectRows(ParquetData, each [domain] = "Finance")
				in
					FilteredDomain
