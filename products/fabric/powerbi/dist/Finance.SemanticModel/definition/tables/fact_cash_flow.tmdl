/// Monthly operating cash flow, CapEx, and plan OCF per entity
table fact_cash_flow
	lineageTag: 24f42843-9e38-540c-99d2-a5ae947766cf
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Operating Cash Flow Amount'
		dataType: Decimal
		sourceColumn: Operating Cash Flow Amount
		summarizeBy: none
	column 'CapEx Amount'
		dataType: Decimal
		sourceColumn: CapEx Amount
		summarizeBy: none
	column 'Plan OCF Amount'
		dataType: Decimal
		sourceColumn: Plan OCF Amount
		summarizeBy: none
	partition fact_cash_flow = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_cash_flow"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
