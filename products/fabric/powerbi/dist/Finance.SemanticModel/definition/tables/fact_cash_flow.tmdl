/// Monthly operating cash flow, CapEx, and plan OCF per entity
table fact_cash_flow
	lineageTag: 24f42843-9e38-540c-99d2-a5ae947766cf
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Operating Cash Flow Amount'
		dataType: Decimal
		sourceColumn: Operating Cash Flow Amount
		summarizeBy: none
	column 'CapEx Amount'
		dataType: Decimal
		sourceColumn: CapEx Amount
		summarizeBy: none
	column 'Plan OCF Amount'
		dataType: Decimal
		sourceColumn: Plan OCF Amount
		summarizeBy: none
	partition fact_cash_flow = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_cash_flow"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
