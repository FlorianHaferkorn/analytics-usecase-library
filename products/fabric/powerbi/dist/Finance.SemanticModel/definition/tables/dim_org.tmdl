/// Organization dimension (company code, cost center, region) for financial reporting.
table dim_org
		lineageTag: 2b3c4d5e-6f7a-8901-2b3c-4d5e6f7a8b9c

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none
			isHidden

		column OrgCode
			dataType: String
			sourceColumn: OrgCode
			summarizeBy: none

		column OrgName
			dataType: String
			sourceColumn: OrgName
			summarizeBy: none

		column Region
			dataType: String
			sourceColumn: Region
			summarizeBy: none

		column CompanyCode
			dataType: String
			sourceColumn: CompanyCode
			summarizeBy: none

		column CostCenter
			dataType: String
			sourceColumn: CostCenter
			summarizeBy: none

		partition dim_org = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

