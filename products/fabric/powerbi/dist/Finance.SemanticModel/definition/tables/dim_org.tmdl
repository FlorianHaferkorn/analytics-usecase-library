/// Entity/organization dimension (entity, region, country) for finance
table dim_org
	lineageTag: 25dd022a-b15b-50f3-8924-d2e94fa044c6
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column Entity
		dataType: String
		sourceColumn: Entity
		summarizeBy: none
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	column OrgName
		dataType: String
		sourceColumn: Entity
		summarizeBy: none
	partition dim_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

	hierarchy 'Org Hierarchy'
		lineageTag: d8040a5f-6ffb-5b26-a36b-bebae26973ba
		level Region
			column: Region
		level Country
			column: Country
		level Entity
			column: Entity
