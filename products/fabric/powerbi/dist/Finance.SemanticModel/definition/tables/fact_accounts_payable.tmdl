/// Accounts payable: open payables, purchases, and DPO inputs.
table fact_accounts_payable
		lineageTag: 5e6f7a8b-9c0d-1234-5e6f-7a8b9c0d1e2f

		column DateKey
			dataType: Int64
			sourceColumn: DateKey
			summarizeBy: none

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none

		column 'AP Balance Amount'
			dataType: Decimal
			sourceColumn: AP Balance Amount
			summarizeBy: none

		column 'Purchases Amount'
			dataType: Decimal
			sourceColumn: Purchases Amount
			summarizeBy: none

		partition fact_accounts_payable = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_accounts_payable"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

