/// Calendar dimension for finance reporting
table dim_date
	lineageTag: 99ecc014-eaec-5bbe-b43e-0a491155a662
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column Date
		dataType: DateTime
		sourceColumn: Date
		summarizeBy: none
	column Year
		dataType: Int64
		sourceColumn: Year
		summarizeBy: none
	column Quarter
		dataType: String
		sourceColumn: Quarter
		summarizeBy: none
	column Month
		dataType: String
		sourceColumn: Month
		summarizeBy: none
	column MonthNumber
		dataType: Int64
		sourceColumn: MonthNumber
		summarizeBy: none

	column CalendarYearMonth
		dataType: String
		sourceColumn: CalendarYearMonth
		summarizeBy: none
	partition dim_date = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_date"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

	hierarchy 'Calendar'
		lineageTag: a91532ec-56df-5b87-96fa-c9807c9fd4a9
		level Year
			column: Year
		level Quarter
			column: Quarter
		level Month
			column: Month
		level Date
			column: Date
