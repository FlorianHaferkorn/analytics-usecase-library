/// Daily cash balance and plan cash per entity
table fact_cash_position
	lineageTag: 21615652-3685-5a91-80c6-a0b778cf7bd2
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Cash Balance Amount'
		dataType: Decimal
		sourceColumn: Cash Balance Amount
		summarizeBy: none
	column 'Plan Cash Amount'
		dataType: Decimal
		sourceColumn: Plan Cash Amount
		summarizeBy: none
	partition fact_cash_position = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_cash_position"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
