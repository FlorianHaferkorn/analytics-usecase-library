/// Accounts receivable and revenue by entity and customer per month
table fact_accounts_receivable
	lineageTag: ead2939b-cbac-5a75-9965-31e40f59dc23
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column CustomerKey
		dataType: Int64
		isHidden
		sourceColumn: CustomerKey
		summarizeBy: none
	column 'AR Amount'
		dataType: Decimal
		sourceColumn: AR Amount
		summarizeBy: none
	column 'Revenue Amount'
		dataType: Decimal
		sourceColumn: Revenue Amount
		summarizeBy: none
	partition fact_accounts_receivable = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_accounts_receivable"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
