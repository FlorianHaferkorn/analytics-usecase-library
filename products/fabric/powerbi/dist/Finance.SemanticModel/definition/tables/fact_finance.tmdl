/// P&L facts (net sales, COGS, EBITDA, OpEx, plan) per entity-month
table fact_finance
	lineageTag: 7695af1c-a6a0-5a03-ae42-602bfa3f849f
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Net Sales Amount'
		dataType: Decimal
		sourceColumn: Net Sales Amount
		summarizeBy: none
	column 'COGS Amount'
		dataType: Decimal
		sourceColumn: COGS Amount
		summarizeBy: none
	column 'EBITDA Amount'
		dataType: Decimal
		sourceColumn: EBITDA Amount
		summarizeBy: none
	column 'Material Cost Amount'
		dataType: Decimal
		sourceColumn: Material Cost Amount
		summarizeBy: none
	column 'OpEx Amount'
		dataType: Decimal
		sourceColumn: OpEx Amount
		summarizeBy: none
	column 'Plan OpEx Amount'
		dataType: Decimal
		sourceColumn: Plan OpEx Amount
		summarizeBy: none
	partition fact_finance = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_finance"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
