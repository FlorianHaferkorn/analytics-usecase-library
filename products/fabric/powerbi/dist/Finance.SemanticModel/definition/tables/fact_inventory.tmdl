/// Inventory balance: for DIO calculation (days inventory outstanding).
table fact_inventory
		lineageTag: 6f7a8b9c-0d1e-2345-6f7a-8b9c0d1e2f3a

		column DateKey
			dataType: Int64
			sourceColumn: DateKey
			summarizeBy: none

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none

		column 'Inventory Balance Amount'
			dataType: Decimal
			sourceColumn: Inventory Balance Amount
			summarizeBy: none

		column 'COGS Amount'
			dataType: Decimal
			sourceColumn: COGS Amount
			summarizeBy: none

		partition fact_inventory = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_inventory"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

