/// Inventory value by entity and product per month (finance view)
table fact_inventory
	lineageTag: a0c1818b-0b64-5372-b78b-4fe07f17dbd0
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Inventory Amount'
		dataType: Decimal
		sourceColumn: Inventory Amount
		summarizeBy: none
	column 'COGS Amount'
		dataType: Decimal
		sourceColumn: COGS Amount
		summarizeBy: none
	partition fact_inventory = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_inventory"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
