/// Supplier dimension for AP and procurement attribution
table dim_supplier
	lineageTag: bda11035-93d3-5905-8140-0f8412032423
	column SupplierKey
		dataType: Int64
		sourceColumn: SupplierKey
		summarizeBy: none
		isHidden
	column SupplierCode
		dataType: String
		sourceColumn: SupplierCode
		summarizeBy: none
	column SupplierName
		dataType: String
		sourceColumn: SupplierName
		summarizeBy: none
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	partition dim_supplier = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_supplier"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
