/// Demand forecast by SKU, location, and month (with version tracking)
table fact_forecast
	lineageTag: 1b37e8e8-5725-5388-b536-d9bdc5114e28
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Forecast Units'
		dataType: Decimal
		sourceColumn: Forecast Units
		summarizeBy: none
	column 'Forecast Version'
		dataType: String
		sourceColumn: Forecast Version
		summarizeBy: none
	partition fact_forecast = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_forecast"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
