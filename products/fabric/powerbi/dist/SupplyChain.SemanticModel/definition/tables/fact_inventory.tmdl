/// Inventory snapshot (average/obsolete) at location-SKU-month grain
table fact_inventory
	lineageTag: b13959f2-8ced-572b-bf48-822cbde48447
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Average Inventory Amount'
		dataType: Decimal
		sourceColumn: Average Inventory Amount
		summarizeBy: none
	column 'Average Inventory Units'
		dataType: Decimal
		sourceColumn: Average Inventory Units
		summarizeBy: none
	column 'Obsolete Inventory Amount'
		dataType: Decimal
		sourceColumn: Obsolete Inventory Amount
		summarizeBy: none
	column 'Obsolete Inventory Units'
		dataType: Decimal
		sourceColumn: Obsolete Inventory Units
		summarizeBy: none
	partition fact_inventory = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_inventory"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
