/// Stockout events and lost demand at location-SKU-day
table fact_stockout
	lineageTag: 00314c33-62fd-56b2-ac23-17d0083cae28
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Stockout Flag'
		dataType: Boolean
		sourceColumn: Stockout Flag
		summarizeBy: none
	column 'Lost Demand Units'
		dataType: Decimal
		sourceColumn: Lost Demand Units
		summarizeBy: none
	column 'Demand Units'
		dataType: Decimal
		sourceColumn: Demand Units
		summarizeBy: none
	partition fact_stockout = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_stockout"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
