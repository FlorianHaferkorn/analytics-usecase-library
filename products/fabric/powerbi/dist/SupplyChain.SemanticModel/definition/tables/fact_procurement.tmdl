/// Purchase order line facts (amount, quantity, contracted vs actual)
table fact_procurement
	lineageTag: 10a58059-c163-57cb-a8a6-d0fecbf9604e
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	/// Distribution centre that raised the purchase order line. Type: int · Role: foreign_key · FK->dim_org
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column VendorKey
		dataType: Int64
		isHidden
		sourceColumn: VendorKey
		summarizeBy: none
	column CategoryKey
		dataType: Int64
		isHidden
		sourceColumn: CategoryKey
		summarizeBy: none
	/// Line spend (= Actual Spend); continuity alias. Type: currency · Unit: EUR · Role: measure
	column 'Purchase Amount'
		dataType: Decimal
		sourceColumn: Procurement Amount
		summarizeBy: none
	/// On-contract spend; on-contract % numerator. Type: currency · Unit: EUR · Role: measure
	column 'Contracted Amount'
		dataType: Decimal
		sourceColumn: On-Contract Amount
		summarizeBy: none
	/// Price actually paid per unit on the line; the PPV actual leg. Type: currency · Unit: EUR · Role: measure
	column 'Actual Unit Price'
		dataType: Decimal
		sourceColumn: Actual Unit Price Amount
		summarizeBy: none
	column 'Contract Unit Price'
		dataType: Decimal
		sourceColumn: Contract Unit Price
		summarizeBy: none
	column 'Purchase Quantity'
		dataType: Decimal
		sourceColumn: Quantity
		summarizeBy: none
	partition fact_procurement = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_procurement"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
