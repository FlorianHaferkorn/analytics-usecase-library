/// Purchase order line facts (amount, quantity, contracted vs actual)
table fact_procurement
	lineageTag: 10a58059-c163-57cb-a8a6-d0fecbf9604e
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Purchase Amount'
		dataType: Decimal
		sourceColumn: Purchase Amount
		summarizeBy: none
	column 'Contracted Amount'
		dataType: Decimal
		sourceColumn: Contracted Amount
		summarizeBy: none
	column 'Actual Unit Price'
		dataType: Decimal
		sourceColumn: Actual Unit Price
		summarizeBy: none
	column 'Contract Unit Price'
		dataType: Decimal
		sourceColumn: Contract Unit Price
		summarizeBy: none
	column 'Purchase Quantity'
		dataType: Decimal
		sourceColumn: Purchase Quantity
		summarizeBy: none
	partition fact_procurement = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_procurement"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
