/// Cost of goods sold at location-SKU-month grain
table fact_cogs
	lineageTag: fbabdae4-996d-53e7-a09a-38e4d9ff956e
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'COGS Amount'
		dataType: Decimal
		sourceColumn: COGS Amount
		summarizeBy: none
	partition fact_cogs = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_cogs"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
