/// Consolidated Measures for: SCM-001, SCM-002, SCM-003 (SupplyChain)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (SCM)' = VAR _otif = [OTIF %] VAR _ot = [On-Time %] VAR _inf = [In-Full %] VAR _dio = [Days in Inventory] VAR _acc = [Forecast Accuracy %] VAR _stk = [Stockout Rate %] RETURN "OTIF: " & FORMAT ( _otif, "0.0%" ) & "  =  On-Time: " & FORMAT ( _ot, "0.0%" ) & "  x  In-Full: " & FORMAT ( _inf, "0.0%" ) & UNICHAR ( 10 ) & "DIO: " & FORMAT ( _dio, "0.0" ) & "d  |  Forecast Acc.: " & FORMAT ( _acc, "0.0%" ) & "  |  Stockout: " & FORMAT ( _stk, "0.0%" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 23cc80cc-c9d7-4dc9-9c9a-9457354cb396

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (SCM)' = VAR _rows = FILTER ( { [Action_S-I1.1_Text], [Action_S-I1.2_Text], [Action_S-I1.3_Text], [Action_S-I1.4_Text], [Action_S-R2.1_Text], [Action_S-R2.2_Text], [Action_S-R2.3_Text], [Action_S-F3.1_Text], [Action_S-F3.2_Text], [Action_S-F3.4_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 2a71c679-0ace-4b00-b1f1-f966a55f91f0


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (SCM)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL(fact_inventory), RELATED('dim_date'[Date])), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: 572855aa-5876-4357-93b3-d499c62f415f
	/// Purpose: Cross-domain measure — average impact value of achieved actions from fact_action_outcome.
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// SCM-001
	/// Days in Inventory - inv.dio.days
	/// Measures inventory holding period in days.
	measure 'Days in Inventory' =
			VAR AverageInventoryAmount =
				SUM ( fact_inventory[Average Inventory Amount] )
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_cogs[COGS Amount] )
			VAR DailyCostOfGoodsSoldAmount =
				DIVIDE ( CostOfGoodsSoldAmount, 365 )
			RETURN
				DIVIDE ( AverageInventoryAmount, DailyCostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "SCM-001"

	/// Inventory Turnover - inv.turnover
	/// Measures how often inventory is sold and replaced.
	measure 'Inventory Turnover' = DIVIDE ( SUM ( fact_cogs[COGS Amount] ), SUM ( fact_inventory[Average Inventory Amount] ) )
		formatString: "#,0"
		displayFolder: "SCM-001"

	/// Stockout Rate % - inv.stockout.pct
	/// Measures how often inventory is unavailable when demanded.
	measure 'Stockout Rate %' =
			VAR StockoutEvents =
				CALCULATE ( COUNTROWS ( fact_stockout ), fact_stockout[Stockout Flag] = TRUE() )
			VAR TotalStockoutObservations =
				COUNTROWS ( fact_stockout )
			RETURN
				DIVIDE ( StockoutEvents, TotalStockoutObservations )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// OTIF % - supply.otif.pct
	/// Measures share of orders delivered on time and in full.
	measure 'OTIF %' =
			VAR OTIFFulfillments =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
			VAR TotalFulfillments =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Obsolete Inventory % - inv.obsolete.pct
	/// Measures share of inventory considered obsolete.
	measure 'Obsolete Inventory %' = DIVIDE ( SUM ( fact_inventory[Obsolete Inventory Amount] ), SUM ( fact_inventory[Average Inventory Amount] ) )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Forecast Accuracy % - plan.forecast.accuracy.pct
	/// Measures how close forecasted demand is to actual demand.
	measure 'Forecast Accuracy %' =
			VAR ForecastUnits =
				SUM ( fact_forecast[Forecast Units] )
			VAR ActualUnits =
				SUM ( fact_sales[Sales Units] )
			VAR ForecastErrorShare =
				ABS ( DIVIDE ( ForecastUnits - ActualUnits, ActualUnits ) )
			RETURN
				IF ( ActualUnits = 0, BLANK(), 1 - ForecastErrorShare )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Sales Units - sales.units
	/// Measures sold units volume in the period.
	measure 'Sales Units' = SUM ( fact_sales[Sales Units] )
		formatString: "#,0"
		displayFolder: "SCM-001"

	/// SCM-002
	/// On-Time % - supply.on_time.pct
	/// Measures share of deliveries arriving on time.
	measure 'On-Time %' =
			VAR OnTimeDeliveries =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[On-Time Flag] = TRUE() )
			VAR TotalDeliveries =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OnTimeDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// In-Full % - supply.in_full.pct
	/// Measures share of deliveries with complete quantities.
	measure 'In-Full %' =
			VAR InFullDeliveries =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[In-Full Flag] = TRUE() )
			VAR TotalDeliveries =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( InFullDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// Stockout Impact % - supply.stockout_impact.pct
	/// Measures lost demand share due to stockouts.
	measure 'Stockout Impact %' = DIVIDE ( SUM ( fact_stockout[Lost Demand Units] ), SUM ( fact_stockout[Demand Units] ) )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// Penalty Amount - supply.penalty.amount
	/// Captures penalties for service level breaches.
	measure 'Penalty Amount' = SUM ( fact_fulfillment[Penalty Amount] )
		formatString: "#,0.00"
		displayFolder: "SCM-002"

	/// Expedite Cost Amount - supply.expedite.amount
	/// Captures additional cost for expedited shipments.
	measure 'Expedite Cost Amount' = SUM ( fact_fulfillment[Expedite Cost] )
		formatString: "#,0.00"
		displayFolder: "SCM-002"

	/// Order Lines Count - order.lines
	/// Counts order lines processed in the period.
	measure 'Order Lines Count' = COUNTROWS ( fact_fulfillment )
		formatString: "#,0"
		displayFolder: "SCM-002"

	/// Shipments Count - shipments.count
	/// Counts shipments executed in the period.
	measure 'Shipments Count' = COUNTROWS ( fact_fulfillment )
		formatString: "#,0"
		displayFolder: "SCM-002"

	/// SCM-003
	/// Forecast MAPE % - plan.forecast.mape.pct
	/// Measures mean absolute percentage error in forecast.
	measure 'Forecast MAPE %' =
			AVERAGEX (
				VALUES ( fact_forecast[ProductKey] ),
				VAR ForecastUnits =
					CALCULATE ( SUM ( fact_forecast[Forecast Units] ) )
				VAR ActualUnits =
					CALCULATE ( SUM ( fact_sales[Sales Units] ) )
				RETURN
					IF ( ActualUnits = 0, BLANK(), ABS ( DIVIDE ( ForecastUnits - ActualUnits, ActualUnits ) ) )
			)
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Forecast Bias % - plan.forecast.bias.pct
	/// Measures systematic over- or under-forecasting.
	measure 'Forecast Bias %' =
			VAR ForecastUnits =
				SUM ( fact_forecast[Forecast Units] )
			VAR ActualUnits =
				SUM ( fact_sales[Sales Units] )
			VAR ForecastBiasUnits =
				ForecastUnits - ActualUnits
			RETURN
				DIVIDE ( ForecastBiasUnits, ActualUnits )
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Service Impact % - plan.forecast.service_impact.pct
	/// Quantifies how much of the service loss (stockouts or OTIF misses) is attributable to forecast un...
	measure 'Service Impact %' =
			VAR StockoutImpactRate =
				[Stockout Impact %]
			VAR TotalLostDemandUnits =
				SUM ( fact_stockout[Lost Demand Units] )
			VAR UnderForecastLostDemandUnits =
				SUMX (
					fact_stockout,
					VAR ActualDemandUnits =
						fact_stockout[Demand Units]
					VAR ForecastUnits =
						CALCULATE ( SUM ( fact_forecast[Forecast Units] ) )
					RETURN
						IF ( ForecastUnits < ActualDemandUnits, fact_stockout[Lost Demand Units], 0 )
				)
			VAR UnderForecastLostShare =
				DIVIDE ( UnderForecastLostDemandUnits, TotalLostDemandUnits )
			RETURN
				StockoutImpactRate * UnderForecastLostShare
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Re-Plan Count - plan.replan.count
	/// Counts number of replanning cycles in a period.
	measure 'Re-Plan Count' = DISTINCTCOUNT ( fact_forecast[Forecast Version] )
		formatString: "#,0"
		displayFolder: "SCM-003"

	/// Plans Count - plans.count
	/// Counts planning cycles or plan versions in the period.
	measure 'Plans Count' = DISTINCTCOUNT ( fact_forecast[Forecast Version] )
		formatString: "#,0"
		displayFolder: "SCM-003"

	/// ActionReady Logic
	/// ActionReady Logic: S-I1.1
	measure 'Action_S-I1.1_Text' = IF ( [Days in Inventory] > 70, "🔴 L3 — S-I1.1 — Inventory Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify excess inventory locations — Initiate destocking — Review DIO monthly", IF ( [Days in Inventory] > 62, "🟠 L2 — S-I1.1 — Inventory Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify excess inventory locations — Initiate destocking — Review DIO monthly", IF ( [Days in Inventory] > 55, "🟡 L1 — S-I1.1 — Inventory Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify excess inventory locations — Initiate destocking — Review DIO monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_supply_chain"
		annotation ActionReady_ActionCodeId = "S-I1.1"

	/// ActionReady Logic: S-I1.2
	measure 'Action_S-I1.2_Text' = IF ( [Days in Inventory] > 60, "🔴 L3 — S-I1.2 — Inventory Working Capital" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify high-DIO SKUs — Reduce safety stock — Monitor DIO monthly", IF ( [Days in Inventory] > 40, "🟠 L2 — S-I1.2 — Inventory Working Capital" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify high-DIO SKUs — Reduce safety stock — Monitor DIO monthly", IF ( [Days in Inventory] > 20, "🟡 L1 — S-I1.2 — Inventory Working Capital" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Days in Inventory], "0.0" ) & UNICHAR ( 10 ) & "→ Identify high-DIO SKUs — Reduce safety stock — Monitor DIO monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "inventory_manager"
		annotation ActionReady_ActionCodeId = "S-I1.2"

	/// ActionReady Logic: S-I1.3
	measure 'Action_S-I1.3_Text' = IF ( [Stockout Rate %] > 0.1, "🔴 L3 — S-I1.3 — Stockout Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Rate %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify stockout-prone SKUs — Emergency replenishment — Review weekly", IF ( [Stockout Rate %] > 0.05, "🟠 L2 — S-I1.3 — Stockout Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Rate %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify stockout-prone SKUs — Emergency replenishment — Review weekly", IF ( [Stockout Rate %] > 0.02, "🟡 L1 — S-I1.3 — Stockout Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Rate %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify stockout-prone SKUs — Emergency replenishment — Review weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "supply_planner"
		annotation ActionReady_ActionCodeId = "S-I1.3"

	/// ActionReady Logic: S-I1.4
	measure 'Action_S-I1.4_Text' = IF ( [Obsolete Inventory %] > 0.2, "🔴 L3 — S-I1.4 — Obsolete Inventory Disposal" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Obsolete Inventory %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify obsolescence categories — Execute disposal or markdown — Review monthly", IF ( [Obsolete Inventory %] > 0.1, "🟠 L2 — S-I1.4 — Obsolete Inventory Disposal" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Obsolete Inventory %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify obsolescence categories — Execute disposal or markdown — Review monthly", IF ( [Obsolete Inventory %] > 0.05, "🟡 L1 — S-I1.4 — Obsolete Inventory Disposal" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Obsolete Inventory %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify obsolescence categories — Execute disposal or markdown — Review monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "inventory_controller"
		annotation ActionReady_ActionCodeId = "S-I1.4"

	/// ActionReady Logic: S-I1.5
	measure 'Action_S-I1.5_Text' = IF ( [Forecast Accuracy %] < 0.5, "🔴 L3 — S-I1.5 — Forecast-Driven Inventory Risk" & UNICHAR ( 10 ) & "Owner: s_and_op_lead | " & FORMAT ( [Forecast Accuracy %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify accuracy-risk SKUs — Increase safety stock — Review accuracy monthly", IF ( [Forecast Accuracy %] < 0.6, "🟠 L2 — S-I1.5 — Forecast-Driven Inventory Risk" & UNICHAR ( 10 ) & "Owner: s_and_op_lead | " & FORMAT ( [Forecast Accuracy %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify accuracy-risk SKUs — Increase safety stock — Review accuracy monthly", IF ( [Forecast Accuracy %] < 0.7, "🟡 L1 — S-I1.5 — Forecast-Driven Inventory Risk" & UNICHAR ( 10 ) & "Owner: s_and_op_lead | " & FORMAT ( [Forecast Accuracy %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify accuracy-risk SKUs — Increase safety stock — Review accuracy monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_demand_planning"
		annotation ActionReady_ActionCodeId = "S-I1.5"

	/// ActionReady Logic: S-R2.1
	measure 'Action_S-R2.1_Text' = IF ( [OTIF %] < 0.9, "🔴 L3 — S-R2.1 — OTIF Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [OTIF %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OTIF-failing suppliers — Escalate and correct — Review OTIF weekly", IF ( [OTIF %] < 0.93, "🟠 L2 — S-R2.1 — OTIF Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [OTIF %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OTIF-failing suppliers — Escalate and correct — Review OTIF weekly", IF ( [OTIF %] < 0.96, "🟡 L1 — S-R2.1 — OTIF Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [OTIF %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OTIF-failing suppliers — Escalate and correct — Review OTIF weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_supply_chain"
		annotation ActionReady_ActionCodeId = "S-R2.1"

	/// ActionReady Logic: S-R2.2
	measure 'Action_S-R2.2_Text' = IF ( [On-Time %] < 0.9, "🔴 L3 — S-R2.2 — On-Time Delivery Recovery" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [On-Time %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify late delivery causes — Expedite priority orders — Review weekly", IF ( [On-Time %] < 0.94, "🟠 L2 — S-R2.2 — On-Time Delivery Recovery" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [On-Time %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify late delivery causes — Expedite priority orders — Review weekly", IF ( [On-Time %] < 0.97, "🟡 L1 — S-R2.2 — On-Time Delivery Recovery" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [On-Time %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify late delivery causes — Expedite priority orders — Review weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "logistics_manager"
		annotation ActionReady_ActionCodeId = "S-R2.2"

	/// ActionReady Logic: S-R2.3
	measure 'Action_S-R2.3_Text' = IF ( [Stockout Impact %] > 0.1, "🔴 L3 — S-R2.3 — Stockout Impact Containment" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Impact %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify impacted customers — Alternative sourcing — Review weekly", IF ( [Stockout Impact %] > 0.06, "🟠 L2 — S-R2.3 — Stockout Impact Containment" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Impact %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify impacted customers — Alternative sourcing — Review weekly", IF ( [Stockout Impact %] > 0.03, "🟡 L1 — S-R2.3 — Stockout Impact Containment" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Stockout Impact %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify impacted customers — Alternative sourcing — Review weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "supply_planner"
		annotation ActionReady_ActionCodeId = "S-R2.3"

	/// ActionReady Logic: S-R2.4
	measure 'Action_S-R2.4_Text' = IF ( [Penalty Amount] > 50000, "🔴 L3 — S-R2.4 — Supplier Penalty Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Penalty Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify penalty-triggering suppliers — Negotiate SLA terms — Review monthly", IF ( [Penalty Amount] > 25000, "🟠 L2 — S-R2.4 — Supplier Penalty Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Penalty Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify penalty-triggering suppliers — Negotiate SLA terms — Review monthly", IF ( [Penalty Amount] > 10000, "🟡 L1 — S-R2.4 — Supplier Penalty Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Penalty Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify penalty-triggering suppliers — Negotiate SLA terms — Review monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "logistics_cost_manager"
		annotation ActionReady_ActionCodeId = "S-R2.4"

	/// ActionReady Logic: S-R2.5
	measure 'Action_S-R2.5_Text' = IF ( [Expedite Cost Amount] > 100000, "🔴 L3 — S-R2.5 — Expedite Cost Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Expedite Cost Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify expedite drivers — Reduce last-minute orders — Monitor monthly", IF ( [Expedite Cost Amount] > 50000, "🟠 L2 — S-R2.5 — Expedite Cost Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Expedite Cost Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify expedite drivers — Reduce last-minute orders — Monitor monthly", IF ( [Expedite Cost Amount] > 25000, "🟡 L1 — S-R2.5 — Expedite Cost Reduction" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( [Expedite Cost Amount], "€#,0" ) & UNICHAR ( 10 ) & "→ Identify expedite drivers — Reduce last-minute orders — Monitor monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "s_and_op_lead"
		annotation ActionReady_ActionCodeId = "S-R2.5"

	/// ActionReady Logic: S-F3.1
