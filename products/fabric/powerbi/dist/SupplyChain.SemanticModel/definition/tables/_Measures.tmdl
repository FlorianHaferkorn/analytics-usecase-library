/// Consolidated Measures for: SCM-001, SCM-002, SCM-003 (SupplyChain)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (SCM)' = VAR _otif = [OTIF %] VAR _ot = [On-Time %] VAR _inf = [In-Full %] VAR _dio = [Days in Inventory] VAR _acc = [Forecast Accuracy %] VAR _stk = [Stockout Rate %] RETURN "OTIF: " & FORMAT ( _otif, "0.0%" ) & "  =  On-Time: " & FORMAT ( _ot, "0.0%" ) & "  x  In-Full: " & FORMAT ( _inf, "0.0%" ) & UNICHAR ( 10 ) & "DIO: " & FORMAT ( _dio, "0.0" ) & "d  |  Forecast Acc.: " & FORMAT ( _acc, "0.0%" ) & "  |  Stockout: " & FORMAT ( _stk, "0.0%" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 23cc80cc-c9d7-4dc9-9c9a-9457354cb396

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (SCM)' = VAR _rows = FILTER ( { [Action_S-I1.1_Text], [Action_S-I1.2_Text], [Action_S-I1.3_Text], [Action_S-I1.4_Text], [Action_S-R2.1_Text], [Action_S-R2.2_Text], [Action_S-R2.3_Text], [Action_S-F3.1_Text], [Action_S-F3.2_Text], [Action_S-F3.4_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 2a71c679-0ace-4b00-b1f1-f966a55f91f0


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (SCM)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: 572855aa-5876-4357-93b3-d499c62f415f
	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR · Good: higher_is_better
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// Purpose: Zielwert von Days in Inventory aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Days in Inventory Target' = CALCULATE ( SUM ( fact_target[Target Value] ), fact_target[kpi_id] = "inv.dio.days", fact_target[scenario] = "target" )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: 59e6eb5b-e257-585b-afb2-ffea0377292c

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Days in Inventory gegen Days in Inventory Target; leer ohne Referenzwert.
	measure 'Days in Inventory vs Target' = VAR _r = [Days in Inventory Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [Days in Inventory] - _r )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: 8255ba4f-1a65-5c4b-aff8-048979ebc941

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Zielwert von Forecast Accuracy % aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Forecast Accuracy % Target' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "plan.forecast.accuracy.pct", fact_target[scenario] = "target" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 4e2ba645-3ab5-55cd-9087-1eae31a11c3a

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Forecast Accuracy % gegen Forecast Accuracy % Target; leer ohne Referenzwert.
	measure 'Forecast Accuracy % vs Target' = VAR _r = [Forecast Accuracy % Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [Forecast Accuracy %] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 28e03618-ff10-5d96-ac39-ffb6c2cd9805

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Zielwert von OTIF % aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'OTIF % Target' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "supply.otif.pct", fact_target[scenario] = "target" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 1c9876ce-ec40-58c9-a12b-87811a2fd56a

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung OTIF % gegen OTIF % Target; leer ohne Referenzwert.
	measure 'OTIF % vs Target' = VAR _r = [OTIF % Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [OTIF %] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 73f038a3-1078-5e43-99e8-7fcac44fe818

		annotation ALUCA_Generated = "comparison_measures"


	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// Working capital efficiency via inventory days.
	/// Formula: SUM(fact_inventory[Average Inventory Amount]) / (SUM(fact_cogs[COGS Amount]) / 365)
	/// Grain: location_sku_month · Unit: days · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-I1.1, S-I1.2, S-I1.4, S-I1.5
	/// Synonyms: Days Inventory Outstanding, Days of Supply, Lagerreichweite, Bestandsreichweite
	/// Example question: Where is days-of-supply highest across the network?
	measure 'Days in Inventory' =
			VAR AverageInventoryAmount =
				SUM ( fact_inventory[Average Inventory Amount] )
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_cogs[COGS Amount] )
			VAR DailyCostOfGoodsSoldAmount =
				DIVIDE ( CostOfGoodsSoldAmount, 365 )
			RETURN
				DIVIDE ( AverageInventoryAmount, DailyCostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "SCM-001"

	/// Velocity of inventory: COGS / Avg Inventory.
	/// Formula: COGS / Average Inventory
	/// Grain: location_sku_month · Unit: x · Good: higher_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-I1.2
	/// Synonyms: Inventory Turns, Stock Turnover, Lagerumschlag, Umschlagshäufigkeit
	/// Example question: Which categories have the slowest inventory turnover?
	measure 'Inventory Turnover' = DIVIDE ( SUM ( fact_cogs[COGS Amount] ), SUM ( fact_inventory[Average Inventory Amount] ) )
		formatString: "#,0"
		displayFolder: "SCM-001"

	/// Service risk from stockout occurrences.
	/// Formula: Stockout Events / Total Demand Events.
	/// Grain: location_sku_day · Unit: % · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-I1.1, S-I1.3, S-I1.5
	/// Synonyms: Out-of-Stock Rate, OOS, Fehlmengenquote, Fehlbestandsquote
	/// Example question: Which SKUs stock out most often?
	measure 'Stockout Rate %' =
			VAR StockoutEvents =
				CALCULATE ( COUNTROWS ( fact_stockout ), fact_stockout[Stockout Flag] = TRUE() )
			VAR TotalStockoutObservations =
				COUNTROWS ( fact_stockout )
			RETURN
				DIVIDE ( StockoutEvents, TotalStockoutObservations )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// On-Time In-Full orders share.
	/// Formula: DIVIDE ( CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE ), COUNTROWS ( fact_fulfillment ) )
	/// Grain: order · Unit: % · Good: higher_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.3, S-I1.1, S-I1.3, S-R2.1, S-R2.2, S-R2.5, F-K2.4
	/// Synonyms: On Time In Full, Delivery Reliability, DIFOT, Liefertreue
	/// Example question: Which lanes are missing the OTIF target this month?
	measure 'OTIF %' =
			VAR OTIFFulfillments =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
			VAR TotalFulfillments =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Share of obsolete stock vs total stock.
	/// Formula: Obsolete Inventory Value / Total Inventory Value.
	/// Grain: location_sku_month · Unit: % · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-I1.4
	/// Synonyms: Dead Stock %, Obsolescence Rate, Obsoleszenzquote, Ladenhüter-Anteil
	/// Example question: How much inventory value is obsolete by category?
	measure 'Obsolete Inventory %' = DIVIDE ( SUM ( fact_inventory[Obsolete Inventory Amount] ), SUM ( fact_inventory[Average Inventory Amount] ) )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Planning quality: 1 - |Forecast - Actual| / Actual.
	/// Formula: 1 - SUM(ABS(fact_forecast[Forecast Units] - fact_sales[Actual Units])) / SUM(fact_sales[Actual Units])
	/// Grain: sku_month · Unit: % · Good: higher_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.1, S-F3.2, S-F3.4, S-I1.5
	/// Synonyms: Demand Forecast Accuracy, Forecast Attainment, Prognosegenauigkeit, Vorhersagegenauigkeit
	/// Example question: Where is forecast accuracy weakest this cycle?
	measure 'Forecast Accuracy %' =
			VAR ForecastUnits =
				SUM ( fact_forecast[Forecast Units] )
			VAR ActualUnits =
				SUM ( fact_sales[Sales Units] )
			VAR ForecastErrorShare =
				ABS ( DIVIDE ( ForecastUnits - ActualUnits, ActualUnits ) )
			RETURN
				IF ( ActualUnits = 0, BLANK(), 1 - ForecastErrorShare )
		formatString: "0.0%"
		displayFolder: "SCM-001"

	/// Total units sold in the period.
	/// Formula: Sum of sold units across transactions.
	/// Grain: invoice_line · Unit: units
	/// Owner: Growth Analytics · Status: active · Actions: O-Q3.5, S-F3.1, S-F3.2, S-I1.1, S-I1.2, S-I1.3, S-I1.5
	measure 'Sales Units' = SUM ( fact_sales[Sales Units] )
		formatString: "#,0"
		displayFolder: "SCM-001"

	/// On-time deliveries share.
	/// Formula: On-Time Deliveries / Total Deliveries.
	/// Grain: shipment · Unit: % · Good: higher_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.1, S-R2.2
	/// Synonyms: On-Time Delivery, OTD, Termintreue, Liefertermintreue
	/// Example question: What is driving late deliveries on the DACH lanes?
	measure 'On-Time %' =
			VAR OnTimeDeliveries =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[On-Time Flag] = TRUE() )
			VAR TotalDeliveries =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OnTimeDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// In-full deliveries share.
	/// Formula: In-Full Deliveries / Total Deliveries.
	/// Grain: shipment · Unit: % · Good: higher_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.1, S-R2.3
	/// Synonyms: Fill Rate, Order Fill Rate, Mengentreue, Lieferbereitschaftsgrad
	/// Example question: Which products fall short on in-full delivery?
	measure 'In-Full %' =
			VAR InFullDeliveries =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[In-Full Flag] = TRUE() )
			VAR TotalDeliveries =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( InFullDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// Lost demand share due to stockout.
	/// Formula: Lost Demand Qty / Total Demand Qty.
	/// Grain: location_sku_day · Unit: % · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.3
	measure 'Stockout Impact %' = DIVIDE ( SUM ( fact_stockout[Lost Demand Units] ), SUM ( fact_stockout[Demand Units] ) )
		formatString: "0.0%"
		displayFolder: "SCM-002"

	/// Penalties incurred for service misses.
	/// Formula: Sum of penalty charges incurred in the period.
	/// Grain: order · Unit: EUR · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.4
	measure 'Penalty Amount' = SUM ( fact_fulfillment[Penalty Amount] )
		formatString: "#,0.00"
		displayFolder: "SCM-002"

	/// Additional cost for expedited shipping.
	/// Formula: Sum of expedite fees and premium freight charges.
	/// Grain: shipment · Unit: EUR · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.4, S-R2.5
	measure 'Expedite Cost Amount' = SUM ( fact_fulfillment[Expedite Cost] )
		formatString: "#,0.00"
		displayFolder: "SCM-002"

	/// Count of order line items.
	/// Formula: Count of order line items.
	/// Grain: order_line · Unit: count
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.3, S-R2.3
	measure 'Order Lines Count' = COUNTROWS ( fact_fulfillment )
		formatString: "#,0"
		displayFolder: "SCM-002"

	/// Count of shipments executed.
	/// Formula: Count of shipment records.
	/// Grain: shipment · Unit: count
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-R2.1, S-R2.2, S-R2.4, S-R2.5
	measure 'Shipments Count' = COUNTROWS ( fact_fulfillment )
		formatString: "#,0"
		displayFolder: "SCM-002"

	/// Alias for MAPE % (TMDL display name).
	/// Formula: Mean(|Forecast - Actual| / Actual).
	/// Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.2
	/// Synonyms: Mean Absolute Percentage Error, MAPE, WMAPE, mittlerer absoluter prozentualer Fehler
	/// Example question: Which product families have the highest MAPE?
	measure 'Forecast MAPE %' =
			AVERAGEX (
				VALUES ( fact_forecast[ProductKey] ),
				VAR ForecastUnits =
					CALCULATE ( SUM ( fact_forecast[Forecast Units] ) )
				VAR ActualUnits =
					CALCULATE ( SUM ( fact_sales[Sales Units] ) )
				RETURN
					IF ( ActualUnits = 0, BLANK(), ABS ( DIVIDE ( ForecastUnits - ActualUnits, ActualUnits ) ) )
			)
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Alias for Bias % (TMDL display name). Forecast error direction (Forecast - Actual) / Actual.
	/// Formula: (Forecast - Actual) / Actual.
	/// Good: closer_to_zero_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.1, S-F3.2
	measure 'Forecast Bias %' =
			VAR ForecastUnits =
				SUM ( fact_forecast[Forecast Units] )
			VAR ActualUnits =
				SUM ( fact_sales[Sales Units] )
			VAR ForecastBiasUnits =
				ForecastUnits - ActualUnits
			RETURN
				DIVIDE ( ForecastBiasUnits, ActualUnits )
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Portion of service misses attributable to forecast error.
	/// Formula: Service Impact % = Stockout Impact % x (Under-Forecast Lost Demand / Total Lost Demand). Under-forecast is defined as a negative forecast error below a configurable threshold; all inputs are unit-based (qty), not revenue.
	/// Grain: sku_month · Unit: % · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.3
	measure 'Service Impact %' =
			VAR StockoutImpactRate =
				[Stockout Impact %]
			VAR TotalLostDemandUnits =
				SUM ( fact_stockout[Lost Demand Units] )
			VAR UnderForecastLostDemandUnits =
				SUMX (
					fact_stockout,
					VAR ActualDemandUnits =
						fact_stockout[Demand Units]
					VAR ForecastUnits =
						CALCULATE ( SUM ( fact_forecast[Forecast Units] ) )
					RETURN
						IF ( ForecastUnits < ActualDemandUnits, fact_stockout[Lost Demand Units], 0 )
				)
			VAR UnderForecastLostShare =
				DIVIDE ( UnderForecastLostDemandUnits, TotalLostDemandUnits )
			RETURN
				StockoutImpactRate * UnderForecastLostShare
		formatString: "0.0%"
		displayFolder: "SCM-003"

	/// Count of plan records or plan versions.
	/// Formula: Count of plan records or plan versions.
	/// Grain: plan_version · Unit: count · Good: lower_is_better
	/// Owner: Supply Chain Analytics · Status: active · Actions: S-F3.4, S-F3.1, S-F3.2
	measure 'Plans Count' = DISTINCTCOUNT ( fact_forecast[Forecast Version] )
		formatString: "#,0"
		displayFolder: "SCM-003"

	/// ActionReady Logic
	/// ActionReady Logic: S-I1.1
	measure 'Action_S-I1.1_Text' = VAR _v0 = [Days in Inventory] VAR _b0 = VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) VAR _idx = MAX ( 'dim_date'[Year] ) * 12 + MAX ( 'dim_date'[MonthNumber] ) RETURN IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 * 1.4 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [Days in Inventory] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) * 1.4, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Sales Units] >= 5000, "🔴 L3 — S-I1.1 — Inventory Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ DETECT sustained DIO deviation for this SKU/location" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant inventory driver (excess, stockout, obsolescence, planning) for this SKU/location" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this SKU/location" & UNICHAR ( 10 ) & "→ REVIEW inventory recovery for this SKU/location monthly", IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 * 1.25 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [Days in Inventory] > ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) * 1.25, REMOVEFILTERS ( 'dim_date' ), FILTER ( ALL ( 'dim_date' ), 'dim_date'[Year] * 12 + 'dim_date'[MonthNumber] = _idx - 1 ) ) && [Sales Units] >= 5000, "🟠 L2 — S-I1.1 — Inventory Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_supply_chain | " & FORMAT ( _v0, "0" ) & UNICHAR ( 10 ) & "→ DETECT sustained DIO deviation for this SKU/location" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant inventory driver (excess, stockout, obsolescence, planning) for this SKU/location" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this SKU/location" & UNICHAR ( 10 ) & "→ REVIEW inventory recovery for this SKU/location monthly", IF ( ( NOT ISBLANK ( _b0 ) && _v0 > _b0 * 1.1 ) && CALCULATE ( NOT ISBLANK ( ( VAR _ref = MIN ( 'dim_date'[Date] ) VAR _monate = CALCULATETABLE ( VALUES ( 'dim_date'[CalendarYearMonth] ), REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _ref - 90, 'dim_date'[Date] < _ref ) RETURN AVERAGEX ( _monate, VAR _m = 'dim_date'[CalendarYearMonth] RETURN CALCULATE ( [Days in Inventory], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[CalendarYearMonth] = _m ) ) ) ) && [Days in Inv