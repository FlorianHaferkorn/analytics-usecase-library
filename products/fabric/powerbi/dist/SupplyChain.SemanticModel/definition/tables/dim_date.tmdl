/// Calendar dimension for supply chain time slicing
table dim_date
	lineageTag: b31b938b-3416-5d00-94b5-2c54c86312c2
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column Date
		dataType: DateTime
		sourceColumn: Date
		summarizeBy: none
	column Year
		dataType: Int64
		sourceColumn: Year
		summarizeBy: none
	column Quarter
		dataType: Int64
		sourceColumn: Quarter
		summarizeBy: none
	column Month
		dataType: Int64
		sourceColumn: Month
		summarizeBy: none
	column MonthNumber
		dataType: Int64
		sourceColumn: MonthNumber
		summarizeBy: none

	column CalendarYearMonth
		dataType: String
		sourceColumn: CalendarYearMonth
		summarizeBy: none

	column Week
		dataType: String
		sourceColumn: Week
		summarizeBy: none
	partition dim_date = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/dimensions/dim_date"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData

	hierarchy 'Calendar'
		lineageTag: fa7726b8-45c0-55f8-a1e7-4ce4ed04b8ae
		level Year
			column: Year
		level Quarter
			column: Quarter
		level Month
			column: Month
		level Date
			column: Date

	hierarchy 'Week Calendar'
		lineageTag: 983b05b7-3c70-538d-802e-dfb2c098137e
		level Year
			column: Year
		level Week
			column: Week
		level Date
			column: Date
