/// Sales units by SKU and month (supply chain demand view)
table fact_sales
	lineageTag: 0afd1d0d-82ca-5a38-b5d6-76c458cd1c2c
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Sales Units'
		dataType: Decimal
		sourceColumn: Quantity
		summarizeBy: none
	partition fact_sales = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_sales"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
