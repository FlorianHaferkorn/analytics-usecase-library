/// Organisation/location dimension for supply chain — sourced from Gold Layer aurora_group org hierarchy.
/// Columns align with current parquet schema: OrgKey, OrgName, OrgCode, OrgLevel, OrgType, Country.
/// Legacy report columns (Location, Region, Channel, Customer) are mapped to closest equivalents.
table dim_org
	lineageTag: 2a591969-855c-5b30-89fc-0f293f64c6e2
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Display name for the org node (store name, country name, etc.)
	column OrgName
		dataType: String
		sourceColumn: OrgName
		summarizeBy: none
	/// Unique org code, e.g. STORE-DE-001 or AURORA-GROUP
	column OrgCode
		dataType: String
		sourceColumn: OrgCode
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Hierarchy level: Country | Store
	column OrgLevel
		dataType: String
		sourceColumn: OrgLevel
		summarizeBy: none
	/// Organisation type: Country | Store
	column OrgType
		dataType: String
		sourceColumn: OrgType
		summarizeBy: none
	/// ISO country code
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	/// Alias column — maps to OrgName for backward compatibility with report visuals
	column Location
		dataType: String
		sourceColumn: OrgName
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to Country for backward compatibility with report visuals
	column Region
		dataType: String
		sourceColumn: Country
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to OrgLevel for backward compatibility with report visuals
	column Channel
		dataType: String
		sourceColumn: OrgLevel
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to OrgCode for backward compatibility with report visuals
	column Customer
		dataType: String
		sourceColumn: OrgCode
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	partition dim_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet") and not Text.Contains([Folder Path], "_delta_log")),
				SortedFiles = Table.Sort(FilteredFiles, {{"Date modified", Order.Descending}}),
				FirstFile = SortedFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

	hierarchy 'Org Hierarchy'
		lineageTag: 9421cf1e-41bb-5e42-b7f4-829ff3547b3e
		level Country
			column: Country
		level OrgLevel
			column: OrgLevel
		level OrgName
			column: OrgName
