/// Organisation/location dimension for supply chain — sourced from Gold Layer aurora_group org hierarchy.
/// Columns align with current parquet schema: OrgKey, OrgName, OrgCode, OrgLevel, OrgType, Country.
/// Legacy columns (Location, Region, Channel, Customer) and 'Location Hierarchy' preserved for report bindings; 'Org Hierarchy' maps Gold parquet.
table dim_org
	lineageTag: 2a591969-855c-5b30-89fc-0f293f64c6e2
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Display name for the org node (store name, country name, etc.)
	column OrgName
		dataType: String
		sourceColumn: OrgName
		summarizeBy: none
	/// Unique org code, e.g. STORE-DE-001 or AURORA-GROUP
	column OrgCode
		dataType: String
		sourceColumn: OrgCode
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Hierarchy level: Country | Store
	column OrgLevel
		dataType: String
		sourceColumn: OrgLevel
		summarizeBy: none
	/// Organisation type: Country | Store
	column OrgType
		dataType: String
		sourceColumn: OrgType
		summarizeBy: none
	/// ISO country code
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	/// Alias column — maps to OrgName for backward compatibility with report visuals
	column Location
		dataType: String
		sourceColumn: OrgName
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to Country for backward compatibility with report visuals
	column Region
		dataType: String
		sourceColumn: Country
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to OrgLevel for backward compatibility with report visuals
	column Channel
		dataType: String
		sourceColumn: OrgLevel
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	/// Alias column — maps to OrgCode for backward compatibility with report visuals
	column Customer
		dataType: String
		sourceColumn: OrgCode
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	partition dim_org = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/dimensions/dim_org"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData

	hierarchy 'Location Hierarchy'
		lineageTag: 9421cf1e-41bb-5e42-b7f4-829ff3547b3e
		level Region
			column: Region
		level Channel
			column: Channel
		level Location
			column: Location
	hierarchy 'Org Hierarchy'
		lineageTag: a8c4e219-7b3f-5d2a-9e61-4f0c8b2a1d05
		level Country
			column: Country
		level OrgLevel
			column: OrgLevel
		level OrgName
			column: OrgName
