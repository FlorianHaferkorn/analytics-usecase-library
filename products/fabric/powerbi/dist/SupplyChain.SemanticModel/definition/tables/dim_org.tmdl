/// Location/organization dimension (location, region, channel, customer) for supply chain
table dim_org
	lineageTag: 2a591969-855c-5b30-89fc-0f293f64c6e2
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
	column Location
		dataType: String
		sourceColumn: Location
		summarizeBy: none
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	column Channel
		dataType: String
		sourceColumn: Channel
		summarizeBy: none
	column Customer
		dataType: String
		sourceColumn: Customer
		summarizeBy: none
	partition dim_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData

	hierarchy 'Location Hierarchy'
		lineageTag: 9421cf1e-41bb-5e42-b7f4-829ff3547b3e
		level Region
			column: Region
		level Channel
			column: Channel
		level Location
			column: Location
