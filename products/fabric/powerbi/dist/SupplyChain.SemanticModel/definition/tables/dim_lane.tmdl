/// Transport lane dimension (origin, destination, mode) for OTIF analysis
table dim_lane
	lineageTag: 301aa748-dd8c-5487-a293-2dc7c8b75a5f
	column LaneKey
		dataType: Int64
		sourceColumn: LaneKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column Origin
		dataType: String
		sourceColumn: Origin
		summarizeBy: none
	column Destination
		dataType: String
		sourceColumn: Destination
		summarizeBy: none
	column Mode
		dataType: String
		sourceColumn: Mode
		summarizeBy: none
	partition dim_lane = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_lane"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
