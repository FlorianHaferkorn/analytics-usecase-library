expression fn_DeltaCurrentFiles =
	(TableFolderPath as text) as table =>
	let
		AllFiles =
			if GoldSourceKind = "onelake" then
				let
					Prefix = Text.Replace(TableFolderPath, "\", "/") & "/",
					Listed = AzureStorage.DataLake(GoldContainerUrl)
				in
					Table.SelectRows(Listed, each Text.StartsWith(Text.Replace([Folder Path], "\", "/"), Prefix))
			else
				Folder.Files(TableFolderPath),
		DataFiles = Table.SelectRows(AllFiles, each Text.EndsWith([Name], ".parquet") and not Text.Contains(Text.Replace([Folder Path], "\", "/"), "_delta_log")),
		LogFiles = Table.SelectRows(AllFiles, each Text.EndsWith([Name], ".json") and Text.Contains(Text.Replace([Folder Path], "\", "/"), "_delta_log")),
		HasLog = Table.RowCount(LogFiles) > 0,
		Result =
			if not HasLog then
				DataFiles
			else
				let
					SortedLog = Table.Sort(LogFiles, {{"Name", Order.Ascending}}),
					AllLines = List.Combine(List.Transform(SortedLog[Content], each List.Select(Text.Split(Text.FromBinary(_, TextEncoding.Utf8), "#(lf)"), each Text.Trim(_) <> ""))),
					ParsedAll = List.Transform(AllLines, each try Json.Document(_) otherwise null),
					ParsedValid = List.Select(ParsedAll, each _ <> null and Value.Is(_, type record) and (Record.HasFields(_, "add") or Record.HasFields(_, "remove"))),
					ActionRows = List.Transform(ParsedValid, each if Record.HasFields(_, "add") then [Path = Record.Field(_, "add")[path], Action = "add"] else [Path = Record.Field(_, "remove")[path], Action = "remove"]),
					ActionTable = Table.FromRecords(ActionRows, type table [Path = text, Action = text]),
					Grouped = Table.Group(ActionTable, {"Path"}, {{"LastAction", each List.Last(_[Action]), type text}}),
					ActivePaths = Table.SelectRows(Grouped, each [LastAction] = "add")[Path],
					NormRootRaw = Text.Replace(TableFolderPath, "\", "/"),
					NormRoot = if Text.EndsWith(NormRootRaw, "/") then NormRootRaw else NormRootRaw & "/",
					WithRelPath = Table.AddColumn(DataFiles, "RelPath", each
						let
							NormFolderRaw = Text.Replace([Folder Path], "\", "/"),
							NormFolder = if Text.EndsWith(NormFolderRaw, "/") then NormFolderRaw else NormFolderRaw & "/",
							RelFolder = if Text.StartsWith(NormFolder, NormRoot) then Text.Range(NormFolder, Text.Length(NormRoot)) else NormFolder,
							RelFolderClean = if Text.EndsWith(RelFolder, "/") then Text.Range(RelFolder, 0, Text.Length(RelFolder) - 1) else RelFolder
						in
							if RelFolderClean = "" then [Name] else RelFolderClean & "/" & [Name]
					),
					FilteredActive = Table.SelectRows(WithRelPath, each List.Contains(ActivePaths, [RelPath])),
					ActiveNoHelper = Table.RemoveColumns(FilteredActive, {"RelPath"})
				in
					ActiveNoHelper
	in
		Result

