/// Consolidated Measures for: OPS-001, OPS-002, OPS-003 (Operations)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (OPS)' = VAR _oee = [OEE %] VAR _a = [Availability %] VAR _p = [Performance %] VAR _q = [Quality %] VAR _fpy = [First Pass Yield %] VAR _copq = [Cost of Poor Quality] RETURN "OEE: " & FORMAT ( _oee, "0.0%" ) & "  =  Avail: " & FORMAT ( _a, "0.0%" ) & "  x  Perf: " & FORMAT ( _p, "0.0%" ) & "  x  Qual: " & FORMAT ( _q, "0.0%" ) & UNICHAR ( 10 ) & "FPY: " & FORMAT ( _fpy, "0.0%" ) & "  |  CoPQ: " & FORMAT ( _copq, "€#,0" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: 3021cf39-e452-4730-994c-67c10e3fae26

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (OPS)' = VAR _rows = FILTER ( { [Action_O-O1.1_Text], [Action_O-O1.2_Text], [Action_O-O1.3_Text], [Action_O-O1.4_Text], [Action_O-A2.1_Text], [Action_O-A2.4_Text], [Action_O-A2.5_Text], [Action_O-Q3.1_Text], [Action_O-Q3.3_Text], [Action_O-Q3.4_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: ca76b3ef-928c-4506-be86-6f96924d6a33


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (OPS)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: a993b6d5-bd3d-4d4b-b8f1-c6b3952844d2
	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// OPS-001
	/// OEE % - ops.oee.pct
	/// Measures manufacturing performance combining availability, performance, and quality.
	measure 'OEE %' =
			VAR AvailabilityRate =
				[Availability %]
			VAR PerformanceRate =
				[Performance %]
			VAR QualityRate =
				[Quality %]
			RETURN
				AvailabilityRate * PerformanceRate * QualityRate
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Uptime control: Run Time / Planned Production Time.
	/// Formula: SUM(fact_ops[Run Time Minutes]) / SUM(fact_ops[Planned Time Minutes])
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.1, O-A2.3, O-O1.1
	/// Synonyms: Availability Rate, Uptime, Verfügbarkeit, Anlagenverfügbarkeit, Verfügbarkeitsgrad
	/// Example question: What is dragging availability down on Line B?
	measure 'Availability %' =
			VAR RunTimeMinutes =
				SUM ( fact_ops[Run Time Minutes] )
			VAR PlannedTimeMinutes =
				SUM ( fact_ops[Planned Time Minutes] )
			RETURN
				DIVIDE ( RunTimeMinutes, PlannedTimeMinutes )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Speed vs standard: Actual Output / Theoretical Output.
	/// Formula: Actual output / Theoretical maximum output
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-O1.2
	/// Synonyms: Performance Rate, Speed Factor, Leistungsgrad, Leistung, Leistungsfaktor
	/// Example question: Where are speed losses hurting performance this week?
	measure 'Performance %' =
			VAR ActualOutputUnits =
				SUM ( fact_ops[Output Units] )
			VAR RunTimeMinutes =
				SUM ( fact_ops[Run Time Minutes] )
			VAR StandardRateUnitsPerMinute =
				AVERAGE ( fact_ops[Standard Rate Units Per Minute] )
			VAR TheoreticalOutputUnits =
				RunTimeMinutes * StandardRateUnitsPerMinute
			RETURN
				DIVIDE ( ActualOutputUnits, TheoreticalOutputUnits )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// First pass yield: Good Units / Total Units.
	/// Formula: Good units / Total units
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-O1.3
	/// Synonyms: Quality Rate, Yield, Qualitätsgrad, Gutanteil, Qualitätsfaktor
	/// Example question: Which lines are below the quality target this month?
	measure 'Quality %' = VAR GoodUnits = SUM ( fact_ops[Good Units] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-001"


	/// Display alias for OEE %. Composite measure combining availability, performance, and quality in manufacturing.
	/// Formula: [OEE %]
	/// Grain: line_day · Unit: %
	/// Owner: Operations BI · Status: active · Actions: O-O1.1, O-O1.3, O-O1.4
	/// Synonyms: Overall Equipment Effectiveness, Equipment Effectiveness, Gesamtanlageneffektivität, GAE, Anlageneffektivität
	/// Example question: Which production lines have the lowest OEE this month?
	measure 'Overall Equipment Effectiveness (OEE) %' = [OEE %]
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Volume output over time.
	/// Formula: Sum of produced units in the period.
	/// Grain: line_day · Unit: qty
	/// Owner: Operations Analytics · Status: active · Actions: O-O1.2, O-O1.4
	measure 'Throughput Units' = SUM ( fact_ops[Output Units] )
		formatString: "#,0"
		displayFolder: "OPS-001"

	/// Loss share: Downtime / Planned Production Time.
	/// Formula: Downtime Minutes / Planned Time Minutes.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active
	measure 'Downtime %' = VAR Downtime = SUM ( fact_ops[Downtime Minutes] ) VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] ) RETURN DIVIDE ( Downtime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Scheduled target output for the period at standard run rate.
	/// Formula: Sum of planned output units for the period.
	/// Grain: line_day · Unit: units
	/// Owner: Operations Analytics · Status: active · Actions: O-O1.4, O-Q3.1, O-Q3.2, O-Q3.3
	measure 'Planned Output Units' =
			VAR PlannedOutputUnits =
				SUMX ( fact_ops, fact_ops[Standard Rate Units Per Minute] * fact_ops[Planned Time Minutes] )
			RETURN
				PlannedOutputUnits
		formatString: "#,0"
		displayFolder: "OPS-001"

	/// Mean time between failures.
	/// Formula: Operating Time Hours / Number of Failures.
	/// Grain: asset · Unit: hours
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.2, O-A2.4
	/// Synonyms: Mean Time Between Failures, Reliability Interval, Mittlere Betriebsdauer zwischen Ausfällen, mittlere Zeit zwischen Ausfällen
	/// Example question: Which assets have the worst MTBF this quarter?
	measure 'MTBF (hours)' = VAR FailureCount = COUNTROWS ( fact_ops_failures ) VAR OperatingTime = SUMX ( fact_ops, DIVIDE ( fact_ops[Run Time Minutes], 60 ) ) RETURN DIVIDE ( OperatingTime, FailureCount )
		formatString: "0"
		displayFolder: "OPS-002"

	/// Mean time to repair.
	/// Formula: Total Repair Time Hours / Number of Failures.
	/// Grain: asset · Unit: hours
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.3, O-A2.5
	/// Synonyms: Mean Time To Repair, Mean Time To Restore, Mittlere Reparaturdauer, mittlere Wiederherstellungszeit
	/// Example question: Where is MTTR longest, and why?
	measure 'MTTR (hours)' = VAR FailureCount = COUNTROWS ( fact_ops_failures ) VAR TotalRepairTime = SUM ( fact_ops_failures[Repair Duration Hours] ) RETURN DIVIDE ( TotalRepairTime, FailureCount )
		formatString: "0"
		displayFolder: "OPS-002"

	/// Unplanned downtime share of planned time.
	/// Formula: Unplanned Downtime Minutes / Planned Time Minutes.
	/// Grain: asset_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.1, O-A2.2
	/// Synonyms: Unscheduled Downtime, Breakdown Downtime, Ungeplante Stillstandszeit, ungeplanter Stillstand
	/// Example question: Which assets cause the most unplanned downtime?
	measure 'Unplanned Downtime %' = VAR UnplannedDowntime = SUMX ( fact_ops_failures, fact_ops_failures[Downtime Minutes] ) VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] ) RETURN DIVIDE ( UnplannedDowntime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// Maintenance readiness via stockout rate for parts.
	/// Formula: Stockout Events / Total Parts Requests.
	/// Grain: month · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.5
	measure 'Spare Parts Stockout %' = VAR StockoutCount = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Parts Stockout Flag] = TRUE () ) VAR TotalRequests = COUNTROWS ( fact_maintenance ) RETURN DIVIDE ( StockoutCount, TotalRequests )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// Preventive maintenance discipline: on-time PM orders / planned PM orders.
	/// Formula: Completed PM Orders / Planned PM Orders.
	/// Grain: month · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.4
	measure 'PM Compliance %' = VAR CompletedPM = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Order Type] = "PM", fact_maintenance[Order Status] = "Completed" ) VAR PlannedPM = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Order Type] = "PM" ) RETURN DIVIDE ( CompletedPM, PlannedPM )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// Count of failure events.
	/// Formula: SUM(fact_ops_failures[Failure Start DateTime])
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.2, O-A2.3, O-A2.5
	measure 'Failure Count' = COUNTROWS ( fact_ops_failures )
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// Total inventory value in the selected scope.
	/// Formula: Sum of inventory value amount for the selected scope.
	/// Grain: location_sku_day · Unit: EUR
	/// Owner: Supply Chain Analytics · Status: active
	measure 'Inventory Value Amount' = SUM ( fact_inventory[Average Inventory Amount] )
		formatString: "#,0.00"
		displayFolder: "OPS-002"

	/// Count of preventive maintenance tasks.
	/// Formula: Count of PM tasks in the period.
	/// Grain: asset_day · Unit: count
	/// Owner: Operations Analytics · Status: active · Actions: O-A2.4
	measure 'Preventive Maintenance Task Count' = COUNTROWS ( fact_maintenance )
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// Count of safety incidents in the period.
	/// Formula: Count of recorded safety incidents.
	/// Grain: site_day · Unit: count
	/// Owner: Operations Analytics · Status: active
	measure 'Safety Incident Count' = VAR _pending = "Requires fact_safety_incidents table (not yet in data contract)" RETURN BLANK()
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// Good units / total units at first pass.
	/// Formula: SUM(fact_quality[Good Units]) / SUM(fact_quality[Total Units])
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.1, O-Q3.2
	/// Synonyms: First Pass Yield, First Time Yield, Erstausbeute, Gutausbeute im ersten Durchgang
	/// Example question: Which products have the lowest first pass yield?
	measure 'First Pass Yield %' = VAR GoodUnits = SUM ( fact_quality[Good Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Scrap units / total units.
	/// Formula: Scrap Units / Total Units.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.1, O-Q3.3, O-Q3.4
	/// Synonyms: Scrap Ratio, Reject Rate, Waste Rate, Ausschussquote, Ausschussrate
	/// Example question: What is driving the scrap rate up in Fashion?
	measure 'Scrap Rate %' = VAR ScrapUnits = SUM ( fact_quality[Scrap Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( ScrapUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Reworked units / total units.
	/// Formula: Reworked Units / Total Units.
	/// Grain: line_day · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.1, O-Q3.3
	measure 'Rework Rate %' = VAR ReworkUnits = SUM ( fact_quality[Rework Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( ReworkUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Financial impact from scrap, rework, and warranty/complaint costs.
	/// Formula: Sum of cost impacts for quality failures in period.
	/// Grain: month · Unit: EUR
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.4, O-Q3.5
	measure 'Cost of Poor Quality' = SUM ( fact_quality_costs[COPQ Amount] )
		formatString: "#,0.00"
		displayFolder: "OPS-003"

	/// Complaints / units shipped.
	/// Formula: Complaint Count / Units Shipped.
	/// Grain: month · Unit: %
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.5
	measure 'Complaint Rate %' = VAR Complaints = SUM ( fact_complaints[Complaint Count] ) VAR ShippedUnits = SUM ( fact_shipments[Shipped Units] ) RETURN DIVIDE ( Complaints, ShippedUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Defects per 1k units.
	/// Formula: (Defect Count / Total Units) * 1,000.
	/// Grain: line_day · Unit: defects per 1k units
	/// Owner: Operations Analytics · Status: active · Actions: O-Q3.2
	measure 'Defect Density' =
			VAR DefectCount =
				SUM ( fact_quality[Defect Count] )
			VAR TotalUnits =
				SUM ( fact_quality[Total Units] )
			VAR DefectRate =
				DIVIDE ( DefectCount, TotalUnits )
			RETURN
				DefectRate * 1000
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// Sales Units (OPS) - sales.units
	/// Measures output units volume from operations in the period.
	measure 'Sales Units (OPS)' = SUM ( fact_ops[Output Units] )
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// ActionReady Logic
	/// ActionReady Logic: O-O1.1
	measure 'Action_O-O1.1_Text' = IF ( [Availability %] < 0.8, "🔴 L3 — O-O1.1 — Operations Stabilisation" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify recurring downtime — Execute corrective actions — Monitor availability weekly", IF ( [Availability %] < 0.85, "🟠 L2 — O-O1.1 — Operations Stabilisation" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify recurring downtime — Execute corrective actions — Monitor availability weekly", IF ( [Availability %] < 0.9, "🟡 L1 — O-O1.1 — Operations Stabilisation" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify recurring downtime — Execute corrective actions — Monitor availability weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_manager"
		annotation ActionReady_ActionCodeId = "O-O1.1"

	/// ActionReady Logic: O-O1.2
	measure 'Action_O-O1.2_Text' = IF ( [Performance %] < 0.85, "🔴 L3 — O-O1.2 — Performance Recovery" & UNICHAR ( 10 ) & "Owner: production_manager | " & FORMAT ( [Performance %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify speed-loss causes — Eliminate micro-stoppages — Monitor performance weekly", IF ( [Performance %] < 0.9, "🟠 L2 — O-O1.2 — Performance Recovery" & UNICHAR ( 10 ) & "Owner: production_manager | " & FORMAT ( [Performance %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify speed-loss causes — Eliminate micro-stoppages — Monitor performance weekly", IF ( [Performance %] < 0.95, "🟡 L1 — O-O1.2 — Performance Recovery" & UNICHAR ( 10 ) & "Owner: production_manager | " & FORMAT ( [Performance %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify speed-loss causes — Eliminate micro-stoppages — Monitor performance weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "production_manager"
		annotation ActionReady_ActionCodeId = "O-O1.2"

	/// ActionReady Logic: O-O1.3
	measure 'Action_O-O1.3_Text' = IF ( [Quality %] < 0.94, "🔴 L3 — O-O1.3 — Quality Stabilisation" & UNICHAR ( 10 ) & "Owner: quality_manager | " & FORMAT ( [Quality %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify top defect categories — Implement quality controls — Monitor daily", IF ( [Quality %] < 0.96, "🟠 L2 — O-O1.3 — Quality Stabilisation" & UNICHAR ( 10 ) & "Owner: quality_manager | " & FORMAT ( [Quality %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify top defect categories — Implement quality controls — Monitor daily", IF ( [Quality %] < 0.98, "🟡 L1 — O-O1.3 — Quality Stabilisation" & UNICHAR ( 10 ) & "Owner: quality_manager | " & FORMAT ( [Quality %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify top defect categories — Implement quality controls — Monitor daily", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "quality_manager"
		annotation ActionReady_ActionCodeId = "O-O1.3"

	/// ActionReady Logic: O-O1.4
	measure 'Action_O-O1.4_Text' = IF ( [OEE %] < 0.65, "🔴 L3 — O-O1.4 — OEE Improvement" & UNICHAR ( 10 ) & "Owner: plant_manager | " & FORMAT ( [OEE %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OEE constraint factor — Execute targeted improvement — Review weekly", IF ( [OEE %] < 0.7, "🟠 L2 — O-O1.4 — OEE Improvement" & UNICHAR ( 10 ) & "Owner: plant_manager | " & FORMAT ( [OEE %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OEE constraint factor — Execute targeted improvement — Review weekly", IF ( [OEE %] < 0.75, "🟡 L1 — O-O1.4 — OEE Improvement" & UNICHAR ( 10 ) & "Owner: plant_manager | " & FORMAT ( [OEE %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify OEE constraint factor — Execute targeted improvement — Review weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "operations_director"
		annotation ActionReady_ActionCodeId = "O-O1.4"

	/// ActionReady Logic: O-A2.1
	measure 'Action_O-A2.1_Text' = IF ( [Availability %] < 0.84, "🔴 L3 — O-A2.1 — Reliability Orchestration" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify chronic failure modes — Execute corrective maintenance — Monitor weekly", IF ( [Availability %] < 0.88, "🟠 L2 — O-A2.1 — Reliability Orchestration" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify chronic failure modes — Execute corrective maintenance — Monitor weekly", IF ( [Availability %] < 0.92, "🟡 L1 — O-A2.1 — Reliability Orchestration" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [Availability %], "0.0%" ) & UNICHAR ( 10 ) & "→ Identify chronic failure modes — Execute corrective maintenance — Monitor weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_manager"
		annotation ActionReady_ActionCodeId = "O-A2.1"

	/// ActionReady Logic: O-A2.2
	measure 'Action_O-A2.2_Text' = IF ( [MTBF (hours)] < 60, "🔴 L3 — O-A2.2 — MTBF Improvement" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTBF (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Analyse recurring failures — Implement reliability fixes — Review MTBF monthly", IF ( [MTBF (hours)] < 72, "🟠 L2 — O-A2.2 — MTBF Improvement" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTBF (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Analyse recurring failures — Implement reliability fixes — Review MTBF monthly", IF ( [MTBF (hours)] < 90, "🟡 L1 — O-A2.2 — MTBF Improvement" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTBF (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Analyse recurring failures — Implement reliability fixes — Review MTBF monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "reliability_engineer"
		annotation ActionReady_ActionCodeId = "O-A2.2"

	/// ActionReady Logic: O-A2.3
	measure 'Action_O-A2.3_Text' = IF ( [MTTR (hours)] > 15, "🔴 L3 — O-A2.3 — MTTR Reduction" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTTR (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Identify slow repair categories — Standardise procedures — Review MTTR monthly", IF ( [MTTR (hours)] > 10, "🟠 L2 — O-A2.3 — MTTR Reduction" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTTR (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Identify slow repair categories — Standardise procedures — Review MTTR monthly", IF ( [MTTR (hours)] > 8, "🟡 L1 — O-A2.3 — MTTR Reduction" & UNICHAR ( 10 ) & "Owner: maintenance_manager | " & FORMAT ( [MTTR (hours)], "0.0" ) & UNICHAR ( 10 ) & "→ Identify slow repair categories — Standardise procedures — Review MTTR monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_supervisor"
		annotation ActionReady_ActionCodeId = "O-A2.3"

	/// ActionReady Logic: O-A2.4
