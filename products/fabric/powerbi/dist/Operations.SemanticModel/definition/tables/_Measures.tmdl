/// Consolidated Measures for: OPS-001, OPS-002, OPS-003 (Operations)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI %' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// OPS-001
	/// OEE % - ops.oee.pct
	/// Measures manufacturing performance combining availability, performance, and quality.
	measure 'OEE %' =
		VAR AvailabilityRate =
			[Availability %]
		VAR PerformanceRate =
			[Performance %]
		VAR QualityRate =
			[Quality %]
		RETURN
			AvailabilityRate * PerformanceRate * QualityRate
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Availability % - ops.availability.pct
	/// Uptime share relative to planned production time.
	measure 'Availability %' =
		VAR RunTimeMinutes =
			SUM ( fact_ops[Run Time Minutes] )
		VAR PlannedTimeMinutes =
			SUM ( fact_ops[Planned Time Minutes] )
		RETURN
			DIVIDE ( RunTimeMinutes, PlannedTimeMinutes )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Performance % - ops.performance.pct
	/// Throughput speed versus theoretical maximum.
	measure 'Performance %' =
		VAR ActualOutputUnits =
			SUM ( fact_ops[Output Units] )
		VAR RunTimeMinutes =
			SUM ( fact_ops[Run Time Minutes] )
		VAR StandardRateUnitsPerMinute =
			AVERAGE ( fact_ops[Standard Rate Units Per Minute] )
		VAR TheoreticalOutputUnits =
			RunTimeMinutes * StandardRateUnitsPerMinute
		RETURN
			DIVIDE ( ActualOutputUnits, TheoreticalOutputUnits )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Quality % - ops.quality.pct
	/// Yield of conforming units relative to total units produced.
	measure 'Quality %' = VAR GoodUnits = SUM ( fact_ops[Good Units] ) VAR TotalUnits = SUM ( fact_ops[Output Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Throughput Units - ops.throughput.units
	/// Measures total output volume in units.
	measure 'Throughput Units' = SUM ( fact_ops[Output Units] )
		formatString: "#,0"
		displayFolder: "OPS-001"

	/// Downtime % - ops.downtime.pct
	/// Measures share of planned production time lost to downtime.
	measure 'Downtime %' = VAR Downtime = SUM ( fact_ops[Downtime Minutes] ) VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] ) RETURN DIVIDE ( Downtime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// Planned Output Units - ops.planned_output.units
	/// Captures planned production output volume.
	measure 'Planned Output Units' =
		VAR PlannedOutputUnits =
			SUMX ( fact_ops, fact_ops[Standard Rate Units Per Minute] * fact_ops[Planned Time Minutes] )
		RETURN
			PlannedOutputUnits
		formatString: "#,0"
		displayFolder: "OPS-001"

	/// OPS-002
	/// MTBF (hours) - ops.mtbf.hours
	/// Measures average operating time between failures.
	measure 'MTBF (hours)' = VAR FailureCount = COUNTROWS ( fact_ops_failures ) VAR OperatingTime = SUMX ( fact_ops, DIVIDE ( fact_ops[Run Time Minutes], 60 ) ) RETURN DIVIDE ( OperatingTime, FailureCount )
		formatString: "0"
		displayFolder: "OPS-002"

	/// MTTR (hours) - ops.mttr.hours
	/// Measures average repair time after failures.
	measure 'MTTR (hours)' = VAR FailureCount = COUNTROWS ( fact_ops_failures ) VAR TotalRepairTime = SUM ( fact_ops_failures[Repair Duration Hours] ) RETURN DIVIDE ( TotalRepairTime, FailureCount )
		formatString: "0"
		displayFolder: "OPS-002"

	/// Unplanned Downtime % - ops.downtime.unplanned.pct
	/// Measures unplanned downtime share of planned time.
	measure 'Unplanned Downtime %' = VAR UnplannedDowntime = SUMX ( fact_ops_failures, fact_ops_failures[Downtime Minutes] ) VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] ) RETURN DIVIDE ( UnplannedDowntime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// Spare Parts Stockout % - ops.spare_parts.stockout.pct
	/// Measures stockout frequency for critical spare parts.
	measure 'Spare Parts Stockout %' = VAR StockoutCount = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Parts Stockout Flag] = TRUE () ) VAR TotalRequests = COUNTROWS ( fact_maintenance ) RETURN DIVIDE ( StockoutCount, TotalRequests )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// PM Compliance % - ops.pm_compliance.pct
	/// Tracks adherence to preventive maintenance plan.
	measure 'PM Compliance %' = VAR CompletedPM = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Order Type] = "PM", fact_maintenance[Order Status] = "Completed" ) VAR PlannedPM = CALCULATE ( COUNTROWS ( fact_maintenance ), fact_maintenance[Order Type] = "PM" ) RETURN DIVIDE ( CompletedPM, PlannedPM )
		formatString: "0.0%"
		displayFolder: "OPS-002"

	/// Failure Count - ops.failure.count
	/// Counts equipment or process failures in the period.
	measure 'Failure Count' = COUNTROWS ( fact_ops_failures )
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// Inventory Value Amount - ops.inventory.value.amount
	/// Tracks inventory value for maintenance-relevant items.
	measure 'Inventory Value Amount' = SUM ( fact_inventory[Average Inventory Amount] )
		formatString: "#,0.00"
		displayFolder: "OPS-002"

	/// Preventive Maintenance Task Count - ops.pm.task.count
	/// Counts preventive maintenance tasks executed or scheduled.
	measure 'Preventive Maintenance Task Count' = COUNTROWS ( fact_maintenance )
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// Safety Incident Count - ops.safety.incident.count
	/// Counts safety incidents recorded in the period.
	measure 'Safety Incident Count' = VAR _pending = "Requires fact_safety_incidents table (not yet in data contract)" RETURN BLANK()
		formatString: "#,0"
		displayFolder: "OPS-002"

	/// OPS-003
	/// First Pass Yield % - quality.fpy.pct
	/// Measures share of units produced without rework or scrap.
	measure 'First Pass Yield %' = VAR GoodUnits = SUM ( fact_quality[Good Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Scrap Rate % - quality.scrap.pct
	/// Measures share of units scrapped in production.
	measure 'Scrap Rate %' = VAR ScrapUnits = SUM ( fact_quality[Scrap Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( ScrapUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Rework Rate % - quality.rework.pct
	/// Measures share of units requiring rework.
	measure 'Rework Rate %' = VAR ReworkUnits = SUM ( fact_quality[Rework Units] ) VAR TotalUnits = SUM ( fact_quality[Total Units] ) RETURN DIVIDE ( ReworkUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Cost of Poor Quality - quality.copq.amount
	/// Captures financial impact of scrap, rework, and warranty/complaints.
	measure 'Cost of Poor Quality' = SUM ( fact_quality_costs[COPQ Amount] )
		formatString: "#,0.00"
		displayFolder: "OPS-003"

	/// Complaint Rate % - quality.complaint.pct
	/// Measures customer complaints relative to shipped units.
	measure 'Complaint Rate %' = VAR Complaints = SUM ( fact_complaints[Complaint Count] ) VAR ShippedUnits = SUM ( fact_shipments[Shipped Units] ) RETURN DIVIDE ( Complaints, ShippedUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// Defect Density - quality.defect_density
	/// Measures defect count per 1,000 units produced.
	measure 'Defect Density' =
		VAR DefectCount =
			SUM ( fact_quality[Defect Count] )
		VAR TotalUnits =
			SUM ( fact_quality[Total Units] )
		VAR DefectRate =
			DIVIDE ( DefectCount, TotalUnits )
		RETURN
			DefectRate * 1000
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// Sales Units - sales.units
	/// Measures sold units volume in the period.
	measure 'Sales Units' = SUM ( fact_sales[Sales Units] )
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// Complaint Count - crm.complaint.count
	/// Count of logged customer complaints
	measure 'Complaint Count' = COUNTROWS ( fact_experience )
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// ActionReady Logic
	/// ActionReady Logic: O-O1.1
	measure 'Action_O-O1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: maintenance_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_manager"
		annotation ActionReady_ActionCodeId = "O-O1.1"

	/// ActionReady Logic: O-O1.2
	measure 'Action_O-O1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: production_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "production_manager"
		annotation ActionReady_ActionCodeId = "O-O1.2"

	/// ActionReady Logic: O-O1.3
	measure 'Action_O-O1.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: quality_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "quality_manager"
		annotation ActionReady_ActionCodeId = "O-O1.3"

	/// ActionReady Logic: O-O1.4
	measure 'Action_O-O1.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: operations_director" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "operations_director"
		annotation ActionReady_ActionCodeId = "O-O1.4"

	/// ActionReady Logic: O-A2.1
	measure 'Action_O-A2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: maintenance_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_manager"
		annotation ActionReady_ActionCodeId = "O-A2.1"

	/// ActionReady Logic: O-A2.2
	measure 'Action_O-A2.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: reliability_engineer" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "reliability_engineer"
		annotation ActionReady_ActionCodeId = "O-A2.2"

	/// ActionReady Logic: O-A2.3
	measure 'Action_O-A2.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: maintenance_supervisor" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_supervisor"
		annotation ActionReady_ActionCodeId = "O-A2.3"

	/// ActionReady Logic: O-A2.4
	measure 'Action_O-A2.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: maintenance_planner" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_planner"
		annotation ActionReady_ActionCodeId = "O-A2.4"

	/// ActionReady Logic: O-A2.5
	measure 'Action_O-A2.5_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: maintenance_supply_coordinator" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "maintenance_supply_coordinator"
		annotation ActionReady_ActionCodeId = "O-A2.5"

	/// ActionReady Logic: O-Q3.1
	measure 'Action_O-Q3.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_quality" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_quality"
		annotation ActionReady_ActionCodeId = "O-Q3.1"

	/// ActionReady Logic: O-Q3.2
	measure 'Action_O-Q3.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: quality_engineer" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "quality_engineer"
		annotation ActionReady_ActionCodeId = "O-Q3.2"

	/// ActionReady Logic: O-Q3.3
	measure 'Action_O-Q3.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: production_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "production_manager"
		annotation ActionReady_ActionCodeId = "O-Q3.3"

	/// ActionReady Logic: O-Q3.4
	measure 'Action_O-Q3.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_quality" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_quality"
		annotation ActionReady_ActionCodeId = "O-Q3.4"

	/// ActionReady Logic: O-Q3.5
	measure 'Action_O-Q3.5_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: quality_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "quality_manager"
		annotation ActionReady_ActionCodeId = "O-Q3.5"
