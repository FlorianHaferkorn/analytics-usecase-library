/// Product dimension with category hierarchy for operations quality and yield analysis.
table dim_product
		lineageTag: d4e5f6a7-b8c9-0123-de45-fg67hi89de01

		column ProductKey
			dataType: Int64
			sourceColumn: ProductKey
			summarizeBy: none
			isHidden

		column ProductCode
			dataType: String
			sourceColumn: ProductCode
			summarizeBy: none

		column ProductName
			dataType: String
			sourceColumn: ProductName
			summarizeBy: none

		column Category
			dataType: String
			sourceColumn: Category
			summarizeBy: none

		column Subcategory
			dataType: String
			sourceColumn: Subcategory
			summarizeBy: none

		partition dim_product = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_product"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

