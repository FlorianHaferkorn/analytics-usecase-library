/// Customer complaint facts per entity-month (complaint count, resolution status).
/// Source: Gold Layer — showcases/aurora_group/data/gold/facts/fact_complaints (Parquet, 2020–2024).
table fact_complaints
	lineageTag: d4f8c109-2a31-4b7e-9c82-f1e3a5d0b294
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column CustomerKey
		dataType: Int64
		isHidden
		sourceColumn: CustomerKey
		summarizeBy: none
	column 'Complaint Count'
		dataType: Int64
		sourceColumn: Complaint Count
		summarizeBy: none
	column 'Resolved Count'
		dataType: Int64
		sourceColumn: Resolved Count
		summarizeBy: none
	column 'Resolution Days'
		dataType: Decimal
		sourceColumn: Resolution Days
		summarizeBy: none
	partition fact_complaints = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_complaints"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
