/// Customer complaint facts per entity-month (complaint count, resolution status).
/// Data contract pending: source table fact_complaints in Gold Layer not yet available.
/// Stub: returns empty partition until Gold Layer table is provisioned.
table fact_complaints
	lineageTag: d4f8c109-2a31-4b7e-9c82-f1e3a5d0b294
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column CustomerKey
		dataType: Int64
		sourceColumn: CustomerKey
		summarizeBy: none
	column 'Complaint Count'
		dataType: Int64
		sourceColumn: Complaint Count
		summarizeBy: none
	column 'Resolved Count'
		dataType: Int64
		sourceColumn: Resolved Count
		summarizeBy: none
	column 'Resolution Days'
		dataType: Decimal
		sourceColumn: Resolution Days
		summarizeBy: none
	partition fact_complaints = m
		mode: import
		source =
			let
				Source = #table(
				type table [DateKey = Int64, OrgKey = Int64, CustomerKey = Int64,
				#"Complaint Count" = Int64, #"Resolved Count" = Int64,
				#"Resolution Days" = Decimal.Type],
				{}
				)
			in
				Source
