/// Maintenance orders (PM/CM) per asset and date with status and on-time flags.
table fact_maintenance
	lineageTag: 7ea6afb8-4f67-4ff6-919f-fb7e5d9a1bbe
	column AssetKey
		dataType: Int64
		sourceColumn: AssetKey
		summarizeBy: none
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column 'Order Type'
		dataType: String
		sourceColumn: Order Type
		summarizeBy: none
	column 'Order Status'
		dataType: String
		sourceColumn: Order Status
		summarizeBy: none
	column 'On Time Flag'
		dataType: Boolean
		sourceColumn: On Time Flag
		summarizeBy: none
	column 'Parts Stockout Flag'
		dataType: Boolean
		sourceColumn: Parts Stockout Flag
		summarizeBy: none
	partition fact_maintenance = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_maintenance"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
