/// Cost of Poor Quality facts per entity-product-month (scrap, rework, warranty, inspection costs).
/// Data contract pending: source table fact_quality_costs in Gold Layer not yet available.
/// Stub: returns empty partition until Gold Layer table is provisioned.
table fact_quality_costs
	lineageTag: b3e21a04-9f12-4d88-a751-cc7a3b1f8e91
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		sourceColumn: ProductKey
		summarizeBy: none
	column 'COPQ Amount'
		dataType: Decimal
		sourceColumn: COPQ Amount
		summarizeBy: none
	column 'Scrap Cost Amount'
		dataType: Decimal
		sourceColumn: Scrap Cost Amount
		summarizeBy: none
	column 'Rework Cost Amount'
		dataType: Decimal
		sourceColumn: Rework Cost Amount
		summarizeBy: none
	column 'Warranty Cost Amount'
		dataType: Decimal
		sourceColumn: Warranty Cost Amount
		summarizeBy: none
	partition fact_quality_costs = m
		mode: import
		source =
			let
				Source = #table(
					type table [DateKey = Int64, OrgKey = Int64, ProductKey = Int64,
						#"COPQ Amount" = Decimal.Type, #"Scrap Cost Amount" = Decimal.Type,
						#"Rework Cost Amount" = Decimal.Type, #"Warranty Cost Amount" = Decimal.Type],
					{}
				)
			in
				Source
