/// Cost of Poor Quality facts per entity-product-month (scrap, rework, warranty, inspection costs).
/// Source: Gold Layer — showcases/aurora_group/data/gold/facts/fact_quality_costs (Parquet, 2020–2024).
table fact_quality_costs
	lineageTag: b3e21a04-9f12-4d88-a751-cc7a3b1f8e91
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'COPQ Amount'
		dataType: Decimal
		sourceColumn: COPQ Amount
		summarizeBy: none
	column 'Scrap Cost Amount'
		dataType: Decimal
		sourceColumn: Scrap Cost Amount
		summarizeBy: none
	column 'Rework Cost Amount'
		dataType: Decimal
		sourceColumn: Rework Cost Amount
		summarizeBy: none
	column 'Warranty Cost Amount'
		dataType: Decimal
		sourceColumn: Warranty Cost Amount
		summarizeBy: none
	partition fact_quality_costs = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_quality_costs"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet") and not Text.Contains([Folder Path], "_delta_log")),
				SortedFiles = Table.Sort(FilteredFiles, {{"Date modified", Order.Descending}}),
				FirstFile = SortedFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
