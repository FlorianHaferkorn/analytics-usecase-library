/// Equipment failure events: for MTBF, MTTR, failure count, and unplanned downtime analysis.
table fact_ops_failures
		lineageTag: a7b8c9d0-e1f2-3456-ab78-cd90ef12ab34

		column DateKey
			dataType: Int64
			sourceColumn: DateKey
			summarizeBy: none

		column OrgKey
			dataType: Int64
			sourceColumn: OrgKey
			summarizeBy: none

		column AssetKey
			dataType: Int64
			sourceColumn: AssetKey
			summarizeBy: none

		column 'Failure Start DateKey'
			dataType: Int64
			sourceColumn: Failure Start DateKey
			summarizeBy: none

		column 'Failure End DateKey'
			dataType: Int64
			sourceColumn: Failure End DateKey
			summarizeBy: none

		column 'Downtime Hours'
			dataType: Decimal
			sourceColumn: Downtime Hours
			summarizeBy: none

		column 'Uptime Hours'
			dataType: Decimal
			sourceColumn: Uptime Hours
			summarizeBy: none

		column 'Is Unplanned'
			dataType: Boolean
			sourceColumn: Is Unplanned
			summarizeBy: none

		column 'Failure Type'
			dataType: String
			sourceColumn: Failure Type
			summarizeBy: none

		partition fact_ops_failures = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/facts/fact_ops_failures"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

