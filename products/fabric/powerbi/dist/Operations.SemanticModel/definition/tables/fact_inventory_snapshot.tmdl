/// Daily inventory snapshot (units/value) at location-SKU grain for operations monitoring.
table fact_inventory_snapshot
	lineageTag: 6d71b5a7-8b1f-5431-b3be-7e71504d4a60
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'On-Hand Units'
		dataType: Decimal
		sourceColumn: Stock Qty
		summarizeBy: none
	column 'Inventory Value'
		dataType: Decimal
		sourceColumn: Stock Value Amount
		summarizeBy: none
	column 'Reorder Flag'
		dataType: Boolean
		sourceColumn: Reorder Flag
		summarizeBy: none
	partition fact_inventory_snapshot = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_inventory_snapshot"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
