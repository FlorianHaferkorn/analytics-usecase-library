/// Asset dimension (machines, lines, equipment) for OEE and maintenance analysis.
table dim_asset
		lineageTag: c3d4e5f6-a7b8-9012-cd34-ef56gh78cd90

		column AssetKey
			dataType: Int64
			sourceColumn: AssetKey
			summarizeBy: none
			isHidden

		column AssetCode
			dataType: String
			sourceColumn: AssetCode
			summarizeBy: none

		column AssetName
			dataType: String
			sourceColumn: AssetName
			summarizeBy: none

		column AssetType
			dataType: String
			sourceColumn: AssetType
			summarizeBy: none

		column Line
			dataType: String
			sourceColumn: Line
			summarizeBy: none

		column Plant
			dataType: String
			sourceColumn: Plant
			summarizeBy: none

		column CriticalityClass
			dataType: String
			sourceColumn: CriticalityClass
			summarizeBy: none

		partition dim_asset = m
			mode: import
			source =
			let
					Source = Folder.Files(GoldDataPath & "/dimensions/dim_asset"),
					FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
					FirstFile = FilteredFiles{0}[Content],
					ParquetData = Parquet.Document(FirstFile)
					in
					ParquetData

