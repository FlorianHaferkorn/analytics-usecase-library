/// Production line-day facts (planned/run/downtime, output, scrap) for OEE.
table fact_ops
	lineageTag: aac0d26d-e7fa-52e7-b358-3b9c146655d6
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column AssetKey
		dataType: Int64
		sourceColumn: AssetKey
		summarizeBy: none
	column 'Planned Time Minutes'
		dataType: Decimal
		sourceColumn: Planned Time Minutes
		summarizeBy: none
	column 'Run Time Minutes'
		dataType: Decimal
		sourceColumn: Run Time Minutes
		summarizeBy: none
	column 'Downtime Minutes'
		dataType: Decimal
		sourceColumn: Downtime Minutes
		summarizeBy: none
	column 'Output Units'
		dataType: Decimal
		sourceColumn: Output Units
		summarizeBy: none
	column 'Good Units'
		dataType: Decimal
		sourceColumn: Good Units
		summarizeBy: none
	column 'Scrap Units'
		dataType: Decimal
		sourceColumn: Scrap Units
		summarizeBy: none
	column 'Standard Rate Units Per Minute'
		dataType: Decimal
		sourceColumn: Standard Rate Units Per Minute
		summarizeBy: none
	partition fact_ops = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_ops"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
