/// Line-day quality facts (total/good/scrap/rework units, defect count) for FPY and COPQ.
table fact_quality
	lineageTag: 09fce7df-982f-47d4-ab54-d57bb3ff1b15
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column ProductKey
		dataType: Int64
		isHidden
		sourceColumn: ProductKey
		summarizeBy: none
	column 'Total Units'
		dataType: Decimal
		sourceColumn: Total Units
		summarizeBy: none
	column 'Good Units'
		dataType: Decimal
		sourceColumn: Good Units
		summarizeBy: none
	column 'Scrap Units'
		dataType: Decimal
		sourceColumn: Scrap Units
		summarizeBy: none
	column 'Rework Units'
		dataType: Decimal
		sourceColumn: Rework Units
		summarizeBy: none
	column 'Defect Count'
		dataType: Decimal
		sourceColumn: Defect Count
		summarizeBy: none
	partition fact_quality = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_quality"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
