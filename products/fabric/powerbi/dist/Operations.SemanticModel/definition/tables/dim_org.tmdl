/// Organization dimension (plant, line, shift, region) for operations.
table dim_org
	lineageTag: 605f86c2-43fd-5ad0-b0d6-1952eb3f0e33
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column Plant
		dataType: String
		sourceColumn: Plant
		summarizeBy: none
	column Line
		dataType: String
		sourceColumn: Line
		summarizeBy: none
	column Shift
		dataType: String
		sourceColumn: Shift
		summarizeBy: none
	/// Sales region grouping countries. Type: text · Role: attribute · Values: DACH, Benelux, Nordics, SouthernEurope, CEE · Synonyms: Sales Region, Geo, Geography, Territory, Vertriebsregion, Gebiet
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	/// Country of the selling org unit. Type: text · Role: attribute · Synonyms: Country of Domicile, Land, Sitzland
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	column OrgName
		dataType: String
		sourceColumn: Plant
		summarizeBy: none
	partition dim_org = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/dimensions/dim_org"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
