/// Organization dimension (plant, line, shift, region) for operations.
table dim_org
	lineageTag: 605f86c2-43fd-5ad0-b0d6-1952eb3f0e33
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
	column Plant
		dataType: String
		sourceColumn: Plant
		summarizeBy: none
	column Line
		dataType: String
		sourceColumn: Line
		summarizeBy: none
	column Shift
		dataType: String
		sourceColumn: Shift
		summarizeBy: none
	column Region
		dataType: String
		sourceColumn: Region
		summarizeBy: none
	column Country
		dataType: String
		sourceColumn: Country
		summarizeBy: none
	partition dim_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/dimensions/dim_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
