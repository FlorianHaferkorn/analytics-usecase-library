/// User-to-Org mapping table for Row-Level Security.
table security_user_org
	lineageTag: fab45ed9-2270-523b-a4cb-daf51d58ce13

	column UserPrincipalName
		dataType: String
		sourceColumn: UserPrincipalName
		summarizeBy: none

	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false

	partition security_user_org = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/security_user_org"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				ParquetData = Table.Combine(List.Transform(FilteredFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
