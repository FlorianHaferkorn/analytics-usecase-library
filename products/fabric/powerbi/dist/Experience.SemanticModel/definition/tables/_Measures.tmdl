/// Consolidated Measures for: XD-001, XD-002, XD-003 (Experience)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// KPI-GOV-005 - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// KPI-GOV-001 - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// KPI-GOV-006 - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// KPI-GOV-007 - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"



	/// ActionReady Logic: X-S1.1 - Service Level Orchestration
	measure 'Action_X-S1.1_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s0 = _ende VAR _e0 = _ende VAR _s1 = _s0 - 1 VAR _e1 = _e0 - 1 VAR _s2 = _s0 - 2 VAR _e2 = _e0 - 2 VAR _v0 = CALCULATE ( [SLA Attainment %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _v0_1 = CALCULATE ( [SLA Attainment %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _v0_2 = CALCULATE ( [SLA Attainment %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s2, 'dim_date'[Date] <= _e2 ) VAR _g = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _g_1 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g_2 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s2, 'dim_date'[Date] <= _e2 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.88 ) && _g >= 100 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.88 ) && _g_1 >= 100 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.88 ) && _g_2 >= 100 ), "🔴 L3 — X-S1.1 — Service Level Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_service_operations | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained SLA deterioration for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant service constraint for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW SLA recovery for this queue daily", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.92 ) && _g >= 100 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.92 ) && _g_1 >= 100 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.92 ) && _g_2 >= 100 ), "🟠 L2 — X-S1.1 — Service Level Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_service_operations | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained SLA deterioration for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant service constraint for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW SLA recovery for this queue daily", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.95 ) && _g >= 100 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.95 ) && _g_1 >= 100 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.95 ) && _g_2 >= 100 ), "🟡 L1 — X-S1.1 — Service Level Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_service_operations | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained SLA deterioration for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant service constraint for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW SLA recovery for this queue daily", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: d5108477-5fae-4b1b-b4a1-b36e2cb6bdad

		annotation ActionReady_ActionCodeId = "X-S1.1"

	/// ActionReady Logic: X-S1.3 - FCR Improvement Programme
	measure 'Action_X-S1.3_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s0 = _ende - WEEKDAY ( _ende, 2 ) + 1 VAR _e0 = _s0 + 6 VAR _s1 = _s0 - 7 VAR _e1 = _e0 - 7 VAR _v0 = CALCULATE ( [First Contact Resolution %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _v0_1 = CALCULATE ( [First Contact Resolution %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g = CALCULATE ( [Tickets Closed Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _g_1 = CALCULATE ( [Tickets Closed Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.55 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.55 ) && _g_1 >= 200 ), "🔴 L3 — X-S1.3 — Quality & First-Contact Resolution Uplift" & UNICHAR ( 10 ) & "Owner: quality_and_training_lead | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY cases with low first-contact resolution by queue/agent group" & UNICHAR ( 10 ) & "→ DIAGNOSE top repeat-contact drivers for this case type" & UNICHAR ( 10 ) & "→ DEPLOY targeted coaching, scripts, or knowledge updates for this case type" & UNICHAR ( 10 ) & "→ REVIEW FCR and escalations for this case type bi-weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.65 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.65 ) && _g_1 >= 200 ), "🟠 L2 — X-S1.3 — Quality & First-Contact Resolution Uplift" & UNICHAR ( 10 ) & "Owner: quality_and_training_lead | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY cases with low first-contact resolution by queue/agent group" & UNICHAR ( 10 ) & "→ DIAGNOSE top repeat-contact drivers for this case type" & UNICHAR ( 10 ) & "→ DEPLOY targeted coaching, scripts, or knowledge updates for this case type" & UNICHAR ( 10 ) & "→ REVIEW FCR and escalations for this case type bi-weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.75 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.75 ) && _g_1 >= 200 ), "🟡 L1 — X-S1.3 — Quality & First-Contact Resolution Uplift" & UNICHAR ( 10 ) & "Owner: quality_and_training_lead | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY cases with low first-contact resolution by queue/agent group" & UNICHAR ( 10 ) & "→ DIAGNOSE top repeat-contact drivers for this case type" & UNICHAR ( 10 ) & "→ DEPLOY targeted coaching, scripts, or knowledge updates for this case type" & UNICHAR ( 10 ) & "→ REVIEW FCR and escalations for this case type bi-weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 1da22171-7171-4535-bf62-1f6a4cee8ec9

		annotation ActionReady_ActionCodeId = "X-S1.3"

	/// Purpose: Dynamic KPI summary string for the Detail page narrative header.
	measure 'Narrative Text (XD)' = VAR _sla = [SLA Attainment %] VAR _fcr = [First Contact Resolution %] VAR _aht = [Average Handling Time (minutes)] VAR _util = [Utilization %] VAR _shrink = [Shrinkage %] VAR _clv = [CLV (Customer Lifetime Value)] RETURN "SLA: " & FORMAT ( _sla, "0.0%" ) & "  |  FCR: " & FORMAT ( _fcr, "0.0%" ) & "  |  AHT: " & FORMAT ( _aht, "0.0" ) & "min" & UNICHAR ( 10 ) & "Utilization: " & FORMAT ( _util, "0.0%" ) & "  |  Shrinkage: " & FORMAT ( _shrink, "0.0%" ) & "  |  CLV: €" & FORMAT ( _clv, "#,0" )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: eee81ba8-c780-4aff-abdf-cb5bfc91134a

	/// Purpose: Concatenates all currently triggered action recommendations.
	measure 'Active Actions Text (XD)' = VAR _rows = FILTER ( { [Action_X-S1.1_Text], [Action_X-S1.3_Text], [Action_X-R2.1_Text], [Action_X-R2.2_Text], [Action_X-R2.3_Text], [Action_X-R2.4_Text], [Action_X-E3.2_Text], [Action_X-E3.3_Text] }, NOT ISBLANK ( [Value] ) ) VAR _result = CONCATENATEX ( _rows, [Value], UNICHAR ( 10 ) & UNICHAR ( 10 ) ) RETURN IF ( ISBLANK ( _result ), "✅ All KPIs within tolerance — no actions triggered.", _result )
		formatString: @
		isHidden
		displayFolder: 0_Summary
		lineageTag: ff06d566-377c-4e83-a398-3504f9c49e0c


	/// Purpose: Freshness timestamp for AI narrative — binds smartNarrativeVisual to latest loaded date.
	measure 'Last Refresh (XD)' = "✦ AI Summary — Data as of " & FORMAT(MAXX(ALL('dim_date'), 'dim_date'[Date]), "DD MMM YYYY")
		formatString: @
		displayFolder: 0_Summary
		lineageTag: 0d48ddf2-cce0-42c3-bf0d-6e08d514271d
	/// Average EUR impact per achieved action execution.
	/// Formula: AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
	/// Grain: month · Unit: EUR · Good: higher_is_better
	/// Owner: Commercial BI · Status: active
	measure 'Action Effectiveness Delta' = AVERAGEX ( FILTER ( fact_action_outcome, fact_action_outcome[outcome_status] = "achieved" ), fact_action_outcome[impact_value] )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// Purpose: Zielwert von Action Outcome Rate % (XD Log) aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Action Outcome Rate % (XD Log) Target' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "KPI-GOV-001", fact_target[scenario] = "target" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 4dab9c41-1a23-5c7d-b1a7-2a47164b1864

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Action Outcome Rate % (XD Log) gegen Action Outcome Rate % (XD Log) Target; leer ohne Referenzwert.
	measure 'Action Outcome Rate % (XD Log) vs Target' = VAR _r = [Action Outcome Rate % (XD Log) Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [Action Outcome Rate % (XD Log)] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: e1e0bc8a-8f95-5d3c-9179-11d1ebb8dc40

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Zielwert von Enterprise Value-at-Risk Index aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Enterprise Value-at-Risk Index Target' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "KPI-GOV-004", fact_target[scenario] = "target" )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: 650da056-a5a5-5c60-b8ad-73ccb6c79219

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Enterprise Value-at-Risk Index gegen Enterprise Value-at-Risk Index Target; leer ohne Referenzwert.
	measure 'Enterprise Value-at-Risk Index vs Target' = VAR _r = [Enterprise Value-at-Risk Index Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [Enterprise Value-at-Risk Index] - _r )
		formatString: "0"
		displayFolder: 8_Comparison
		lineageTag: b283a9fa-d4f0-53a2-b66c-1cdf584c8b73

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Zielwert von SLA Attainment % aus fact_target (comparison: vs_target); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'SLA Attainment % Target' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "KPI-SVC-004", fact_target[scenario] = "target" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 951b6dba-279f-5a42-a41c-ef112b772337

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung SLA Attainment % gegen SLA Attainment % Target; leer ohne Referenzwert.
	measure 'SLA Attainment % vs Target' = VAR _r = [SLA Attainment % Target] RETURN IF ( ISBLANK ( _r ), BLANK (), [SLA Attainment %] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 76d2c389-79dc-550a-8b83-99d7da030a57

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Planwert von Utilization % aus fact_target (comparison: vs_plan); konzernweit, auch beim Filtern auf eine Einheit; leer, solange der Kunde keinen Wert geliefert hat.
	measure 'Utilization % Plan (Target Table)' = CALCULATE ( AVERAGE ( fact_target[Target Value] ), fact_target[kpi_id] = "KPI-SVC-009", fact_target[scenario] = "plan" )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: 7ba5ce95-54f7-5a00-9125-23a892b7fbd3

		annotation ALUCA_Generated = "comparison_measures"

	/// Purpose: Abweichung Utilization % gegen Utilization % Plan (Target Table); leer ohne Referenzwert.
	measure 'Utilization % vs Plan (Target Table)' = VAR _r = [Utilization % Plan (Target Table)] RETURN IF ( ISBLANK ( _r ), BLANK (), [Utilization %] - _r )
		formatString: "0.0%"
		displayFolder: 8_Comparison
		lineageTag: ae9f26dc-0a28-5a2e-ada8-3fe7f6eb4229

		annotation ALUCA_Generated = "comparison_measures"


	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// Cases meeting SLA divided by total cases.
	/// Formula: Cases with SLA Met Flag = 1 divided by total cases in period.
	/// Grain: day_queue · Unit: % · Good: higher_is_better
	/// Owner: Service Analytics · Status: active · Actions: X-S1.1, X-S1.2, X-S1.4
	/// Synonyms: Service Level, SLA Compliance, Telephone Service Factor, Servicegrad, Servicelevel
	/// Example question: Which queues are missing the SLA this week?
	measure 'SLA Attainment %' =
			VAR CasesWithinSla =
				CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[SLA Met Flag] = TRUE() )
			VAR TotalCases =
				COUNTROWS ( fact_support_cases )
			RETURN
				DIVIDE ( CasesWithinSla, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// FCR % - KPI-SVC-005
	/// Shows the share of cases solved on first contact.
	measure 'FCR %' =
			VAR FirstContactResolvedCases =
				CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[FCR Flag] = TRUE() )
			VAR TotalCases =
				COUNTROWS ( fact_support_cases )
			RETURN
				DIVIDE ( FirstContactResolvedCases, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// AHT Minutes - KPI-SVC-006
	/// Measures average time to handle a contact.
	measure 'AHT Minutes' = DIVIDE ( SUM ( fact_support_cases[Handle Time Minutes] ), COUNTROWS ( fact_support_cases ) )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Open cases not resolved.
	/// Formula: Count of open cases at period end.
	/// Grain: day_queue · Unit: count · Good: lower_is_better
	/// Owner: Service Analytics · Status: active · Actions: X-S1.1, X-S1.2
	/// Synonyms: Support Backlog, Open Ticket Backlog, Unresolved Tickets, Rückstand, offene Tickets
	/// Example question: Which queues have the largest case backlog?
	measure 'Backlog Count' =
			VAR BacklogCases =
				CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Backlog Flag] = TRUE() )
			RETURN
				BacklogCases
		formatString: "#,0"
		displayFolder: "XD-001"

	/// NPS score from surveys: %Promoters - %Detractors.
	/// Formula: %Promoters minus %Detractors from NPS survey.
	/// Grain: month · Unit: index
	/// Owner: Service Analytics · Status: active
	/// Synonyms: Net Promoter Score, Service NPS, Weiterempfehlungsrate, NPS
	/// Example question: Why did NPS dip for the Returns queue?
	measure 'NPS Index' =
			VAR Promoters =
				CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] >= 9 )
			VAR Detractors =
				CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] <= 6 )
			VAR TotalResponses =
				COUNTROWS ( fact_nps )
			VAR NetPromoterShare =
				DIVIDE ( Promoters - Detractors, TotalResponses )
			RETURN
				ROUND ( NetPromoterShare * 100, 0 )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Escalated cases / total cases.
	/// Formula: Escalated cases divided by total cases.
	/// Grain: day_queue · Unit: % · Good: lower_is_better
	/// Owner: Service Analytics · Status: active · Actions: X-S1.1, X-S1.3
	/// Synonyms: Escalation Rate, Ticket Escalation Rate, Transfer Rate, Eskalationsquote, Eskalationsrate
	/// Example question: Which issue types escalate most often?
	measure 'Escalation %' =
			VAR EscalatedCases =
				CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Escalation Flag] = TRUE() )
			VAR TotalCases =
				COUNTROWS ( fact_support_cases )
			RETURN
				DIVIDE ( EscalatedCases, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// Count of newly created service tickets.
	/// Formula: Count of newly created service tickets.
	/// Grain: ticket_day · Unit: count
	/// Owner: Service Analytics · Status: active · Actions: X-R2.1, X-R2.2, X-R2.3, X-R2.4, X-S1.1, X-S1.2
	measure 'Tickets Created Count' = COUNTROWS ( fact_support_cases )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Count of closed service tickets.
	/// Formula: Count of closed service tickets.
	/// Grain: ticket_day · Unit: count
	/// Owner: Service Analytics · Status: active · Actions: X-S1.3, X-S1.4
	measure 'Tickets Closed Count' =
			VAR ClosedTickets =
				CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Open Case Flag] = FALSE() )
			RETURN
				ClosedTickets
		formatString: "#,0"
		displayFolder: "XD-001"


	/// Share of cases solved on first contact without escalation or rework.
	/// Formula: DIVIDE ( CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[FCR Flag] = TRUE() ), COUNTROWS ( fact_support_cases ) )
	/// Grain: queue_day · Unit: % · Good: higher_is_better
	/// Owner: Service BI · Status: active · Actions: X-S1.3
	/// Synonyms: First Contact Resolution, First Call Resolution, One-Touch Resolution, Erstlösungsquote, Erstkontaktlösung
	/// Example question: Where is first contact resolution lowest, and why?
	measure 'First Contact Resolution %' = [FCR %]
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// Display alias for AHT Minutes; measures average time to handle a contact.
	/// Formula: DIVIDE ( SUM ( fact_support_cases[Handle Time Minutes] ), COUNTROWS ( fact_support_cases ) )
	/// Grain: queue_day · Unit: minutes · Good: lower_is_better
	/// Owner: Service BI · Status: active · Actions: X-S1.4
	/// Synonyms: Average Handle Time, Average Handling Time, Handle Time, durchschnittliche Bearbeitungszeit
	/// Example question: What is pushing average handle time up on chat?
	measure 'Average Handling Time (minutes)' = [AHT Minutes]
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Productive time vs paid time.
	/// Formula: Productive time divided by paid time.
	/// Grain: agent_day or queue_day · Unit: % · Good: within_target_band
	/// Owner: Service Analytics · Status: active · Actions: X-R2.1, X-R2.2, X-R2.3, X-R2.4
	measure 'Utilization %' = DIVIDE ( SUM ( fact_workforce_management[Work Time Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Active vs available time: (Talk + Wrap) / (Talk + Wrap + Idle).
	/// Formula: (Talk + Wrap) / (Talk + Wrap + Idle).
	/// Grain: agent_day or queue_day · Unit: % · Good: within_target_band
	/// Owner: Service Analytics · Status: active · Actions: X-R2.1, X-R2.2
	measure 'Occupancy %' =
			VAR TalkMinutes =
				SUM ( fact_workforce_management[Talk Time Minutes] )
			VAR WrapMinutes =
				SUM ( fact_workforce_management[Wrap Time Minutes] )
			VAR IdleMinutes =
				SUM ( fact_workforce_management[Idle Time Minutes] )
			VAR ActiveMinutes =
				TalkMinutes + WrapMinutes
			VAR TotalAvailableMinutes =
				ActiveMinutes + IdleMinutes
			RETURN
				DIVIDE ( ActiveMinutes, TotalAvailableMinutes )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Overtime minutes / paid time minutes.
	/// Formula: Overtime hours divided by total hours.
	/// Grain: agent_day or region_week · Unit: % · Good: lower_is_better
	/// Owner: Service Analytics · Status: active · Actions: X-R2.1, X-R2.4
	measure 'Overtime %' = DIVIDE ( SUM ( fact_workforce_management[Overtime Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Shrinkage minutes / paid time minutes.
	/// Formula: Non-productive time divided by paid time.
	/// Grain: agent_day · Unit: % · Good: lower_is_better
	/// Owner: Service Analytics · Status: active · Actions: X-R2.3
	measure 'Shrinkage %' = DIVIDE ( SUM ( fact_workforce_management[Shrinkage Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// XD-003
	/// Gross Margin % (XD) - KPI-COM-013
	/// Gross Margin % used in Experience domain reporting and P&L reconciliation.
	measure 'Gross Margin % (XD)' =
			VAR NetSalesAmount =
				[Net Sales Amount (XD)]
			VAR GrossMarginAmount =
				NetSalesAmount - [Cost of Goods Sold Amount (XD)]
			RETURN
				DIVIDE ( GrossMarginAmount, NetSalesAmount )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Delta% Net Sales (XD) - KPI-COM-008
	/// Relative variance of Net Sales vs Last Year, Experience domain view.
	measure 'Delta% Net Sales (XD)' =
			VAR ActualNetSales =
				[Net Sales Amount (XD)]
			VAR LastYearNetSales =
				SUM ( fact_sales[Last Year Sales Amount] )
			VAR NetSalesDelta =
				ActualNetSales - LastYearNetSales
			RETURN
				DIVIDE ( NetSalesDelta, LastYearNetSales )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// CLV - KPI-CUS-001
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investme...
	measure 'CLV' =
			VAR HorizonYears = 3
			RETURN
				AVERAGEX (
					VALUES ( fact_sales[CustomerKey] ),
					CALCULATE ( [Net Sales Amount (XD)] - [Cost of Goods Sold Amount (XD)] ) * HorizonYears
				)
		formatString: "#,0.00"
		displayFolder: "XD-003"


	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	/// Formula: AVERAGEX ( VALUES ( fact_customer_value[CustomerKey] ), CALCULATE ( SUM ( fact_customer_value[CLV Amount] ) ) )
	/// Grain: customer · Unit: EUR · Good: higher_is_better
	/// Owner: Commercial BI · Status: active · Actions: C-C3.1
	measure 'CLV (Customer Lifetime Value)' = [CLV]
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// DSO Days (XD) - receivables days estimate for CCC cross-domain view
	measure 'DSO Days (XD)' =
			VAR AccountsReceivableProxy =
				SUM ( fact_sales[Net Sales Amount] ) * 0.12
			VAR NetSalesAmount =
				SUM ( fact_sales[Net Sales Amount] )
			VAR AnnualizedReceivables =
				AccountsReceivableProxy * 365
			RETURN
				DIVIDE ( AnnualizedReceivables, NetSalesAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// DIO Days (XD) - inventory days estimate for CCC cross-domain view
	measure 'DIO Days (XD)' =
			VAR InventoryProxy =
				SUM ( fact_sales[Cost of Goods Sold Amount] ) * 0.15
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_sales[Cost of Goods Sold Amount] )
			VAR AnnualizedInventory =
				InventoryProxy * 365
			RETURN
				DIVIDE ( AnnualizedInventory, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// DPO Days (XD) - payables days estimate for CCC cross-domain view
	measure 'DPO Days (XD)' =
			VAR AccountsPayableProxy =
				SUM ( fact_sales[Cost of Goods Sold Amount] ) * 0.08
			VAR CostOfGoodsSoldAmount =
				SUM ( fact_sales[Cost of Goods Sold Amount] )
			VAR AnnualizedPayables =
				AccountsPayableProxy * 365
			RETURN
				DIVIDE ( AnnualizedPayables, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// First Pass Yield % (XD) - delivery quality proxy via fulfillment in-full rate
	measure 'First Pass Yield % (XD)' =
			VAR InFullDeliveries =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[In-Full Flag] = TRUE() )
			VAR TotalDeliveries =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( InFullDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Revenue at Risk Amount (XD) - KPI-OPS-001
	/// Net Sales Amount weighted by average of OTIF failure rate and First Pass Yield failure rate.
	measure 'Revenue at Risk Amount (XD)' =
			VAR OTIFFailureRate =
				1 - [OTIF % (XD)]
			VAR FirstPassYieldFailureRate =
				1 - [First Pass Yield % (XD)]
			VAR CombinedRiskFactor =
				DIVIDE ( OTIFFailureRate + FirstPassYieldFailureRate, 2 )
			VAR NetSalesAmount =
				SUM ( fact_sales[Net Sales Amount] )
			RETURN
				NetSalesAmount * CombinedRiskFactor
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// Aggregated cash conversion cycle derived from DSO, DIO, and DPO measures.
	/// Formula: DSO + DIO - DPO.
	/// Good: lower_is_better
	/// Owner: Finance BI · Status: active
	measure 'Cash Conversion Cycle (Days)' =
			VAR DaysSalesOutstanding =
				[DSO Days (XD)]
			VAR DaysInventoryOutstanding =
				[DIO Days (XD)]
			VAR DaysPayablesOutstanding =
				[DPO Days (XD)]
			RETURN
				DaysSalesOutstanding + DaysInventoryOutstanding - DaysPayablesOutstanding
		formatString: "0"
		displayFolder: "XD-003"

	/// Alias for Digital Adoption % (TMDL display name).
	/// Formula: Alias for Digital Adoption % (TMDL display name).
	/// Good: higher_is_better
	/// Owner: Innovation Analytics · Status: active
	measure 'Digital Adoption Rate %' = VAR _pending = "Requires fact_it Digital Users and fact_hr Total Headcount (not yet in data contracts)" RETURN BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Average attrition risk for the selected population.
	/// Formula: Probability of attrition for the selected population in the period.
	/// Grain: month · Unit: % · Good: lower_is_better
	/// Owner: Innovation Analytics · Status: active
	measure 'Attrition Risk %' = VAR _pending = "Requires predictive attrition model output table (not yet in data contracts)" RETURN BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Count of routed action instances.
	/// Formula: Count of routed action instances in the period.
	/// Grain: action_instance · Unit: count
	/// Owner: Executive Office · Status: active · Actions: X-E3.3
	measure 'Actions Routed Count' = COUNTROWS ( fact_action_log )
		formatString: "#,0"
		displayFolder: "XD-003"

	/// Action Outcome Rate % - KPI-GOV-001
	/// Measures share of actions that achieved the intended outcome.
	measure 'Action Outcome Rate % (XD Log)' =
			VAR AchievedActions =
				CALCULATE ( COUNTROWS ( fact_action_log ), fact_action_log[Outcome Status] = "Achieved" )
			VAR TotalActions =
				COUNTROWS ( fact_action_log )
			RETURN
				DIVIDE ( AchievedActions, TotalActions )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Composite enterprise risk index based on domain signals.
	/// Formula: Weighted index of normalized domain risk signals.
	/// Grain: entity_month · Unit: index · Good: lower_is_better
	/// Owner: Risk Analytics · Status: active · Actions: X-E3.2
	measure 'Enterprise Value-at-Risk Index' =
			VAR RevenueAtRiskShare =
				DIVIDE ( [Revenue at Risk Amount (XD)], [Net Sales Amount (XD)] )
			VAR DeliveryRisk =
				1 - [OTIF % (XD)]
			VAR QualityRisk =
				1 - [First Pass Yield % (XD)]
			VAR AverageRisk =
				DIVIDE ( RevenueAtRiskShare + DeliveryRisk + QualityRisk, 3 )
			RETURN
				ROUND ( AverageRisk * 100, 0 )
		formatString: "0"
		displayFolder: "XD-003"

	/// Cost of Goods Sold Amount (XD) - KPI-FIN-011
	/// Total cost of goods sold; base measure for Experience domain margin calculations.
	measure 'Cost of Goods Sold Amount (XD)' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// Net Sales Amount - KPI-COM-005
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount (XD)' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// OTIF % - KPI-SCM-007
	/// Measures share of orders delivered on time and in full.
	measure 'OTIF % (XD)' =
			VAR OTIFFulfillments =
				CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
			VAR TotalFulfillments =
				COUNTROWS ( fact_fulfillment )
			RETURN
				DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// ActionReady Logic
	/// ActionReady Logic: X-R2.1
	measure 'Action_X-R2.1_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s0 = _ende - WEEKDAY ( _ende, 2 ) + 1 VAR _e0 = _s0 + 6 VAR _s1 = _s0 - 7 VAR _e1 = _e0 - 7 VAR _v0 = CALCULATE ( [Utilization %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _v0_1 = CALCULATE ( [Utilization %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _g_1 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.6 || _v0 > 0.95 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.6 || _v0_1 > 0.95 ) && _g_1 >= 200 ), "🔴 L3 — X-R2.1 — Resource Utilization Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_workforce_management | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained utilization band violations for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant utilization driver for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW utilization for this queue weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.65 || _v0 > 0.9 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.65 || _v0_1 > 0.9 ) && _g_1 >= 200 ), "🟠 L2 — X-R2.1 — Resource Utilization Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_workforce_management | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained utilization band violations for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant utilization driver for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW utilization for this queue weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.7 || _v0 > 0.85 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.7 || _v0_1 > 0.85 ) && _g_1 >= 200 ), "🟡 L1 — X-R2.1 — Resource Utilization Orchestration" & UNICHAR ( 10 ) & "Owner: head_of_workforce_management | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ DETECT sustained utilization band violations for this queue" & UNICHAR ( 10 ) & "→ DIAGNOSE the dominant utilization driver for this queue" & UNICHAR ( 10 ) & "→ ACTIVATE the corresponding execution Action Code for this queue" & UNICHAR ( 10 ) & "→ REVIEW utilization for this queue weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_workforce_management"
		annotation ActionReady_ActionCodeId = "X-R2.1"

	/// ActionReady Logic: X-R2.2
	measure 'Action_X-R2.2_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s0 = _ende VAR _e0 = _ende VAR _s1 = _s0 - 1 VAR _e1 = _e0 - 1 VAR _s2 = _s0 - 2 VAR _e2 = _e0 - 2 VAR _v0 = CALCULATE ( [Utilization %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _v0_1 = CALCULATE ( [Utilization %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _v0_2 = CALCULATE ( [Utilization %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s2, 'dim_date'[Date] <= _e2 ) VAR _g = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _g_1 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g_2 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s2, 'dim_date'[Date] <= _e2 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.63 || _v0 > 0.95 ) && _g >= 150 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.63 || _v0_1 > 0.95 ) && _g_1 >= 150 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.63 || _v0_2 > 0.95 ) && _g_2 >= 150 ), "🔴 L3 — X-R2.2 — Capacity Reallocation & Load Balancing" & UNICHAR ( 10 ) & "Owner: workforce_management_lead | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues with sustained utilization imbalance" & UNICHAR ( 10 ) & "→ REALLOCATE capacity across queues or channels for this queue cluster" & UNICHAR ( 10 ) & "→ VALIDATE SLA and backlog impact for this queue daily", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.68 || _v0 > 0.9 ) && _g >= 150 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.68 || _v0_1 > 0.9 ) && _g_1 >= 150 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.68 || _v0_2 > 0.9 ) && _g_2 >= 150 ), "🟠 L2 — X-R2.2 — Capacity Reallocation & Load Balancing" & UNICHAR ( 10 ) & "Owner: workforce_management_lead | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues with sustained utilization imbalance" & UNICHAR ( 10 ) & "→ REALLOCATE capacity across queues or channels for this queue cluster" & UNICHAR ( 10 ) & "→ VALIDATE SLA and backlog impact for this queue daily", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 < 0.72 || _v0 > 0.85 ) && _g >= 150 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 < 0.72 || _v0_1 > 0.85 ) && _g_1 >= 150 ) && ( NOT ISBLANK ( _v0_2 ) && ( _v0_2 < 0.72 || _v0_2 > 0.85 ) && _g_2 >= 150 ), "🟡 L1 — X-R2.2 — Capacity Reallocation & Load Balancing" & UNICHAR ( 10 ) & "Owner: workforce_management_lead | " & FORMAT ( _v0, "0.0%" ) & " (" & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues with sustained utilization imbalance" & UNICHAR ( 10 ) & "→ REALLOCATE capacity across queues or channels for this queue cluster" & UNICHAR ( 10 ) & "→ VALIDATE SLA and backlog impact for this queue daily", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "workforce_management_lead"
		annotation ActionReady_ActionCodeId = "X-R2.2"

	/// ActionReady Logic: X-R2.3
	measure 'Action_X-R2.3_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s0 = _ende - WEEKDAY ( _ende, 2 ) + 1 VAR _e0 = _s0 + 6 VAR _s1 = _s0 - 7 VAR _e1 = _e0 - 7 VAR _v0 = CALCULATE ( [Shrinkage %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _v0_1 = CALCULATE ( [Shrinkage %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s0, 'dim_date'[Date] <= _e0 ) VAR _g_1 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.35 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.35 ) && _g_1 >= 200 ), "🔴 L3 — X-R2.3 — Shrinkage & Productive Time Control" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues or agent groups with elevated shrinkage" & UNICHAR ( 10 ) & "→ ANALYSE dominant shrinkage categories for this queue or agent group" & UNICHAR ( 10 ) & "→ ADJUST planning, adherence, or scheduling practices for this queue or agent group" & UNICHAR ( 10 ) & "→ MONITOR shrinkage and utilization for this queue or agent group weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.3 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.3 ) && _g_1 >= 200 ), "🟠 L2 — X-R2.3 — Shrinkage & Productive Time Control" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues or agent groups with elevated shrinkage" & UNICHAR ( 10 ) & "→ ANALYSE dominant shrinkage categories for this queue or agent group" & UNICHAR ( 10 ) & "→ ADJUST planning, adherence, or scheduling practices for this queue or agent group" & UNICHAR ( 10 ) & "→ MONITOR shrinkage and utilization for this queue or agent group weekly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.25 ) && _g >= 200 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.25 ) && _g_1 >= 200 ), "🟡 L1 — X-R2.3 — Shrinkage & Productive Time Control" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & " (week of " & FORMAT ( _s0, "yyyy-mm-dd" ) & ")" & UNICHAR ( 10 ) & "→ IDENTIFY queues or agent groups with elevated shrinkage" & UNICHAR ( 10 ) & "→ ANALYSE dominant shrinkage categories for this queue or agent group" & UNICHAR ( 10 ) & "→ ADJUST planning, adherence, or scheduling practices for this queue or agent group" & UNICHAR ( 10 ) & "→ MONITOR shrinkage and utilization for this queue or agent group weekly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "service_operations_manager"
		annotation ActionReady_ActionCodeId = "X-R2.3"

	/// ActionReady Logic: X-R2.4
	measure 'Action_X-R2.4_Text' = VAR _ende = MAX ( 'dim_date'[Date] ) VAR _s1 = DATE ( YEAR ( _ende ), MONTH ( _ende ) - 1, 1 ) VAR _e1 = EOMONTH ( _s1, 0 ) VAR _v0 = [Overtime %] VAR _v0_1 = CALCULATE ( [Overtime %], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) VAR _g = [Tickets Created Count] VAR _g_1 = CALCULATE ( [Tickets Created Count], REMOVEFILTERS ( 'dim_date' ), 'dim_date'[Date] >= _s1, 'dim_date'[Date] <= _e1 ) RETURN IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.18 ) && _g >= 500 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.18 ) && _g_1 >= 500 ), "🔴 L3 — X-R2.4 — Overtime & Fatigue Containment" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY queues with recurring overtime" & UNICHAR ( 10 ) & "→ ANALYSE root causes (demand spikes, misallocation, shrinkage) for this queue" & UNICHAR ( 10 ) & "→ ADJUST schedules, REALLOCATE capacity, or CORRECT planning gaps for this queue" & UNICHAR ( 10 ) & "→ REVIEW overtime and SLA for this queue monthly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.12 ) && _g >= 500 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.12 ) && _g_1 >= 500 ), "🟠 L2 — X-R2.4 — Overtime & Fatigue Containment" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY queues with recurring overtime" & UNICHAR ( 10 ) & "→ ANALYSE root causes (demand spikes, misallocation, shrinkage) for this queue" & UNICHAR ( 10 ) & "→ ADJUST schedules, REALLOCATE capacity, or CORRECT planning gaps for this queue" & UNICHAR ( 10 ) & "→ REVIEW overtime and SLA for this queue monthly", IF ( ( NOT ISBLANK ( _v0 ) && ( _v0 > 0.08 ) && _g >= 500 ) && ( NOT ISBLANK ( _v0_1 ) && ( _v0_1 > 0.08 ) && _g_1 >= 500 ), "🟡 L1 — X-R2.4 — Overtime & Fatigue Containment" & UNICHAR ( 10 ) & "Owner: service_operations_manager | " & FORMAT ( _v0, "0.0%" ) & UNICHAR ( 10 ) & "→ IDENTIFY queues with recurring overtime" & UNICHAR ( 10 ) & "→ ANALYSE root causes (demand spikes, misallocation, shrinkage) for this queue" & UNICHAR ( 10 ) & "→ ADJUST schedules, REALLOCATE capacity, or CORRECT planning gaps for this queue" & UNICHAR ( 10 ) & "→ REVIEW overtime and SLA for this queue monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "service_operations_manager"
		annotation ActionReady_ActionCodeId = "X-R2.4"

	/// ActionReady Logic: X-E3.2
	measure 'Action_X-E3.2_Text' = IF ( [Enterprise Value-at-Risk Index] > 0.7, "🔴 L3 — X-E3.2 — Cross-Domain Risk Prioritisation" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Enterprise Value-at-Risk Index], "0.000" ) & UNICHAR ( 10 ) & "→ Identify highest-risk KPIs — Escalate to steering — Review risk index monthly", IF ( [Enterprise Value-at-Risk Index] > 0.5, "🟠 L2 — X-E3.2 — Cross-Domain Risk Prioritisation" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Enterprise Value-at-Risk Index], "0.000" ) & UNICHAR ( 10 ) & "→ Identify highest-risk KPIs — Escalate to steering — Review risk index monthly", IF ( [Enterprise Value-at-Risk Index] > 0.3, "🟡 L1 — X-E3.2 — Cross-Domain Risk Prioritisation" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Enterprise Value-at-Risk Index], "0.000" ) & UNICHAR ( 10 ) & "→ Identify highest-risk KPIs — Escalate to steering — Review risk index monthly", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_enterprise_controlling"
		annotation ActionReady_ActionCodeId = "X-E3.2"

	/// ActionReady Logic: X-E3.3
	measure 'Action_X-E3.3_Text' = IF ( [Action Effectiveness Delta] < -0.3, "🔴 L3 — X-E3.3 — Strategy Execution Monitoring" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Action Effectiveness Delta], "+0.000;-0.000" ) & UNICHAR ( 10 ) & "→ Identify underperforming actions — Review execution quality — Escalate failures", IF ( [Action Effectiveness Delta] < -0.2, "🟠 L2 — X-E3.3 — Strategy Execution Monitoring" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Action Effectiveness Delta], "+0.000;-0.000" ) & UNICHAR ( 10 ) & "→ Identify underperforming actions — Review execution quality — Escalate failures", IF ( [Action Effectiveness Delta] < -0.1, "🟡 L1 — X-E3.3 — Strategy Execution Monitoring" & UNICHAR ( 10 ) & "Owner: head_of_enterprise_controlling | " & FORMAT ( [Action Effectiveness Delta], "+0.000;-0.000" ) & UNICHAR ( 10 ) & "→ Identify underperforming actions — Review execution quality — Escalate failures", BLANK () ) ) )
		formatString: @
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "chief_of_staff_pmo_lead"
		annotation ActionReady_ActionCodeId = "X-E3.3"
