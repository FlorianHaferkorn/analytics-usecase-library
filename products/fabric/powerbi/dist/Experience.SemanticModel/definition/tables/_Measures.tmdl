/// Consolidated Measures for: XD-001, XD-002, XD-003 (Experience)
table _Measures

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table[Column1 = text], {})
			in
				Source

	/// enterprise.actions_executed.count - Actions Executed Count
	/// Number of action codes with a recorded outcome in fact_action_outcome.
	measure 'Actions Executed Count (XD)' = COUNTROWS ( FILTER ( fact_action_outcome, NOT ISBLANK ( fact_action_outcome[outcome_status] ) ) )
		formatString: #,0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Percentage of executed actions with a confirmed achieved outcome.
	measure 'Action Outcome Rate % (XD)' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_action_outcome ), fact_action_outcome[outcome_status] = "achieved" ), COUNTROWS ( fact_action_outcome ) )
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	/// enterprise.avg_time_to_outcome.days - Avg Time-to-Outcome Days
	/// Average days between action execution and outcome confirmation.
	measure 'Avg Time-to-Outcome Days (XD)' = AVERAGEX ( fact_action_outcome, fact_action_outcome[days_to_outcome] )
		formatString: #,0.0
		displayFolder: "8_Action_Outcomes"

	/// enterprise.action_roi.pct - Action ROI %
	/// Average ROI of executed actions: total impact value / total execution cost - 1.
	measure 'Action ROI % (XD)' = DIVIDE ( SUMX ( fact_action_outcome, fact_action_outcome[impact_value] ), SUMX ( fact_action_outcome, fact_action_outcome[cost_to_execute] ) ) - 1
		formatString: 0.0%
		displayFolder: "8_Action_Outcomes"

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// XD-001
	/// SLA Attainment % - svc.sla.attainment.pct
	/// Measures how many cases meet the committed SLA.
	measure 'SLA Attainment %' =
		VAR CasesWithinSla =
			CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[SLA Met Flag] = TRUE() )
		VAR TotalCases =
			COUNTROWS ( fact_support_cases )
		RETURN
			DIVIDE ( CasesWithinSla, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// FCR % - svc.fcr.pct
	/// Shows the share of cases solved on first contact.
	measure 'FCR %' =
		VAR FirstContactResolvedCases =
			CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[FCR Flag] = TRUE() )
		VAR TotalCases =
			COUNTROWS ( fact_support_cases )
		RETURN
			DIVIDE ( FirstContactResolvedCases, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// AHT Minutes - svc.aht.minutes
	/// Measures average time to handle a contact.
	measure 'AHT Minutes' = DIVIDE ( SUM ( fact_support_cases[Handle Time Minutes] ), COUNTROWS ( fact_support_cases ) )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Backlog Count - svc.backlog.count
	/// Quantifies unresolved work in queue.
	measure 'Backlog Count' =
		VAR BacklogCases =
			CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Backlog Flag] = TRUE() )
		RETURN
			BacklogCases
		formatString: "#,0"
		displayFolder: "XD-001"

	/// NPS Index (Service) - svc.nps.index
	/// Measures customer advocacy and experience quality.
	measure 'NPS Index (Service)' =
		VAR Promoters =
			CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] >= 9 )
		VAR Detractors =
			CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[NPS Score] <= 6 )
		VAR TotalResponses =
			COUNTROWS ( fact_nps )
		VAR NetPromoterShare =
			DIVIDE ( Promoters - Detractors, TotalResponses )
		RETURN
			ROUND ( NetPromoterShare * 100, 0 )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Escalation % - svc.escalation.pct
	/// Measures frequency of escalated cases.
	measure 'Escalation %' =
		VAR EscalatedCases =
			CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Escalation Flag] = TRUE() )
		VAR TotalCases =
			COUNTROWS ( fact_support_cases )
		RETURN
			DIVIDE ( EscalatedCases, TotalCases )
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// Tickets Created Count - svc.tickets.created.count
	/// Counts customer service tickets created in the period.
	measure 'Tickets Created Count' = COUNTROWS ( fact_support_cases )
		formatString: "#,0"
		displayFolder: "XD-001"

	/// Tickets Closed Count - svc.tickets.closed.count
	/// Counts customer service tickets closed in the period.
	measure 'Tickets Closed Count' =
		VAR ClosedTickets =
			CALCULATE ( COUNTROWS ( fact_support_cases ), fact_support_cases[Open Case Flag] = FALSE() )
		RETURN
			ClosedTickets
		formatString: "#,0"
		displayFolder: "XD-001"

	/// XD-002
	/// Utilization % - res.utilization.pct
	/// Measures productive time versus paid time for agents.
	measure 'Utilization %' = DIVIDE ( SUM ( fact_workforce_management[Work Time Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Occupancy % - res.occupancy.pct
	/// Measures active vs idle share of time.
	measure 'Occupancy %' =
		VAR TalkMinutes =
			SUM ( fact_workforce_management[Talk Time Minutes] )
		VAR WrapMinutes =
			SUM ( fact_workforce_management[Wrap Time Minutes] )
		VAR IdleMinutes =
			SUM ( fact_workforce_management[Idle Time Minutes] )
		VAR ActiveMinutes =
			TalkMinutes + WrapMinutes
		VAR TotalAvailableMinutes =
			ActiveMinutes + IdleMinutes
		RETURN
			DIVIDE ( ActiveMinutes, TotalAvailableMinutes )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Overtime % - res.overtime.pct
	/// Shows overtime share of total hours.
	measure 'Overtime %' = DIVIDE ( SUM ( fact_workforce_management[Overtime Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// Shrinkage % - res.shrinkage.pct
	/// Measures non-productive share of paid time.
	measure 'Shrinkage %' = DIVIDE ( SUM ( fact_workforce_management[Shrinkage Minutes] ), SUM ( fact_workforce_management[Paid Time Minutes] ) )
		formatString: "0.0%"
		displayFolder: "XD-002"

	/// XD-003
	/// Gross Margin % - margin.gm.pct
	/// Gross Margin % used in commercial and management reporting and P&L reconciliation.
	measure 'Gross Margin %' =
		VAR NetSalesAmount =
			[Net Sales Amount (XD)]
		VAR GrossMarginAmount =
			NetSalesAmount - [Cost of Goods Sold Amount]
		RETURN
			DIVIDE ( GrossMarginAmount, NetSalesAmount )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Delta% Net Sales - sales.net_sales.delta_pct.ly
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' =
		VAR ActualNetSales =
			[Net Sales Amount (XD)]
		VAR LastYearNetSales =
			SUM ( fact_sales[Last Year Sales Amount] )
		VAR NetSalesDelta =
			ActualNetSales - LastYearNetSales
		RETURN
			DIVIDE ( NetSalesDelta, LastYearNetSales )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// CLV - crm.clv.amount
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investme...
	measure 'CLV' =
		VAR HorizonYears = 3
		RETURN
			AVERAGEX (
				VALUES ( fact_sales[CustomerKey] ),
				CALCULATE ( [Net Sales Amount (XD)] - [Cost of Goods Sold Amount] ) * HorizonYears
			)
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// Ops OTIF % - ops.otif.pct
	/// Delivery reliability measured by orders delivered on-time and in-full.
	measure 'Ops OTIF %' =
		VAR OTIFFulfillments =
			CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
		VAR TotalFulfillments =
			COUNTROWS ( fact_fulfillment )
		RETURN
			DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// DSO Days (XD) - receivables days estimate for CCC cross-domain view
	/// Cross-domain proxy: canonical measure lives in Finance.SemanticModel.
	measure 'DSO Days (XD)' =
		VAR AccountsReceivableProxy =
			SUM ( fact_sales[Net Sales Amount] ) * 0.12
		VAR NetSalesAmount =
			SUM ( fact_sales[Net Sales Amount] )
		VAR AnnualizedReceivables =
			AccountsReceivableProxy * 365
		RETURN
			DIVIDE ( AnnualizedReceivables, NetSalesAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// DIO Days (XD) - inventory days estimate for CCC cross-domain view
	/// Cross-domain proxy: canonical measure lives in Finance.SemanticModel.
	measure 'DIO Days (XD)' =
		VAR InventoryProxy =
			SUM ( fact_sales[Cost of Goods Sold Amount] ) * 0.15
		VAR CostOfGoodsSoldAmount =
			SUM ( fact_sales[Cost of Goods Sold Amount] )
		VAR AnnualizedInventory =
			InventoryProxy * 365
		RETURN
			DIVIDE ( AnnualizedInventory, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// DPO Days (XD) - payables days estimate for CCC cross-domain view
	/// Cross-domain proxy: canonical measure lives in Finance.SemanticModel.
	measure 'DPO Days (XD)' =
		VAR AccountsPayableProxy =
			SUM ( fact_sales[Cost of Goods Sold Amount] ) * 0.08
		VAR CostOfGoodsSoldAmount =
			SUM ( fact_sales[Cost of Goods Sold Amount] )
		VAR AnnualizedPayables =
			AccountsPayableProxy * 365
		RETURN
			DIVIDE ( AnnualizedPayables, CostOfGoodsSoldAmount )
		formatString: "0"
		displayFolder: "XD-003"

	/// First Pass Yield % (XD) - delivery quality proxy via fulfillment in-full rate
	/// Cross-domain proxy: canonical measure lives in Operations.SemanticModel.
	measure 'First Pass Yield % (XD)' =
		VAR InFullDeliveries =
			CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[In-Full Flag] = TRUE() )
		VAR TotalDeliveries =
			COUNTROWS ( fact_fulfillment )
		RETURN
			DIVIDE ( InFullDeliveries, TotalDeliveries )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Revenue at Risk Amount - crm.revenue_at_risk.amount
	/// Net Sales Amount weighted by average of OTIF failure rate and First Pass Yield failure rate.
	measure 'Revenue at Risk Amount' =
		VAR OTIFFailureRate =
			1 - [Ops OTIF %]
		VAR FirstPassYieldFailureRate =
			1 - [First Pass Yield % (XD)]
		VAR CombinedRiskFactor =
			DIVIDE ( OTIFFailureRate + FirstPassYieldFailureRate, 2 )
		VAR NetSalesAmount =
			SUM ( fact_sales[Net Sales Amount] )
		RETURN
			NetSalesAmount * CombinedRiskFactor
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// Cash Conversion Cycle (Days) - ops.working_capital.ccc.days
	/// Combines receivables, inventory, and payables days to show cash efficiency.
	measure 'Cash Conversion Cycle (Days)' =
		VAR DaysSalesOutstanding =
			[DSO Days (XD)]
		VAR DaysInventoryOutstanding =
			[DIO Days (XD)]
		VAR DaysPayablesOutstanding =
			[DPO Days (XD)]
		RETURN
			DaysSalesOutstanding + DaysInventoryOutstanding - DaysPayablesOutstanding
		formatString: "0"
		displayFolder: "XD-003"

	/// Digital Adoption Rate % - people.digital_adoption.pct
	/// Measure how much of all eligible process transactions are executed via digital tools instead of m...
	measure 'Digital Adoption Rate %' = VAR _pending = "Requires fact_it Digital Users and fact_hr Total Headcount (not yet in data contracts)" RETURN BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Attrition Risk % - people.attrition_risk.pct
	/// Probability of employee attrition
	measure 'Attrition Risk %' = VAR _pending = "Requires predictive attrition model output table (not yet in data contracts)" RETURN BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Actions Routed Count - enterprise.action_routed.count
	/// Counts action codes routed for execution.
	measure 'Actions Routed Count' = COUNTROWS ( fact_action_log )
		formatString: "#,0"
		displayFolder: "XD-003"

	/// Action Outcome Rate % (XD Log) - enterprise.action_outcome_rate.pct
	/// Cross-domain proxy: action outcome rate sourced from fact_action_log.
	/// Canonical measure lives in the domain that owns fact_action_outcome.
	measure 'Action Outcome Rate % (XD Log)' =
		VAR AchievedActions =
			CALCULATE ( COUNTROWS ( fact_action_log ), fact_action_log[Outcome Status] = "Achieved" )
		VAR TotalActions =
			COUNTROWS ( fact_action_log )
		RETURN
			DIVIDE ( AchievedActions, TotalActions )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// Enterprise Value-at-Risk Index - enterprise.value_at_risk.index
	/// Aggregates downside risk across domains into a single index.
	measure 'Enterprise Value-at-Risk Index' =
		VAR RevenueAtRiskShare =
			DIVIDE ( [Revenue at Risk Amount], [Net Sales Amount (XD)] )
		VAR DeliveryRisk =
			1 - [OTIF % (XD)]
		VAR QualityRisk =
			1 - [First Pass Yield % (XD)]
		VAR AverageRisk =
			DIVIDE ( RevenueAtRiskShare + DeliveryRisk + QualityRisk, 3 )
		RETURN
			ROUND ( AverageRisk * 100, 0 )
		formatString: "0"
		displayFolder: "XD-003"

	/// Cost of Goods Sold Amount - cost.cogs.amount
	/// Total cost of goods sold; base measure for margin and PVM.
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// Net Sales Amount (XD) - sales.net_sales.amount cross-domain proxy
	/// Cross-domain proxy: canonical measure lives in Commercial.SemanticModel.
	measure 'Net Sales Amount (XD)' = SUM ( fact_sales[Net Sales Amount] )
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// OTIF % (XD) - supply.otif.pct cross-domain proxy
	/// Cross-domain proxy: canonical measure lives in SupplyChain.SemanticModel.
	measure 'OTIF % (XD)' =
		VAR OTIFFulfillments =
			CALCULATE ( COUNTROWS ( fact_fulfillment ), fact_fulfillment[OTIF Flag] = TRUE() )
		VAR TotalFulfillments =
			COUNTROWS ( fact_fulfillment )
		RETURN
			DIVIDE ( OTIFFulfillments, TotalFulfillments )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// ActionReady Logic
	/// ActionReady Logic: X-R2.1
	measure 'Action_X-R2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_workforce_management" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_workforce_management"
		annotation ActionReady_ActionCodeId = "X-R2.1"

	/// ActionReady Logic: X-R2.2
	measure 'Action_X-R2.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: workforce_management_lead" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "workforce_management_lead"
		annotation ActionReady_ActionCodeId = "X-R2.2"

	/// ActionReady Logic: X-R2.3
	measure 'Action_X-R2.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: service_operations_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "service_operations_manager"
		annotation ActionReady_ActionCodeId = "X-R2.3"

	/// ActionReady Logic: X-R2.4
	measure 'Action_X-R2.4_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: service_operations_manager" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "service_operations_manager"
		annotation ActionReady_ActionCodeId = "X-R2.4"

	/// ActionReady Logic: X-E3.2
	measure 'Action_X-E3.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: head_of_enterprise_controlling" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "head_of_enterprise_controlling"
		annotation ActionReady_ActionCodeId = "X-E3.2"

	/// ActionReady Logic: X-E3.3
	measure 'Action_X-E3.3_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: chief_of_staff_pmo_lead" & UNICHAR(10) & "Steps:"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "chief_of_staff_pmo_lead"
		annotation ActionReady_ActionCodeId = "X-E3.3"
