/// NPS survey facts (score per survey response)
table fact_nps
	lineageTag: d19a9cd5-e967-5d2f-b7e9-b2d0c7113e64
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column QueueKey
		dataType: Int64
		sourceColumn: QueueKey
		summarizeBy: none
	column 'NPS Score'
		dataType: Int64
		sourceColumn: NPS Score
		summarizeBy: none
	partition fact_nps = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_nps"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
