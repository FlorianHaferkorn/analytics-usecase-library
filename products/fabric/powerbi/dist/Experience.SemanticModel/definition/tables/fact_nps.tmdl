/// NPS survey facts (score per survey response)
table fact_nps
	lineageTag: d19a9cd5-e967-5d2f-b7e9-b2d0c7113e64
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column QueueKey
		dataType: Int64
		isHidden
		sourceColumn: QueueKey
		summarizeBy: none
	column 'NPS Score'
		dataType: Int64
		sourceColumn: NPS Score
		summarizeBy: none
	partition fact_nps = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_nps"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
