/// Action routing log — action code executions with outcome tracking for enterprise KPI monitoring.
table fact_action_log
	lineageTag: c1f4d892-7b3e-4a18-b9c0-e5d2f8a31074
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Action Code'
		dataType: String
		sourceColumn: Action Code
		summarizeBy: none
	column 'Outcome Status'
		dataType: String
		sourceColumn: Outcome Status
		summarizeBy: none
	column 'Responsible Role'
		dataType: String
		sourceColumn: Responsible Role
		summarizeBy: none
	partition fact_action_log = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_action_log"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
