/// Action routing log — action code executions with outcome tracking for enterprise KPI monitoring.
table fact_action_log
	lineageTag: c1f4d892-7b3e-4a18-b9c0-e5d2f8a31074
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column 'Action Code'
		dataType: String
		sourceColumn: Action Code
		summarizeBy: none
	column 'Outcome Status'
		dataType: String
		sourceColumn: Action Outcome
		summarizeBy: none
	column 'Responsible Role'
		dataType: String
		sourceColumn: Responsible Role
		summarizeBy: none
	partition fact_action_log = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_action_log"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
