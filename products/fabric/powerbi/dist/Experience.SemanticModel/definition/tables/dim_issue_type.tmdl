/// Issue type dimension (type, severity) for case classification
table dim_issue_type
	lineageTag: b2086640-6aee-5744-906c-da5d5c19b548
	column IssueKey
		dataType: Int64
		sourceColumn: IssueKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false
	column IssueType
		dataType: String
		sourceColumn: IssueType
		summarizeBy: none
	column Severity
		dataType: String
		sourceColumn: Severity
		summarizeBy: none
	partition dim_issue_type = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/dimensions/dim_issue_type"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
