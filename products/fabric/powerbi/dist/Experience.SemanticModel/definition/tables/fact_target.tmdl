/// Purpose: Ziel- und Planwerte je KPI und Monat, vom Kunden beim Onboarding geliefert (R6.1).
/// Leer, solange keine Werte vorliegen: dann zeigt der Report keine Ziellinie statt einer erfundenen.
/// Werte in der Skala der Measure (Prozent als Anteil). Erzeugt von tooling/codegen/comparison_measures.py.
table fact_target
	lineageTag: 683c5ef0-9918-5ba4-912c-4ca1f47fc7b9

	column kpi_id
		dataType: string
		isHidden
		lineageTag: 257c66b3-3db0-5cdd-9bc9-14802864faba
		summarizeBy: none
		sourceColumn: kpi_id

	column scenario
		dataType: string
		isHidden
		lineageTag: dd78d5ec-855b-5864-95ba-c58c742510d2
		summarizeBy: none
		sourceColumn: scenario

	column DateKey
		dataType: int64
		isHidden
		lineageTag: 74b59f39-0e1f-50d3-a6c4-a34f2f6acf43
		summarizeBy: none
		sourceColumn: DateKey

	column 'Target Value'
		dataType: double
		isHidden
		lineageTag: 7dbba07a-d563-5d6e-91b1-4629fcde09ad
		summarizeBy: none
		sourceColumn: Target Value

	partition fact_target = m
		mode: import
		source =
				let
					ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_target"),
					ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
				in
					ParquetData
