/// Support case facts (SLA met, FCR, handle time, escalation, backlog, open flag)
table fact_support_cases
	lineageTag: 75a4617a-8ba8-520a-86b7-92fd0ff154a6
	column DateKey
		dataType: Int64
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
	column QueueKey
		dataType: Int64
		sourceColumn: QueueKey
		summarizeBy: none
	column IssueKey
		dataType: Int64
		sourceColumn: IssueKey
		summarizeBy: none
	column 'SLA Met Flag'
		dataType: Boolean
		sourceColumn: SLA Met Flag
		summarizeBy: none
	column 'FCR Flag'
		dataType: Boolean
		sourceColumn: FCR Flag
		summarizeBy: none
	column 'Handle Time Minutes'
		dataType: Decimal
		sourceColumn: Handle Time Minutes
		summarizeBy: none
	column 'Escalation Flag'
		dataType: Boolean
		sourceColumn: Escalation Flag
		summarizeBy: none
	column 'Backlog Flag'
		dataType: Boolean
		sourceColumn: Backlog Flag
		summarizeBy: none
	column 'Open Case Flag'
		dataType: Boolean
		sourceColumn: Open Case Flag
		summarizeBy: none
	partition fact_support_cases = m
		mode: import
		source =
			let
				Source = Folder.Files(GoldDataPath & "/facts/fact_support_cases"),
				FilteredFiles = Table.SelectRows(Source, each Text.EndsWith([Name], ".parquet")),
				FirstFile = FilteredFiles{0}[Content],
				ParquetData = Parquet.Document(FirstFile)
			in
				ParquetData
