/// User-to-Org mapping table for Row-Level Security.
table security_user_org
	lineageTag: f8bfbc73-28f9-52c7-b7ee-c6b5a3174877

	column UserPrincipalName
		dataType: String
		sourceColumn: UserPrincipalName
		summarizeBy: none

	column OrgKey
		dataType: Int64
		sourceColumn: OrgKey
		summarizeBy: none
		isHidden
		isAvailableInMDX: false

	partition security_user_org = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/security_user_org"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
