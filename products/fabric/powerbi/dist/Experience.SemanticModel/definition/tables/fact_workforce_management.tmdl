/// Workforce management facts (work, paid, talk, wrap, idle, overtime, shrinkage) per agent-day
table fact_workforce_management
	lineageTag: 5d91568c-7a74-546e-8b46-78611de04414
	column DateKey
		dataType: Int64
		isHidden
		sourceColumn: DateKey
		summarizeBy: none
	column OrgKey
		dataType: Int64
		isHidden
		sourceColumn: OrgKey
		summarizeBy: none
	column QueueKey
		dataType: Int64
		isHidden
		sourceColumn: QueueKey
		summarizeBy: none
	column 'Work Time Minutes'
		dataType: Decimal
		sourceColumn: Work Time Minutes
		summarizeBy: none
	column 'Paid Time Minutes'
		dataType: Decimal
		sourceColumn: Paid Time Minutes
		summarizeBy: none
	column 'Talk Time Minutes'
		dataType: Decimal
		sourceColumn: Talk Time Minutes
		summarizeBy: none
	column 'Wrap Time Minutes'
		dataType: Decimal
		sourceColumn: Wrap Time Minutes
		summarizeBy: none
	column 'Idle Time Minutes'
		dataType: Decimal
		sourceColumn: Idle Time Minutes
		summarizeBy: none
	column 'Overtime Minutes'
		dataType: Decimal
		sourceColumn: Overtime Minutes
		summarizeBy: none
	column 'Shrinkage Minutes'
		dataType: Decimal
		sourceColumn: Shrinkage Minutes
		summarizeBy: none
	partition fact_workforce_management = m
		mode: import
		source =
			let
				ActiveFiles = fn_DeltaCurrentFiles(GoldDataPath & "/facts/fact_workforce_management"),
				ParquetData = Table.Combine(List.Transform(ActiveFiles[Content], each Parquet.Document(_)))
			in
				ParquetData
