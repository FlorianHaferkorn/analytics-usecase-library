{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fabric Parameter File",
  "description": "Best-effort schema for fabric-cicd parameter.yml. Structure may change with fabric-cicd updates.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "find_replace": {
      "type": "array",
      "description": "Find-and-replace operations",
      "items": {
        "type": "object",
        "required": ["find_value", "replace_value"],
        "properties": {
          "find_value": { "type": "string" },
          "replace_value": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            ]
          },
          "item_type": { "type": "string" },
          "item_name": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "file_path": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "is_regex": { "type": "string" }
        }
      }
    },
    "key_value_replace": {
      "type": "array",
      "description": "JSONPath key-value replacements",
      "items": {
        "type": "object",
        "required": ["find_key", "replace_value"],
        "properties": {
          "find_key": { "type": "string" },
          "replace_value": {},
          "item_type": { "type": "string" },
          "file_path": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "spark_pool": {
      "type": "array",
      "description": "Spark pool parameterization",
      "items": {
        "type": "object",
        "required": ["instance_pool_id", "replace_value"],
        "properties": {
          "instance_pool_id": { "type": "string" },
          "replace_value": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "item_name": { "type": "string" }
        }
      }
    },
    "semantic_model_binding": {
      "description": "Semantic model to connection binding. Current fabric-cicd format (>= 1.2.0) is an object with 'default' and/or 'models'; the former array format still works but fabric-cicd logs a deprecation warning.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "default": {
              "type": "object",
              "required": ["connection_id"],
              "properties": {
                "connection_id": { "$ref": "#/definitions/connectionIdByEnvironment" }
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["semantic_model_name", "connection_id"],
                "properties": {
                  "semantic_model_name": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                    ]
                  },
                  "connection_id": { "$ref": "#/definitions/connectionIdByEnvironment" }
                }
              }
            }
          }
        },
        {
          "type": "array",
          "description": "Deprecated format",
          "items": {
            "type": "object",
            "required": ["connection_id", "semantic_model_name"],
            "properties": {
              "connection_id": { "type": "string" },
              "semantic_model_name": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "connectionIdByEnvironment": {
      "type": "object",
      "description": "Environment key (or _ALL_) to one connection GUID or a list of GUIDs",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        ]
      }
    }
  }
}
