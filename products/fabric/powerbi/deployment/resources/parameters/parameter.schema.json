{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fabric Parameter File",
  "description": "Best-effort schema for fabric-cicd parameter.yml. Structure may change with fabric-cicd updates.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "find_replace": {
      "type": "array",
      "description": "Find-and-replace operations",
      "items": {
        "type": "object",
        "required": ["find_value", "replace_value"],
        "properties": {
          "find_value": { "type": "string" },
          "replace_value": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            ]
          },
          "item_type": { "type": "string" },
          "item_name": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "file_path": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "is_regex": { "type": "string" }
        }
      }
    },
    "key_value_replace": {
      "type": "array",
      "description": "JSONPath key-value replacements",
      "items": {
        "type": "object",
        "required": ["find_key", "replace_value"],
        "properties": {
          "find_key": { "type": "string" },
          "replace_value": {},
          "item_type": { "type": "string" },
          "file_path": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "spark_pool": {
      "type": "array",
      "description": "Spark pool parameterization",
      "items": {
        "type": "object",
        "required": ["instance_pool_id", "replace_value"],
        "properties": {
          "instance_pool_id": { "type": "string" },
          "replace_value": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "item_name": { "type": "string" }
        }
      }
    },
    "semantic_model_binding": {
      "type": "array",
      "description": "Semantic model to connection binding",
      "items": {
        "type": "object",
        "required": ["connection_id", "semantic_model_name"],
        "properties": {
          "connection_id": { "type": "string" },
          "semantic_model_name": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    }
  }
}
