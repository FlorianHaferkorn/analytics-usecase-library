{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionReady Tool Adapter Manifest v1",
  "description": "Versioned contract for tool-specific adapters. Used by internal adapter registry/marketplace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "name",
    "version",
    "compatibility",
    "capabilities",
    "commands"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+/[a-z0-9][a-z0-9-]*$",
      "description": "Reverse-DNS namespace + adapter slug, e.g. com.actionready/fabric-powerbi."
    },
    "name": { "type": "string", "minLength": 3 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "SemVer version for the adapter package."
    },
    "description": { "type": "string" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_ir_versions"],
      "properties": {
        "supported_core_schema_versions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional: compatible Core schema versions (e.g. UseCase_Bracket schema_version)."
        },
        "supported_ir_versions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Compatible IR major versions, e.g. [\"1.x\"]."
        },
        "supported_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tool version hints, e.g. [\"FabricAPI>=2025-12\", \"PowerBIDesktop>=2.130\"]."
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "validate", "deploy"],
      "properties": {
        "build": { "type": "boolean" },
        "validate": { "type": "boolean" },
        "deploy": { "type": "boolean" },
        "ops": { "type": "boolean" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "validate"],
      "properties": {
        "build": { "$ref": "#/$defs/command" },
        "validate": { "$ref": "#/$defs/command" },
        "deploy": { "$ref": "#/$defs/command" }
      }
    },
    "required_secrets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of secrets required for deploy/ops (resolved by runner; never stored in repo)."
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "High-level permission declarations (least privilege)."
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entrypoint"],
      "properties": {
        "type": { "type": "string", "enum": ["powershell", "python", "node", "docker", "mcp"] },
        "entrypoint": { "type": "string", "description": "Repo-relative command/script path or MCP server reference." },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

