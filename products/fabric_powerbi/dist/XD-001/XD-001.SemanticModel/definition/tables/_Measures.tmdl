/// XD-001 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// svc.sla.attainment.pct - SLA Attainment %
	/// Measures how many cases meet the committed SLA.
	measure 'SLA Attainment %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// svc.fcr.pct - FCR %
	/// Shows the share of cases solved on first contact.
	measure 'FCR %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-001"

	/// svc.aht.minutes - AHT Minutes
	/// Measures average time to handle a contact.
	measure 'AHT Minutes' =
			BLANK()
		formatString: "#,0"
		displayFolder: "XD-001"

	/// svc.backlog.count - Backlog Count
	/// Quantifies unresolved work in queue.
	measure 'Backlog Count' =
			BLANK()
		formatString: "#,0"
		displayFolder: "XD-001"

	/// svc.nps.index - NPS Index
	/// Measures customer advocacy and experience quality.
	measure 'NPS Index' =
			BLANK()
		formatString: "#,0"
		displayFolder: "XD-001"

	/// svc.escalation.pct - Escalation %
	/// Measures frequency of escalated cases.
	measure 'Escalation %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-001"
