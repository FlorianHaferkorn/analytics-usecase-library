/// OPS-003 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// quality.fpy.pct - First Pass Yield %
	/// Measures share of units produced without rework or scrap.
	measure 'First Pass Yield %' =
			VAR GoodUnits = SUM ( fact_quality[Good Units] )
			VAR TotalUnits = SUM ( fact_quality[Total Units] )
			RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// quality.scrap.pct - Scrap Rate %
	/// Measures share of units scrapped in production.
	measure 'Scrap Rate %' =
			VAR ScrapUnits = SUM ( fact_quality[Scrap Units] )
			VAR TotalUnits = SUM ( fact_quality[Total Units] )
			RETURN DIVIDE ( ScrapUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// quality.rework.pct - Rework Rate %
	/// Measures share of units requiring rework.
	measure 'Rework Rate %' =
			VAR ReworkUnits = SUM ( fact_quality[Rework Units] )
			VAR TotalUnits = SUM ( fact_quality[Total Units] )
			RETURN DIVIDE ( ReworkUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// quality.copq.amount - Cost of Poor Quality
	/// Captures financial impact of scrap, rework, and warranty/complaints.
	measure 'Cost of Poor Quality' =
			SUM ( fact_quality_costs[COPQ Amount] )
		formatString: "#,0.00"
		displayFolder: "OPS-003"

	/// quality.complaint.pct - Complaint Rate %
	/// Measures customer complaints relative to shipped units.
	measure 'Complaint Rate %' =
			VAR Complaints = SUM ( fact_complaints[Complaint Count] )
			VAR ShippedUnits = SUM ( fact_shipments[Shipped Units] )
			RETURN DIVIDE ( Complaints, ShippedUnits )
		formatString: "0.0%"
		displayFolder: "OPS-003"

	/// quality.defect_density - Defect Density
	/// Measures defect count per 1,000 units produced.
	measure 'Defect Density' =
			VAR DefectCount = SUM ( fact_quality[Defect Count] )
			VAR TotalUnits = SUM ( fact_quality[Total Units] )
			RETURN DIVIDE ( DefectCount, TotalUnits ) * 1000
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// ops.planned_output.units - Planned Output Units
	/// Captures planned production output volume.
	measure 'Planned Output Units' =
			BLANK()
		formatString: "#,0"
		displayFolder: "OPS-003"

	/// sales.units - Sales Units
	/// Measures sold units volume in the period.
	measure 'Sales Units' =
			BLANK()
		formatString: "#,0"
		displayFolder: "OPS-003"
