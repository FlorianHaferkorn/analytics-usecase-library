/// FIN-001 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// wc.ccc.days - CCC Days
	/// Measures cash conversion cycle length.
	measure 'CCC Days' =
			[DSO Days] + [DIO Days] - [DPO Days]
		formatString: "0"
		displayFolder: "FIN-001"

	/// fin.cash.balance - Cash Balance
	/// Tracks cash and cash equivalents at period end.
	measure 'Cash Balance' =
			SUM ( fact_cash_position[Cash Balance Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// fin.cash.ocf - Operating Cash Flow
	/// Measures cash generated by operating activities.
	measure 'Operating Cash Flow' =
			SUM ( fact_cash_flow[Operating Cash Flow Amount] )
		formatString: "#,0.00"
		displayFolder: "FIN-001"

	/// fin.cash.vs_plan.pct - Cash vs Plan %
	/// Measures deviation of cash balance versus plan.
	measure 'Cash vs Plan %' =
			VAR Actual = SUM ( fact_cash_position[Cash Balance Amount] )
			VAR Plan = SUM ( fact_cash_position[Plan Cash Amount] )
			RETURN DIVIDE ( Actual - Plan, Plan )
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// wc.dso.days - DSO Days
	/// Measures days sales outstanding for receivables.
	measure 'DSO Days' =
			VAR AR = SUM ( fact_accounts_receivable[AR Amount] )
			VAR NetSales = SUM ( fact_accounts_receivable[Revenue Amount] )
			RETURN DIVIDE ( AR * 365, NetSales )
		formatString: "0"
		displayFolder: "FIN-001"

	/// wc.dio.days - DIO Days
	/// Measures days inventory outstanding.
	measure 'DIO Days' =
			VAR Inventory = SUM ( fact_inventory[Inventory Amount] )
			VAR COGS = SUM ( fact_inventory[COGS Amount] )
			RETURN DIVIDE ( Inventory * 365, COGS )
		formatString: "0"
		displayFolder: "FIN-001"

	/// wc.dpo.days - DPO Days
	/// Measures days payables outstanding.
	measure 'DPO Days' =
			VAR AP = SUM ( fact_accounts_payable[AP Amount] )
			VAR COGS = SUM ( fact_accounts_payable[COGS Amount] )
			RETURN DIVIDE ( AP * 365, COGS )
		formatString: "0"
		displayFolder: "FIN-001"

	/// scm.service_level.pct - Supply Chain Service Level %
	/// Measures supply chain service level performance.
	measure 'Supply Chain Service Level %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "FIN-001"

	/// scm.supplier_risk.score - Supplier Risk Score
	/// Rates suppliers based on risk indicators.
	measure 'Supplier Risk Score' =
			BLANK()
		formatString: "0"
		displayFolder: "FIN-001"
