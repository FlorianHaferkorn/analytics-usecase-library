/// OPS-001 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// ops.oee.pct - OEE %
	/// Measures manufacturing performance combining availability, performance, and quality.
	measure 'OEE %' =
			[Availability %] * [Performance %] * [Quality %]
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// ops.availability.pct - Availability %
	/// Uptime share relative to planned production time.
	measure 'Availability %' =
			VAR RunTime = SUM ( fact_ops[Run Time Minutes] )
			VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] )
			RETURN DIVIDE ( RunTime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// ops.performance.pct - Performance %
	/// Throughput speed versus theoretical maximum.
	measure 'Performance %' =
			VAR ActualOutput = SUM ( fact_ops[Output Units] )
			VAR RunTime = SUM ( fact_ops[Run Time Minutes] )
			VAR StandardRate = AVERAGE ( fact_ops[Standard Rate Units Per Minute] )
			VAR TheoreticalOutput = RunTime * StandardRate
			RETURN DIVIDE ( ActualOutput, TheoreticalOutput )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// ops.quality.pct - Quality %
	/// Yield of conforming units relative to total units produced.
	measure 'Quality %' =
			VAR GoodUnits = SUM ( fact_ops[Good Units] )
			VAR TotalUnits = SUM ( fact_ops[Output Units] )
			RETURN DIVIDE ( GoodUnits, TotalUnits )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// ops.throughput.units - Throughput Units
	/// Measures total output volume in units.
	measure 'Throughput Units' =
			SUM ( fact_ops[Output Units] )
		formatString: "#,0"
		displayFolder: "OPS-001"

	/// ops.downtime.pct - Downtime %
	/// Measures share of planned production time lost to downtime.
	measure 'Downtime %' =
			VAR Downtime = SUM ( fact_ops[Downtime Minutes] )
			VAR PlannedTime = SUM ( fact_ops[Planned Time Minutes] )
			RETURN DIVIDE ( Downtime, PlannedTime )
		formatString: "0.0%"
		displayFolder: "OPS-001"

	/// ops.planned_output.units - Planned Output Units
	/// Captures planned production output volume.
	measure 'Planned Output Units' =
			BLANK()
		formatString: "#,0"
		displayFolder: "OPS-001"
