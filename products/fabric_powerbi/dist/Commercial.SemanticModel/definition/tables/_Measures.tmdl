/// Consolidated Measures for: COM-001, COM-002, COM-003, COM-004
table _Measures
	lineageTag: 8bc57f21-c2cc-4955-a03a-153deb0ec45b

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' = DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: f3afc511-5776-421c-887a-7c73eeb942ff

	/// cost.cogs.amount - Cost of Goods Sold Amount
	/// Total cost of goods sold for invoiced revenue; base for margin and PVM.
	measure 'Cost of Goods Sold Amount' = SUM ( fact_sales[Cost of Goods Sold Amount] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 4c31cc94-f351-4f6d-aed6-2f120f38d266

	/// sales.net_sales.amount - Net Sales Amount
	/// Total invoiced revenue net of discounts and returns.
	measure 'Net Sales Amount' = SUM ( fact_sales[Net Sales Amount] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 5de66abd-f3dd-4580-9437-33b366e20d56

	/// sales.net_sales.delta_pct.plan - Net Sales % vs Plan
	/// Relative variance of Net Sales vs Plan.
	measure 'Net Sales % vs Plan' = VAR Actual = [Net Sales Amount] VAR Plan   = SUM ( fact_sales[Plan Sales Amount] ) RETURN DIVIDE ( Actual - Plan, Plan )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: 41019692-77d3-4aae-b8b2-dca05ac3c686

	/// sales.net_sales.delta_pct.ly - Delta% Net Sales
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' = VAR Actual = [Net Sales Amount] VAR LY     = SUM ( fact_sales[Last Year Sales Amount] ) RETURN DIVIDE ( Actual - LY, LY )
		formatString: 0.0%
		displayFolder: COM-001
		lineageTag: b058693b-f5e7-475b-90c9-ff59c195a592

	/// sales.pvm.price_effect.amount - Price Effect Amount
	/// Quantifies the pure price impact in the PVM bridge.
	measure 'Price Effect Amount' = SUMX ( fact_sales, VAR ActualPrice = DIVIDE ( fact_sales[Net Sales Amount], fact_sales[Quantity] ) VAR PlanPrice   = DIVIDE ( fact_sales[Plan Sales Amount], fact_sales[Plan Quantity] ) RETURN ( ActualPrice - PlanPrice ) * fact_sales[Quantity] )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: 8342366a-1cce-44b8-b562-f4f0bfc8a29c

	/// sales.pvm.volume_effect.amount - Volume Effect Amount
	/// Measures the variance caused purely by quantity changes at plan price.
	measure 'Volume Effect Amount' = SUMX ( fact_sales, VAR ActualQty = fact_sales[Quantity] VAR PlanQty   = fact_sales[Plan Quantity] VAR PlanPrice = DIVIDE ( fact_sales[Plan Sales Amount], PlanQty ) RETURN ( ActualQty - PlanQty ) * PlanPrice )
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: ede44441-0a93-4724-97ce-b0f5fb919f1a

	/// sales.pvm.mix_effect.amount - Mix Effect Amount
	/// Captures the residual effect from changes in product, channel, or region mix.
	measure 'Mix Effect Amount' = [Net Sales Amount] - SUM ( fact_sales[Plan Sales Amount] ) - [Price Effect Amount] - [Volume Effect Amount]
		formatString: #,0.00
		displayFolder: COM-001
		lineageTag: a0155193-ee71-47c2-8803-f0d5b0204af1

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} where price realization falls below threshold" & UNICHAR(10) & "  2. FREEZE discretionary discounts for this {entity}" & UNICHAR(10) & "  3. ENFORCE approval workflow for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW realization recovery for this {entity} monthly"
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 8ebf65f4-e78a-4f9e-b7f7-2e335f34d645

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching gross margin threshold" & UNICHAR(10) & "  2. FREEZE new discretionary discounts for this {entity}" & UNICHAR(10) & "  3. REQUIRE approval for any price exception on this {entity}" & UNICHAR(10) & "  4. REVIEW net price realization for this {entity} weekly"
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: de829a57-6d25-4e92-bb19-af8aabad161d

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this {entity} within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this {entity}" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this {entity} after one cycle"
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 3466bba3-80ca-4edb-820a-582c9147b43b

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-S1.2"

	/// margin.gm.amount - Gross Margin Amount
	/// Absolute gross margin in currency.
	measure 'Gross Margin Amount' = [Net Sales Amount] - [Cost of Goods Sold Amount]
		formatString: #,0.00
		displayFolder: COM-002
		lineageTag: 7970a900-dd61-40c9-8407-1c3a8abfc400

	/// sales.price.realization_pct - Price Realization %
	/// Shows how much of list price is realized after discounts.
	measure 'Price Realization %' = DIVIDE ( [Net Price Amount], [List Price Amount] )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: 14853177-332b-48c8-a6ec-2b8ec6018bda

	/// cost.cogs_per_unit.amount - COGS per Unit
	/// Shows unit cost level relative to sold volume.
	measure 'COGS per Unit' = DIVIDE ( [Cost of Goods Sold Amount], SUM ( fact_sales[Quantity] ) )
		formatString: #,0
		displayFolder: COM-002
		lineageTag: 1420e0f1-5cbc-4ec0-b765-3adc4c50baeb

	/// margin.gm.vs_plan.pct - Gross Margin % vs Plan
	/// Measures gross margin rate variance versus plan.
	measure 'Gross Margin % vs Plan' = VAR GMAct = DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ) VAR GMPlan = DIVIDE ( SUM ( fact_sales[Plan Sales Amount] ) - SUM ( fact_sales[Plan COGS Amount] ), SUM ( fact_sales[Plan Sales Amount] ) ) RETURN DIVIDE ( GMAct - GMPlan, GMPlan )
		formatString: 0.0%
		displayFolder: COM-002
		lineageTag: d1aef29c-0417-4815-8ed4-aa112987ffd8

	/// crm.clv.amount - CLV
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure CLV = AVERAGEX ( VALUES ( fact_sales[CustomerKey] ), CALCULATE ( SUM ( fact_sales[Net Sales Amount] ) - SUM ( fact_sales[Cost of Goods Sold Amount] ) ) * 3 )
		formatString: #,0.00
		displayFolder: COM-003
		lineageTag: ed81c604-f281-4816-8fa8-1978f8ee09cb

	/// crm.lifetime_revenue.amount - Customer Lifetime Revenue Amount
	/// Sum of realized revenue across the customer lifecycle.
	measure 'Customer Lifetime Revenue Amount' = CALCULATE ( SUM ( fact_sales[Net Sales Amount] ), ALLSELECTED ( dim_date ) )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: c9915efe-f87b-4cfb-b05a-d256c8e81f91

	/// crm.retention.pct - Customer Retention %
	/// Measure the share of customers that remain active from one period to the next, as a core loyalty KPI.
	measure 'Customer Retention %' = VAR CurrentPeriodCustomers = CALCULATE ( DISTINCTCOUNT ( fact_sales[CustomerKey] ), FILTER ( ALLSELECTED ( dim_date ), dim_date[Date] = MAX ( dim_date[Date] ) ) ) VAR PreviousPeriodCustomers = CALCULATE ( DISTINCTCOUNT ( fact_sales[CustomerKey] ), DATEADD ( dim_date[Date], -1, MONTH ) ) RETURN DIVIDE ( CurrentPeriodCustomers, PreviousPeriodCustomers )
		formatString: 0.0%
		displayFolder: COM-003
		lineageTag: 26e46e94-6fb3-424a-bc1f-e0cd9ea6d7bd

	/// crm.churned_customers.count - Churned Customers
	/// Count customers that have stopped purchasing in the observation window as basis for churn calculations.
	measure 'Churned Customers' = VAR PreviousMonthCustomers = CALCULATETABLE ( VALUES ( fact_sales[CustomerKey] ), DATEADD ( dim_date[Date], -1, MONTH ) ) VAR CurrentMonthCustomers = VALUES ( fact_sales[CustomerKey] ) RETURN COUNTROWS ( EXCEPT ( PreviousMonthCustomers, CurrentMonthCustomers ) )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 43b81270-20f0-41af-b021-12b78ba5555f

	/// crm.revenue_at_risk.amount - Revenue at Risk Amount
	/// Quantify revenue exposure from customers flagged as churn-risk.
	measure 'Revenue at Risk Amount' = VAR ChurnRiskPct = 0.15 RETURN [CLV] * ChurnRiskPct
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 31ea58e9-adfd-4c55-b97c-c198580ba782

	/// crm.active_customers.count - Active Customers
	/// Number of unique active customers in the reporting period.
	measure 'Active Customers' = DISTINCTCOUNT ( fact_sales[CustomerKey] )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 212ba43b-8950-4bf1-90ec-d02093a46f68

	/// crm.nps.index - NPS Score
	/// Measures customer advocacy and likelihood to recommend.
	measure 'NPS Score' = VAR Promoters = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[Is Promoter] = TRUE () ) VAR Detractors = CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[Is Detractor] = TRUE () ) VAR Total = COUNTROWS ( fact_nps ) RETURN DIVIDE ( Promoters - Detractors, Total ) * 100
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 691d87c6-5ab1-4a31-b64d-ce97fd748090

	/// crm.complaint.count - Complaint Count
	/// Provide the absolute number of logged complaints.
	measure 'Complaint Count' = COUNTROWS ( fact_experience )
		formatString: #,0
		displayFolder: COM-003
		lineageTag: 8855aff7-5ca0-46fb-95d9-4ddd25db5299

	/// sales.promo.roi.pct - Promo ROI %
	/// Measures profitability of promotions relative to spend.
	measure 'Promo ROI %' = DIVIDE ( [Incremental Gross Margin Amount], [Promo Cost] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 8d179456-80d9-4f03-9d52-90ac262d65f5

	/// sales.promo.incremental.amount - Incremental Sales Amount
	/// Additional sales due to promotion.
	measure 'Incremental Sales Amount' = [Net Sales Amount] - [Baseline Sales Amount]
		formatString: #,0.00
		displayFolder: COM-004
		lineageTag: f3b2b0f6-4fa0-40ee-9cd4-1ae01d32db3e

	/// margin.promo.gm.pct - GM % During Promo
	/// Gross margin rate during promo periods.
	measure 'GM % During Promo' = CALCULATE ( DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] ), fact_sales[Promo Flag] = "Yes" )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 81815de8-e4d4-49ca-82b1-1f74e17d0287

	/// sales.promo.cannibalization.pct - Cannibalization %
	/// Measures share of promo uplift offset by decline in non-promoted sales.
	measure 'Cannibalization %' = DIVIDE ( [Cannibalized Sales Amount], [Incremental Sales Amount] )
		formatString: 0.0%
		displayFolder: COM-004
		lineageTag: 6c14f845-d596-4924-b21c-d7b80c3b964b

	/// ActionReady Logic: C-M2.2 - Mix Optimization (Margin-Driven)
	measure 'Action_C-M2.2_Text' = "Trigger: Pattern (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with persistent negative mix effect" & UNICHAR(10) & "  2. RANK SKUs by margin contribution for this {entity}" & UNICHAR(10) & "  3. ADJUST sales targets and focus lists for this {entity}" & UNICHAR(10) & "  4. MONITOR mix and margin for this {entity} monthly"
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 01293a59-3f5d-44b7-aebf-496a7b97c9f2

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-M2.2"

	/// ActionReady Logic: C-P4.1 - Promo Calendar Discipline
	measure 'Action_C-P4.1_Text' = "Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: TBD" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each {entity} with repeated negative ROI" & UNICHAR(10) & "  2. REVIEW mechanics and baseline assumptions for this {entity}" & UNICHAR(10) & "  3. STOP, REPLACE, or RESEQUENCE this {entity} based on ROI analysis" & UNICHAR(10) & "  4. VALIDATE ROI improvement for this {entity} in next cycle"
		isHidden
		displayFolder: 9_ActionReady_Logic
		lineageTag: 3b357e83-c6ff-4fba-a7fb-65a74776d109

		annotation ActionReady_ResponsibleRole = "TBD"

		annotation ActionReady_ActionCodeId = "C-P4.1"

	column Column1
		dataType: string
		isHidden
		lineageTag: 05fb8684-2074-418f-b58d-c8db1e29f364
		summarizeBy: none
		sourceColumn: Column1

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

