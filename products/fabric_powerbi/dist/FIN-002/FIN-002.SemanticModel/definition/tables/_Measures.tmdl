/// FIN-002 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// cost.unit.amount - Unit Cost Amount
	/// Measures total cost per unit produced or sold.
	measure 'Unit Cost Amount' =
			VAR TotalCost = SUM ( fact_cost[COGS Amount] )
			VAR OutputUnits = SUM ( fact_output[Output Units] )
			RETURN DIVIDE ( TotalCost, OutputUnits )
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// margin.cogs.pct - COGS % of Sales
	/// Shows cost share relative to net sales.
	measure 'COGS % of Sales' =
			VAR COGS = SUM ( fact_finance[COGS Amount] )
			VAR NetSales = SUM ( fact_finance[Net Sales Amount] )
			RETURN DIVIDE ( COGS, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// cost.opex.vs_plan.pct - OpEx vs Plan %
	/// Measures OpEx variance versus plan.
	measure 'OpEx vs Plan %' =
			VAR Actual = SUM ( fact_finance[OpEx Amount] )
			VAR Plan = SUM ( fact_finance[Plan OpEx Amount] )
			RETURN DIVIDE ( Actual - Plan, Plan )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// cost.material.pct - Material Cost %
	/// Shows material cost share of net sales.
	measure 'Material Cost %' =
			VAR MaterialCost = SUM ( fact_finance[Material Cost Amount] )
			VAR NetSales = SUM ( fact_finance[Net Sales Amount] )
			RETURN DIVIDE ( MaterialCost, NetSales )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// ops.labor.productivity.pct - Labor Productivity %
	/// Shows output efficiency relative to labor input.
	measure 'Labor Productivity %' =
			VAR OutputUnits = SUM ( fact_output[Output Units] )
			VAR LaborHours = SUM ( fact_labor[Labor Hours] )
			VAR BaselineRate = 100.0
			RETURN DIVIDE ( DIVIDE ( OutputUnits, LaborHours ) * 100, BaselineRate )
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// cost.base_volume.amount - Cost Base Volume Amount
	/// Baseline cost volume used for variance analysis.
	measure 'Cost Base Volume Amount' =
			BLANK()
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// cost.opex.base.amount - Opex Base Amount
	/// Baseline operating expense amount for variance tracking.
	measure 'Opex Base Amount' =
			BLANK()
		formatString: "#,0.00"
		displayFolder: "FIN-002"

	/// ops.production.volume - Production Volume Units
	/// Measures total produced volume in units.
	measure 'Production Volume Units' =
			BLANK()
		formatString: "#,0"
		displayFolder: "FIN-002"

	/// ops.quality.defect_rate.pct - Quality Defect Rate %
	/// Measures share of defective units in production.
	measure 'Quality Defect Rate %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// ops.service_level.pct - Operations Service Level %
	/// Measures on-time or in-full performance for operational delivery.
	measure 'Operations Service Level %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "FIN-002"

	/// ops.yield.pct - Yield %
	/// Measures ratio of good output to total input.
	measure 'Yield %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "FIN-002"
