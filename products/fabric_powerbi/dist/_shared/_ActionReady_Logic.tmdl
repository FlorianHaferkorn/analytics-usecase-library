/// ActionReady Logic Table - Auto-generated from UseCase Brackets + Action Code YAMLs
/// Contains hidden text measures for each subscribed Action Code.
/// DO NOT EDIT MANUALLY - regenerate via generate_tmdl_measures.ps1
table _ActionReady_Logic
	isHidden

	partition _ActionReady_Logic = m
		mode: import
		source =
				let
					Source = #table(type table[_Placeholder = text], {})
				in
					Source

	column _Placeholder
		dataType: string
		sourceColumn: _Placeholder
		isHidden
		summarizeBy: none

	/// ActionReady Logic: C-M2.1 - Price Realization Guardrails
	measure 'Action_C-M2.1_Text' =
			"Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_lead" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each invoice line where price realization falls below threshold" & UNICHAR(10) & "  2. FREEZE discretionary discounts for this invoice line" & UNICHAR(10) & "  3. ENFORCE approval workflow for any price exception on this invoice line" & UNICHAR(10) & "  4. REVIEW realization recovery for this invoice line monthly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_lead"
		annotation ActionReady_ActionCodeId = "C-M2.1"

	/// ActionReady Logic: C-S1.1 - Price Discipline Enforcement
	measure 'Action_C-S1.1_Text' =
			"Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: pricing_manager" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each invoice line breaching gross margin threshold" & UNICHAR(10) & "  2. FREEZE new discretionary discounts for this invoice line" & UNICHAR(10) & "  3. REQUIRE approval for any price exception on this invoice line" & UNICHAR(10) & "  4. REVIEW net price realization for this invoice line weekly"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "pricing_manager"
		annotation ActionReady_ActionCodeId = "C-S1.1"

	/// ActionReady Logic: C-S1.2 - Sales Gap Recovery via Price & Pack Adjustment
	measure 'Action_C-S1.2_Text' =
			"Trigger: Deviation (L1: EarlyWarning, L2: RequiredIntervention, L3: PrescriptiveExecution)" & UNICHAR(10) & "Owner: sales_director" & UNICHAR(10) & "Steps:" & UNICHAR(10) & "  1. IDENTIFY each invoice line breaching plan thresholds" & UNICHAR(10) & "  2. SELECT eligible products for this invoice line within GM guardrails" & UNICHAR(10) & "  3. APPLY temporary price or pack adjustments to this invoice line" & UNICHAR(10) & "  4. REVIEW Net Sales uplift for this invoice line after one cycle"
		isHidden
		displayFolder: "9_ActionReady_Logic"
		annotation ActionReady_ResponsibleRole = "sales_director"
		annotation ActionReady_ActionCodeId = "C-S1.2"
