/// XD-003 Measures
table _Measures

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table[Column1 = text], {})
				in
					Source

	column Column1
		dataType: string
		sourceColumn: Column1
		isHidden
		summarizeBy: none

	/// margin.gm.pct - Gross Margin %
	/// Gross margin % for commercial/operational reporting and strategic P&L reconciliation.
	measure 'Gross Margin %' =
			DIVIDE ( [Net Sales Amount] - [Cost of Goods Sold Amount], [Net Sales Amount] )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// sales.net_sales.delta_pct.ly - Delta% Net Sales
	/// Relative variance of Net Sales vs Last Year.
	measure 'Delta% Net Sales' =
			VAR Actual = [Net Sales Amount]
			VAR LY     = SUM ( fact_sales[Last Year Sales Amount] )
			RETURN DIVIDE ( Actual - LY, LY )
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// crm.clv.amount - CLV
	/// Estimate long-term value of a customer to prioritize retention, acquisition, and service investments.
	measure 'CLV' =
			AVERAGEX (
			VALUES ( fact_sales[CustomerKey] ),
			CALCULATE (
			SUM ( fact_sales[Net Sales Amount] ) - SUM ( fact_sales[Cost of Goods Sold Amount] )
			) * 3
			)
		formatString: "#,0.00"
		displayFolder: "XD-003"

	/// svc.sla.attainment.pct - SLA Attainment %
	/// Measures how many cases meet the committed SLA.
	measure 'SLA Attainment %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// ops.otif.pct - OTIF %
	/// Delivery reliability measured by orders delivered on-time and in-full.
	measure 'OTIF %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// ops.working_capital.ccc.days - Cash Conversion Cycle (Days)
	/// Combines receivables, inventory, and payables days to show cash efficiency.
	measure 'Cash Conversion Cycle (Days)' =
			BLANK()
		formatString: "0"
		displayFolder: "XD-003"

	/// people.digital_adoption.pct - Digital Adoption Rate %
	/// Measure how much of all eligible process transactions are executed via digital tools instead of manual channels.
	measure 'Digital Adoption Rate %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// people.attrition_risk.pct - Attrition Risk %
	/// Monitor risk of employee attrition across key roles and segments.
	measure 'Attrition Risk %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// enterprise.action_routed.count - Actions Routed Count
	/// Counts action codes routed for execution.
	measure 'Actions Routed Count' =
			BLANK()
		formatString: "#,0"
		displayFolder: "XD-003"

	/// enterprise.action_outcome_rate.pct - Action Outcome Rate %
	/// Measures share of actions that achieved the intended outcome.
	measure 'Action Outcome Rate %' =
			BLANK()
		formatString: "0.0%"
		displayFolder: "XD-003"

	/// enterprise.value_at_risk.index - Enterprise Value-at-Risk Index
	/// Aggregates downside risk across domains into a single index.
	measure 'Enterprise Value-at-Risk Index' =
			BLANK()
		formatString: "0"
		displayFolder: "XD-003"
