# LLM Provider — set ONE of the following (priority: Gemini → Azure → OpenAI)
# If multiple keys are set, the first match wins.

# Google Gemini (recommended — use GOOGLE_API_KEY or GEMINI_API_KEY)
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI (only used if no Gemini/Azure key is set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Repo root — path to the analytics-usecase-library repo root
# Default: two levels up from this file (../../)
# Override if running from a different working directory
# REPO_ROOT=/absolute/path/to/analytics-usecase-library
